"Group of queries related to alerts."
type ShepherdAlertQueries @apiGroup(name : GUARD_DETECT) {
  """
  `[Internal]` Exports an alert data to a CSV-like content.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:alert:guard-detect__
  """
  alertExports(
    "The alert ARI."
    id: ID! @ARI(interpreted : false, owner : "beacon", type : "alert", usesActivationId : false)
  ): ShepherdAlertExportsResult @rateLimited(disabled : false, rate : 20, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 500, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_ALERT])
  """
  Returns the snippets of detected content for a content scanning alert.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:alert:guard-detect__
  """
  alertSnippets(
    "The alert ARI."
    id: ID! @ARI(interpreted : false, owner : "beacon", type : "alert", usesActivationId : false)
  ): ShepherdAlertSnippetResult @apiGroup(name : GUARD_DETECT) @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_ALERT])
  """
  Returns the most recent attachment redaction operation associated with an alert, if one exists.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:alert:guard-detect__
  """
  attachmentRedaction(
    "The alert ARI."
    id: ID! @ARI(interpreted : false, owner : "beacon", type : "alert", usesActivationId : false)
  ): ShepherdAttachmentRedactionResult @apiGroup(name : GUARD_DETECT) @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_ALERT])
  "`[Internal]` Returns the authorized actions the current user can perform on a given resource in the context of an alert or redaction task."
  authorizedActions(
    "The alert or redaction task ARI."
    id: ID! @ARI(interpreted : false, owner : "beacon", type : "alert, redaction-task", usesActivationId : false),
    "Resource ARI, e.g. page, work item, etc."
    resource: ID!
  ): ShepherdAlertAuthorizedActionsResult @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false)
  """
  Returns an alert by its ARI.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:alert:guard-detect__
  """
  byAri(id: ID! @ARI(interpreted : false, owner : "beacon", type : "alert", usesActivationId : false)): ShepherdAlertResult @apiGroup(name : GUARD_DETECT) @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_ALERT])
  """
  `[Internal]` Returns alert for a given content ARI (e.g. attachment ARI).
  As of now, it works by indexing content scanning alerts by the content ARI where they were found (e.g. page, issue, comment, attachment).
  
  ### The field is not available for OAuth authenticated requests
  """
  byContentAri(
    "A cursor indicating the last result of a previous query, after which we should begin retrieving for the current query."
    after: String,
    "The content ARI (e.g. an attachment ARI such as `ari:cloud:jira:...:issue-attachment/10066/11083`) to retrieve content scanning alerts for."
    contentAri: String!,
    """
    An optional Media file ID to scope results to a specific file version. When provided, only alerts for that exact
    file version are returned. Useful when the same content ARI has multiple alerts due to same-name re-uploads.
    """
    fileId: String,
    "The maximum number of alerts to return per page. Must be between 1 and 100 (defaults to 50)."
    first: Int,
    "The Guard Detect workspace ARI (e.g. `ari:cloud:beacon::workspace/<workspace-id>`)."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdAlertsResult @apiGroup(name : GUARD_DETECT) @oauthUnavailable @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false)
  """
  Returns alerts for a given workspace and type and status.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:alert:guard-detect__
  """
  byTypeAndStatus(
    "A cursor indicating the last result of a previous query, after which we should begin retrieving for the current query."
    after: String,
    "The alert statuses."
    alertStatuses: [String!]!,
    "The alert type."
    alertType: String!,
    "The number of alerts to return."
    first: Int,
    "The workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdAlertsResult @apiGroup(name : GUARD_DETECT) @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_ALERT])
  """
  Returns alerts for a given workspace.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:alert:guard-detect__
  """
  byWorkspace(
    "Use `aaid` to restrict alerts to a specific account."
    aaid: ID,
    "A cursor indicating the last result of a previous query, after which we should begin retrieving for the current query."
    after: String,
    "The number of alerts to return."
    first: Int,
    "The workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdAlertsResult @apiGroup(name : GUARD_DETECT) @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 5000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_ALERT])
  """
  `[Internal]` Returns the snippet of content for a single finding, with the matched span marked
  sensitive so the caller can highlight it.
  
  `contentHash` is mandatory: the resolved span is hashed and must match it before any text is
  returned.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:alert:guard-detect__
  """
  findingSnippet(
    """
    Base64-encoded SHA-256 of the matched content. Required: the resolved span is hashed and compared
    against this value, and no content is returned unless they match.
    """
    contentHash: String!,
    "The scanned content type, e.g. `confluence_page_body`, `summary`, or `jira_attachment12345`."
    contentType: String!,
    "Character offset of the end of the match, exclusive."
    endIndex: Int!,
    "JSON pointer to the ADF text node the match ends in. Empty for plain text fields."
    endPointer: String!,
    """
    The Media Platform file ID. Required when `resourceAri` is an attachment ARI and ignored
    otherwise.
    """
    mediaFileId: String,
    """
    The ARI of the resource containing the match — a Confluence page or blogpost, a Jira work item, a
    comment, a worklog, or an attachment.
    """
    resourceAri: ID! @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false),
    "Character offset of the start of the match, within the node named by `startPointer`."
    startIndex: Int!,
    "JSON pointer to the ADF text node the match starts in. Empty for plain text fields."
    startPointer: String!,
    "The Beacon workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdFindingSnippetResult @apiGroup(name : GUARD_DETECT) @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @routing(ariFilters : [{owner : "beacon", type : "workspace"}]) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_ALERT])
  """
  Returns the snippets of detected content for a policy violation. The violation is verified
  server-side against the violation service before any content is read.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:alert:guard-detect__
  """
  violationSnippets(
    "The violation ID."
    violationId: ID!,
    "The workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdViolationSnippetsResult @apiGroup(name : GUARD_DETECT) @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_ALERT])
}

