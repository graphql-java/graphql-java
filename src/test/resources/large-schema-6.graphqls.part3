  "The lifecycle event this timeline entry represents."
  event: PsmSensorEventType
  "Occurrence id for this event (echoed from the SysTrack envelope)."
  eventId: ID!
  "Backend-rendered message for this event."
  message: PsmSensorEventMessage
  "When the event occurred on the endpoint (UTC)."
  occurredAt: DateTime
}

"A relay-style page of an employee's proactive-support conversations on a device, newest activity first."
type PsmConversationHistoryConnection {
  "The page of conversations, each alongside its pagination cursor."
  edges: [PsmConversationHistoryEdge!]
  "Populated instead of edges/nodes when the listing could not be served."
  errors: [QueryError!]
  "AGG-encouraged collapsed node list for clients that don't need a per-row cursor."
  nodes: [PsmConversationHistoryItem]
  pageInfo: PageInfo!
}

type PsmConversationHistoryEdge {
  cursor: String!
  node: PsmConversationHistoryItem
}

"""
A single conversation-history row: a proactive-support conversation for an employee on a device,
summarised for the sidebar list. The two status dimensions are kept separate (never flattened).
"""
type PsmConversationHistoryItem {
  "Stable id of the conversation."
  conversationId: ID!
  "When the conversation was last active (UTC)."
  lastActivityTime: DateTime
  "The SysTrack notification kind that opened the conversation."
  notificationType: PsmSensorEventType
  "Read state of the conversation (unread/read)."
  readState: PsmConversationReadState
  "Remediation state of the fix (awaiting_action, in_progress, resolved, …)."
  remediationState: PsmRemediationState
  "When the conversation started (UTC) — the opening event's occurrence time."
  startedAt: DateTime
  "Conversation title (the rendered message title of the opening event)."
  title: String
}

"""
Stretch $-savings card. Optional / flag-gated: null until savings can be computed
(by parsing Lakeside audit logs). The committed count-only ROI lives on silentSaves.
"""
type PsmCostSavings {
  "ISO-4217 currency code for itCostSaved."
  currency: String!
  itCostSaved: Float!
  ticketsPrevented: Int!
}

"""
The pre-shaped dashboard-overview view-model for one space and window. Every field is
render-ready; the frontend performs no aggregation.
"""
type PsmDashboardOverview {
  activeIssuesBySeverity: [PsmSeverityCount!]!
  "Stretch $-savings card; null unless flag-gated savings are available (count-only ROI is on silentSaves)."
  costSavings: PsmCostSavings
  devicesNotReporting: Int!
  fleetHealth: PsmFleetHealth!
  "When psm-service assembled this overview from the provider."
  generatedAt: DateTime!
  pendingEndUserActions: Int!
  remediationOutcomes: PsmRemediationOutcomes!
  sensorCoverage: PsmSensorCoverage!
  silentSaves: PsmSilentSaves!
  topIssues: [PsmTopIssue!]!
  totalManagedDevices: Int!
}

"""
Canonical device-identity record: binds an Atlassian account to a physical device
(by serial number) within a tenant, optionally scoped to a JSM space and linked to
the DEX provider's system id. See the ERS node type ati:cloud:jsm:psm-device-mapping.
"""
type PsmDevice {
  "Number of active sensor faults currently affecting this device; null when fault data is unavailable."
  activeSensorCount: Int
  """
  Active sensor faults currently affecting this device; null when no faults or data unavailable.
  
  
  This field is **deprecated** and will be removed in the future
  """
  activeSensorFaults: [PsmDeviceSensorFault!]
  "Sensors currently raising an issue on this device, one entry per sensor, in the shared PsmRemediationSensor shape used by the remediation-history timelines. Replaces activeSensorFaults. Null when there are no active issues or fault data is unavailable."
  activeSensors: [PsmRemediationSensor!]
  "The tenant (cloud id) the device belongs to."
  cloudId: ID!
  "Hardware and software configuration of this device; null when not reported by the provider."
  configuration: PsmDeviceConfiguration
  "When the device mapping was created (UTC)."
  createdAt: DateTime!
  "Human-readable device name (e.g. hostname or asset tag); null when not reported by the provider."
  deviceName: String
  "When the device was enrolled into the PSM provider system (UTC)."
  enrolledAt: DateTime
  "Device-level health summary; null when health data is unavailable."
  health: PsmDeviceHealth
  "When the provider last saw the device, if known."
  lastSeen: DateTime
  "Operating system the device runs, recorded at registration. Null when it was never captured (the device registered before this field existed) or the provider reported an OS with no value here; UNKNOWN is not emitted."
  osType: PsmOsType
  "Enriched owner of this device; null when owner data has not been resolved."
  owner: PsmDeviceOwner
  "The DEX provider's system id for this device (e.g. the Lakeside sysGuid); null until reconciled."
  providerSystemId: ID
  "Normalized device serial number — the primary device identifier."
  serialNumber: String!
  "The JSM space the device is currently scoped to; null until resolved via lazy matching."
  spaceId: ID
  "Derived lifecycle status of the device."
  status: PsmDeviceStatus!
  "When the device mapping was last updated (UTC)."
  updatedAt: DateTime!
}

"Hardware and software configuration of a device, as reported by the provider."
type PsmDeviceConfiguration {
  "CPU description (e.g. \"Apple M3 Pro\")."
  cpu: String
  "Device model (e.g. \"MacBook Pro 16-inch\")."
  model: String
  "Operating system version string (e.g. \"macOS 15.1\", \"Windows 11 23H2\")."
  os: String
  "Operating system platform (e.g. \"Windows\", \"macOS\", \"Linux\")."
  platform: String
  "Total RAM as a human-readable string (e.g. \"16 GB\")."
  ram: String
  "Total storage as a human-readable string (e.g. \"512 GB SSD\")."
  storage: String
}

"A relay-style page of devices, alongside space-level summary counts."
type PsmDeviceConnection {
  "The page of devices, narrowed by filter (if any), each alongside its pagination cursor."
  edges: [PsmDeviceEdge!]
  "Populated instead of edges/nodes when the listing could not be served."
  errors: [QueryError!]
  "Device counts grouped by health status — space-wide, unaffected by filter. One entry per PsmDeviceHealthStatus, including zeros."
  healthStatusCounts: [PsmDeviceHealthStatusCount!]
  "AGG-encouraged collapsed node list for clients that don't need a per-row cursor."
  nodes: [PsmDevice]
  "Number of devices currently offline in the space — space-wide, unaffected by filter."
  offlineDeviceCount: Int
  pageInfo: PageInfo!
  "Total number of registered devices in the space — space-wide, unaffected by filter."
  totalRegisteredDevices: Int
}

