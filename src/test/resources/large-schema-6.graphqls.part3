"Identity of the actor that last remediated a device/sensor pair."
type PsmRemediatedBy {
  "Atlassian account id of the user; null when kind = SYSTEM. Frontend can resolve avatar/display name from this."
  accountId: ID
  "Email address of the user; null when kind = SYSTEM."
  email: String
  "Whether the remediation was performed by the system (automation) or a user."
  kind: PsmActorType
  "Display name of the user; null when kind = SYSTEM."
  name: String
}

"Remediation breakdown grouped by resolution type."
type PsmRemediationBreakdownResult {
  buckets: [PsmRemediationBucket!]!
  "End of the requested window."
  endTime: DateTime!
  "Start of the requested window, echoed so the chart can label itself."
  startTime: DateTime!
}

"Succeeded/failed counts for one resolution type bucket."
type PsmRemediationBucket {
  failed: Int!
  resolutionType: PsmRemediationResolutionType!
  succeeded: Int!
}

"A remediation category value paired with its display label for the Active Sensors row."
type PsmRemediationCategoryInfo {
  "Display label for the value (e.g. \"User prompted\")."
  label: String
  "The remediation category value."
  value: PsmRemediationCategory
}

"""
A remediation-history row on a device/sensor pair. Detected (open-fault) events are
excluded. Automatic runs include pending / declined / delivery-issue rows; manual
PSM jobs are SUCCESS or FAILED only.

Display mapping (this event is one timeline row under the sensor group) is owned by
the service layer from approvalStatus + errorCode + returnCode (Event log sheet):
- title ← status line (e.g. "Remediation completed successfully")
- result.label ← lozenge text (e.g. "Succeeded", "Failed to start")
- detailMessage ← detail sentence, including on SUCCESS
"""
type PsmRemediationHistoryEvent {
  "User-facing detail sentence for the run (success, failure, declined, pending, or delivery issue)."
  detailMessage: String
  "How long the remediation run took, in milliseconds; null when the provider does not report a duration."
  durationMs: Int
  """
  Technical error when result is FAILED; null otherwise.
  
  
  This field is **deprecated** and will be removed in the future
  """
  errorMessage: String
  "When the remediation ran (UTC)."
  executedAt: DateTime!
  "Stable id of this history row (from the provider event id); null when the provider gives no stable id for the run."
  id: ID
  "Outcome of the run, with a display label for the timeline lozenge."
  result: PsmRemediationResultInfo!
  "Status-line summary of what happened (e.g. \"Remediation completed successfully\", \"Remediation couldn't start\")."
  title: String
  "How this run was triggered."
  triggerType: PsmRemediationTrigger
  "Actor for this run. kind = SYSTEM when triggerType is AUTO or END_USER; USER with account details when triggerType is AGENT."
  triggeredBy: PsmRemediatedBy
}

"Remediation-outcomes card: the disposition of remediations attempted in the window."
type PsmRemediationOutcomes {
  failed: Int!
  pending: Int!
  success: Int!
  successRatePct: Float!
}

"""
Outcome pill for a history event. `value` is the programmatic enum; `label` is the
lozenge text so the client does not hardcode "Success" / "Failed". Same value+label
shape as PsmRemediationCategoryInfo.
"""
type PsmRemediationResultInfo {
  "Display label for the lozenge (e.g. \"Succeeded\", \"Failed to start\", \"Declined\", \"Awaiting approval\")."
  label: String!
  "Programmatic outcome. SUCCESS, FAILED, or PENDING. Clients own lozenge colour; do not infer colour from this field."
  value: PsmRemediationResult!
}

"""
A sensor grouped with its remediation events (the sensor name is the group header, e.g.
"Unauthorised access"). Shared by two surfaces:
- the history timelines (psm_faultRemediationHistory / psm_deviceRemediationHistory), where
  `events` are the sensor's completed Failed/Success runs, newest first; and
- PsmDevice.activeSensors, where it lists the sensors currently raising an issue on a device.
"""
type PsmRemediationSensor {
  "Remediation events for this sensor, newest first (Detected omitted). On PsmDevice.activeSensors these are the currently-active sensor's past completed runs; null when history data is unavailable."
  events: [PsmRemediationHistoryEvent!]
  "Identifier of the fault (one device + sensor) this sensor row belongs to; null when there is no associated fault (e.g. history groupings not tied to a single fault)."
  faultId: ID
  "Raw lifecycle status of the backing fault (same vocabulary psm_faultStatuses polls); null on history groupings not tied to a single currently-open fault."
  faultStatus: PsmFaultStatus
  "Human-readable sensor name (e.g. \"Unauthorised access\")."
  name: String
  "Identifier for this sensor in the source monitoring provider (vendor-specific)."
  providerSensorId: ID!
  "Stable PSM-internal identifier for the sensor; null on PsmDevice.activeSensors when the sensor has no config row and the internal id could not be resolved. Group/key on providerSensorId, which is always present."
  sensorId: ID
}

" ---------------------------------------------------------------------------------------------"
type PsmRemediationTriggerSummary {
  closed: [String!]
  offline: [String!]
  queued: [String!]
}

"The filter panel definition for one screen: every dimension to render, in tab order."
type PsmScreenFilterResult {
  "Populated instead of filters when the filter panel could not be served."
  errors: [QueryError!]
  "Filters to render, in tab order. Empty/null when the panel could not be fully built — see errors."
  filters: [PsmFilter!]
  screen: PsmFilterScreen!
}

"Result type for DB-backed sensor categories."
type PsmSensorCategoriesResult {
  categories: [String!]!
  errors: [QueryError!]
}

"The lightweight sensor representation used in list results."
type PsmSensorConfig {
  "Broad category used for filtering."
  category: String
  "Short sensor description."
  description: String
  "Whether the sensor is currently enabled."
  enabled: Boolean
  "Stable composite PSM identifier for the sensor."
  id: ID!
  "Confluence page ARIs currently associated with the sensor. Empty/null for a KB_ASSISTED sensor means no KB articles are attached."
  kbArticleAris: [String!]
  "Human-readable sensor name."
  name: String
  "Coarse remediation category for this sensor."
  remediationCategory: PsmRemediationCategory
  "How remediation is handled for this sensor."
  remediationType: PsmSensorRemediationType
  "Provider sensor identifier used within the cloud + space scope."
  sensorId: String
}

"Detailed sensor representation for the details page."
type PsmSensorConfigDetails {
  "Whether this sensor supports push remediation from the UI."
  canPushRemediation: Boolean
  "Broad category used for filtering."
  category: String
  "Short sensor description."
  description: String
  "Whether the sensor is currently enabled."
  enabled: Boolean
  "Read-only guided steps for guidance-based remediation types. Null when the sensor has no authored guidance."
  guidedSteps: String
  "Stable composite PSM identifier for the sensor."
  id: ID!
  "Confluence page ARIs currently associated with the sensor."
  kbArticleAris: [String!]
  "Human-readable sensor name."
  name: String
  "Coarse remediation category for this sensor."
  remediationCategory: PsmRemediationCategory
  "Provider-backed remediation description."
  remediationDesc: String
  "Provider-backed remediation frequency."
  remediationFrequency: String
  "Linked remediation config's internal identifier for this sensor; null if unlinked (MVP: at most one)."
  remediationId: ID
  "How remediation is handled for this sensor."
  remediationType: PsmSensorRemediationType
  "Provider sensor identifier used within the cloud + space scope."
  sensorId: String
  "Provider-backed trigger condition."
  triggerCondition: String
}

"Result type for a single sensor details lookup."
type PsmSensorConfigResult {
  errors: [QueryError!]
  "Sensor details when the lookup succeeded. Null when missing or when errors are present."
  sensor: PsmSensorConfigDetails
}

"Relay-style sensor connection."
type PsmSensorConnection {
  edges: [PsmSensorEdge!]
  "Populated instead of edges/nodes when the listing could not be served."
  errors: [QueryError!]
  nodes: [PsmSensorConfig]
  pageInfo: PageInfo!
}

"Sensor-coverage card: how many available sensors are actually enabled for the space."
type PsmSensorCoverage {
  available: Int!
  enabled: Int!
}

type PsmSensorEdge {
  cursor: String!
  node: PsmSensorConfig
}

"A single sensor that failed during bulk enablement."
type PsmSensorEnablementFailure {
  "Optional human-readable failure reason. Null in the current iteration."
  errorMessage: String
  "Provider sensor identifier that failed enablement."
  sensorId: String!
}

"An action button the client can render for this event (e.g. approve/deny/snooze)."
type PsmSensorEventAction {
  "Stable id for the action; echoed back on the follow-up ingest event."
  actionId: ID!
  "Human-readable button label; always present so the client can render the button."
  label: String!
}

"""
The materialised conversation state after applying a sensor event: what to render, the
backend-rendered message, the two orthogonal status dimensions, and echoed correlation ids.
"""
type PsmSensorEventConversation {
  "Action buttons available now (e.g. approve/deny/snooze). Empty list when no actions apply."
  actions: [PsmSensorEventAction!]!
  "Stable id of the conversation this event belongs to."
  conversationId: ID!
  "What the client should do with the conversation after this event (use NO_OP for nothing-to-render)."
  directive: PsmEventDirective!
  "Backend-rendered message for this event."
  message: PsmSensorEventMessage
  "Pass-through correlation ids echoed from the envelope."
  providerInfo: PsmSensorEventProviderInfo
  "Read state of the conversation after applying this event."
  readState: PsmConversationReadState
  "Remediation state of the fix after applying this event."
  remediationState: PsmRemediationState
}

"Backend-rendered message content for the event, shared across message types."
type PsmSensorEventMessage {
  "Whether the message was produced by the employee or the system."
  actor: PsmEventActor
  "Full body shown in the chat window."
  detail: String!
  "When this message was last active (UTC)."
  lastActivityTime: DateTime
  "How the message body should be rendered. Governs client rendering, so always present."
  messageType: PsmMessageType!
  "Optional structured metadata for the message (e.g. a deep link to a raised ticket)."
  metadata: PsmMessageMetadata
  "Sources the message content was generated from, when any (surfaced for attribution, e.g. KB articles on KB-assisted guidance)."
  sources: [PsmSource!]
  "Short summary (OS toast footer / sidebar preview)."
  summary: String!
  "Message title."
  title: String!
}

"Pass-through correlation ids from the provider's sensor event envelope, echoed back for client reconciliation."
type PsmSensorEventProviderInfo {
  "Occurrence id — one of batch_id or consent_id."
  eventId: ID!
  "Transport-level idempotency/dedupe key."
  notificationId: ID!
  "The automation associated with the sensor."
  remediationId: ID!
  "Which sensor definition fired."
  sensorId: ID!
  "Per-notification sequence used with notificationId for dedupe."
  sequence: Int!
}

"""
The state of a sensor's trigger on a device: when the fault was detected, how it is remediated, and
the outcome of the latest remediation attempt.
"""
type PsmSensorTriggerState {
  "Raw lifecycle status of the backing fault (same vocabulary psm_faultStatuses polls), alongside remediationStatus."
  faultStatus: PsmFaultStatus
  "When the fault for this device/sensor pair was most recently detected (UTC) — the \"Created\" column."
  lastDetectedAt: DateTime
  "When the most recent remediation attempt happened (UTC), or null if never remediated."
  lastRemediatedAt: DateTime
  "Identity of the actor that last remediated this device for this sensor, or null if never remediated."
  lastRemediatedBy: PsmRemediatedBy
  "Error message from the most recent remediation attempt, or null when there was none or it succeeded."
  lastRemediationError: String
  "Coarse remediation grouping (manual / user-prompted / automatic) shown on the row, with display label."
  remediationCategory: PsmRemediationCategoryInfo
  "How this issue is remediated."
  remediationMode: PsmRemediationMode
  "Lifecycle status of the remediation for this issue."
  remediationStatus: PsmRemediationStatus
  "Sensor remediation classification from sensor config (e.g. REQUIRES_APPROVAL, KB_ASSISTED)."
  remediationType: PsmSensorRemediationType
}

"""
A device that a sensor has triggered a fault on. Stitches together the device's identity and the
trigger state of that fault; both are tied together by faultId.
"""
type PsmSensorTriggeredDevice {
  "Identity of the device this fault is on."
  device: PsmDeviceIdentity
  "Unique id for the fault (derived from sensor id + device serial + detection timestamp); ties the device identity and trigger state together."
  faultId: ID!
  "State of the sensor's trigger on this device."
  triggerState: PsmSensorTriggerState
}

"One bar of the active-issues-by-severity breakdown."
type PsmSeverityCount {
  count: Int!
  severity: PsmSeverity!
}

"Count-only ROI card: remediations that resolved silently (AUTO, no ticket) in the window."
type PsmSilentSaves {
  count: Int!
  "Echoes the requested window so the card can label itself without re-reading the query variables."
  timeWindow: PsmTimeWindow!
  "Change vs the previous comparable window; null when a trend cannot be computed yet."
  trendPct: Float
}

"A source the message content was generated from (surfaced for attribution, e.g. a KB article on KB-assisted guidance)."
type PsmSource {
  "Title of the source, as captured when the message was generated. Null when unavailable."
  title: String
  "Absolute deep link to the source."
  url: String!
}

"Tenant information"
type PsmTenant {
  "Timestamp of tenant creation"
  createdAt: DateTime
  "Error details if in a failed state"
  errorMessage: String
  "JSM space ARI"
  spaceId: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  "Current onboarding status"
  status: PsmOnboardTenantStatus!
}

"A row of the top-issues list: the most impactful open issue types by affected device count."
type PsmTopIssue {
  affectedDeviceCount: Int!
  name: String!
  severity: PsmSeverity!
}

