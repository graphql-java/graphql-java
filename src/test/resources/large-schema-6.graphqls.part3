  """
    Returns the upgrade and rollback availability for the workbench (OOTB Overview) dashboard view.
  
  AVS calls JSM Reporting twice (in parallel):
      1. `GET /api/v1/templates/{templateName}/latest-version` (forward-looking — endpoint may not
         yet exist server-side) to compute `upgrade`.
      2. `GET /api/v1/views/{viewId}/versions/published` to compute `rollback`.
  
  On per-call failure the corresponding section is returned as `null` (logged server-side).
    Returns `null` when the `assets_vertical_enable_template_update` feature gate is disabled.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:itam-config:jira-service-management__
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AssetsVerticalWorkbenchDashboard")' query directive to the 'assetsVertical_workbenchDashboardTemplateStatus' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  assetsVertical_workbenchDashboardTemplateStatus(
    "The AVP template version currently applied to the view (used to determine `upgrade.available`)."
    avpTemplateVersion: Int!,
    "The Atlassian cloudId; used to initialise tenant context."
    cloudId: ID! @CloudID(owner : "assets-vertical"),
    """
      The vertical instantiation that owns the dashboard. Used to resolve the vertical-specific
      reporting container when the dashboard-definition registry is enabled.
    
    Nullable for backwards compatibility during rollout. Clients should supply it for
      vertical-aware dashboard status; it will become required after the migration completes.
    """
    verticalInstantiationId: ID,
    "The JSM Reporting view id whose template-update status is being queried."
    viewId: ID!
  ): AssetsVerticalWorkbenchDashboardTemplateStatus @lifecycle(allowThirdParties : false, name : "AssetsVerticalWorkbenchDashboard", stage : EXPERIMENTAL) @scopes(product : JIRA_SERVICEDESK, required : [READ_ITAM_CONFIG_JSM])
