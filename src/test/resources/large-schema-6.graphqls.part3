  ): AssetsVerticalCheckPermissionsResult @lifecycle(allowThirdParties : false, name : "AssetsVerticalCheckPermissions", stage : EXPERIMENTAL) @scopes(product : JIRA_SERVICEDESK, required : [READ_ITAM_CONFIG_JSM])
