  """
    Returns a unified paginated list of OOTB and custom insights for the tenant,
    ranked per the calling user:
      1. Pinned insights (OOTB or custom) in pin_order
      2. Unpinned OOTB insights in recommendation/ranking-score order
      3. Unpinned custom insights by category then last_run_at descending
  
  Disabled custom insights are included (flagged isEnabled=false). Archived are excluded.
    Use `first` and `after` for cursor-based pagination (default page size: 20).
  
  ### The field is not available for OAuth authenticated requests
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AssetsVerticalAllInsights")' query directive to the 'assetsVertical_allInsights' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  assetsVertical_allInsights(after: String, cloudId: ID! @CloudID(owner : "assets-vertical"), first: Int = 20): AssetsVerticalAllInsightsResult @lifecycle(allowThirdParties : false, name : "AssetsVerticalAllInsights", stage : EXPERIMENTAL) @oauthUnavailable @scopedApiTokenUnavailable
