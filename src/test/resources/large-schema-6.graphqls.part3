type SearchResultJiraComment {
  """
  Deprecated: comment authors are first-party Atlassian users. The thirdPartyUsers resolver only accepts
  third-party-user ARIs, so this field does not resolve for a Jira comment author. Use authorUser instead.
  
  
  This field is **deprecated** and will be removed in the future
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
