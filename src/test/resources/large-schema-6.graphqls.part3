"Time-to-comms metrics from IMA. Timestamps that IMA reports as not happened are null."
type StakeholderCommsImaCommsTiming {
  "When the first external comm was sent (ISO-8601 UTC)."
  initialExternalCommsSentAt: String
  "When the first internal comm was sent (ISO-8601 UTC)."
  initialInternalCommsSentAt: String
  "Seconds from HOT creation to the first external comm."
  timeToInitialExternalCommsSeconds: Float
  "Seconds from HOT creation to the first internal comm."
  timeToInitialInternalCommsSeconds: Float
}

"External communication from IMA (provisional shape)."
type StakeholderCommsImaExternalComm {
  "Body of the communication."
  content: String
  "When the communication was published (ISO-8601 UTC)."
  createdAt: String
  "Status text supplied by IMA."
  status: String
  "Links to associated Statuspage posts (https only)."
  statuspageLinks: [String!]
  "Title or headline."
  title: String
}

"HOT issue fields from IMA."
type StakeholderCommsImaIncident {
  "Affected products."
  affectedProducts: [String!]
  "Display name of the HOT issue assignee."
  assigneeName: String
  "When the HOT issue was created (ISO-8601 UTC)."
  createdAt: String
  "Whether impact is External (customers) or Internal."
  customerImpact: String
  "Service identified as the cause."
  faultyService: String
  "HOT Jira issue key (e.g. \"HOT-12345\")."
  hotIssueKey: String
  "Highest severity reached."
  peakSeverity: String
  "When the HOT issue was resolved (ISO-8601 UTC); null while open."
  resolvedAt: String
  "Current severity (e.g. \"2 - Major\")."
  severity: String
  "Current incident status as supplied by IMA (e.g. \"fixing\")."
  status: String
  "Incident title."
  summary: String
  "Number of customer support tickets raised."
  supportTicketCount: Int
  "When the HOT issue was last updated (ISO-8601 UTC)."
  updatedAt: String
}

"Internal stakeholder communication from IMA."
type StakeholderCommsImaInternalComm {
  "FINAL when flagged final, INITIAL for the earliest communication, otherwise UPDATE."
  commType: StakeholderCommsImaCommType
  "When the communication was sent (ISO-8601 UTC)."
  createdAt: String
  "What the incident team is doing now."
  currentStatus: String
  "What customers are experiencing."
  customerImpact: String
  "Whether this is the closing communication."
  finalComms: Boolean
  "Who held the Incident Manager role when this was sent. This is NOT the sender: IMA does not record one."
  incidentManagerAtTime: StakeholderCommsImaPerson
  "Planned next actions; may contain line breaks."
  nextSteps: String
}

"Incident links. Only absolute https URLs are returned."
type StakeholderCommsImaLinks {
  "IMA incident page; null when not configured."
  imaIncidentLink: String
  "Incident details document."
  isdLink: String
  "Incident Slack channel."
  slackRoomLink: String
  "Incident bridge with the meeting passcode (pwd) parameter removed."
  zoomRoomLink: String
}

"A person from IMA role data. No email or avatar is exposed."
type StakeholderCommsImaPerson {
  "True when this person is also the HOT assignee; null when it cannot be determined."
  isAssignee: Boolean
  "Display name."
  name: String
  "Team name."
  team: String
}

"A team paged for the incident."
type StakeholderCommsImaTeamPaged {
  "When the team was paged (ISO-8601 UTC)."
  pageTime: String
  "How the team was paged as supplied by IMA (e.g. \"manual_page\")."
  pageType: String
  "Team name."
  responderName: String
}

