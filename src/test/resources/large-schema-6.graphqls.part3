}

"""
One bucket of the fleet health distribution. Band counts sum to reportingSystemCount,
so the chart can derive shares without losing the denominator.
"""
type PsmDeviceHealthTrendPoint {
  bands: [PsmDeviceHealthBandCount!]
  "Start of the bucket, in UTC."
  date: DateTime!
  "Devices in scope with no score for this bucket."
  notReportingSystemCount: Int!
  "Devices in scope that reported a score for this bucket."
  reportingSystemCount: Int!
}

"Identity of the device a sensor fault is on: which device, and whether it can be reached right now."
type PsmDeviceIdentity {
  "Hardware and software configuration of this device; null when not reported by the provider."
  configuration: PsmDeviceConfiguration
  "Human-readable device name (e.g. hostname or asset tag); null when not reported by the provider."
  deviceName: String
  "When true the device is offline and the row shows a \"Device offline\" warning instead of \"Remediate\"."
  isDeviceOffline: Boolean
  "When the user last saw the device, if known."
  lastSeen: DateTime
  "Enriched owner of this device; null when owner data has not been resolved."
  owner: PsmDeviceOwner
  "Normalized device serial number — the device identifier shown in the list (e.g. \"WIN-SYD-0142\")."
  serialNumber: String!
}

type PsmDeviceKeys {
  pairingId: String!
  publicKeyPins: [String!]!
}

"The owner of a device: the Atlassian user bound to the physical device."
