  "Request ID sent to POA during activation of entitlement"
  provisionRequestId: String
  success: Boolean!
  "Internal cs-apps task id created to track the installation. Useful for follow-up status queries."
  taskId: ID
}

"""
An active sensor: a sensor that currently has one or more open faults, together with all the devices
it is affecting. Backs one collapsible group on the Active Sensors screen.
"""
type PsmActiveSensor {
  "Number of devices currently affected by this sensor (the group badge count)."
  affectedDeviceCount: Int
  "All devices that currently have an open fault for this sensor, newest fault first."
  affectedDevices: [PsmSensorTriggeredDevice!]
  "Broad grouping for the sensor (free-form, vendor-neutral — e.g. \"storage\", \"network\")."
  category: String
  "Stable PSM-internal identifier for the sensor."
  id: ID!
  "Human-readable sensor name (e.g. \"CPU Thermal Throttling\")."
  name: String
  "Identifier for this sensor in the source monitoring provider (vendor-specific)."
  providerSensorId: ID!
}

"The Active Sensors read-model: all active sensors for a space and the devices they affect."
type PsmActiveSensors {
  "Populated instead of sensors when the active-sensors list could not be served (e.g. a provider or store failure)."
  errors: [QueryError!]
  "When psm-service assembled this list from the provider."
  generatedAt: DateTime
  "All sensors that currently have open faults, after applying the filter."
  sensors: [PsmActiveSensor!]
}

"The device an activity ran on — the 'Device' column. UI links on serialNumber, prefers displayName as label when present."
type PsmActivityDevice {
  "Human-readable device name; null when not reported by the provider."
  displayName: String
  "Normalized device serial number shown/linked in the row (e.g. \"WIN-MIA-0301\")."
  serialNumber: String!
}

"The owner of the device an activity ran on — the 'Device owner' column. Enriched so the column renders without a separate identity lookup."
type PsmActivityDeviceOwner {
  "Atlassian account id of the device owner."
  accountId: ID!
  "Display name of the owner; null when not resolved."
  name: String
}

"PSM agent details for an eligible user."
type PsmAgent {
  "Whether the agent is currently reporting data for this user's device."
  status: PsmAgentStatus!
}

"""
A relay-style page of the calling agent's activities, newest first, plus the two
summary cards shown above the table. Intentionally NO totalCount — exact counts are
expensive; use infinite scroll. The summary counts are agent-scoped and are NOT
affected by the query's timeWindow or dateRange.
"""
type PsmAgentActivitiesConnection {
  "'Open issues' card — the count of the agent's active sensors whose issue is still OPEN right now, regardless of the query window/filter."
  activeSensorsCount: Int
  "The page of activities, each alongside its pagination cursor."
  edges: [PsmAgentActivityEdge!]
  "Populated instead of edges/nodes when the listing could not be served (e.g. a provider or store failure)."
  errors: [QueryError!]
  "When psm-service assembled this page."
  generatedAt: DateTime!
  "AGG-encouraged collapsed node list for clients that don't need a per-row cursor."
  nodes: [PsmAgentActivity]
  pageInfo: PageInfo!
  "'Remediated successfully' card — the count of the agent's successful remediations over a recent fixed window (currently the last 30 days), regardless of the query window/filter."
  remediationSuccessCount: Int
}

"A single agent-activity row: one remediation the agent pushed, with its outcome, issue status, timing, and the device it ran on."
type PsmAgentActivity {
  "The device this activity ran on — the 'Device' column."
  device: PsmActivityDevice
  "Owner of the device — the 'Device owner' column."
  deviceOwner: PsmActivityDeviceOwner
  "How long the remediation took, in milliseconds — the 'Duration' column; null when it never ran or is still running."
  durationMilliseconds: Int
  "Identifier for this sensor in the source monitoring provider; null when unknown. For drill-through to psm_sensorDetails."
  providerSensorId: ID
  "Remediation outcome — the 'Event type' pill (SUCCESS / FAILED)."
  result: PsmRemediationResult
  "Human-readable sensor name — the 'Sensor' column (e.g. \"Defender Signatures Outdated\")."
  sensorName: String
  "Status of the underlying issue — the 'Sensor status' pill (OPEN / CLOSED)."
  status: PsmSensorStatus
  "When the remediation was triggered (UTC) — the 'Triggered at' column."
  triggeredAt: DateTime
}

type PsmAgentActivityEdge {
  cursor: String!
  node: PsmAgentActivity!
}

"The entity that triggered a remediation; null when AUTO. Enriched so the column renders without a separate identity lookup."
type PsmAuditActor {
  accountId: ID!
  avatarUrl: URL
  name: String
}

"The device a remediation ran on. UI prefers displayName, falls back to serialNumber."
type PsmAuditDevice {
  displayName: String
  serialNumber: String!
}

"""
Canonical AGG hybrid-Relay connection. Intentionally NO totalCount — exact
counts are expensive and discouraged; use infinite scroll / 'showing N of many'.
"""
type PsmAuditLogConnection {
  edges: [PsmAuditLogEdge!]
  "When psm-service fetched these entries from the provider."
  generatedAt: DateTime!
  "AGG-encouraged collapsed node list for clients that don't need a per-row cursor."
  nodes: [PsmAuditLogEntry]
  pageInfo: PageInfo!
}

type PsmAuditLogEdge {
  cursor: String!
  node: PsmAuditLogEntry!
}

"A single audit-log row."
type PsmAuditLogEntry {
  "The device this row ran on."
  device: PsmAuditDevice
  id: ID!
  """
  Remediation result. Null when the run never happened (e.g. not approved); superseded by `status`.
  
  
  This field is **deprecated** and will be removed in the future
  """
  result: PsmRemediationResult
  sensorName: String!
  "Outcome pill for this row (superset of `result`)."
  status: PsmAuditStatus
  timestamp: DateTime!
  triggerType: PsmRemediationTrigger!
  "The specific entity that triggered it; null when triggerType is AUTO."
  triggeredBy: PsmAuditActor
}

"Result of a psm_checkDevicePermittance poll."
type PsmCheckDevicePermittanceResult {
  "Populated instead of status when no decision was reached. Never a denial: retry a 503, but a 400 means the request itself is wrong."
  errors: [QueryError!]
  "What the client should do next. Null when errors are present."
  status: PsmDevicePermittanceStatus
}

"""
The full detail of a single conversation: its two orthogonal status dimensions, the action
buttons that apply given the latest event, and the ordered timeline of events (oldest first).
"""
type PsmConversationDetail {
  "Action buttons available now, derived from the latest event (e.g. approve/deny). Empty list (never null) when none apply."
  actions: [PsmSensorEventAction!]!
  "Stable id of the conversation."
  conversationId: ID!
  "Read state of the conversation (unread / read)."
  readState: PsmConversationReadState
  "Remediation state of the fix."
  remediationState: PsmRemediationState
  "The conversation's events, oldest first. Always has at least one event (never null)."
  timeline: [PsmConversationEvent!]!
}

"""
Result wrapper for psm_getConversationById: the conversation on success, or errors on failure.
`conversation` is null whenever `errors` is non-empty (e.g. NOT_FOUND for an unknown conversationId).
"""
type PsmConversationDetailResult {
  "The resolved conversation; null when errors is non-empty."
  conversation: PsmConversationDetail
  "Errors encountered resolving the conversation (e.g. NOT_FOUND for an unknown conversationId)."
  errors: [QueryError!]
}

"""
One event in a conversation's timeline: a SysTrack lifecycle event and the message the
backend rendered for it.
"""
type PsmConversationEvent {
  "Whether the event was produced by the employee or the system."
