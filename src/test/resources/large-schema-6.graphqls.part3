type ShepherdCustomDetection implements Node @defaultHydration(batchSize : 50, field : "shepherdTeamworkGraph.customDetections", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_GUARD_DETECT_DETECTION]) {
