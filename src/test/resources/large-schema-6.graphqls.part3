type QueryError {
  "Contains extra data describing the error."
  extensions: [QueryErrorExtension!]
  "The ID of the requested object, or null when the ID is not available."
  identifier: ID
  "A message describing the error."
  message: String
}

"Entry point for query suggestion"
type QuerySuggestionAPI {
  suggest(
    "Contains metadata on any analytics related fields. These fields do not affect the search results."
    analytics: QuerySuggestionAnalyticsInput,
    "String describing the context from which the search is being initiated, e.g., 'confluence.fullPageSearch'."
    experience: String,
    """
    This object determines the tenants/locations where the search should be performed.
    It also determines the kind of results which must be returned.
    """
    filters: QuerySuggestionFilterInput!,
    "The maximum number of items to return in the search results."
    limit: Int,
    "Query to suggest"
    query: String
  ): QuerySuggestionItemConnection
}

type QuerySuggestionItemConnection {
  "The list of suggested queries and its type."
  nodes: [QuerySuggestionResultNode]
  "The total number of suggested queries."
  totalCount: Int
}

type QuerySuggestionResultNode {
  "The title of the suggested queris."
  title: String
  "The type of the suggested queris."
  type: String
}

type QuickReload @apiGroup(name : CONFLUENCE_LEGACY) {
  comments: [QuickReloadComment!]!
  "The page's current version, including versions published by the requesting user"
  currentVersion: ConfluenceQuickReloadVersion
  editorPersonForPage: ConfluencePerson
  time: Long!
}

type QuickReloadComment @apiGroup(name : CONFLUENCE_LEGACY) {
  asyncRenderSafe: Boolean!
  comment: Comment!
  primaryActions: [CommentUserAction]!
  secondaryActions: [CommentUserAction]!
}

type RadarAiConnector {
  "Provider-specific config for this connector, such as workspace ID, pricing per credit, and seat configuration."
  config: RadarAiConnectorConfig
  createdAt: DateTime!
  id: ID!
  isEnabled: Boolean!
  "Will be null if there have been no successful syncs."
  lastSuccessfulSync: RadarSyncHistory
  "Will be null if there have been no syncs."
  lastSync: RadarSyncHistory
  name: String!
  provider: RadarAiConnectorProvider!
  type: RadarAiConnectorType!
  updatedAt: DateTime!
}

type RadarAiConnectorConfig {
  pricePerCredit: RadarMoney
  seats: RadarAiConnectorSeatConfig
  workspaceId: String
}

type RadarAiConnectorSeatConfig {
  pricePerSeat: RadarMoney!
  seatCount: Int!
}

type RadarAiConnectorsConnection implements RadarConnection {
  edges: [RadarAiConnectorsEdge!]!
  nodes: [RadarAiConnector!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type RadarAiConnectorsEdge implements RadarEdge {
  cursor: String!
  node: RadarAiConnector!
}

"A generated summary whose layout is selected by the generator"
type RadarAiGeneratedSummary {
  "Presentation-shaped summary content"
  content: RadarAiSummaryContent!
  "Time at which the summary generation completed"
  generatedAt: DateTime!
  "The fully rendered user prompt sent to the model, including selected filters and tables"
  userPrompt: String!
}

"Per-generation metadata attached to every AI response"
type RadarAiGenerationMetadata {
  "True when the response was served from cache"
  cached: Boolean!
  "ISO-8601 UTC timestamp when the underlying generation happened"
  generatedAt: DateTime!
  "Correlation id for logs + feedback (matches the runner's request id)"
  generationId: ID!
  "Model that produced the response, e.g. \"gpt-4o\""
  model: String!
  "Use-case identifier, e.g. `talent-org-metrics-overview`"
  useCaseId: String!
}

type RadarAiModelFieldValue {
  "The formatted display name of the AI model (e.g. 'GPT-4o', 'Claude Opus 4.6')"
  displayValue: String
  "Denotes if the value was hidden, this may be due to RLS or CLS"
  isRestricted: Boolean
  "The raw normalized model name used for RQL filtering (e.g. 'gpt-4o', 'claude-opus-4.6')"
  value: String
}

