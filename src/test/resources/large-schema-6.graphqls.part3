}

"""
Result of an eligible-users listing. Unpaginated: the full set for the space is
returned in one response.
"""
type PsmEligibleUsersListResult {
  "Populated instead of users when the listing could not be served."
  errors: [QueryError!]
  "Eligible users for the space. Empty when the space has no eligible users, or when errors are present."
  users: [PsmEligibleUser!]
}

"Estimated tickets prevented ROI metric for a JSM space over a reporting window."
type PsmEstimatedTicketsPrevented {
  "Estimated number of support tickets prevented by remediations in the window."
  count: Int!
}

"""
Remediation history for one fault (one device + sensor). The sensor grouping is included
so the same timeline row component can render both this query and the device query.
"""
type PsmFaultRemediationHistory {
  "Populated instead of sensor when the history could not be served."
  errors: [QueryError!]
  "The requested fault id, echoed so the client does not have to keep it from variables."
  faultId: ID!
  "When psm-service assembled this history."
  generatedAt: DateTime
  "The sensor this fault belongs to, with its Failed/Success events. Null when the fault is unknown."
  sensor: PsmRemediationSensor
}

"One requested fault and its current remediation status."
type PsmFaultStatusEntry {
  faultId: String!
  status: PsmFaultStatus!
}

"Per-fault remediation statuses for the requested IDs."
type PsmFaultStatusResult {
  faults: [PsmFaultStatusEntry!]!
}

"One filter dimension (tab) within a screen's filter panel, and the options available for it."
type PsmFilter {
  key: PsmFilterKey!
  "Display label for this filter's tab, e.g. \"Remediation category\"."
  label: String!
  "Selectable values for this filter, in display order."
  options: [PsmFilterOption!]!
  "Whether the FE should render a search box above the option list (false for DEVICE_LIST's simple dropdown filter)."
  searchable: Boolean!
}

"""
One selectable value within a filter. `value` is what the FE echoes back into the
corresponding list query's filter input; `label` is what's rendered in the checkbox.
For REMEDIATION_CATEGORY and STATUS, `value` is the name of the relevant filter enum
(e.g. "AUTOMATIC", "NOT_REPORTING" on DEVICE_LIST; "OPEN"/"CLOSED" for PsmSensorStatus on ACTIVITIES);
for SENSOR_CATEGORY and SENSOR it's a dynamic, tenant-specific string.
"""
type PsmFilterOption {
  label: String!
  value: String!
}

