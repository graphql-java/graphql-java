"A sensor that has been triggered across devices in the fleet, with its severity and affected device count."
type PsmTriggeredSensor {
  "Distinct devices this sensor fired on at least once in the window."
  affectedDeviceCount: Int
  "Identifier for this sensor in the source monitoring provider (vendor-specific). Pass to psm_sensorDetails as sensorId for drill-through."
  providerSensorId: ID!
  "Human-readable sensor name (e.g. \"Disk space below 10%\")."
  sensorName: String
  "Severity of the sensor issue."
  severity: PsmSensorSeverity
}

"Most frequently triggered sensors across the fleet — includes open and closed sensor issues."
type PsmTriggeredSensorsList {
  "Populated instead of sensors when the triggered-sensors list could not be served (e.g. a provider failure)."
  errors: [QueryError!]
  """
  Triggered sensors ordered by affected device count, highest first. At most `first` entries.
  Sensors the space has no configuration row for are omitted, so this can be shorter.
  """
  sensors: [PsmTriggeredSensor!]
}

