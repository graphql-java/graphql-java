"Main group of Guard Detect queries."
type ShepherdQuery @apiGroup(name : GUARD_DETECT) {
  "Group of queries related to alerts."
  alert: ShepherdAlertQueries
  "Group of queries related to classifications."
  classifications: ShepherdClassificationsQueries
  """
  Hydrates display metadata for content used by Guard Detect workflows.
  
  ### The field is not available for OAuth authenticated requests
  """
  contentInfo(
    "Content URLs or ARIs to hydrate. Maximum 50 inputs per request."
    contentUrlsOrAris: [String!]!,
    "The workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): [ShepherdContentInfoResult!] @apiGroup(name : GUARD_DETECT) @oauthUnavailable @rateLimited(disabled : false, rate : 500, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 5000, usePerIpPolicy : false, usePerUserPolicy : false)
  """
    `[Internal]` This query uses the user context to determine which workspaces the user has access to. It will then
    return the first enabled workspace in the list.
  
