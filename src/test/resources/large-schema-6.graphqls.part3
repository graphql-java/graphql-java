}

type SearchInterleaverScrapingResult {
  rerankerRequestInJSON: String!
}

type SearchItemConnection {
  "AbTest details. Strictly used by the Confluence Search Team to run and identify experiments."
  abTest: SearchAbTest
  "Filters auto applied by query intelligence based on the search query"
  autoAppliedFilters: SearchFilterOutput
  """
  Autocomplete suggestions based on the search query prefix.
  Returns a list of suggested completions for the current query.
  """
  autocompleteSuggestions: [String!]
  "The search results that are deferred (if any). The deferred edges enable a faster render of the initial page"
  deferredEdges: [SearchResultItemEdge!]
  "The search result items as per pagination specs"
  edges(excludeFederated: Boolean = false): [SearchResultItemEdge!]!
  "List of errors which occurred for any search requests."
  errors: [SearchError!]
  "The search result items from federated sources (nullable, populated only when requested)"
  federatedEdges: [SearchResultItemEdge!]
  """
  When true, indicates that query intelligence applied filters and the search results came from the structured query.
  False when no filters were applied, or when filters were applied but fallback was used (structured query returned empty).
  """
  hasAutoAppliedFilters: Boolean
  "Full reranker request in JSON. Returned for scraping and search-tool experiences"
  interleaverScrapingResult: SearchInterleaverScrapingResult
  """
  When true, indicates the result was returned from a cache (Redis pubsub subscription or direct cache hit).
  When false, indicates a synchronous fallback was used to retrieve the result.
  Null when the search was just initiated (initial async result with no cached data yet).
  """
  isCachedResult: Boolean
  "The page info as per pagination specs"
  pageInfo: PageInfo!
  "Query info for the search"
  queryInfo: SearchQueryInfo
  """
  Scraping metadata containing product-specific scraping responses, query intelligence results,
  and searcher errors. Only populated when enableRelevanceDebugging is true.
  """
  scrapingMetadata: SearchScrapingMetadata
  "The search session ID provided in the request, echoed back for tracking purposes."
  searchSessionId: String
  totalCount: Int
  """
  totalCounts of search results for every product.
  
  Note - the entities are all rolled up to one product.
  For example - Jira-project, issue, board etc are all rolled up to Jira.
  """
  totalCounts: [SearchProductCount!]!
  "The trace ID for this request, echoed back for tracking and debugging purposes."
  traceId: String
}

