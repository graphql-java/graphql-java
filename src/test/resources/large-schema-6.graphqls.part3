"Group of mutations related to workspaces."
type ShepherdWorkspaceMutations @apiGroup(name : GUARD_DETECT) {
  """
  Creates a new custom detection.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __write:detection:guard-detect__
  """
  createCustomDetection(
    input: ShepherdWorkspaceCreateCustomDetectionInput!,
    "The workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdCustomDetectionMutationPayload @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [WRITE_GUARD_DETECT_DETECTION])
  """
  Deletes an existing custom detection. This operation cannot be undone.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __write:detection:guard-detect__
  """
  deleteCustomDetection(
    "The custom detection ARI."
    customDetectionId: ID!,
    "The workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdCustomDetectionMutationPayload @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [WRITE_GUARD_DETECT_DETECTION])
  "Group of queries related to detection settings."
  detectionSetting: ShepherdDetectionSettingMutations
  """
  `[Internal]` Finalizes the workspace onboard flow.
  
  ### The field is not available for OAuth authenticated requests
  """
  onboard(
    "The workspace ARI."
    id: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdWorkspaceMutationPayload @oauthUnavailable @rateLimited(disabled : false, rate : 5, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 100, usePerIpPolicy : false, usePerUserPolicy : false)
  """
  Sets whether a workspace has consented to semantic detections.
  
  ### The field is not available for OAuth authenticated requests
  """
  setSemanticDetectionsEnabled(
    "Whether semantic detections are enabled for the workspace."
    enabled: Boolean!,
    "The workspace ARI."
    id: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdWorkspaceMutationPayload @oauthUnavailable @rateLimited(disabled : false, rate : 5, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 100, usePerIpPolicy : false, usePerUserPolicy : false)
  """
  `[Internal]` Updates a Guard Detect workspace metadata.
  
  ### The field is not available for OAuth authenticated requests
  """
  update(
    "The workspace ARI."
    id: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false),
    input: ShepherdWorkspaceUpdateInput!
  ): ShepherdWorkspaceMutationPayload @oauthUnavailable @rateLimited(disabled : false, rate : 5, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 100, usePerIpPolicy : false, usePerUserPolicy : false)
  """
  Updates an existing custom detection.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __write:detection:guard-detect__
  """
  updateCustomDetection(
    input: ShepherdWorkspaceUpdateCustomDetectionInput!,
    "The workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdCustomDetectionMutationPayload @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [WRITE_GUARD_DETECT_DETECTION])
  """
  `[Internal]` Replaces the datasets an EDM detector is anchored to. Called by the
  scanning platform once a dataset has been hashed and uploaded.
  
  ### The field is not available for OAuth authenticated requests
  """
  updateCustomDetectionEdmDatasets(
    input: ShepherdWorkspaceUpdateEdmDatasetsInput!,
    "The workspace ARI."
    workspaceId: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdCustomDetectionMutationPayload @oauthUnavailable @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false)
  """
  Updates a detection setting.
  
  
  This field is **deprecated** and will be removed in the future
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __write:detection-setting:guard-detect__
  """
  updateDetectionSetting(
    "The workspace ARI."
    id: ID! @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false),
    input: ShepherdWorkspaceSettingUpdateInput!
  ): ShepherdWorkspaceMutationPayload @rateLimited(disabled : false, rate : 50, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @scopes(product : NO_GRANT_CHECKS, required : [WRITE_GUARD_DETECT_DETECTION_SETTING])
}

