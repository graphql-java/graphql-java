"""
A worker-to-skill assignment, uniquely identified by (workerId, skillId).
Carries verification metadata about the assignment. The referenced skill and
worker are hydrated lazily via AGG so a single query can render skill details
without an extra `radar_skillsByAris` call.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:radar:twg-cli__
"""
type RadarWorkerSkill implements Node @defaultHydration(batchSize : 200, field : "radar_workerSkillsByAris", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_RADAR_TWG_CLI]) {
  "Whether this skill was inferred by AI or manually assigned."
  classificationType: RadarSkillClassificationType
  "The Atlassian Resource Identifier of this Radar worker-skill assignment"
  id: ID! @ARI(interpreted : false, owner : "radar", type : "worker-skill", usesActivationId : false)
  "The AI generated reason for the skill assignment"
  reasoning: String
  """
  The taxonomy skill assigned to the worker. Hydrated by AGG from `skillId`
  so field resolution goes through the shared `radar_skillsByAris` batcher.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "RadarSkills")' query directive to the 'skill' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  skill: RadarSkill @hydrated(arguments : [{name : "ids", value : "$source.skillId"}], batchSize : 100, field : "radar_skillsByAris", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "radar", timeout : 3000) @lifecycle(allowThirdParties : true, name : "RadarSkills", stage : EXPERIMENTAL)
  "ARI of the taxonomy skill assigned to the worker"
  skillId: ID! @ARI(interpreted : false, owner : "radar", type : "skill", usesActivationId : false)
  """
  The work items the classifier cited when it assigned this skill.
  
  
  This field is **deprecated** and will be removed in the future
  """
  sources: [RadarSkillSource!]
  """
  The work items the classifier cited for this assignment, ordered by descending
  evidence weight. Defaults to 10 sources and permits at most 25 per page.
  """
  sourcesConnection(after: String, first: Int = 10): RadarSkillSourceConnection
  "Verification state of the worker-skill mapping"
  verificationStatus: RadarSkillVerificationStatus!
  "Timestamp when the mapping was verified. Null when unverified"
  verifiedAt: DateTime
  "The AAID of the user who verified or manually assigned this skill."
  verifiedByAaid: ID
  "The Atlassian account that verified or manually assigned this skill."
  verifiedByUser: User @idHydrated(idField : "verifiedByAaid", identifiedBy : "accountId")
  "ARI of the worker this skill is assigned to"
  workerId: ID! @ARI(interpreted : false, owner : "radar", type : "worker", usesActivationId : false)
}

" Data about this workspace. This will expose what fields each Entity has available as well as any other additional metadata"
type RadarWorkspace {
  "The activation ID for the workspace"
  entityId: ID!
  "Groups of fields this workspace supports"
  fields: RadarFields!
  """
  A list of fields the focus area entity supports
  
  
  This field is **deprecated** and will be removed in the future
  """
