"""
 ---------------------------------------------------------------------------------------------

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:radar:twg-cli__
"""
type RadarPosition implements Node & RadarEntity @defaultHydration(batchSize : 200, field : "radar_positionsByAris", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_RADAR_TWG_CLI]) {
  "The ISO 3166-1 alpha-2 country code for this position"
  countryCode: String
  "The discipline or skill family associated with this position (e.g. Engineering, Design, Product)"
  craft: String
  "An internal uuid for the entity, this is not an ARI"
  entityId: ID!
  "A list of fieldId, fieldValue pairs for this Position entity"
  fieldValues(
    " a collection of unique fieldIds indicating which fields to return"
    fieldIdIsIn: [ID!],
    """
    an RQL query to filter the requested field values without filtering the returned positions
    (e.g. aiMonthlyUsagePeriodStart = "2026-07-01")
    """
    fieldRql: String
  ): [RadarFieldValueIdPair!]!
  "The Atlassian Resource Identifier of this Radar position"
  id: ID! @ARI(interpreted : false, owner : "radar", type : "position", usesActivationId : false)
  "Get a position's manager, this can be null if the position does not have a manager"
  manager: RadarPosition @hydrated(arguments : [{name : "ids", value : "$source.managerId"}], batchSize : 100, field : "radar_positionsByAris", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "radar", timeout : 3000)
  "Get a position's manager's ARI, this can be null if the position does not have a manager. This will be hydrated via AGG."
  managerId: ID
  "The geographical region derived from the position's country code (e.g. APAC, EMEA, Americas)"
  region: String
  "Get a position's manager hierarchy starting from their direct manager to their top level manager"
  reportingLine: [RadarPosition!] @hydrated(arguments : [{name : "ids", value : "$source.reportingLineId"}], batchSize : 100, field : "radar_positionsByAris", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "radar", timeout : 3000)
  "Get a position's manager hierarchy starting from their direct manager to their top level manager"
  reportingLineId: [ID!]!
  "Get position's role"
  role: RadarPositionRole
  "The type of entity"
  type: RadarEntityType!
  "The URL to view this position's details page"
  url: String
  "When the position is filled, represents the worker currently filling the position"
  worker: RadarWorker @hydrated(arguments : [{name : "ids", value : "$source.workerId"}], batchSize : 100, field : "radar_workersByAris", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "radar", timeout : 3000)
  "When the position is filled, this will be the Worker's ARI. This will be hydrated by AGG"
  workerId: ID
}

