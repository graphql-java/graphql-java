  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "TeamworkGraphContextAPIs")' query directive to the 'teamworkGraph_userReportChainV2' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  teamworkGraph_userReportChainV2(
    "The ID of the user to retrieve the management chain for."
    userId: ID! @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  ): GraphStoreCypherQueryV2Connection @apiGroup(name : DEVOPS_ARI_GRAPH) @cypherQueryV2(query : "MATCH (user:IdentityUser {ari: $userId})<-[:external_worker_conflates_to_user]-(uw:ExternalWorker)\nMATCH (uw)<-[:external_position_is_filled_by_external_worker]-(up:ExternalPosition)\nMATCH p=(up)<-[:external_position_manages_external_position*1..10]-(mp:ExternalPosition)\nMATCH (mp)-[:external_position_is_filled_by_external_worker]->(mw:ExternalWorker)\nMATCH (mw)-[:external_worker_conflates_to_user]->(manager:IdentityUser)\nWITH manager, min(length(p)) AS depth\nWITH depth, collect(manager) AS mgrs\nWITH depth, mgrs[0] AS mgr\nORDER BY depth\nWITH collect(mgr) AS chain\nRETURN chain[0] AS level1Manager, chain[1] AS level2Manager, chain[2] AS level3Manager,\nchain[3] AS level4Manager, chain[4] AS level5Manager, chain[5] AS level6Manager,\nchain[6] AS level7Manager, chain[7] AS level8Manager, chain[8] AS level9Manager,\nchain[9] AS level10Manager") @lifecycle(allowThirdParties : false, name : "TeamworkGraphContextAPIs", stage : EXPERIMENTAL) @scopes(product : CONFLUENCE, required : [CONFLUENCE_ATLASSIAN_EXTERNAL])
