  authResolutionMode: String
  connectedAt: String
  connectionId: String
  connectorCreatedAt: String
  connectorSyncType: String
  datasourceId: String
  entityTypes: [String!]
  environmentType: String
  hasAuthUpgrade: Boolean
  integrationARI: String!
  isImpersonationAuthEnabled: Boolean
  isUserOAuthed: Boolean!
  lightIcon: String
  name: String!
  outboundAuthUrl: String!
  providerId: String
  workspaceName: String
  workspaceUrl: String
}

"Slack conversation metadata exposed to consumers"
type SearchThirdPartySlackChannel {
  id: String!
  isPrivate: Boolean!
  name: String!
  numMembers: Int
  purpose: String
  topic: String
}

"Slack conversations (channels) returned from the third-party datasource"
type SearchThirdPartySlackChannelOptions {
  channels: [SearchThirdPartySlackChannel!]!
  nextCursor: String
}

