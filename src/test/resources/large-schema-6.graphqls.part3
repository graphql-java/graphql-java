  agentAI_contextPanel(cloudId: ID! @CloudID, issueId: String): AgentAIContextPanelResult
  """
   Rate limits protect the shared AI-gateway connection pool from a single noisy user or
   tenant. agentAI_panel auto-loads on the issue view, so per-user allows normal navigation
   while capping runaway loops; the per-tenant (cloudId) cap bounds aggregate tenant load.
   rate = requests/minute. Per-user sized from prod (19-20 Oct 2026): agents triaging queues
   open 11-37 distinct issues/min, which 10/min was rejecting with 429; 20 covers the observed
   max. Per-tenant 400 has ~8x headroom over the busiest tenant (47/min).
  """
  agentAI_panel(cloudId: ID! @CloudID, issueId: String!): AgentAIPanelResult @rateLimited(disabled : false, rate : 20, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, properties : [{argumentPath : "cloudId"}], rate : 400, usePerIpPolicy : false, usePerUserPolicy : false)
  agentAI_summarizeIssue(cloudId: ID! @CloudID, issueId: String): AgentAIIssueSummaryResult
