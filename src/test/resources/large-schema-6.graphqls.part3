}

"Number of devices in one band for one bucket."
type PsmDeviceHealthBandCount {
  band: PsmDeviceHealthBand!
  systemCount: Int!
}

"One bucket of the space-wide health-status breakdown on PsmDeviceConnection."
type PsmDeviceHealthStatusCount {
  "Number of devices in the space currently in this health band."
  count: Int!
  "Health band this count is for."
  healthStatus: PsmDeviceHealthStatus!
}

"Fleet health series for the devices registered to a space."
type PsmDeviceHealthTrend {
