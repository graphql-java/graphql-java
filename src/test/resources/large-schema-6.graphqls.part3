"Configuration response for search which includes product entitlements and site metadata"
type SearchGraphQLConfigurationResponse {
  "List of products that the user has access to"
  firstPartyProducts: [SearchFirstPartyMetadata!]!
  "HMAC Key for intercom"
  intercomHmac: String
  "Metadata about the site"
  siteMetadata: SearchConfigurationSiteMetadata!
