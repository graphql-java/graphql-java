"IMA incident context for a HOT Jira issue, shaped for the JSM past-communications panel. All timestamps are ISO-8601 UTC strings (for example \"2026-04-15T14:07:22Z\"); every field is nullable. Contains no email addresses."
type StakeholderCommsIncidentContextResponse {
  "Time-to-comms metrics."
  commsTiming: StakeholderCommsImaCommsTiming
  "External communications, newest first. Provisional shape: not yet confirmed with a populated IMA sample."
  externalComms: [StakeholderCommsImaExternalComm!]
  "HOT issue header fields."
  incident: StakeholderCommsImaIncident
  "Current Incident Manager (the role entry with no end time)."
  incidentManager: StakeholderCommsImaPerson
  "Internal communications, newest first."
  internalComms: [StakeholderCommsImaInternalComm!]
  "Related links. Only absolute https URLs are returned."
  links: StakeholderCommsImaLinks
  "Teams paged for this incident."
  teamsPaged: [StakeholderCommsImaTeamPaged!]
}

