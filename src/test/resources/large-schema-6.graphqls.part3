  """
  Merged, reverse-chronological activity timeline for one service over a fixed time window.
  
  Items carry top-level fields only.
  Mirrors ICC's aiops_serviceActivityTimeline, plus CHANGE as a fifth activity type.
  
  Identify the service by EXACTLY ONE of serviceAri / serviceName. Supplying both, or neither,
  is a 400. Use serviceAri; serviceName is deprecated.
  """
  changeManagement_serviceActivityTimeline(
    "Forward pagination cursor. Omit on the first call."
    after: String,
    cloudId: ID! @CloudID(owner : "jira"),
    "Restrict results to these types. Omit or leave empty to return all types."
    entityTypes: [ChangeManagementActivityEntityType!],
    "Items per page. Default 10, clamped to 1-50."
    first: Int,
    "Minimum Opsgenie priority for the alert source. Defaults to P2."
    minimumAlertPriority: String,
    """
    ARI of the service to fetch activity for, e.g.
    ari:cloud:graph::service/<workspaceId>/<serviceId>.
    
    Use this rather than serviceName. Service identity is mid-migration from the DevOps service
    registry (SVC) to Assets-backed service objects (OSC), and name lookup is the half that the
    migration rewrites — post-OSC a service's display name lives in a customer-renamable
    attribute. The ARI is stable across the migration; it is what OSC preserves as
    `a_service_id`.
    """
    serviceAri: ID,
    """
    Name of the service to fetch activity for, resolved via `devOpsServices` with a byte-exact,
    case-sensitive match.
    
    Deprecated and slated for removal. The match fails silently: a miss returns an empty timeline
    indistinguishable from a service with no activity, and it has been observed failing on a
    tenant whose underlying data was present. Nothing consumes it.
    """
    serviceName: String,
    "End of the time window. Fixed across all pages."
    windowEnd: DateTime!,
    "Start of the time window. Fixed across all pages."
    windowStart: DateTime!
  ): ChangeManagementServiceActivityTimelineConnection
