    "Forward pagination cursor. Omit on first call."
    after: String,
    cloudId: ID! @CloudID(collabContextProduct : JIRA_SERVICE_DESK, owner : "jira"),
    "Restrict results to these activity types. Omit or leave empty to return all types."
    entityTypes: [AIOpsActivityEntityType!],
    "Number of items to return per page. Default: 10."
    first: Int,
    "Name of the service to fetch activity for. The resolver resolves service details using the existing activity timeline flow."
    serviceName: String!,
    "End of the time window. Typically now. Fixed across all pages."
    windowEnd: DateTime!,
    "Start of the time window. Typically now minus 72 hours. Fixed across all pages."
    windowStart: DateTime!
  ): AIOpsServiceActivityTimelineConnection @scopes(product : JIRA_SERVICEDESK, required : [READ_SERVICEDESK_REQUEST, READ_REQUEST])
