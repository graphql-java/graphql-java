  """
  Request an abort of the in-flight Prevention Center overview-summary run for an entity.
  
  Best-effort: the run is NOT interrupted, but its result is discarded and never persisted.
  
  Returns the state to render:
    * ABORT_REQUESTED — a run was in flight and has been flagged for discard.
    * AVAILABLE + summary — nothing to abort; the run completed before this call landed.
    * null — nothing in flight and nothing stored.
  """
  changeManagement_cancelJsmPreventionCenterOverviewSummary(cloudId: ID! @CloudID(owner : "jira"), entityKey: String!): ChangeManagementJSMPreventionCenterOverviewSummaryResponse
  """
  Request an abort of the in-flight risk-assessment run. Same semantics as
  changeManagement_cancelJsmPreventionCenterOverviewSummary.
  """
  changeManagement_cancelJsmPreventionCenterRiskAssessment(cloudId: ID! @CloudID(owner : "jira"), entityKey: String!): ChangeManagementJSMPreventionCenterRiskAssessmentResponse
  """
  Delete the stored Prevention Center overview summary for an entity.
  
  Deletes only — this does NOT start generation. Generation is triggered exclusively by opening
  changeManagement_jsmPreventionCenterOverviewSummaryUpdated.
  """
  changeManagement_deleteJsmPreventionCenterOverviewSummary(cloudId: ID! @CloudID(owner : "jira"), entityKey: String!): ChangeManagementJSMPreventionCenterOverviewSummaryResponse
  """
  Delete the stored Prevention Center risk assessment for an entity (the tab's "Clear assessment").
  Deletes only — this does NOT start generation. Returns status IN_PROGRESS.
  """
  changeManagement_deleteJsmPreventionCenterRiskAssessment(cloudId: ID! @CloudID(owner : "jira"), entityKey: String!): ChangeManagementJSMPreventionCenterRiskAssessmentResponse
  "Mutation for deleting the last risk assessment for the issue"
  changeManagement_deleteLastRovoRiskAssessment(cloudId: ID! @CloudID(owner : "jira"), issueId: String!): Boolean!
  "Mutation for updating the last risk assessment for the issue"
  changeManagement_recordLastRovoRiskAssessment(input: ChangeManagementUpdateLastRovoRiskAssessmentInput!, keepUpdatedAt: Boolean = false): Boolean!
  """
  Request regeneration of the Prevention Center overview summary for an entity.
  
  PRESERVES the currently stored summary, so if the user aborts or the run fails they keep what they
  already had. Use changeManagement_deleteJsmPreventionCenterOverviewSummary to discard it instead.
  
  Does NOT itself start generation: the client must (re)open
  changeManagement_jsmPreventionCenterOverviewSummaryUpdated, which promotes the pending
  regeneration and triggers the run. Returns status IN_PROGRESS.
  """
  changeManagement_regenerateJsmPreventionCenterOverviewSummary(cloudId: ID! @CloudID(owner : "jira"), entityKey: String!): ChangeManagementJSMPreventionCenterOverviewSummaryResponse
  """
  Request regeneration of the Prevention Center risk assessment for an entity.
  
  PRESERVES the currently stored assessment, so if the user aborts or the run fails they keep what
  they already had. Does NOT itself start generation: the client must (re)open
  changeManagement_jsmPreventionCenterRiskAssessmentUpdated, which starts the run. Returns status
  IN_PROGRESS.
  """
  changeManagement_regenerateJsmPreventionCenterRiskAssessment(cloudId: ID! @CloudID(owner : "jira"), entityKey: String!): ChangeManagementJSMPreventionCenterRiskAssessmentResponse
  "Mutation for updating global risk assessment settings in Change Management"
  changeManagement_updateGlobalRiskAssessmentSettings(input: ChangeManagementUpdateGlobalRiskAssessmentSettingsInput!): Boolean!
  """
  Keep only the given stored steps, in the given order (accept / reject send the remaining steps;
  [] after accept-all / reject-all). Each must name an open stored step by summary, once, else the
  request is rejected; steps keep their stored details. The rest of the stored assessment is
  untouched. Returns the updated assessment, or null when no assessment is stored.
  """
  changeManagement_updateJsmPreventionCenterMitigationSteps(input: ChangeManagementJSMPreventionCenterUpdateMitigationStepsInput!): ChangeManagementJSMPreventionCenterRiskAssessmentResponse
