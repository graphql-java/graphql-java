type ShepherdContentInfo @apiGroup(name : GUARD_DETECT) {
  "Canonical content ARI, when resolved."
  ari: ID
  "ATI for the resolved content."
  ati: String
  """
  The account ID of the user who created the content.
  For Confluence this is the page or blogpost author, which is always reported.
  Not yet populated for Jira.
  """
  creatorAccountId: String
  "Information about the user who created the content."
  creatorUser: User @hydrated(arguments : [{name : "accountIds", value : "$source.creatorAccountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  """
  Display name for the content.
  For Jira this is the issue summary. For Confluence this is the page or blogpost title.
  """
  name: String
  """
  The account ID of the user who owns the content.
  For Confluence this is the page or blogpost owner, which is reported only when one is set
  explicitly, so this is null for content that has no distinct owner. Prefer this over
  `creatorAccountId` where both are present, and label the two differently rather than
  presenting a creator as an owner. Not yet populated for Jira.
  """
  ownerAccountId: String
  "Information about the user who owns the content."
  ownerUser: User @hydrated(arguments : [{name : "accountIds", value : "$source.ownerAccountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "Project or space information for the content."
  space: ShepherdContentSpaceInfo
  "URL to open the content in product."
  url: URL
}

