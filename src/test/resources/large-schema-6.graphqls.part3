"""
The conversation state returned after raising a ticket, mirroring the sensor-ingest conversation shape
so the client can patch the sidebar in place. References the shared PSM sensor-event types defined in the
psm-sensor-ingest contract.
"""
type PsmRaiseTicketConversation {
  "Action buttons available now. Empty list when no actions apply."
  actions: [PsmSensorEventAction!]!
  "Stable id of the conversation the ticket was raised for."
  conversationId: ID!
  "What the client should do with the conversation after the ticket was raised."
  directive: PsmEventDirective!
  "Backend-rendered messages for the conversation timeline."
  messages: [PsmSensorEventMessage!]!
  "Read state of the conversation after raising the ticket."
  readState: PsmConversationReadState
  "Remediation state of the fix after raising the ticket."
  remediationState: PsmRemediationState
}

"""
Result of psm_raiseTicket: the conversation state on success, or errors on failure. `conversation` is
null whenever `errors` is non-empty (e.g. NOT_FOUND for an unknown conversationId).
"""
type PsmRaiseTicketPayload implements Payload {
  """
  The conversation state after raising the ticket; null when errors is non-empty.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  conversation: PsmRaiseTicketConversation
  """
  Errors encountered raising the ticket (e.g. NOT_FOUND for an unknown conversationId).
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  True when the ticket was raised (or already existed); false when errors is non-empty.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

"""
The conversation as it stands after a user action was recorded.

A user action carries no provider envelope, so unlike psm_ingestSensorEvent's conversation this has no
providerInfo. `messages` reuses PsmSensorEventMessage: the backend renders the messages the client
should append to the chat - for RESOLVED, a system acknowledgement followed by the employee's line.
"""
type PsmRecordUserActionConversation {
  "Action buttons available now. Empty once the conversation is resolved."
  actions: [PsmSensorEventAction!]!
  "Stable id of the conversation the action was recorded against."
  conversationId: ID!
  "What the client should do with the conversation after this action."
  directive: PsmEventDirective!
  "Backend-rendered messages to append to the chat, in display order."
  messages: [PsmSensorEventMessage!]!
  "Read state of the conversation after the action."
  readState: PsmConversationReadState
  "Remediation state after the action (USER_RESOLVED for RESOLVED)."
  remediationState: PsmRemediationState
}

"""
Outcome of recording a user action.

On success, `conversation` carries the conversation as it stands after the action was recorded, so the
client can patch its view without a follow-up read. `conversation` is null on failure.

Domain failures surface in `errors` rather than as top-level GraphQL errors: unknown conversation
(NOT_FOUND), a remediation that is not KB-assisted, or a conversation whose remediationState is not
IN_PROGRESS. In every failure case nothing is appended to the timeline.
"""
type PsmRecordUserActionPayload implements Payload {
  """
  The conversation after the action was recorded. Null when the action was not recorded.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  conversation: PsmRecordUserActionConversation
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

