"A named group of filter values (e.g. opportunityStages)"
type SearchThirdPartyDynamicFilter {
  name: String!
  values: [SearchThirdPartyDynamicFilterValue!]!
}

"Top-level wrapper for third-party dynamic filter options"
type SearchThirdPartyDynamicFilterOptions {
  filters: [SearchThirdPartyDynamicFilter!]!
}

"A single filter value — name is always present, label is optional (fall back to name for display)"
type SearchThirdPartyDynamicFilterValue {
  label: String
  name: String!
}

"Stores meta information about a first party product"
