  "Email address of the owner."
  email: String
  "Display name of the owner."
  name: String
}

"""
Remediation history for one device: every sensor that has been active on it, each with
its event-log rows. Sensors with only Detected activity (no remediation event)
are omitted.
"""
type PsmDeviceRemediationHistory {
  "Populated instead of sensors when the history could not be served."
  errors: [QueryError!]
  "When psm-service assembled this history."
  generatedAt: DateTime
  "Sensors that have event-log rows on this device, most recently active first."
  sensors: [PsmRemediationSensor!]
}

"An active sensor fault currently affecting this device."
type PsmDeviceSensorFault {
  "Broad category of the sensor (e.g. \"storage\", \"network\")."
  category: String
  "Unique id for the fault (derived from sensor id + device serial + detection timestamp)."
  faultId: ID!
  "Identifier for this sensor in the source monitoring provider (vendor-specific)."
  providerSensorId: ID
  "PSM-internal identifier of the sensor."
  sensorId: ID
  "Human-readable name of the sensor (e.g. \"CPU Thermal Throttling\")."
  sensorName: String
  "Trigger states for this sensor on this device, including current and past remediation attempts."
  triggerStates: [PsmSensorTriggerState!]
}

"One row of the eligible-users list."
type PsmEligibleUser {
  "Atlassian account id — the stable row identity."
  atlassianAccountId: ID!
  "Email address, resolved from Identity. Null when unavailable or unverified."
  email: String
  "Display name, resolved from Identity. Null when Identity has no name for the account."
  name: String
  "PSM agent details for this user."
