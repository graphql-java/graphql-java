"A source document that was used to generate a mitigation plan."
type PlanSource {
  "The type of document. Null when the underlying value is missing or maps to UNKNOWN (values outside the enum)."
  documentType: MitigationDocumentType
  "The ID of the source document."
  sourceId: String
  "The title of the source document."
  title: String
  "The URL of the source document."
  url: String
}

"Playbook details for view including summary and usage statistics"
type PlaybookDetailsForView {
  createdAt: String
  executedOnIssues: [PlaybookExecutedIssue!]
  id: ID!
  "Whether the playbook was created via AI generation."
  isAiCreated: Boolean
  lastUpdatedAt: String
  name: String
  owner: User @hydrated(arguments : [{name : "accountIds", value : "$source.ownerAccountId"}], batchSize : 50, field : "users", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "AI-generated summary of the playbook"
  summary: String
  totalExecutionCount: Int
}

"Response payload for playbook details view query"
type PlaybookDetailsForViewPayload implements QueryPayload {
  errors: [QueryError!]
  playbook: PlaybookDetailsForView
  success: Boolean!
}

"Issue on which the playbook was executed"
type PlaybookExecutedIssue {
  issue: JiraIssue @hydrated(arguments : [{name : "ids", value : "$source.issueId"}], batchSize : 50, field : "jira.issuesById", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "gira", timeout : -1)
  lastExecutedAt: String
}

"""
One connector available to the tenant, together with the calling user's authorisation state against
it.

Read by surfaces that need to explain, before anything is run, whether a step depending on a
connector can work — and to hand the user somewhere to go when it cannot.

**Only connectors the tenant has configured appear at all.** An absent connector is not an
unconnected one: there is nothing for the user to authorise, and no `consentUrl` could exist for it.
Do not render absence as a disconnected state.
"""
type PlaybookUnifiedConnector {
  "Whether this user can use the connector."
  authStatus: PlaybookConnectorAuthStatus
  """
    Where to send the user to authorise the connector. **Populated only when `authStatus` says action
    is needed**, and null when the user is already connected — so it can be treated as "the user has
    something to do" without cross-checking the status. Note this differs from the equivalent
    incident-management surface, which returns a consent URL even for a connected user. Also null when
    the provider offered no URL, which happens for app-level auth modes where there is nothing for the
    user to consent to: **do not render a call to action when this is null**, even if `authStatus` is
    `NOT_CONNECTED`, because the remedy there is an admin one. Short-lived and specific to this user,
    so do not cache it, persist it, or share it between users.
  
  Always an absolute `https` URL — anything else the provider offers is dropped and this reads null,
    so a non-`https` scheme can never reach a browser through this field.
  """
  consentUrl: String
  """
    Product name, for example `Google Drive` or `SharePoint`. Rendered as-is; no further casing or
    formatting is needed.
  
  Served for the connector rather than relayed from the provider, on the same basis as `iconUrl`: the
    provider's own naming is inconsistent — it spells SharePoint "Sharepoint" — so serving it gives every
    tenant the same name for the same product. Not translated, since product names are not.
  """
  displayName: String
  """
    Icon for the connector, for example `/gateway/api/assist/rovo/v1/resources/icon/name/google-drive`.
  
  **Always a gateway-relative path, never an absolute URL** — resolve it against the site base before
    rendering. Served by-name for the connector rather than relayed from the provider's per-data-source
    icon, so every tenant gets the same icon for the same connector.
  """
  iconUrl: String
  """
    The connector's product ARI. One of a known set — `ari:cloud:platform::product/google/google-drive`
    or `ari:cloud:platform::product/microsoft/sharepoint` today. Stable across tenants, so match on this
    rather than on `displayName`, which the provider may reword.
  
  Always an ARI. A connector the provider reports without one is omitted from `connectors` rather than
    given a per-tenant local identifier, so this never carries a value a client cannot parse as an ARI.
  
  Identifies the connector product, not a per-tenant record: two tenants with Google Drive connected
    report the same `id`. It is stable and safe to compare, but this type does not implement `Node`, so
    the value is not resolvable through `node(id:)`.
  """
  id: ID!
}

"""
The tenant's connectors for the calling user.

A wrapper rather than a bare list so that `playbook_unifiedConnectors` can gain sibling fields later
— a count, or a partial-result marker — without a breaking change, and to match the `QueryPayload`
shape the rest of this schema uses for client-facing queries.
"""
type PlaybookUnifiedConnectorsQueryPayload implements QueryPayload {
  """
    The tenant's supported connectors — Google Drive and SharePoint today. A tenant may have others
    configured in Rovo; those are filtered out rather than reported, so do not treat this as a complete
    inventory of the tenant's Rovo connectors.
  
  Empty when the tenant has none of the supported connectors — which is a success, not a failure. A
    provider that cannot be read raises `CONNECTOR_SERVICE_ERROR` instead, so an empty list is never used
    to stand in for "we could not tell".
  """
  connectors: [PlaybookUnifiedConnector!]
  errors: [QueryError!]
  success: Boolean!
}

type PolarisComment {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  aaid: String!
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  account: User @hydrated(arguments : [{name : "accountIds", value : "$source.aaid"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  """
  ARI with UUID
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  ari: ID @ARI(interpreted : false, owner : "jira/jira-product-discovery", type : "polaris-comment", usesActivationId : false)
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  content: JSON! @suppressValidationRule(rules : ["JSON"])
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  created: String!
  """
  ARI with numeric ID
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  id: ID!
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  kind: PolarisCommentKind!
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  subject: ID!
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  updated: String!
  """
  View UUID when this comment is a view comment. Set only for polarisCommentByCommentARI. Needed for permission checks
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  viewUUID: ID
}

type PolarisConnectApp {
  """
  appId is the CaaS app id.  Note that a single app may have
  multiple oauth client ids, notably when deployed in different
  environments such as staging and production
