  avatarUrl: String!
  """
  the oauthClientId, which functions as the unique identifier id of CaaS app
  for our purposes
  """
  id: ID!
  "name of CaaS app"
  name: String!
  "oauthClientId of CaaS app"
  oauthClientId: String!
  play: PolarisPlay
}

