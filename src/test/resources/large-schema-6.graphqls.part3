"""
Individual skills represent the skills and capabilities associated with each person in the workforce. Multiple workers can share the same skill.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:radar:twg-cli__
* __write:talent:agent-interface__
"""
type RadarSkill implements Node @defaultHydration(batchSize : 200, field : "radar_skillsByAris", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_RADAR_TWG_CLI]) @scopes(product : NO_GRANT_CHECKS, required : [WRITE_TALENT_AGENT_INTERFACE]) {
  "The number of direct children of this skill in the taxonomy. For a domain, this is its specializations. For a specialization, this is its skills. For skills, this is always 0"
  childCount: Int
  "The number of active workers in filled, active positions associated with this skill"
  classifiedWorkerCount: Int
  "Additional context describing the skill"
  context: String
  "When the skill was created"
  createdAt: DateTime!
  "The depth of the skill in the taxonomy hierarchy"
  depth: Int
  "Optional description of the skill"
  description: String
  "Whether this skill has child skills in the taxonomy"
  hasChildren: Boolean
  "The Atlassian Resource Identifier of this Radar skill"
  id: ID! @ARI(interpreted : false, owner : "radar", type : "skill", usesActivationId : false)
  "The number of leaf skills below this node in the taxonomy. For domains and specializations, this is their leaf skills. For skills, this is always 0"
  leafSkillCount: Int
  "The name of the skill"
  name: String!
  """
  Get a skill's parent, this can be null if the skill does not have a parent
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "RadarSkills")' query directive to the 'parent' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  parent: RadarSkill @hydrated(arguments : [{name : "ids", value : "$source.parentId"}], batchSize : 100, field : "radar_skillsByAris", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "radar", timeout : 3000) @lifecycle(allowThirdParties : true, name : "RadarSkills", stage : EXPERIMENTAL)
  "A skill's parent ARI, this can be null if the skill does not have a parent. This will be hydrated via AGG."
  parentId: ID
  "The skill hierarchy path from the taxonomy root to this skill"
  pathIds: [ID!]!
  "When the skill was last updated"
  updatedAt: DateTime!
}

type RadarSkillAssignmentMetadata {
  "Whether this skill was inferred by AI or manually assigned."
  classificationType: RadarSkillClassificationType
  "The AI generated reason for the skill assignment"
  reasoning: String
  skillId: ID! @ARI(interpreted : false, owner : "radar", type : "skill", usesActivationId : false)
  """
  The first 10 work items the classifier cited for this assignment.
  
  
  This field is **deprecated** and will be removed in the future
  """
  sources: [RadarSkillSource!]
  """
  The work items the classifier cited for this assignment, ordered by descending
  evidence weight. Defaults to 10 sources and permits at most 25 per page.
  """
  sourcesConnection(after: String, first: Int = 10): RadarSkillSourceConnection
  "Verification state of the worker-skill mapping."
  verificationStatus: RadarSkillVerificationStatus
  "Timestamp when the worker-skill mapping was verified."
  verifiedAt: DateTime
  "The AAID of the user who verified or manually assigned this skill."
  verifiedByAaid: ID
  "The Atlassian account that verified or manually assigned this skill."
  verifiedByUser: User @idHydrated(idField : "verifiedByAaid", identifiedBy : "accountId")
  workerId: ID! @ARI(interpreted : false, owner : "radar", type : "worker", usesActivationId : false)
}

