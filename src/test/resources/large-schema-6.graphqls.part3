"Group of mutations related to actors."
type ShepherdActorMutations @apiGroup(name : GUARD_DETECT) {
  """
  Suspends the actor in the org of the specified workspace.
  
  ### The field is not available for OAuth authenticated requests
  """
  suspend(
    "The actor Atlassian account ID."
    aaid: ID!,
    "The organization ID."
    orgId: ID,
    "The workspace ARI."
    workspaceAri: ID @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdActorMutationPayload @oauthUnavailable @rateLimited(disabled : false, rate : 10, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 500, usePerIpPolicy : false, usePerUserPolicy : false)
  """
  Unsuspends the actor in the org of the specified workspace.
  
  ### The field is not available for OAuth authenticated requests
  """
  unsuspend(
    "The actor Atlassian account ID."
    aaid: ID!,
    "The organization ID."
    orgId: ID,
    "The workspace ARI."
    workspaceAri: ID @ARI(interpreted : false, owner : "beacon", type : "workspace", usesActivationId : false)
  ): ShepherdActorMutationPayload @oauthUnavailable @rateLimited(disabled : false, rate : 10, usePerIpPolicy : false, usePerUserPolicy : true) @rateLimited(disabled : false, rate : 500, usePerIpPolicy : false, usePerUserPolicy : false)
}

