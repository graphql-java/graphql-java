"""
The set of Unit-related resources linked to a given anchor resource via collaboration-context
links. The {@code id} echoes the anchor ARI that was queried. The {@code links} connection is
filtered server-side by CCM to only include resources the calling user has permission to see,
so this query can safely be called by regular (non org-admin) users.
"""
type AdminUnitLinkedResource {
  "The ARI of the anchor resource that was queried."
  id: ID!
  """
  The Unit-related resources linked to the anchor via collaboration-context links and visible
  to the calling user. Returned as a Connection per the Relay pagination spec. Supply {@code
  first} to request a page size and {@code after} (an opaque cursor from a previous page's
  {@code pageInfo.endCursor}) to page forward. When the upstream CCM pagination gate is off the
  full result set is returned in a single page with {@code pageInfo.hasNextPage = false}. Supply
  {@code filter} to restrict the returned links to specific target resource types.
  """
  links(after: String, filter: AdminUnitLinkedResourceFilter, first: Int): AdminUnitLinkedConnection!
}

