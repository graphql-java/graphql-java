type CplsWork {
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:capacity-planning:jira-software__
  * __write:capacity-planning:jira-software__
  * __write:capacity-planning:agent-interface__
