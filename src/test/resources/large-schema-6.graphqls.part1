type AgentConversationChannel @renamed(from : "AtiCloudConvoAiConversationChannel") {
  createdAt: Long
  id: ID
  interactionChannel: String
  interactionChannelAri: String
  isPinned: Boolean
  isPlanning: Boolean
  lastAgentMessageId: String
  lastAgentMessageStatus: String
  lastMessage: String
  lastMessageTimestamp: Long
  lastMessageType: [String]
  "The last requested conversation mode, as stored on the channel."
  lastRequestedMode: String
  name: String
  pinnedAt: Long
  """
  Stored agent metadata as JSON, without CAP REST normalization or derived isDefault.
  Select as a scalar leaf; stored keys are not a typed GraphQL contract.
  """
  rawAgent: JSON @renamed(from : "agent") @suppressValidationRule(rules : ["JSON"])
  """
  Stored agent author and version identity as JSON, without product-derived values.
  Select as a scalar leaf; stored keys are not a typed GraphQL contract.
  """
  rawAgentAuthor: JSON @renamed(from : "agentAuthor") @suppressValidationRule(rules : ["JSON"])
  """
  Open-ended stored attributes JSON shared with consumers such as Agent Memory Service.
  No inner-key allowlist is applied. Select as a scalar leaf and validate its stored shape.
  """
  rawAttributes: JSON @renamed(from : "attributes") @suppressValidationRule(rules : ["JSON"])
  """
  Stored remote A2A orchestration JSON, including task and message IDs and write-control flags.
  Select as a scalar leaf; stored keys are not a typed GraphQL contract.
  """
  rawCurrentRemoteA2ATaskMetadata: JSON @renamed(from : "currentRemoteA2ATaskMetadata") @suppressValidationRule(rules : ["JSON"])
  """
  Stored participant JSON in its original order, using participantType.
  CAP REST normalization and the ROVO_CHAT_AGENT_SELECTION feature gate are not applied.
  Select as scalar leaves; consumers must retain their UI feature gating.
  """
  rawParticipants: [JSON] @renamed(from : "participants") @suppressValidationRule(rules : ["JSON"])
  """
  Stored scope JSON in its original order, using subType and iconUrl keys.
  No CAP REST validation, normalization or entity hydration is applied.
  Select as scalar leaves; stored keys are not a typed GraphQL contract.
  """
  rawScopes: [JSON] @renamed(from : "scopes") @suppressValidationRule(rules : ["JSON"])
  readStatus: Boolean
  status: String
}

type AgentSession implements AgentSessionNode @renamed(from : "AtiCloudConvoAiSessionPublic") {
  _type: String
  agent: User @idHydrated(idField : "agentAccountId", identifiedBy : null)
  agentAccountId: String
  "The ARI of the agent (referring to the agent profile in studio)"
  agentAri: ID
  "The Jira issues and Confluence content associated with this session."
  associatedEntities: [AgentSessionLinkedEntity] @idHydrated(idField : "associatedEntityAris", identifiedBy : null)
  associatedEntityAris: [String] @hidden
  author: User @hydrated(arguments : [{name : "accountIds", value : "$source.authorAccountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  authorAccountId: String @hidden
  """
  The conversation channel associated with this session.
  
  Experimental field exclusively for limited-volume TEAMEU 26 demos. Do not use
  in production application flows, bulk processing, or high-volume workloads.
  Its API and behavior may change or be removed without notice.
  
  Conversation channels currently exist only in Rovo workspaces. For any other
  valid workspace, this field resolves to null when no matching channel exists.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AgentConversationChannelTeamEu26DemoOnly")' query directive to the 'conversationChannel' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  conversationChannel(workspaceAri: String! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : false)): AgentConversationChannel @hydrated(arguments : [{name : "id", value : "$source.id"}, {name : "shardingContext", value : "$argument.workspaceAri"}], batchSize : 200, field : "agent_conversationChannelGetById", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1) @lifecycle(allowThirdParties : false, name : "AgentConversationChannelTeamEu26DemoOnly", stage : EXPERIMENTAL)
  convoAiAgentId: String
  expireTime: DateTime
  """
  Epoch milliseconds timestamp of when the agent session logically expires under its retention policy.
  Consumers derive expired state by comparing against the current time. Absent means the session never expires.
  Distinct from expireTime, which controls physical deletion of the record.
  """
  expiresAt: Long
  "Whether the session has unseen activity. Null means the status is unknown."
  hasUnseenActivity: Boolean
  id: ID
  "The invocation type of the session."
  invocationType: String
  isRovo: Boolean
  """
  The JCA (Jira Coding Agent) Rovo Dev session associated with this agent session,
  hydrated from jcaSessionAri on the underlying agent session record.
  Populated when a Rovo Dev session was created alongside this conversational session.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "DevAiRovoDevSessions")' query directive to the 'jcaSession' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  jcaSession: DevAiRovoDevSession @hydrated(arguments : [{name : "id", value : "$source.jcaSessionAri"}], batchSize : 1, field : "devai_rovodevSessionById", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "devai", timeout : -1) @lifecycle(allowThirdParties : false, name : "DevAiRovoDevSessions", stage : EXPERIMENTAL)
  """
  The ARI of the associated JCA (Jira Coding Agent) session.
  Set when this agent session has a corresponding session in conversational-ai-platform.
  """
  jcaSessionAri: ID
  "Epoch milliseconds timestamp of the last session state change."
  lastStateChangeAt: Long
  """
  The native conversation channel relationship, resolved using the session's
  shard context. Access is subject to the conversation channel's permissions.
  
  DANGEROUS: Experimental field exclusively for limited-volume TEAMEU 26 demos.
  Do not use in production application flows, bulk processing, or high-volume
  workloads. Its API and behavior may change or be removed without notice.
  Requires explicit opt-in to AgentConvoChannelStrictlyTeamEu26DemoOnly.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AgentConvoChannelStrictlyTeamEu26DemoOnly")' query directive to the 'nativeConversationChannel' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  nativeConversationChannel: AgentConversationChannel @lifecycle(allowThirdParties : false, name : "AgentConvoChannelStrictlyTeamEu26DemoOnly", stage : EXPERIMENTAL)
  "The URL of the pull request associated with the agent session."
  pullRequestUrl: String
  "Epoch milliseconds timestamp of when the agent session started."
  startTime: Long
  state: String
  "The reason for the session's current state."
  stateReason: String
  "The studio agent profile"
  studioAgent: AgentStudioAgent @hydrated(arguments : [{name : "ids", value : "$source.agentAri"}], batchSize : 90, field : "agentStudio_agentsByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "agent", timeout : -1)
  "The title of the agent session."
  title: String
  version: Long
}

type AgentSessionAssociation implements AgentSessionAssociationNode @renamed(from : "AtiCloudConvoAiSessionAssociationPublic") {
  _type: String
  """
  The Rovo agent that ran this session — resolved from agentSession.agentAccountId via identity.
  Exposed at top-level to match existing aiAgentSessions node.agent { ... } structure.
  Will be populated once convo-ai writes agentAccountId to session-public.
  """
  agent: User @idHydrated(idField : "agentSession.agentAccountId", identifiedBy : null)
  """
  Full session record from session-public — fetched lazily by SkyBridge via the
  agentSessionId relationship property. Contains agentAccountId → agent: User via identity.
  """
  agentSession: AgentSession
  agentSessionId: String
  """
  Alias for agentSessionId — matches the conversationId field name used in aiAgentSessions
  so the FE can migrate gradually without breaking changes.
  """
  conversationId: String @renamed(from : "agentSessionId")
  """
  Alias for agentSession — matches the convoAiSession field name used in aiAgentSessions
  so the FE can migrate gradually without breaking changes.
  """
  convoAiSession: AgentSession @renamed(from : "agentSession")
  """
  Whether this association has been soft-deleted.
  Added in ERS v2.
  """
  deleted: Boolean
  entity: AgentSessionLinkedEntity @idHydrated(idField : "entityId", identifiedBy : null)
  entityId: String
  expireTime: DateTime
  id: ID
  """
  The invocation type for this session.
  Added in ERS v2.
  """
  invocationType: String
  """
  The JCA (Jira Coding Agent) Rovo Dev session associated with this agent session,
  hydrated from jcaSessionAri on the underlying agent session record.
  Populated when a Rovo Dev session was created alongside this conversational session.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "DevAiRovoDevSessions")' query directive to the 'jcaSession' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  jcaSession: DevAiRovoDevSession @hydrated(arguments : [{name : "id", value : "$source.agentSession.jcaSessionAri"}], batchSize : 1, field : "devai_rovodevSessionById", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "devai", timeout : -1) @lifecycle(allowThirdParties : false, name : "DevAiRovoDevSessions", stage : EXPERIMENTAL)
  """
  The start time of the session (epoch ms).
  Added in ERS v2.
  """
  startTime: Long
  """
  The ARI of the comment (inline or footer) that this session is anchored to.
  Present when the session was started in the context of a specific comment.
  """
  subEntityId: String
  """
  The human user who triggered this session — resolved from userAccountId via identity.
  Exposed at top-level to match existing aiAgentSessions structure.
  """
  triggeredBy: User @hydrated(arguments : [{name : "accountIds", value : "$source.userAccountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  """
  The account ID of the user who owns this session association.
  Added in ERS v2.
  """
  userAccountId: String @hidden
  version: Long
}

