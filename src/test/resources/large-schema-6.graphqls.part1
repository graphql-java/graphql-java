"""
Result of a rollout eligibility check for a given target version.
Counts the current total number of eligible installations across all eligible
source versions, and a per-version breakdown of eligibility.
"""
type EcosystemRollingReleaseEligibility @renamed(from : "RollingReleaseEligibility") {
  "The resolved target version number like \"1.0.0\" that eligibility was computed against."
  targetVersion: String!
  """
  The resolved target version ID that eligibility was computed against.
  Useful when the caller did not provide a `targetVersionId` (defaults to the
  latest version for the environment).
  """
  targetVersionId: ID!
  """
  The total number of installations that would be upgraded if the rollout
  were initiated — i.e. the sum of installations on all eligible source versions.
  """
  totalEligibleInstallationCount: Int!
  """
  A breakdown of eligibility per source version (all versions older than the target
  by semver, within the same environment).
