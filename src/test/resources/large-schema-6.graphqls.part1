type AVPAddFilterExpressionsPayload implements Payload {
  """
  A list of errors if the mutation was not successful
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  List of newly created IDs in same order as input expressions (empty if operation failed)
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __write:dashboard:jira__
  """
  expressionIds: [ID!] @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_WRITE])
  """
  The entire filter expression tree after adding (null if operation failed)
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  filterExpression: AVPFilterExpression @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  Was this mutation successful
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

"""
Error extension for mutation errors that the client can explicitly acknowledge and retry.

`impactedMetrics` is populated only for `LINEAGE_IMPACT` errors and carries the full list
of impacted linked custom metrics as structured (metricAri, name) pairs so the UI can render
names and deep-link without parsing the human-readable error message. Null/empty for all
other acknowledgeable errors.
"""
