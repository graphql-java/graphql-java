"A breaching connection registered against a Unit (Collaboration Context) in CCM."
type AdminBreachingConnection {
  "The id of the entity the connection refers to."
  connectionEntityId: ID!
  "The unique id of the breaching connection."
  connectionId: ID!
  "A self link to the connection entity."
  connectionSelfLink: String!
  "The type of the connection (e.g. APP_LINK)."
  connectionType: String!
  """
  The user that created the connection, hydrated from their account ID.
  Empty if the connection has no known creator, or the user could not be found.
  """
  createdBy: AdminUser
  """
  ISO-8601 timestamp (e.g. 2026-06-29T04:27:47.267Z) when the connection was created.
  Empty if CCM did not return a creation timestamp.
  """
  createdTimestamp: String
  "The source resource, hydrated from its ARI. An unresolved resource is a restricted workspace."
  source: AdminBreachingConnectionResource
  """
  The source Workspace of the connection, hydrated from its ARI.
  Empty if the Workspace could not be found or the caller is not permitted to view it.
  
  
  This field is **deprecated** and will be removed in the future
  """
  sourceWorkspace: AdminWorkspace
  "The status of the connection."
  status: AdminBreachingConnectionStatus!
  "The target resource, hydrated from its ARI. An unresolved resource is a restricted workspace."
  target: AdminBreachingConnectionResource
  """
  The Unit (Collaboration Context) owning the target Workspace, hydrated from the Workspace's
  Unit ARI. Empty if there is no target, the target Workspace could not be hydrated, or its
  Unit could not be resolved (deleted, or in another organisation).
  
  
  This field is **deprecated** and will be removed in the future
  """
  targetUnit: AdminUnit
  """
  The target Workspace of the connection, hydrated from its ARI.
  Empty if there is no target, the Workspace could not be found, or the caller is not
  permitted to view it.
  
  
  This field is **deprecated** and will be removed in the future
  """
  targetWorkspace: AdminWorkspace
  """
  ISO-8601 timestamp (e.g. 2026-06-29T04:27:47.267Z) when the connection was last updated.
  Empty if CCM did not return an update timestamp.
  """
  updatedTimestamp: String
}

"""
