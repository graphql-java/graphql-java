"Response for `playbook_generateHypothesisMitigation`."
type GenerateHypothesisMitigationPayload implements Payload {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  The hypothesis, in a progress state and with no plans yet: generation has only just been queued.
  Poll `playbook_hypothesisMitigationById` for the plans.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  hypothesisMitigation: HypothesisMitigation
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

"Wrapper for generation query response, always returns a result shape."
type GeneratePlaybookPayload implements QueryPayload {
  "Error details. Empty list if success=true."
  errors: [QueryError!]
  "Generated playbook structure. Null if generation failed."
  playbook: GeneratedPlaybook
  "True if suggestion succeeded, false otherwise."
  success: Boolean!
}

"""
AI-generated playbook suggestion ready for frontend rendering and user refinement.
Aligns with existing JiraPlaybookDto model for seamless FE rendering.
"""
type GeneratedPlaybook {
  "AI-generated playbook name."
  name: String!
  """
  Ordered list of generated steps. Supports INSTRUCTIONAL_RULE and CHECKLIST step types.
  A CHECKLIST step is only returned when BOTH `phantom-5968-ai-checklist-step` (this
  AI-generation path) AND `phantom-5483-checklist-step` (the manual/GraphQL-authoring path,
  which enforces the save-time gate) are on for the tenant; otherwise it is downgraded
  server-side to INSTRUCTIONAL_RULE. The two gates are checked together deliberately, so a
  tenant can never receive a CHECKLIST step it would then fail to save.
  Empty list if no steps could be generated.
  """
  steps: [GeneratedStep!]!
}

"""
Single suggested step, aligned with existing StepDto model.
Supports INSTRUCTIONAL_RULE and CHECKLIST step types; other fields (ruleId, automationTemplateId,
taskId) are omitted — they are not applicable to AI generation.
"""
type GeneratedStep {
  """
  Checklist items for CHECKLIST steps; null otherwise. Reuses the shared `ChecklistItem` type;
  `itemId` is always null here and must not be synthesized by the frontend — it is assigned
  server-side when the playbook is created.
  """
  checklistItems: [ChecklistItem!]
  """
  Instructional description in JSON format, consistent with existing JiraPlaybookStep.
  Maps to StepDto.description.
  """
  description: JSON @suppressValidationRule(rules : ["JSON"])
  """
  Step name (e.g., "Notify team on issue resolved").
  Maps to StepDto.name.
  """
  name: String!
  """
  Step type enum. Generation supports INSTRUCTIONAL_RULE and CHECKLIST.
  Maps to StepDto.type (JiraPlaybookStepType enum).
  """
  type: JiraPlaybookStepType!
}

