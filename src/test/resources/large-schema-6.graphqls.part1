"GUPS Mutation"
type CommerceExpGupsMutation {
  """
  Gets the entitlement information for a given order and set it into GUPS entitlement context
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  createEntitlementProfile(orderId: ID!, transactionAccountId: ID!, trialTrigger: String, trialType: String): CommerceExpCreateEntitlementProfilePayload
}

