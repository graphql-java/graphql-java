}

type AiManagedObjectDesiredUpdateFrequency {
  """
  Optional IANA timezone for CRON expressions (e.g. America/New_York). Defaults to UTC.
  Ignored for INTERVAL type.
  """
  timezone: String
  "Discriminator for the frequency value. INTERVAL = ISO 8601 duration, CRON = Quartz cron expression."
  type: AiManagedObjectDesiredUpdateFrequencyType!
  """
  The frequency value. For INTERVAL: an ISO 8601 duration (e.g. PT1H, PT24H).
  For CRON: a 6-field Quartz cron expression (e.g. 0 0 9 ? * MON-FRI).
  """
  value: String!
}

