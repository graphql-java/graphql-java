"""
Third-party identities connected by the agreed email-link relationship.

At least one member matches the search. Other members need not match.
This group is not an Atlassian account or an authoritative person record.
"""
type AdminThirdPartyUserGroup {
  """
  Identifies the same group consistently within the organization and search
  pagination context, regardless of which member matched or which scope returned it.
  Truncated member details must not change this key. It is not an Atlassian
  account ID, a permanent person identifier, or a globally refetchable Node ID.
  """
  groupKey: ID!
  """
    The group's underlying identities, including the matching members.
    Returns at most 51 distinct members across all pages, preserving the limit of
    one selected identity plus 50 linked identities. This cap is independent of
    the search's 50-group cap. Incomplete membership is reported by completeness
    and must not change the group's key or cause duplicate search groups.
  
  Supports forward pagination only; backward pagination is not supported.
  """
  members(
    "An opaque continuation cursor for this group's members."
    after: String,
    """
    The maximum number of members to return in this page, from 1 to 51;
    defaults to 51.
    """
    first: Int = 51
  ): AdminThirdPartyUserIdentityConnection
}

"""
An identity belonging to a third-party provider.

The identity may also have an associated Atlassian account.
Its identifier remains the third-party identity ARI.

Refetch through admin_org(...).thirdPartyUser(id: ...) within the parent
organization's authorized and validated backend scopes. This type implements
AdminPrincipal but does not provide the shared Node refetch contract.
Possession of an identity ARI alone does not authorize access.
"""
type AdminThirdPartyUserIdentity implements AdminPrincipal {
  """
    Connector objects associated with this identity's canonical provider in its
    validated organization and resource scopes. Different installations may produce
    multiple connector objects; they do not represent different member identities.
    This connection is limited to this identity's validated resource scopes;
    provider.connectors exposes the provider across the organization's validated
    resource scopes. Provider membership alone does not establish identity scope.
  
  Preserves existing connector and data-source semantics, including site context
    where applicable. Provider names and icons are available through the existing
    connector form configuration. Missing optional metadata must not erase the
    identity ARI or provider ID. Supports forward pagination only.
  """
  connectors(
    "An opaque continuation cursor for these scoped connector results."
    after: String,
    "The maximum number of connector objects to return in this page."
    first: Int = 10
  ): AdminConnectorConnection
  "The identity's email address, when available."
  email: String
  "The real third-party identity ARI; not an Atlassian account ID."
  id: ID!
  """
    The directly email-linked third-party identities in the same validated
    organization context, excluding this identity and deduplicated by ARI.
    Reciprocal relationship edges must not duplicate an account. Includes accounts
    with or without an associated Atlassian identity.
  
  Returns at most 50 linked identities across all pages. This limit is separate
    from the 50-group search cap and the 51-member group cap. Completeness reports
    omitted or potentially missing accounts; required dependency failures are
    GraphQL errors. Requires the same organization authorization, rollout gate
    and enabled linking setting as search and individual lookup.
  
  Supports forward pagination only; backward pagination is not supported.
  """
  linkedAccounts(
    """
    An opaque continuation cursor for this identity's linked accounts within
    the same organization.
    """
    after: String,
    """
    The maximum number of linked identities to return in this page, from 1 to 50;
    defaults to 50.
    """
    first: Int = 50
  ): AdminThirdPartyUserIdentityConnection
  "The identity's display name, when available."
  name: String
  """
  The canonical provider referenced by this identity's providerId, resolved within
  the same authorized organization context as the identity. Uses the same provider
  type and organization-wide connector scope as thirdPartyUserProviders.
  Its providerId, when available, must match this identity's providerId.
  Requires the same rollout gate and enabled organization linking setting.
  A missing provider reference must not erase the identity or its known providerId;
  authorization and required dependency failures remain GraphQL errors.
  """
  provider: AdminThirdPartyUserProvider
  """
  The canonical provider ID supplied by jswdd-processor with this identity,
  when available. This value is independent of connector name/icon enrichment;
  missing optional connector metadata must not erase a known provider ID.
  """
  providerId: ID
}

"""
A page of third-party identities from a group's members or an identity's
directly linked accounts. The parent field defines inclusion rules and total cap.
"""
type AdminThirdPartyUserIdentityConnection {
  """
  Completeness of identity retrieval across pages under the parent field's cap,
  independently of search completeness. COMPLETE means no qualifying identities
  were omitted. TRUNCATED means additional qualifying identities are known to
  exist beyond that cap. UNKNOWN means successful retrieval cannot establish
  either outcome. A null value does not establish completeness and must not be
  treated as COMPLETE. Required dependency failures are GraphQL errors.
  """
  completeness: AdminThirdPartyUserResultCompleteness
  "The identities in this page, deduplicated by identity ARI."
  edges: [AdminThirdPartyUserIdentityEdge!]
  "Pagination information for the returned identities."
  pageInfo: PageInfo!
}

"An identity and its position within a member or linked-account connection."
type AdminThirdPartyUserIdentityEdge {
  "An opaque cursor identifying this identity's position in its parent connection."
  cursor: String!
  "The underlying third-party identity."
  node: AdminThirdPartyUserIdentity
}

"""
A canonical provider with at least one qualifying email-linked identity in the
parent organization. This is distinct from a site-specific connector grouping.
Both organization-level discovery and identity provider relationships use this type.
"""
type AdminThirdPartyUserProvider {
  """
    Connector objects associated with this provider within the parent organization's
    validated resource scopes. Reuses existing connector and data-source semantics,
    preserving site context rather than merging site-specific connector objects.
    Duplicate observations must not repeat the same scoped connector in this list.
    This is the organization-wide provider view, regardless of the identity used
    to reach it. It does not imply that an identity was ingested from every site.
  
  Provider names and icons are available through connector form configuration.
    Missing optional display metadata must not remove a qualifying provider from
    discovery. Requires the same authorized organization context, rollout gate and
    enabled linking setting as discovery. Supports forward pagination only.
  """
  connectors(
    "An opaque continuation cursor for this provider's scoped connector results."
    after: String,
    "The maximum number of scoped connector objects to return in this page."
    first: Int = 10
  ): AdminConnectorConnection
  """
  The canonical provider ID used to deduplicate discovery results. Optional
  connector metadata must not erase a known provider ID. A null value indicates
  unavailable field data, not an additional unidentified provider.
  """
  providerId: ID
}

"""
A page of distinct providers with qualifying email-linked users in an organization.
All qualifying providers must be retrievable by following the connection's pages;
the user-search result cap does not limit provider discovery.
"""
type AdminThirdPartyUserProviderConnection {
  "The qualifying providers in this page, deduplicated by canonical provider ID."
  edges: [AdminThirdPartyUserProviderEdge!]
  "Pagination information for the qualifying providers."
  pageInfo: PageInfo!
}

"A provider and its position in the organization's provider-discovery results."
type AdminThirdPartyUserProviderEdge {
  "An opaque cursor identifying this provider's position in the connection."
  cursor: String!
  "The qualifying provider."
  node: AdminThirdPartyUserProvider
}

"A page of distinct email-linked identity groups matching a search."
type AdminThirdPartyUserSearchConnection {
  """
    Completeness of the search across all pages, within the total cap of 50 groups.
    COMPLETE requires exhaustion of all relevant scopes with no qualifying groups
    omitted. TRUNCATED requires evidence of more than 50 qualifying groups. UNKNOWN
    means successful retrieval cannot establish either outcome.
  
  This is separate from whether another API page can be retrieved. Reaching the
    total cap can prevent further pages even when completeness is TRUNCATED.
    A null value does not establish completeness and must not be treated as COMPLETE.
    Required dependency failures still fail the search with a GraphQL error.
  """
  completeness: AdminThirdPartyUserResultCompleteness
  "The matching groups in this page."
  edges: [AdminThirdPartyUserSearchEdge!]
  "Pagination information for the returned groups."
  pageInfo: PageInfo!
}

"A group and its position in the search results."
type AdminThirdPartyUserSearchEdge {
  "An opaque cursor identifying this position in the search."
  cursor: String!
  "The matching email-linked identity group."
  node: AdminThirdPartyUserGroup
}

