  initial: Int
}

"Output of the CHANGE_IMPACT task — per-service change analysis results."
type AIOpsChangeImpactTaskOutput {
  "Per-service change analysis results."
  perServiceAnalysis: [AIOpsServiceChangeAnalysis!]
}

"""
Payload returned by the aiops_triggerInvestigation mutation.

Follows the Atlassian v2 mutation payload format:
- success: true when the investigation was created successfully, false otherwise.
- errors: populated with error details when success is false.
- investigation: the created investigation when success is true.
"""
type AIOpsCreateInvestigationPayload implements Payload {
  """
  Errors encountered during the mutation. Populated when success is false.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  True when the mutation returned an existing investigation instead of creating a new one.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  idempotent: Boolean
  """
  The created investigation. Populated when success is true.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  investigation: AIOpsInvestigation
  """
  Whether the mutation succeeded.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

"Top-level deployment activity. Use aiops_entityDetail for full deployment detail."
