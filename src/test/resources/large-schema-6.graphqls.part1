  "Description from the underlying definition."
  description: String
  "Display name from the underlying definition."
  displayName: String
  "URL of the tool icon."
  iconUrl: String
  "Server-minted id for this selection."
  id: ID!
  "Whether the upstream registry resolves this definition."
  isResolved: Boolean!
  "Origin of the tool definition."
  source: CsmAiAgentToolSource!
}

