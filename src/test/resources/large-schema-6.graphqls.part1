  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  categories: [ChangeManagementJSMPreventionCenterRiskAssessmentCategoryResult!]
  """
   0-1 fraction; the UI shows it as a percentage.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  confidenceScore: Float
  """
  {cloudId}:risk-assessment:{issueId}:{accountId}. Unique and stable per change and user, so Relay merges
  mutation responses into the stored record.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID
  """
   epoch milliseconds as a string. Null while IN_PROGRESS.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  lastUpdatedAt: String
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  mitigationSteps: [ChangeManagementJSMPreventionCenterRiskAssessmentMitigationStep!]
  """
  The assessment's overall level. Null until an assessment is available.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  riskLevel: ChangeManagementJSMPreventionCenterOverviewSummaryRiskLevel
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  sources: [ChangeManagementJSMPreventionCenterOverviewSummarySource!]
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  status: ChangeManagementJSMPreventionCenterOverviewSummaryStatus!
  """
  Trace id of the run, for AI analytics events. Set on the run's subscription snapshots only; not stored,
  so null on the query and mutations.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
