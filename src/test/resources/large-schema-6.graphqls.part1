  """
  hasSid: Boolean
  id: ID! @ARI(interpreted : false, owner : "commerce", type : "entitlement", usesActivationId : false)
  "The last 10 invoice requests for an entitlement"
  invoiceRequests(range: [CcpSearchFieldRangeInput!], sort: [CcpSearchSortInput]): [CcpInvoiceRequest]
  "Whether the entitlement is active on a contract"
  isActiveOnContract: Boolean
  "Is eligible for a Cloud Migration Trial for the entitlement"
  isEligibleForCloudMigrationTrial: Boolean
