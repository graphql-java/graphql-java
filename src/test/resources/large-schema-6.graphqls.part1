"An ordinary hyperlink with no resolved metadata"
type ConfluenceHyperlink implements SmartLink @apiGroup(name : CONFLUENCE_LEGACY) {
  """
  Whether the current user has permission to view the linked content. Defaults to false if resolved is false.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  canView: Boolean!
  """
  The emoji used as the title icon for the linked content. Null if resolved is false or the content has no emoji title.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  emojiTitle: String
  """
  The URL of the icon representing the linked content (e.g. space icon). Null if resolved is false or no icon is available.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  iconUrl: String
  """
  The product that owns the linked content (e.g. 'confluence'). Null if resolved is false.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  product: String
  """
  Whether the linked content was successfully resolved. If false, canView defaults to false and title, emojiTitle, iconUrl, product, resourceType, and subType will all be null.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  resolved: Boolean!
  """
  The resource type of the linked content (e.g. 'page', 'blogpost', 'space'). Null if resolved is false.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  resourceType: String
  """
  The visual appearance of the linked content status.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  statusAppearance: String
  """
  The status text of the linked content. Null when no status is available.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  statusText: String
  """
  The subtype of the linked content, if applicable. Null if resolved is false or the content has no subtype.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  subType: String
  """
  The title of the linked content. Null when metadata has not been resolved.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  title: String
  """
  The original URL of the linked content.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  url: String!
}

