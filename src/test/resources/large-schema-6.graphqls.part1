type AppLogsWithMetaData {
  "Unique Id assign to each app"
  appId: String!
  "Defines the current version of your app in particular context."
  appVersion: String
  "Name of the browser that emitted the frontend (UI) log (e.g. \"Chrome\"). Null for backend/runtime logs."
  browserName: String
  "Version of the browser that emitted the frontend (UI) log (e.g. \"138\"). Null for backend/runtime logs."
  browserVersion: String
  cloudwatchId: String
  "Container name."
  container: String
  "context field to define which context or product the app is invoked for"
  context: Context
  "edition of the installation context of the logline"
  edition: EditionValue
  "Specify which environment to search."
  environmentId: String!
  "error occurs during invocation"
  error: String
  "Type of the error associated with the frontend (UI) log (e.g. \"TypeError\"). Null for backend/runtime logs."
  errorType: String
  "Extension id (ARI) associated with the frontend (UI) log. Null for backend/runtime logs."
  extensionId: String
  "Extension type of the frontend module (e.g. \"confluence:globalPage\"). Null for backend/runtime logs."
  extensionType: String
  "function name gets triggered during invocation"
  functionKey: String
  "The context in which the app is installed"
  installationContext: String
  "Installation id associated with the frontend (UI) log"
  installationId: String
  "Container instance."
  instance: String
  "Id uniquely identifies each invocation."
  invocationId: String!
  "license state of the installation context of the logline"
  licenseState: LicenseValue
  "Source of the frontend (UI) log (e.g. CONSOLE). Null for backend/runtime logs."
  logSource: FrontendLogSource
  "Log level of log line.  Typically one of: TRACE, DEBUG, INFO, WARN, ERROR, FATAL"
  lvl: String
  "The textual message from the log statement."
  message: String
  "module key of your app invoked"
  moduleKey: String
  "Metadata about module type"
  moduleType: String
  "Organization id associated with the log entry. Can be present for any log (backend or frontend)."
  orgId: String
  "Operating system name of the client that emitted the frontend (UI) log (e.g. \"Mac OS X\"). Null for backend/runtime logs."
  osName: String
  "other field that contains any additional JSON fields included in the log line"
  other: String
  "Defines the priority of log line"
  p: String
  "Container placement."
  placement: String
