}

"Page-based response for service options."
type AgentWorkspaceServiceOptionsPage {
  "Whether there are more results after this page."
  hasNextPage: Boolean!
  "Whether there are results before this page."
  hasPreviousPage: Boolean!
  "Requested page size after service-side limits are applied."
  limit: Int!
  "Zero-based offset used to fetch this page."
  offset: Int!
  "1-based page number returned."
  page: Int!
  "Services on the requested page."
  services: [AgentWorkspaceService!]!
  "Total number of services matching the query before pagination."
  totalCount: Int!
  "Total number of pages matching the query."
  totalPages: Int!
}

"""
Per-row progress for a routing-table generation run: a service bucket in service mode or a team
in team mode. Surfaced as a list (rather than the underlying map) so it is consumable by
REST/GraphQL clients without custom scalar handling. Stable across redeliveries — a missing entry
means the worker has not yet recorded a transition for its identifier. The legacy type and field
names are retained for compatibility.
"""
type AgentWorkspaceServiceProgressEntry {
  "Stable row identifier: a service ID in service mode or a team ARI in team mode."
  serviceId: ID!
  """
  Reason the service was skipped. Only populated when `status = SKIPPED`. Useful for FE diagnostics
  and a "no data" affordance — e.g. \"No matching tickets found in the past 30 days\".
  """
  skipReason: AgentWorkspaceServiceSkipReason
  "Current per-service status."
  status: AgentWorkspaceServiceProcessingStatus!
}

