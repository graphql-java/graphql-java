  "The ARI of the user"
  principalId: ID! @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  "The user identity details (name, picture; email deferred to AVP-23762)"
  user: User @idHydrated(idField : "principalId", identifiedBy : null)
}

"Represents a dimension in a platform filter."
type AVPPlatformDimension {
  "Datasource locator configuration"
  datasourceLocator: AVPDatasourceLocator!
  """
  Dynamic dimension key (e.g., customfield_10286). Must provide for dynamic dimensions.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  dynamicDimensionKey: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  "Dimension name/key"
  name: String!
  "Product context (e.g., jira, confluence)"
  product: String!
  """
  Optional sub-product context (e.g., jsm, csm)
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  subProduct: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
}

"Represents a platform filter (leaf node in the filter expression tree)."
type AVPPlatformFilter {
  "Comparison operator (e.g., in, datebti)"
  comparison: String!
  "List of default values"
  defaultValues: [String]!
  "List of dimensions for this filter"
  dimensions: [AVPPlatformDimension!]!
  "Unique identifier"
  id: ID!
  """
  Whether this filter is hidden from UI (i.e. externally configured). Derived from `visibility` for backwards compatibility.
  
  
  This field is **deprecated** and will be removed in the future
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  isHidden: Boolean @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  Optional human-readable label
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  label: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  Optional metadata as JSON
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  metadata: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  What modes this filter is visible in (VIEW_AND_EDIT, EDIT_ONLY, NONE)
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  visibility: AVPPlatformFilterVisibility @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
}

"Shared global config for a metrics source, applied to that source's metrics on a dashboard."
