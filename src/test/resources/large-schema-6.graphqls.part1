  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  type: ChangeManagementActivityEntityType!
}

"Top-level change request activity. No ICC equivalent."
type ChangeManagementChangeActivity implements ChangeManagementServiceActivity {
  """
  Change risk level. Tenant-configurable.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  changeRisk: String
  """
  Change type, e.g. Standard, Normal, Emergency. Tenant-configurable.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  changeType: String
  """
  Jira issue ID, not the key.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  entityId: ID!
  """
  Deep link to the Jira change issue.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  link: String
  """
  Planned end. Use with plannedStartDate to render a span rather than a point.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  plannedEndDate: DateTime
  """
  Planned start. Null when unset on the issue.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  plannedStartDate: DateTime
  """
  Raw Jira priority string. Clients should tolerate custom values.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  priority: String
  """
  Current status name. Current state, not the state at timestamp.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  status: String
  """
  Change summary or title.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  summary: String
  """
  Planned start date, falling back to created. See timestampBasis.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  timestamp: DateTime!
  """
  Whether timestamp came from the planned start date or the created date.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  timestampBasis: ChangeManagementChangeTimestampBasis!
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  type: ChangeManagementActivityEntityType!
}

