  requiresConfirmation: Boolean
}

"A single tool mapping selected on a CSM agent. Identity is the client-supplied `toolMappingId`; the same `(definitionId, source)` may appear more than once under distinct ids. Display metadata (name, description, icon) is stitched on by AGG via `mcpTool` / `mcpServer`."
type CsmAiAgentToolMapping @apiGroup(name : CSM_AI) {
  "Configuration of this tool. Null for unconfigured tools."
  configuration: CsmAiAgentToolConfiguration
  "Opaque definition identifier from the source registry — may be an ARI, UUID, or vendor-specific key depending on `source`."
  definitionId: String!
  "Stable id for this mapping, supplied by the client as `toolMappingId` in `csmAi_updateAgentToolMappings`. Returned on reads and used to update the tool's configuration via `csmAi_updateAgentToolConfiguration`."
  id: ID!
  """
  Server details resolved live from the Integrations Service. Null unless `source` is
  `MCP_SERVER`, and null when the server is missing or uninstalled. Batched alongside `mcpTool`,
  so a mixed `MCP_TOOL` + `MCP_SERVER` list costs one call per actor rather than one per mapping.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "CsmAiHub")' query directive to the 'mcpServer' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  mcpServer(cloudId: ID @CloudID(owner : "graph")): GraphIntegrationMcpServerNode @hydrated(arguments : [{name : "ids", value : "$source.mcpServerId"}, {name : "cloudId", value : "$argument.cloudId"}], batchSize : 50, field : "graphIntegration_mcpServers", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "graph_integrations", timeout : -1) @lifecycle(allowThirdParties : false, name : "CsmAiHub", stage : EXPERIMENTAL)
  "Source field AGG hydrates `mcpServer` from. Non-null only when `source` is `MCP_SERVER` and `definitionId` is an Integrations Service MCP server ARI."
  mcpServerId: ID @hidden
  """
  Tool details resolved live from the Integrations Service, so a tool card renders without a
  second client round-trip. Null unless `source` is `MCP_TOOL`, and null when the tool is missing
  or uninstalled — a mapping that fails to resolve never fails the enclosing `toolMappings` list.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "CsmAiHub")' query directive to the 'mcpTool' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  mcpTool(cloudId: ID @CloudID(owner : "graph")): GraphIntegrationMcpToolNode @hydrated(arguments : [{name : "ids", value : "$source.mcpToolId"}, {name : "cloudId", value : "$argument.cloudId"}], batchSize : 50, field : "graphIntegration_mcpTools", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "graph_integrations", timeout : -1) @lifecycle(allowThirdParties : false, name : "CsmAiHub", stage : EXPERIMENTAL)
  "Source field AGG hydrates `mcpTool` from. Non-null only when `source` is `MCP_TOOL` and `definitionId` is an Integrations Service MCP tool ARI."
  mcpToolId: ID @hidden
  "Origin of the tool definition."
  source: CsmAiAgentToolSource!
}

