  offering: CcpOffering @hydrated(arguments : [{name : "ids", value : "$source.offeringId"}], batchSize : 90, field : "ccp_offerings", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  "The offering ID"
  offeringId: ID
  "The period for which the estimate line is generated"
  period: CommerceExpPeriodResponse
  "This will store the reference pricing plan id which will determine the list price of the product"
  pricingPlan: CommerceExpCcpPricingPlan
  "The quantity for which the user is charged"
  quantity: Float
  "Id for the quote line item"
  quoteLineId: String
  "Cost of the line item excluding tax, promotions, upgrade credits and accured charges"
  subTotal: Float
  "Tax estimate of the line item"
  tax: Float
  "Tax distribution for the line item"
  taxItems: [CommerceExpTaxItemsResponse]
  """
  Percentage value of tax for the lineItem
  
  
  This field is **deprecated** and will be removed in the future
  """
  taxPercent: Int
  "Percentage value of tax for the lineItem"
  taxPercent2: Float
  "Net payable cost for the line item"
  total: Float
}

