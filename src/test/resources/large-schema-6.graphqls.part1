  "End time for the billing period"
  endTimestamp: Float
  "EntitlementId"
  entitlementId: ID!
  "Whether the billing period is the current billing period of the entitlement"
  isCurrentBillingPeriod: Boolean
  "Whether the pricing plan is eligible for High Watermark Billing"
  isPricingPlanEligibleForHWM: Boolean
  "Start time for the billing period"
  startTimestamp: Float
  "The usage aggregation for the entitlement during the billing period"
  usageAggregations(
    "The input for usage aggregations"
    input: CommerceExpUsageAggregationsInput!
  ): CommerceExpUsageAggregationResponse
}

