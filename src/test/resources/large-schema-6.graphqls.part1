  cardStatus: CardStatus @renamed(from : "status")
  cardType: CardType @renamed(from : "issueType")
  estimate: Float
  issueKey: String!
  issueSummary: String!
}

type BurndownChartDataTableScopeChangeRow {
  cardParent: CardParent @renamed(from : "issueParent")
  cardType: CardType @renamed(from : "issueType")
