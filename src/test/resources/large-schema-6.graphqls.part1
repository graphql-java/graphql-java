"A bundle definition."
type AssetsBundle {
  "Immutable bundle definition version. `null` for the legacy definition."
  bundleVersion: Int
  "List of schema definitions for this bundle's dependencies."
  dependencySchemas: [AssetsCdmSchema!]
  "Globally unique identifier (UUID)."
  id: ID!
  "Name of the bundle."
  name: String!
  "List of Bundle Schema Definitions"
  schemas: [AssetsCdmSchema!]
  "Type of the bundle."
  type: AssetsBundleType!
}

"Details of a bundle instantiation."
type AssetsBundleInstantiation {
  "Persisted version of this bundle instantiation."
  bundleVersion: Int
  "Dependency schemas which are instantiated"
  dependencyInstantiatedSchemas: [AssetsSchema!]
  """
  Unique identifier of this instantiation (UUID).
  `null` when the primary bundle is not instantiated for the workspace; the client
  can still select `dependencyInstantiatedSchemas` to see instantiated dependencies.
  """
  id: ID
  "Schemas actually created by this instantiation."
  instantiatedSchemas: [AssetsSchema!]
}

"""
An object type in the CDM schema: defines a kind of asset and its attributes.
Implements Node for global identification and Relay compatibility.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __write:cmdb-attribute:jira__
"""
type AssetsCdmObjectType implements Node @defaultHydration(batchSize : 25, field : "assets_cdmObjectTypesDefinitions", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : ASSETS, required : [WRITE_CMDB_ATTRIBUTE_JIRA]) {
  "True if this type is abstract (cannot be instantiated directly; only concrete subtypes can)."
  abstractObjectType: Boolean
  "Human readable display name for the object type."
  displayName: String
  "Icon used in the UI for this object type (small and large URLs)."
  icon: AssetsIcon
  "Unique identifier for this CDM object type (ARI). Stable across schema versions when the type identity is unchanged."
  id: ID! @ARI(interpreted : false, owner : "cdm", type : "objecttype", usesActivationId : false)
  "Name of the object type."
  name: String
}

"Relay-style connection for paginated AssetsCdmObjectType results."
type AssetsCdmObjectTypeConnection {
  "Edges in the current page, each wrapping a AssetsCdmObjectType node and a cursor."
  edges: [AssetsCdmObjectTypeEdge!]
  "Standard Relay page info: hasNextPage, hasPreviousPage, startCursor, endCursor."
  pageInfo: PageInfo!
  "Total number of items matching the query (across all pages)."
  totalCount: Int
}

"Single edge in a AssetsCdmObjectType connection (Relay pattern)."
type AssetsCdmObjectTypeEdge {
  "Opaque cursor for this position in the connection. Pass to after/before for adjacent pages."
  cursor: String!
  "The AssetsCdmObjectType for this edge. Null if the node was filtered or is no longer available."
  node: AssetsCdmObjectType
}

"""
Represents the CDM (Common Data Model) contract for assets schema.
A schema defines the structure, object types, references, and statuses available for assets in a given context.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __write:cmdb-attribute:jira__
"""
type AssetsCdmSchema implements Node @defaultHydration(batchSize : 25, field : "assets_cdmSchemasDefinitions", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : ASSETS, required : [WRITE_CMDB_ATTRIBUTE_JIRA]) {
  "Optional description of the CDM Schema."
  description: String
  " Human readable display name for the schema."
  displayName: String
  id: ID! @ARI(interpreted : false, owner : "cdm", type : "schema", usesActivationId : false)
  "Schema key used to reference the schema (e.g. in APIs or config)."
  key: String!
  "Name of the schema."
  name: String!
  """
  Paginated object types defined in this schema.
  These are returned with a flattened object type hierarchy and will contain depth and parent information.
  """
  objectTypes(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int
  ): AssetsCdmObjectTypeConnection
  "Semantic version of the CDM template, for example `v1.0.0`."
  templateVersion: String
}

