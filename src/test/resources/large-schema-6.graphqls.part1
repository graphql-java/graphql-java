  endpointPath: String
  "A relative or absolute URL to the MCP server icon."
  iconUrl: String
  "The ARI of the MCP server."
  id: ID!
  "The server product name."
  name: String!
  "The product ARI associated with the MCP server, if applicable."
  productAri: String
  "The source of the MCP server registration."
  registrationSource: GraphIntegrationMcpAdminManagementMcpRegistrationSource!
  "The type of the MCP server. This can be either SSE or HTTP."
  serverType: GraphIntegrationMcpAdminManagementMcpServerType!
  "Status of the MCP server registration."
  status: GraphIntegrationMcpAdminManagementMcpServerStatus!
  """
