"Paginated response for allInsights."
type AssetsVerticalAllInsightsResponse {
  items: [AssetsVerticalInsightItem!]!
  pageInfo: PageInfo!
  """
  Whether the Get Insights button should be shown for this tenant — mirrors
  `AssetsVerticalInsights.shouldShowGetInsights` so the unified list can gate the CTA from the same
  response. Same backend gate (itam + Rovo + AI + not-CMK); fails closed to `false`.
  """
  shouldShowGetInsights: Boolean
}

