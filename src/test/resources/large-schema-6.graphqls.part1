"""
How a `USER`-scope Rovo Credits block lets the user request more credits, sourced from the
Pre-Flight Credit Check API's `requestMethod`. The FE uses it to render the "Request credits" CTA;
AVS relays the data only and never performs the request action itself.
"""
type AssetsVerticalRovoCreditRequestMethod {
  "How the request is made."
  mode: AssetsVerticalRovoCreditRequestMode!
  """
  For `REDIRECT_URL`, the link the FE opens in a new tab. Null for `EMAIL`, where the FE POSTs to
  the convo-ai credits-requests endpoint instead.
  """
  redirectUrl: String
}

"""
Rovo Credits enforcement state for the calling user on this site.

Sourced from the UBP Enforcement API (allow/block decision) and, when a block occurs, the
Pre-Flight Credit Check API (reset date, scope and request-credits eligibility). Drives the
"out of Rovo Credits" message on the insights page.
"""
type AssetsVerticalRovoCredits {
  """
  Whether this user may start insight generation.
  
  `true` when enforcement allows it, the meter is not onboarded, or the enforcement check fails
  open. `false` only when the Enforcement API returned `allowed=false`.
  """
  allowed: Boolean!
  "Which limit was hit. Null when `allowed` is true."
  blockReason: AssetsVerticalRovoCreditBlockReason
  """
  Whether to show the "Request credits" link in the block message.
  
  `true` only when the user's own allocation is exhausted (`blockReason=USER`) and the
  request-credits flag is on, mirroring Pre-Flight's `canRequestCredits`. Null when `allowed`
  is true; treat null as false.
  
  Prefer `requestMethod` for new clients — this boolean is `true` exactly when `requestMethod`
  is non-null and is retained for back-compat.
  """
  canRequestCredits: Boolean
  """
  How the user may request more credits, for rendering the "Request credits" CTA.
  
  Non-null only for a `USER` block where Pre-Flight offers a request option (equivalent to
  `canRequestCredits == true`). Null when `allowed` is true, for `ORG`/`RESTRICTED` blocks, or
  when no request option is available. AVS only relays this — the FE performs the request action
  against convo-ai.
  """
  requestMethod: AssetsVerticalRovoCreditRequestMethod
  """
  Next credit reset as a UTC calendar date (`yyyy-MM-dd`).
  
  Null when `allowed` is true, when `blockReason` is `RESTRICTED`, when Pre-Flight has no date
  (`resetsAt=null`), or when this user has never used credits in the pool. The FE renders the
  message without a date when this is null.
  """
  resetDate: Date
}

