"""
Outcome of a single item inside an avp_createCharts batch. Exactly one of
`chart` or `errors` is populated:
  - success == true  -> `chart` is set, `errors` is null
  - success == false -> `chart` is null, `errors` describes why this item was
    rejected (validation, env-var-not-supported, persistence failure, ...)
`idempotencyKey` always echoes the value supplied in AVPCreateChartsItemInput.idempotencyKey
so callers can match results to inputs without depending on list order.
"""
type AVPCreateChartsItemResult {
  "The created chart, or null when success == false."
  chart: AVPChart
  "Per-item errors, or null when success == true."
  errors: [MutationError!]
  "Echo of AVPCreateChartsItemInput.idempotencyKey."
  idempotencyKey: String!
  "True iff this item was successfully persisted."
  success: Boolean!
}

"""
Response for avp_createCharts. `results` is in the same order as the input list.
`canvasLayout` reflects the dashboard layout AFTER all successful inserts have
been applied (a single layout write). `success` is true iff every entry in
`results` succeeded; inspect each entry individually otherwise.
"""
type AVPCreateChartsPayload implements Payload {
  """
  The updated canvas layout, with all successfully created charts added.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  canvasLayout: AVPDashboardCanvasLayout
  """
  Top-level errors (e.g. permission denied, dashboard not found, batch-size violation, persistence failure). Per-item validation errors are reported under results[*].errors.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  Per-item results, in input order. One entry per AVPCreateChartsItemInput.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  results: [AVPCreateChartsItemResult!]!
  """
  True iff every item in `results` succeeded.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

