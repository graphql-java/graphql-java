"""
The custom auth input contract for a server with no gallery template, plus any values already known.

Carries the same descriptor shape the template queries return, so one form component serves gallery
registration, custom registration and editing.
"""
type GraphIntegrationMcpAdminManagementCustomAuthContract @apiGroup(name : ACTIONS) @renamed(from : "McpAdminManagementCustomAuthContract") {
  "Whether PKCE is already known to apply. Null until provider metadata discovery is available."
  pkceEnabled: Boolean
  """
  Descriptors for the selected auth type. Because there is no provider template, every field an
  admin must author is present here, and nothing is pinned.
  """
  properties: GraphIntegrationMcpAdminManagementCustomOauthProperties!
  "Scopes already known. Null until provider metadata discovery is available."
  scopes: [String!]
  """
  Values already known for these descriptors, keyed by input key. Empty until provider metadata
  discovery is available, and a form should treat an absent key as an empty field.
  """
  values: [GraphIntegrationMcpAdminManagementAuthConfigValue!]!
}

"Result of fetching the custom auth contract for a server with no gallery template"
type GraphIntegrationMcpAdminManagementCustomAuthContractPayload implements Payload @apiGroup(name : ACTIONS) @renamed(from : "McpAdminManagementCustomAuthContractPayload") {
  "The contract. Only provided if the operation is successful."
  contract: GraphIntegrationMcpAdminManagementCustomAuthContract
  errors: [MutationError!]
  success: Boolean!
}

"Custom OAuth form metadata for a single auth type on an MCP template."
type GraphIntegrationMcpAdminManagementCustomOauthProperties @apiGroup(name : ACTIONS) @renamed(from : "McpAdminManagementCustomOauthProperties") {
  "The auth type these fields apply to."
  authType: GraphIntegrationMcpAdminManagementMcpServerAuthType!
  """
  Platform-owned custom OAuth inputs such as clientId and clientSecret. Never de-duplicated against
  extraInputs: a client credential is issued for this specific connection and can never be satisfied by
  a server URL value.
  """
  platformInputs: [GraphIntegrationCustomAuthInputField!]!
  """
  Provider-owned custom OAuth template inputs such as loginHost or audience, EXCLUDING any key already
  present in the template's extraInputs. A key needed by both the server URL and the auth template is
  therefore returned once, under extraInputs, and must be supplied via registerMcpServer.extraInputs --
  the backend feeds it into the auth template automatically.
  """
  templateInputs: [GraphIntegrationCustomAuthInputField!]!
}

"A selectable option for an OPTIONS type extra input."
type GraphIntegrationMcpAdminManagementExtraInputOption @apiGroup(name : ACTIONS) @renamed(from : "McpAdminManagementExtraInputOption") {
  "The display label shown in the UI."
