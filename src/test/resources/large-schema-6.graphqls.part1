  "Identifies the run for results and rollback."
  runId: ID!
  "What the run was started with: spaces, transformers, native macros and dry run."
  scope: ConfluenceNbmRunScope!
  "When the run was registered, as an RFC 3339 date-time."
  startedAt: String
  "Account ID of the operator who started the run."
  startedBy: String
  "Whether the run is still running, completed, or failed."
  status: ConfluenceNbmRunStatus!
  "Aggregated per-page outcome counts. Zero until the run is terminal."
  summary: ConfluenceNbmRunSummary!
