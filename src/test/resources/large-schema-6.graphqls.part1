  "Explanation of why this evidence relates to the hypothesis, as a stringified ADF document."
  summary: String
  "Category of evidence; drives the icon/appearance shown in the UI."
  type: AIOpsHypothesisEvidenceType
  "External URL the evidence links to."
  url: String
}

