"""


### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __confluence:atlassian-external__
* __read:database:confluence__
* __read:confluence:twg-cli__
"""
type ConfluenceDatabase implements Node @defaultHydration(batchSize : 50, field : "confluence.databases", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : CONFLUENCE, required : [CONFLUENCE_ATLASSIAN_EXTERNAL]) @scopes(product : CONFLUENCE, required : [READ_CONFLUENCE_DATABASE]) @scopes(product : NO_GRANT_CHECKS, required : [READ_CONFLUENCE_TWG_CLI]) {
  "Ancestors of the Database, of all types."
  allAncestors: [ConfluenceAncestor]
  "Original User who authored the Database."
  author: ConfluenceUserInfo
  commentCountSummary: ConfluenceCommentCountSummary
  "Content ID of the Database."
  databaseId: ID!
  "ARI of the Database, ConfluenceDatabaseARI format."
  id: ID! @ARI(interpreted : false, owner : "confluence", type : "database", usesActivationId : false)
  "Latest Version of the Database."
  latestVersion: ConfluenceContentVersion
  "Links associated with the Database."
  links: ConfluenceDatabaseLinks
  "Current explicitly referenced accounts, capped at 400. isTruncated indicates incomplete results."
  mentionedAccounts(after: String, first: Int = 400): ConfluenceDatabaseMentionConnection
  "The owner of the Database."
  owner: ConfluenceUserInfo
  "Space that contains the Database."
  space: ConfluenceSpace
  "Status of the Database."
  status: ConfluenceContentStatus
  "Title of the Database."
  title: String
  "Content type of the Database. Will always be \\\"DATABASE\\\"."
  type: ConfluenceContentType
  "Summary of viewer-related fields for the Database."
  viewer: ConfluenceContentViewerSummary
}

type ConfluenceDatabaseLinks @apiGroup(name : CONFLUENCE) {
  "The base URL of the site."
  base: String
  "The web UI URL path associated with the Database."
  webUi: String
}

type ConfluenceDatabaseMention @apiGroup(name : CONFLUENCE) {
  "Atlassian account ID referenced in a database cell."
  accountId: String!
  "Database cells containing references to this account."
  locations: [ConfluenceDatabaseMentionLocation]
}

"Current database mention references, deduplicated by account within a bounded snapshot."
type ConfluenceDatabaseMentionConnection @apiGroup(name : CONFLUENCE) {
  "Mention accounts and their pagination cursors."
  edges: [ConfluenceDatabaseMentionEdge]
  "True when scan or result limits prevented returning all mentions."
  isTruncated: Boolean!
  "Accounts explicitly referenced in the scanned database entries."
  nodes: [ConfluenceDatabaseMention]
  "Pagination within the bounded mention results."
  pageInfo: ConfluencePageInfo!
}

type ConfluenceDatabaseMentionEdge @apiGroup(name : CONFLUENCE) {
  "Opaque pagination cursor for this account."
  cursor: String!
  "The mentioned account."
  node: ConfluenceDatabaseMention
}

type ConfluenceDatabaseMentionLocation @apiGroup(name : CONFLUENCE) {
  "Database entry containing the reference."
  entryId: String!
  "Database field containing the reference."
  fieldId: String!
  "ADF local ID when available; absent for user-reference cells."
  localId: String
}

