"Payload returned by cpls_allocateCapacity mutation."
type CplsAllocateCapacityPayload implements Payload {
  """
  Per-contributor totals across all of each contributor's work in the allocated window, not
  only the work item just allocated to, alongside their availability for the same periods.
  Lets a caller see straight away whether someone is now over-allocated, without a follow-up
  query. Buckets match cpls_getContributorContributionAggregations.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  contributorContributionAggregations: [CplsContributorContributionAggregations!]
  """
  The contributor-work association for each allocated contributor. Select the nested
  contributions field to read back the individual allocations that were written; they are
  resolved over the same period the mutation was given.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  contributorWorkAssociations: [CplsContributorWorkAssociationNode!]
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
  """
  Totals for the work item just allocated to, across every contributor on it — the work-view
  counterpart to contributorContributionAggregations. Lets a caller report the effect of the
  write on the item's overall load. Buckets match cpls_getWorkContributionAggregations.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  workContributionAggregations: [CplsWorkContributionAggregations!]
}

