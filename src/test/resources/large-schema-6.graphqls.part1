"""
Actions are generated whenever an action occurs in Trello. For instance, when a user deletes a card, a
`deleteCard` action is generated and includes information about the deleted card.
"""
interface TrelloAction {
  "The agentic identity that caused the Action, if any. Null otherwise."
  agenticIdentity: TrelloAgenticIdentity
  "The app that caused the Action"
  appCreator: TrelloAppCreator
  "The Member who caused the Action"
  creator: TrelloMember
  "When the Action occurred"
  date: DateTime
  "Relevant information for displaying the Action"
  displayKey: String
  "The ID of the Action"
  id: ID!
  "Any limits affected by the action"
  limits: TrelloActionLimits
  "The legacy Trello object ID of the Action"
  objectId: ID!
  "The Reactions on the Action"
  reactions: [TrelloReaction!]
  "Information about deleted reactions"
  reactionsDeleted: [TrelloReactionDeleted!]
  "The type of the Action, from Trello Server.  May not match action __typename"
  type: String
}

"A Trello Base Board"
interface TrelloBaseBoard {
  """
  Actions (activity history) on this board, including card moves, comments,
  member changes, and other events.
  """
  actions(
    """
    The pointer to a place in the actions dataset (cursor). It's used as the
    starting point for the next page. If not specified, the page will start
    from the very beginning of the dataset.
    """
    after: String,
    "Number of actions to retrieve after the given \"after\" cursor."
    first: Int = 50,
    "Type of actions to filter by. Defaults to all card action types."
    type: [TrelloCardActionType!]
  ): TrelloCardActionConnection
  "AI metadata for the board"
  aiMetadata: TrelloObjectAiMetadata
  "The board's enterprise"
  enterprise: TrelloEnterprise
  "True if the board is owned by an enterprise. False otherwise."
  enterpriseOwned: Boolean!
  "The board's primary identifier."
  id: ID!
  "The labels on the board."
  labels(
    """
    The pointer to a place in the labels dataset (cursor). It's used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    "Number of labels to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloLabelConnection
  """
  Last time a change was made to the board. Note: this can be null when board
  is first created.
  """
  lastActivityAt: DateTime
  "Limits for this board"
  limits: TrelloBoardLimits
  "Lists on the board. Note: this returns null when selected in mutation payload responses"
  lists(
    """
    The pointer to a place in the dataset (cursor). It’s used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    "Applies filters the list items"
    filter: TrelloListFilterInput = {closed : false},
    "Number of items to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloListConnection
  "Id used for (legacy) interaction with the REST API."
  objectId: ID!
  """
  Cards on this board that have associated planner events in the future.
  WARNING: Calls third-party calendar APIs. Do not use in critical paths.
  
  Events are grouped by card (multiple events for the same card appear together).
  The "first" argument limits the number of events fetched, NOT the number of cards returned.
  Due to grouping, fewer cards may be returned than the "first" value.
  pageInfo.hasNextPage should be respected regardless of result count.
  """
  plannerEventCards(
    """
    The pointer to a place in the dataset (cursor). It's used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    "Number of events to fetch (not cards). Due to grouping, fewer cards may be returned."
    first: Int = 20
  ): TrelloPlannerEventCardConnection
  "Preferences for the board."
  prefs: TrelloBaseBoardPrefs!
  "The workspace this board belongs to."
  workspace: TrelloWorkspace
}

"Identifiers of a Trello board or inbox"
interface TrelloBaseBoardId {
  "The ID of the board or inbox"
  id: ID!
  "The object ID of the board or inbox"
  objectId: ID!
}

"Common preferences for board and inbox."
interface TrelloBaseBoardPrefs {
  "Attributes relating to the board background."
  background: TrelloBoardBackground
}

"TrelloBaseBoard update subscription."
interface TrelloBaseBoardUpdated {
  "Delta information for this event"
  _deltas: [String!]
  "The board's enterprise. Only includes id and object id."
  enterprise: TrelloEnterprise
  "Board ARI"
  id: ID
  "The new or updated labels on the board."
  labels: TrelloLabelConnectionUpdated
  "Lists for the board. Null on subscribe for full board subscriptions. Returns a connection for specific card subscriptions."
  lists: TrelloListUpdatedConnection
  "Board's objectId"
  objectId: ID
  "Deleted labels"
  onLabelDeleted: [TrelloLabelDeleted!]
  "Deleted planner event-card associations."
  onPlannerEventCardsDeleted: [TrelloPlannerEventCardDeleted!]
  """
  Cards with planner event associations.
  Only populated in planner event card subscription updates (onMemberPlannerEventCardsUpdated).
  Data originates from third-party calendar providers.
  """
  plannerEventCards: TrelloCardUpdatedConnection
  "ID of the board's new workspace"
  workspace: TrelloBoardWorkspaceUpdated
}

"A base card type, which is used for both Trello cards and inbox cards."
interface TrelloBaseCard {
  "Actions taken on this card (comment, add/remove members, etc)"
  actions(
    """
    The pointer to a place in the actions dataset (cursor). It's used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    "Number of actions to retrieve after the given \"after\" cursor."
    first: Int = 50,
    "Type of actions to retrieve.  Defaults to all card actions"
    type: [TrelloCardActionType!]
  ): TrelloCardActionConnection
  """
  Live agentic activities currently working on this card. Entity-scoped
  (board-visible). High-level status only.
  """
  agenticActivities(
    "The pointer to a place in the activities dataset (cursor)."
    after: String,
    "Number of activities to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloAgenticActivityConnection
  "AI metadata for the card"
  aiMetadata: TrelloObjectAiMetadata
  "Read-only progress for operations on this card; null when progress is unavailable."
  aiProgress(
    "Opaque cursor from the previous page. Omit for the first page."
    after: String,
    "Maximum operations to return, from 1 to 100. Defaults to 10."
    first: Int = 10
  ): TrelloAiProgressConnection
  "The attachments on the card."
  attachments(
    """
    The pointer to a place in the attachments dataset (cursor).
    It's used as the starting point for the next page.
    If not specified, the page will start from the very beginning of the dataset.
    """
    after: String,
    "Number of attachments to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloAttachmentConnection
  "Badges for a card"
  badges: TrelloCardBadges
  "The checklists on the card."
  checklists(
    """
    The pointer to a place in the checklists dataset (cursor). It's used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    """
    Checklist id to filter by
    If provided, only the checklist with this id will be returned.
    If checklist is not found, an empty list will be returned.
    This is helpful for paginating the checklist's check items.
    Note: All other arguments will be ignored.
    """
    checklistId: ID,
    "Number of checklists to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloChecklistConnection
  "True if the card has been closed. False otherwise."
  closed: Boolean
  "Whether the card has been marked complete."
  complete: Boolean
  "The card cover"
  cover: TrelloCardCover
  "Details about the creation of the card"
  creation: TrelloCardCreationInfo
  "The datetime when the card was closed."
  dateClosed: DateTime
  "The date when the card was last viewed by its creator"
  dateViewedByCreator: DateTime
  "The card's description."
  description: TrelloUserGeneratedText
  "The due date for the card."
  due: TrelloCardDueInfo
  "The card's primary identifier"
  id: ID!
  "The labels on the card."
  labels(
    """
    The pointer to a place in the labels dataset (cursor). It's used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    "Number of labels to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloLabelConnection
  """
  Last time a change was made to the card. Note: this can be null when card
  is first created.
  """
  lastActivityAt: DateTime
  "The latest tracked change to content used in a card summary."
  lastSummaryChangeEventAt: DateTime
  "Limits for this card"
  limits: TrelloCardLimits
  "The list this card belongs to."
  list: TrelloList
  """
  The manifest associated with this card.
  Only present when the card has the corresponding MANIFEST role.
  """
  manifest: TrelloCardManifest
  "The card's name."
  name: String
  "Id used for (legacy) interaction with the REST API."
  objectId: ID!
  "The original description of the card before any AI-generated modifications"
  originalDesc: TrelloUserGeneratedText
  "The original name of the card before any AI-generated modifications"
  originalName: TrelloUserGeneratedText
  "Whether or not the card is pinned to the list"
  pinned: Boolean
  """
  Planner events associated with this card.
  WARNING: Calls third-party calendar APIs. Do not use in critical paths.
  
  When queried via board.plannerEventCards: Pagination args are ignored.
  All events for the card (within the current board page) are returned.
  When queried directly on a card: Pagination args (first, after, filter) are respected.
  """
  plannerEvents(
    "Pagination cursor. Ignored when queried via board.plannerEventCards."
    after: String,
    """
    Time filter for events.
    FUTURE: Only upcoming events (default)
    ALL: Past and future events
    """
    filter: TrelloPlannerEventTimeFilter,
    "Number of events to retrieve. Ignored when queried via board.plannerEventCards."
    first: Int = 20
  ): TrelloPlannerEventConnection
  "The position of the card in the list."
  position: Float
  """
  AI-generated recommendations for this card. Empty when the caller cannot
  read the card, the recommendation engine or workspace AI is disabled, or
  the caller cannot create a board in the card's workspace.
  """
  recommendations(
    "The pointer to a place in the recommendations dataset (cursor)."
    after: String,
    "Number of recommendations to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloRecommendationConnection
  "Recurrence rule for the card's due date, if set. Null otherwise."
  recurrenceRule: String
  "The role of the card (if any)."
  role: TrelloCardRole
  "The card's unique shortened link id (not a complete URL)."
  shortLink: TrelloShortLink
  "The URL to the card without the name slug"
  shortUrl: URL
  "The single instrumentation id for the card."
  singleInstrumentationId: String
  "The time the card was started."
  startedAt: DateTime
  "Url of the card"
  url: URL
}

"Information about a deleted card"
interface TrelloBaseCardDeleted {
  """
  The ID of the deleted card
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID!
  """
  The object ID of the deleted card
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  objectId: ID!
}

"Information about a card that has moved to a new board."
interface TrelloBaseCardMoved {
  """
  The ID of the moved card. Note: the ID may have changed if the card was moved to a new workspace.
  The card objectId will be stable between board and workspace moves.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID!
  """
  The new list of the card
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  list: TrelloListContainer
  """
  The object ID of the moved card. Will not change between board and workspace moves.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  objectId: ID!
  """
  The list the card was in before the move
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  previousList: TrelloPreviousList
}

"Interface for the updated card fields within a TrelloBoardUpdated event."
interface TrelloBaseCardUpdated {
  """
  Actions taken on this card
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  actions: TrelloCardActionConnectionUpdated
  """
  Live agentic activities on this card, delivered over onBoardUpdated
  (board-visible, high-level only).
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  agenticActivities: TrelloAgenticActivityConnectionUpdated
  """
  AI metadata for the card
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  aiMetadata: TrelloObjectAiMetadataUpdated
  """
  Operations to merge into the cached connection by node ID.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  aiProgress: TrelloAiProgressConnectionUpdated
  """
  The attachments on the card
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  attachments: TrelloAttachmentConnectionUpdated
  """
  Badges for a card
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  badges: TrelloCardBadges
  """
  The checklists on the card
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  checklists: TrelloChecklistConnectionUpdated
  """
  True if the card has been closed. False otherwise.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  closed: Boolean
  """
  Whether the card has been marked complete.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  complete: Boolean
  """
  The card cover
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  cover: TrelloCardCoverUpdated
  """
  Information about the card's creation.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
