"An Admin scope that can be granted to an OAuth 2LO client credential."
type AdminOAuthScope {
  """
  The kind of access the scope grants - `delete:accounts:admin` is `DELETE`. Exposed as a typed
  value so that clients can render and group by action without parsing scope strings. Null when
  the scope's action is not one of the known values, so a scope added upstream with a new action
  renders as an empty action rather than failing the query.
  """
  action: AdminOAuthScopeAction
  "Longer explanation of what the scope permits, for secondary display such as a tooltip."
  description: String
  """
  The scope string, e.g. `read:groups:admin`. This is the value passed in
  `AdminCreateOAuthClientInput.scopes` and returned in `AdminOAuthClient.scopes`, so it is the
  key clients should join on.
  """
  id: ID!
}

"A page of Admin scopes from the catalogue, following the Relay connection pattern."
type AdminOAuthScopeConnection {
  "The scopes in this page, each wrapped with its pagination cursor."
  edges: [AdminOAuthScopeEdge!]
  "Cursors and flags for fetching the pages either side of this one."
  pageInfo: PageInfo!
  """
  Total number of scopes matching `filter`, ignoring pagination. Null when the count is
  unavailable.
  """
  totalCount: Int
}

"A single Admin scope together with its position in the catalogue."
type AdminOAuthScopeEdge {
  """
  Opaque cursor marking this scope's position. Pass it as `after` or `before` to page from
  here. The cursor encodes a position within the ordered result rather than a property of the
  scope itself, so it is only valid when replayed with the same `filter` and `sortBy` that
  produced it.
  """
  cursor: String!
  "The scope at this position."
  node: AdminOAuthScope!
}

