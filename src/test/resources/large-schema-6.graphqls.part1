  "Machine-readable failure code. Set only when status=FAILED."
  errorCode: String
  "Human-readable failure detail. Set only when status=FAILED."
  errorMessage: String
  "Current job status. Poll until COMPLETED or FAILED."
  status: AiCoreApiRsaJobStatus!
}

