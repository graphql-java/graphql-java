"A curated MCP server template returned for a given surface. Generic and not site-scoped: it carries no per-site installation state."
type GraphIntegrationMcpAdminManagementSurfaceMcpServerTemplateNode @apiGroup(name : ACTIONS) @renamed(from : "McpAdminManagementSurfaceMcpServerTemplateNode") {
  """
  The authentication mechanism the gallery frontend should use for this server. Lets the frontend
  render the correct connect UI (e.g. hide all auth/consent options when NONE). Defaults to OAUTH
  for servers that do not declare an authType.
  
  Deprecated in favour of supportedAuthTypes, which can express a server that offers more than one
  mechanism. This field returns the first entry of supportedAuthTypes.
  """
  authType: GraphIntegrationMcpAdminManagementMcpServerAuthType!
  "Custom OAuth form metadata grouped by auth type. Used by the UI to render custom OAuth registration forms without hardcoding provider-specific fields."
  customOauthProperties: [GraphIntegrationMcpAdminManagementCustomOauthProperties!]!
  "A description of the curated MCP server."
  description: String
  "The name of the curated MCP server."
  displayName: String!
  "The tools surfaced for this MCP server template for the requested surface."
  displayTools: [GraphIntegrationMcpAdminManagementSurfaceMcpServerToolNode!]!
  "An URL to the documentation of the MCP server."
  documentationUrl: String
  "Extra input fields required from the user to construct the final server URL. When present, the serverUrl contains placeholders (e.g. {{tenantId}}) that must be replaced with user-provided values before registration."
  extraInputs: [GraphIntegrationMcpAdminManagementMcpServerExtraInput!]!
  "The key of the MCP server icon."
  iconKey: String
  "A relative or absolute URL to the MCP server icon."
  iconUrl: String
  "An absolute URL to the MCP server. May contain template placeholders (e.g. {{tenantId}}) when extraInputs are defined."
  serverUrl: String!
  """
  Every authentication mechanism this server supports, in the order they should be offered in the
  connect UI. A server may support more than one (e.g. GitHub offers both OAUTH and API_TOKEN), in
  which case the frontend must let the admin choose and send the matching authConfig variant in
  registerMcpServer. Never empty; defaults to [OAUTH] for servers that do not declare any.
  """
  supportedAuthTypes: [GraphIntegrationMcpAdminManagementMcpServerAuthType!]!
  "The ID for this curated MCP server template."
  templateId: String!
}

