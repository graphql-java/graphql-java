"One design token authored content can use."
type ArtifactDesignToken {
  "The token's CSS custom property name, such as `--ds-surface`."
  name: String!
  "How to reference it in CSS, such as `var(--ds-surface)`."
  use: String!
  """
  The values the token takes. A themed token reports light then dark; the rest
  report a single value.
  
  A value that is structured rather than a single CSS value is reported as
  JSON, such as a motion token's
  `{"duration":150,"curve":"cubic-bezier(0.4, 1, 0.6, 1)",...}`. Which tokens
  do that is a property of the token and not of its family:
  `--ds-avatar-enter` reports JSON where `--ds-duration-instant` reports `0ms`.
  """
  values: [String!]!
}

"One thing an authoring check noticed about the HTML it was given."
type ArtifactLintFinding {
  "What the check noticed."
  describe: String!
  "What to do about it."
  fix: String!
  "The offending text, where the check could point at one."
  found: String
  "Line of the submitted HTML the finding is on, counting from 1."
  line: Int!
  "Identifier of the check that reported this, such as `no-page-background`."
  rule: String!
}

"Details about the grant of access to an artifact."
type ArtifactShare {
  "The artifact this grant is on."
  artifactId: ID!
  "Who the artifact was shared with - a user, group, or team - as an ARI."
  audienceAri: ID!
  "When the share was granted, as an ISO-8601 timestamp."
  grantedAt: DateTime!
  id: ID!
  "Who owns the artifact, as an ARI."
  ownerAri: ID!
  "Who granted the share, as an ARI. Not always the owner."
  sharedByAri: ID!
}

