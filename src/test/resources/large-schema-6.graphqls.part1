  "Date and time of rollout initiation"
  createdAt: DateTime!
  "User account ID which initiated the rollout"
  createdByAccountId: String!
  "Identifier for the app version rollout"
  id: ID!
  "Progress of rollout"
  progress: AppVersionRolloutProgress!
  "Identifier for the version being upgraded from"
  sourceVersionId: ID!
  "Status of rollout"
  status: AppVersionRolloutStatus!
  "Identifier for the version being upgraded to"
  targetVersionId: ID!
  "The upgrade limit that was applied to this rollout (if any)"
