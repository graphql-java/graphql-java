"""
Response payload for the createDraftedRoutingTable mutation.
Contains merged (existing + newly-inserted) DraftedRoutingTableEntry rows for the requested page,
along with pagination info and count of newly-inserted rows. Also returns the BE-minted draft
session UUID — see `draftId` below.
"""
type AgentWorkspaceCreateDraftedRoutingTableEntriesPayload {
  """
  BE-minted draft session UUID. FE persists this for the lifetime of the wizard session and echoes it back on every subsequent drafted-routing-table mutation/query.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  draftId: ID!
  """
  Optional id of a routing-table generation job associated with this draft. Currently always
  null — reserved for a future flow where the BE auto-starts (or correlates) a generation job
  as part of materialising the draft skeleton. FE should poll
  `agentWorkspace_routingTableGenerationStatus(generationId)` when non-null.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  generationId: ID
  """
  Pagination info; loop until hasNextPage = false
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  pageInfo: AgentWorkspacePageInfo!
  """
  Merged rows: existing + newly-inserted blanks for this page
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  rows: [AgentWorkspaceDraftedRoutingTableEntry!]!
  """
  How many blank rows were newly persisted in this call
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  rowsInserted: Int!
}

