  workaroundForSessionCardDuplicateSubscriptions: String @stubbed
}

"Message sent when an agent session encounters an error during execution."
type ConvoAiErrorMessage implements ConvoAiAgentMessage {
  """
  Initial characters of the error message, truncated to a predefined string limit
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  contentSummary: String
  """
  Typed reason for the failure, when the client can explain it more specifically than a generic error
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  failureReason: ConvoAiAgentSessionFailureReason
  """
  ID of the assistant message for the failed round
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  messageId: String
  """
  The template type of the error message
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  messageTemplate: ConvoAiErrorMessageTemplate!
  """
  Earliest time the user should retry, when known
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  retryAt: DateTime
  """
  Status code associated with the error
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  statusCode: Int!
  """
  Timestamp when this message was created
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  timeCreated: DateTime!
}

