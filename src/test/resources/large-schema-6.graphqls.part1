"""
A user-authored ("custom") dashboard template stored in ERS.

Distinct from `AVPDashboardTemplate`, which represents the curated, Atlassian-shipped gallery. The
template body itself is not returned here — it lives in the TDP object store and is referenced by
`templateJsonId`.
"""
type AVPCustomTemplate {
  """
  Identity account ARI of the author, derived from `creatorAaid`. Exists so AGG can hydrate the
  author's profile — prefer `creatorHydrated` for display and use this only when you need the raw ARI.
  """
  creator: String
  "Atlassian account id of the author. Immutable after create; ownership is decided on this field."
  creatorAaid: String!
  "The hydrated author profile (name, picture). Resolved by AGG from `creator`."
  creatorHydrated: User @idHydrated(idField : "creator", identifiedBy : null)
  "The dashboard this template was published from."
  dashboardId: ID!
  "Which data source the template's charts read from. Used as the gallery filter."
  datasourceType: AVPTemplateDatasourceType!
  "Description of the template, as entered by the author."
  description: String!
  "Unique identifier of the custom template."
  id: ID!
  "Epoch millis at which the template was published, as a string (exceeds the 32-bit Int range)."
  publishedAt: String
  "Identifier of the exported template body in the object store."
  templateJsonId: ID!
  "The static thumbnail image the author picked for the template card."
  thumbnail: AVPTemplateThumbnail!
  "How many dashboards have been created from this template."
  timesUsed: Int
  "Title of the template, as entered by the author."
  title: String!
  "Identity account ARI of whoever last updated the template, derived from `updatedByAaid`."
  updatedBy: String
  "Atlassian account id of whoever last updated the template. Equals creatorAaid on create."
  updatedByAaid: String
  "The hydrated profile of whoever last updated the template. Resolved by AGG from `updatedBy`."
  updatedByHydrated: User @idHydrated(idField : "updatedBy", identifiedBy : null)
  "Optimistic-locking version of the metadata row."
  version: Int
}

"A Relay connection for paginated custom-template results."
type AVPCustomTemplateConnection implements HasPageInfo {
  "The edges in the current page of custom-template results."
  edges: [AVPCustomTemplateEdge!]!
  "Pagination metadata for the current result set."
  pageInfo: PageInfo!
}

"An edge in a custom-template connection."
type AVPCustomTemplateEdge {
  "An opaque cursor for this template in the current connection."
  cursor: String!
  "The custom template for this edge."
  node: AVPCustomTemplate
}

"""


### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
* __read:dashboard:jira__
"""
type AVPDashboard implements Node @defaultHydration(batchSize : 100, field : "avp_getDashboardsByAris", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ]) {
  """
  The level of access the user has for the dashboard.
  0- none
  1- view
  2- edit/write
  3- admin/manage
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  access: Int @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  category: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  charts: [AVPChart!] @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  Todo: figure out date types
  Todo: figure out date types
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  createdAt: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  Account ARI of user who created the dashboard
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  creator: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  "Hydrated user who created the dashboard"
  creatorHydrated: User @idHydrated(idField : "creator", identifiedBy : null)
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  description: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  List of env vars on the dashboard, e.g. associated with a dashboard-level filter
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  envVars: [AVPEnvVar!] @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  Filter expression tree for the dashboard
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  filterExpression: AVPFilterExpression @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  The name of the template that the dashboard was created from
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  fromTemplate: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  id: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  """
  The AVP integration that owns this dashboard.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  integrationId: AVPIntegrationId @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  isReadOnly: Boolean @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  Whether the current user has starred this dashboard. Null when that is unknown rather than false: there is no authenticated user, or the field was not resolved for this request.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  isStarred: Boolean @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  Whether this dashboard is a wrapper for a standalone chart
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AVP-standalone-charts")' query directive to the 'isWrapper' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  isWrapper: Boolean @lifecycle(allowThirdParties : false, name : "AVP-standalone-charts", stage : EXPERIMENTAL) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
    The id of the custom template this dashboard has been published as, or null if it has not been
    published. A dashboard backs at most one custom template, so this is the whole "is it published?"
    check — present means published.
  
  Resolved lazily as part of the dashboard read, so selecting it costs one extra ERS lookup and
    omitting it costs nothing.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  publishedTemplateId: ID @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  settings: AVPDashboardSettings @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  status: AVPDashboardStatus @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  The version of the template that the dashboard was created from
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  templateVersion: Int @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  title: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  trashedAt: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  The layout type of the dashboard. SIMPLE for canvas layout dashboards, ADVANCED for grid layout dashboards, ie legacy AA dashboards.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  type: AVPDashboardType @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  updatedAt: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  Deep-link URL to the dashboard. Uses the v2 path (/analytics/dashboard/v2/{id}) for platform dashboards in atlassian-analytics-free workspaces.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  url: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
}

"Opinionated dashboard layout configuration"
type AVPDashboardCanvasLayout {
  "Chart IDs of dashboard controls/filters"
  controlIds: [String!]
  rows: [AVPDashboardCanvasLayoutRow!]
  """
  does this actually increment?  always seems to be 1 in sandpit
  does this actually increment?  always seems to be 1 in sandpit
  """
  version: Int
}

type AVPDashboardCanvasLayoutElement {
  id: ID
  item: AVPDashboardCanvasLayoutItem
  "size of element based on 12 column grid"
  span: Int
}

type AVPDashboardCanvasLayoutItem {
  """
  A chart ID.
  Maybe used for lookup of chart meta data (e.g. min width)
  or to retrieve chart element from a registry.
  """
  id: ID
  templateChartId: String
}

type AVPDashboardCanvasLayoutRow {
  elements: [AVPDashboardCanvasLayoutElement!]
  "Height setting for the row"
  height: AVPCanvasRowHeight
  id: ID
}

"The canvas layout after a row or element change."
type AVPDashboardCanvasLayoutUpdated {
  canvasLayout: AVPDashboardCanvasLayout!
}

"A chart was created and the resulting canvas layout was persisted."
type AVPDashboardChartCreated {
  canvasLayout: AVPDashboardCanvasLayout!
  chart: AVPChart!
}

"A chart was deleted and the resulting canvas layout was persisted."
type AVPDashboardChartDeleted {
  canvasLayout: AVPDashboardCanvasLayout!
  chartId: ID!
}

"A chart was updated."
type AVPDashboardChartUpdated {
  chart: AVPChart!
}

"""
Comment counts for a dashboard and its charts, for the calling user. Charts count only the comments in
their unresolved threads.
"""
type AVPDashboardCommentCounts {
  """
  Counts for each chart with at least one comment in an unresolved thread. Charts without such comments
  are omitted, so a chart missing from the list has no open comments, unless `truncated` is true.
  """
  charts: [AVPChartCommentCounts!]!
  """
  Whether the dashboard has more unresolved chart threads than were counted. Only the 25 most recently
  created unresolved chart threads are counted. When this is true, charts whose unresolved threads are
  all older are missing from `charts`, and the other charts' counts may be low.
  """
  truncated: Boolean!
  """
  Number of comments in the dashboard-level thread that the calling user has not seen, excluding
  comments the caller authored. These are the comments created after the user's `lastSeen`, or every
  comment when the user has no read state for the thread. 0 when the dashboard has no thread yet. At
  most 1000 comments are counted.
  """
  unreadCommentCount: Int!
}

"A Relay edge containing a dashboard node and its pagination cursor."
type AVPDashboardEdge {
  "An opaque cursor for this dashboard in the current connection."
  cursor: String!
  "The dashboard node for this edge."
  node: AVPDashboard
}

"Details about a failed user access update."
type AVPDashboardFailedUserAccess {
  "Description of what went wrong"
  errorMessage: String!
  "The user whose access update failed"
  user: AVPDashboardUserAccessResult!
}

"The complete filter-expression tree after an update. Null means it was removed."
type AVPDashboardFilterExpressionUpdated {
  filterExpression: AVPFilterExpression
}

"""
The identity access state for a dashboard: a single list of users and groups
that have access, each with one access level (their maximum: READ, WRITE, or MANAGE).
Mirrors the shape of `AVPPermissionsDashboardIdentityAccess` so Relay clients can
merge query reads with mutation responses on this dashboards-service-owned type.
"""
type AVPDashboardIdentityAccess {
  "The ARI of the dashboard"
  dashboardId: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Groups with their current access details (each principal appears once with max level)"
  groups: [AVPDashboardIdentityGroupAccess!]!
  "Users with their current access details (each principal appears once with max level)"
  users: [AVPDashboardIdentityUserAccess!]!
}

"""
A group with its current access level on a dashboard.
Mirrors the shape of `AVPPermissionsGroupAccess`. Group identity details (name)
are hydrated by AGG via the `IdentityGroup` type's default hydration on `principalId`.
"""
type AVPDashboardIdentityGroupAccess {
  "The current access level for this group (READ, WRITE, or MANAGE)"
  accessLevel: AVPDashboardIdentityAccessLevel!
  "The group identity details (name)"
  group: IdentityGroup @idHydrated(idField : "principalId", identifiedBy : null)
  "The ARI of the group (e.g. ari:cloud:identity::scoped-group/<uuid>)"
  principalId: ID! @ARI(interpreted : false, owner : "identity", type : "scoped-group", usesActivationId : false)
}

"""
A user with their current access level on a dashboard.
Mirrors the shape of `AVPPermissionsUserAccess`. Identity details (name, picture)
are hydrated by AGG via the `User` type's default `@idHydrated` directive on
`principalId`. Email is excluded until AVP-23762.
"""
type AVPDashboardIdentityUserAccess {
  "The current access level for this user (READ, WRITE, or MANAGE)"
  accessLevel: AVPDashboardIdentityAccessLevel!
  "The ARI of the user (e.g. ari:cloud:identity::user/<uuid>)"
  principalId: ID! @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  "The user identity details (name, picture; email deferred to AVP-23762)"
  user: User @idHydrated(idField : "principalId", identifiedBy : null)
}

"The dashboard metadata after an update."
type AVPDashboardMetadataUpdated {
  dashboard: AVPDashboard
}

"""
The resource-level (open-access) permission record for a dashboard.
Returns null if no record exists for the dashboard.
"""
type AVPDashboardResourcePermission {
  "The container ARI for container-inherited permissions (e.g. a Jira project ARI)"
  containerId: ID
  "The ARI of the dashboard"
  dashboardId: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "The integration ID associated with this dashboard"
  integrationId: String
  "The open-access permission level for the dashboard"
  permissionType: AVPDashboardPermissionType
}

"""
TODO: determine if any of these settings are only applicable to either platform dashboards or AA dashboards, and note this in the doc
TODO: determine if any of these settings are only applicable to either platform dashboards or AA dashboards, and note this in the doc
"""
type AVPDashboardSettings {
  """
  If true, convert dates and times to viewer's local time zone
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  allowTzOverride: Boolean @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  If true, show UI elements allowing the user to refresh one or more charts
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  allowViewerRefresh: Boolean @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  If true, automatically update dashboard when a control's value changes
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  autoApplyVars: Boolean @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  Chart data refresh interval, in seconds
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  autoRefreshInterval: Int @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  How long dashboard data should be considered up to date, in seconds
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  cacheDuration: Int @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  Layout configuration of the dashboard
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  canvasLayout: AVPDashboardCanvasLayout @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  Per-source global config (e.g. Ops business hours/days) applied to the dashboard's metrics
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AVPProductSettings")' query directive to the 'productSettings' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  productSettings: AVPProductSettings @lifecycle(allowThirdParties : false, name : "AVPProductSettings", stage : EXPERIMENTAL) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  Method of refreshing dashboard data automatically
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  refreshMethod: AVPRefreshMethod @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  If true, users can create email subscriptions for this dashboard
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  subscriptionsEnabled: Boolean @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  """
  The configured timezone of the dashboard
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  timezone: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
}

"Dashboard template representing a dashboard template information"
type AVPDashboardTemplate {
  "Description of the template functionality"
  description: String
  "Unique identifier of the template"
  id: String!
  "The latest template version visible to the calling tenant; `null` when unavailable."
  latestTemplateVersion: Int
  "List of product schemas required for this template"
  products: [String!]!
  """
  Optional API path (containing a ${workspaceId} placeholder) the client can call to prefetch template-detail placeholder replacements when a user hovers over the template card.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AVPTemplatePlaceholderApiPath")' query directive to the 'templatePlaceholderReplacementsApiPath' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  templatePlaceholderReplacementsApiPath: String @lifecycle(allowThirdParties : false, name : "AVPTemplatePlaceholderApiPath", stage : EXPERIMENTAL)
  "Thumbnail image URL for the template"
  thumbnailUrl: String
  "Title/name of the template"
  title: String!
}

type AVPDashboardUpdateEvent {
  """
  The committed dashboard change. This is null for updates which do not have a more specific change payload.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  change: AVPDashboardUpdateChange
  """
  The ARI of the dashboard whose persisted state changed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  """
  Whether the dashboard update succeeded.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

"Result for a single user's identity access update."
type AVPDashboardUserAccessResult {
  "The access level that was set"
  accessLevel: AVPDashboardIdentityAccessLevel!
  "The ARI of the user (e.g. ari:cloud:identity::user/<uuid>)"
  principalAri: ID! @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
}

"A Relay connection for paginated dashboard results."
type AVPDashboardsConnection implements HasPageInfo {
  "The edges in the current page of dashboard results."
  edges: [AVPDashboardEdge!]!
  "Pagination metadata for the current result set."
  pageInfo: PageInfo!
}

type AVPDatasourceLocator {
  "A cloud id (only valid for Jira datasources)"
  cloudId: String
  "A reference to an AVP datasource by ARI"
  datasourceAri: String
  "A reference to a datasource in the AVP database (by primary key)"
  datasourceId: String
  "A datasource type, defined as an enum DsType in Castle"
  dstype: String
  "A workspace id (only valid for hot tier datasources)"
  workspaceId: String
}

type AVPDeleteChartPayload implements Payload {
  """
  The updated canvas layout, with the chart removed
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  * __read:dashboard:jira__
  """
  canvasLayout: AVPDashboardCanvasLayout @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [DASHBOARD_READ])
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
