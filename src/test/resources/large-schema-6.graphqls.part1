type DevAiAutodevNextWorkstream {
  createdAt: DateTime
  """
  Repositories excluded from automated processing within this workstream. Resolved lazily
  via @SchemaMapping for efficiency — not eagerly joined into the parent workstream query.
  """
  excludedRepositories: [DevAiAutodevNextExcludedRepository!]
  """
  How the workstream discovers work. Set at creation time and immutable
  thereafter — there is no findWorkMode field on the update input.
  """
  findWorkMode: DevAiAutodevNextWorkstreamFindWorkMode!
  id: ID!
  """
  The most recently started sweep for this workstream, when one has ever run. Resolved
  from autodev-next sweep records only when requested; a single lookup backs both
  `startedAt` and `completedAt` below.
  """
  lastSweep: DevAiAutodevNextWorkstreamLastSweep
  "Identifies whether the workstream runs an administrative or user-owned loop."
  loopType: String
  "Members of this workstream. Resolved lazily via @SchemaMapping."
  members(after: String, first: Int): DevAiAutodevNextMemberConnection
  name: String
  "Projects associated with this workstream. Resolved lazily via @SchemaMapping."
  projects(after: String, first: Int): DevAiAutodevNextProjectConnection
  settings: DevAiAutodevNextWorkstreamSettings
  "High-level state of the workstream. Defaults to ACTIVE on creation."
  status: DevAiAutodevNextWorkstreamStatus!
  updatedAt: DateTime
  workspaceId: ID!
}

