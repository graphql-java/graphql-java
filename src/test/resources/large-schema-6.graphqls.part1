  featureFlags: [AIOpsServiceFeatureFlag!]
  "Root cause signals identified for this service's changes."
  rootCauses: [AIOpsLikelyRootCause!]
  "ARI of the analysed service."
  serviceAri: String
  "Human-readable name of the service."
  serviceName: String
  "Analysis status for this service."
  status: AIOpsChangeAnalysisStatus
}

"A mapping between an affected service and its dependent services."
type AIOpsServiceDependencyMapping {
  "The service that is affected."
  affectedService: AIOpsInvestigatedServiceDetail
  "Services that the affected service depends on."
  dependentServices: [AIOpsInvestigatedServiceDetail!]
}

"A deployment detected during change-impact analysis."
type AIOpsServiceDeployment {
  "Number of commits in this deployment."
  commitCount: Int
  "Deployment identifier."
  deploymentId: String
  "URL link to the deployment."
  link: String
  "Number of work items associated with this deployment."
  workItemCount: Int
}

"A feature flag detected during change-impact analysis."
type AIOpsServiceFeatureFlag {
  "URL link to the feature flag."
  link: String
  "Name of the feature flag."
  name: String
}

