"""
type AdminBreachingConnectionEdge {
  "An opaque cursor for this edge, usable for pagination."
  cursor: String!
  "The breaching connection at this edge."
  node: AdminBreachingConnection!
}

"The values available for filtering breaching connections in a Unit."
type AdminBreachingConnectionFilterOptions {
