type AVPEnvVar {
  "Whether this filter should be auto-applied to all charts in the dashboard (false for BYOD, true for Hot Tier)"
  applyToAll: Boolean
  chartId: ID
  "The type of chart for the filter or variable; filters use an EnvVarChartType enum value; variables use null"
  chartType: String
  dataType: AVPEnvVarDataType
  defaultValues: [String]
  "An array of data objects where each provides Hot Tier product context ((e.g., jira, devops))"
  hotTierFilterConfig: [AVPHotTierFilterConfig]
  id: ID
  "Filter metadata as a JSON string, used by BYOD filters."
  metadata: String
  "Name must start with a letter and include letters, numbers, or underscores."
  name: String
  operator: String
}

"Temporary type for an env var with its chart attached; will be unified with AVPEnvVar when Dashboard/Chart are updated"
type AVPEnvVarWithChart {
  "Whether this filter should be auto-applied to all charts in the dashboard (false for BYOD, true for Hot Tier)"
  applyToAll: Boolean
  chart: AVPChart
  "The type of chart for the filter or variable; filters use an EnvVarChartType enum value; variables use null"
  chartType: String
  "The data type of the env var filter or variable"
  dataType: AVPEnvVarDataType
  defaultValues: [String]
  "An array of data objects where each provides Hot Tier product context ((e.g., jira, devops))"
  hotTierFilterConfig: [AVPHotTierFilterConfig]
  id: ID
  "Filter metadata as a JSON string, used by BYOD filters."
  metadata: String
  "Name must start with a letter and include letters, numbers, or underscores."
  name: String
  "The logical condition for how to apply the value, related to the dataType. Set automatically for filters."
  operator: String
}

"External resource associated with a chart configuration"
type AVPExternalResource {
  "Cloud ID associated with the external resource"
  cloudId: String
  "The external resource provider"
  provider: AVPExternalResourceProvider!
  "UUID for the resource within the provider"
  resourceId: ID!
  "Workspace ID associated with the external resource"
  workspaceId: String
}

"""
Represents a group node in the filter expression tree.
Contains a logical operator (AND/OR) and child nodes.
"""
type AVPFilterGroup {
  "Child nodes (can be AVPFilterGroups or AVPPlatformFilters)"
  groups: [AVPFilterExpression!]!
  "Unique identifier for the filter group"
  id: ID!
  """
  Optional metadata as JSON
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __jira:atlassian-external__
  """
  metadata: String @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL])
  "Logical operator for combining child nodes"
  operator: AVPFilterOperator!
}

"Migration status of a single Jira gadget."
type AVPGadgetMigrationStatus {
  "The Jira gadget ID."
  gadgetId: ID!
  "The migration status of this gadget."
  status: AVPGadgetMigrationStatusValue!
}

type AVPGetDashboardIdBySlugPayload {
  "Unique identifier for the dashboard"
  id: ID
}

"A data object to provide Hot Tier product context, stored on the EnvVar. Required to support HotTier-compatible filters."
type AVPHotTierFilterConfig {
  datasourceLocator: AVPDatasourceLocator
  dimension: String
  product: String
  semanticModel: String
}

"""
Migration status of a Jira Dashboard being migrated.
Exactly one record exists per source Jira Dashboard.
The `jiraDashboardAri` is the source Jira Dashboard ARI.
"""
type AVPJiraDashboardMigrationStatus {
  "The IDs of the AVP dashboards created from this Jira Dashboard."
  avpDashboardIds: [ID!]!
  "Per-gadget migration status for every gadget in the source Jira Dashboard."
  gadgetStatuses: [AVPGadgetMigrationStatus!]!
  "The Jira Dashboard ARI (ari:cloud:jira:{cloudId}:dashboard/activation/{activationId}/{jiraDashboardId})."
  jiraDashboardAri: ID! @ARI(interpreted : false, owner : "jira", type : "dashboard", usesActivationId : false)
  "Time (microseconds since epoch) when the most recent migration attempt started."
  lastRetryAt: String!
  "Time (microseconds since epoch) when the most recent migration attempt finished."
  lastRetryFinishedAt: String
  "Number of retries attempted (0 if the migration has only been attempted once)."
  retried: Int!
  "Atlassian Account ID of the user who started the most recent migration attempt."
  startedBy: String!
  "Overall migration status."
  status: AVPJiraDashboardMigrationStatusValue!
}

"""
Tagged-union representation of the JQL source backing a metrics query. Currently the only
supported variant is FILTER_ID; `filterId` is set when `type == FILTER_ID`.
"""
type AVPJqlSource {
  "Set iff `type` == FILTER_ID; the Jira saved-filter identifier (numeric ID or ARI)."
  filterId: ID
  "Discriminator selecting which scalar carries the value."
  type: AVPJqlSourceType!
}

