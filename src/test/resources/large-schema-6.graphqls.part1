  user: User @hydrated(arguments : [{name : "accountIds", value : "$source.accountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
}

"A single committed routing-table entry as exposed to the FE list view."
type AgentWorkspaceRoutingTableEntry {
  "Natural-language description of when an incoming ticket should match this entry."
  description: String!
  "Stable service identifier for this live routing-table entry."
  serviceId: ID!
  "Display name of the service this entry routes for (e.g. `VPN Access`)."
  serviceName: String!
  """
  Skills required to handle work routed to this service. Nullable until the services-and-skills
  mapping table (owned by another team) is integrated; once integrated, this will reflect the
  per-service skill list. Empty list when the service has no skills configured. FE should select
  the subset of `AgentWorkspaceSkill` fields it needs (e.g. `{ id, name }`).
  """
  skills: [AgentWorkspaceSkill!]
  """
  Owning team hydrated from the Identity service via AGG (name + avatar for display).
  Resolved from `teamAri`; null if the team has been deleted or is not visible to the caller.
  """
  team: TeamV2 @hydrated(arguments : [{name : "ids", value : "$source.teamAri"}], batchSize : 50, field : "team.teamsV2Hydration", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  "Fully-qualified Identity team ARI that owns this service."
  teamAri: ID!
}

"Status and progress of an asynchronous routing-table generation job."
type AgentWorkspaceRoutingTableGeneration {
  "Number of generated rows that have finished processing: service buckets in service mode or teams in team mode."
  completedServices: Int!
  "The phase of work the job is currently executing. Null when the job has finished."
  currentPhase: AgentWorkspaceRoutingTableGenerationPhase
  "Time at which the generation job finished. Null while the job is still running."
  endedAt: DateTime
  "Error message describing why the job failed. Only populated when status is FAILED."
  errorMessage: String
  "The ID of the generation job."
  generationId: ID!
  """
  Stable identifiers for rows selected for this run: service IDs in service mode or team ARIs in
  team mode. The legacy field name is retained for compatibility. Each identifier corresponds to
  one drafted row. Empty list when no rows were selected.
  """
  selectedRowServiceIds: [String!]!
  """
  Per-row progress entries. In service mode, entries are keyed by `serviceId`; in team mode, they
  are keyed by team ARI. The legacy field name is retained for compatibility. The worker populates
  entries as each row transitions through PENDING → ENRICHING → ENRICHED / SKIPPED, allowing the
  FE to render completed rows before the entire run reaches COMPLETED.
  
  **Nullable** — `null` when the run did not go through AI enrichment (e.g. CSV import, manual
  draft creation, or any flow that bypasses the orchestrator). FE should treat `null` and `[]`
  identically: "no per-row progress to render" — fall back to the overall `status` /
  `currentPhase` for high-level progress indication.
  """
  serviceProgress: [AgentWorkspaceServiceProgressEntry!]
  "Time at which the generation job was started."
  startedAt: DateTime!
  "Overall status of the job."
  status: AgentWorkspaceRoutingTableGenerationStatus!
  "Total number of generated rows: service buckets in service mode or teams in team mode."
  totalServices: Int!
  "Account ID of the user who triggered the generation job. Null if unknown."
  triggeredBy: String
}

"Result of saving a project's team-assignment setup."
type AgentWorkspaceSaveRoutingSetupPayload {
  """
  Number of live rows written when `rows` was supplied, otherwise zero.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  rowsWritten: Int!
  """
  Persisted routing configuration after the save.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  smartRoutingConfig: AgentWorkspaceSmartRoutingConfig!
  """
  Whether the save succeeded.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

"""
============================================
Schedule Types
============================================
"""
type AgentWorkspaceSchedule {
  agents: [AgentWorkspaceAgent!]!
  cloudId: ID!
  "Backend-computed recurrence expansion boundary derived from either effectiveUntil or endAfterOccurrences. Null when the schedule has no end condition or when count-based schedule end behavior is not enabled."
  computedEffectiveUntil: DateTime
  """
  Coverage gaps in this schedule within the requested render window. Each gap
  carries enough addressing information for the FE to invoke
  `agentWorkspace_assignAgentToGap` and
  `agentWorkspace_recommendedAgentsForCoverageGap` directly. Stubbed to an
  empty list until schedule-level coverage-gap reads are implemented.
  """
  coverageGapDetails: [AgentWorkspaceCoverageGap!]
  createdAt: DateTime!
  createdBy: String!
  "User who created the schedule - hydrated from Identity service via AGG"
  createdByUser: User @hydrated(arguments : [{name : "accountIds", value : "$source.createdBy"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "Whether this schedule has been deleted"
  deleted: Boolean!
  description: String
  effectiveUntil: DateTime
  enabled: Boolean!
  "Number of schedule occurrences after which the recurrence ends. Mutually exclusive with effectiveUntil."
  endAfterOccurrences: Int
  endTime: DateTime!
  "Globally unique identifier for this schedule version, composed of scheduleId and versionStartTime. Required by Relay."
  id: ID!
  "Minimum valid endAfterOccurrences value when updating this schedule. Null when not applicable."
  minimumEndAfterOccurrencesForUpdate: Int
  name: String!
  projectId: ID
  projectKey: String
  recurrence: AgentWorkspaceRecurrenceRule
  recurring: Boolean!
  "The schedule identifier. Stable across versions of the same schedule."
  scheduleId: ID!
  startTime: DateTime!
  "Team information - hydrated from Team service via AGG"
  team: TeamV2 @hydrated(arguments : [{name : "ids", value : "$source.teamARI"}], batchSize : 50, field : "team.teamsV2Hydration", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  teamARI: ID @ARI(interpreted : false, owner : "identity", type : "team", usesActivationId : false)
  teamId: ID
  "IANA timezone ID for this schedule (e.g., Australia/Sydney). Defaults to UTC."
  timezone: String!
  updatedAt: DateTime!
}

type AgentWorkspaceScheduleEdge {
  "Cursor for this edge (schedule ID)"
  cursor: String!
  "The schedule"
  node: AgentWorkspaceSchedule!
}

