"A reason why a data source is currently in a failure state."
type AdminDataSourceFailureReason {
  """
  A machine-readable failure reason code. Codes are connector-specific integer values
  defined upstream by each connector's `ConnectorErrorCodes` enum (e.g. `1000` =
  `UNAUTHORIZED_DC_USER` for Confluence).
  The full int -> code mapping per connector lives in the per-connector `*Errors` enum
  classes upstream (e.g. `ConfluenceErrors`, `GitHubErrors`, `WorkdayErrors`), all of
  which implement the `ConnectorErrorCodes` interface in `ai-3p-connector`.
  """
  failureReasonCode: Int!
  "Named values to interpolate into the localized failure reason message."
  failureReasonMessageValues: [AdminDataSourceMessageValue!]!
}

"A named value used for message interpolation."
type AdminDataSourceMessageValue {
  "The placeholder name within the message template."
  name: String!
  "The value to substitute for the placeholder."
  value: String!
}

"A connector-specific configuration property of a data source."
type AdminDataSourceProperty {
  "The property key."
  key: String
  """
  The currently stored property value. Modeled as a `JSON` scalar because each 3rd-party
  connector defines its own property schema at runtime: stored values are heterogeneous
  (strings, numbers, booleans, lists, or nested objects) and the upstream
  `ai-3p-connector` service stores them as a free-form `Map<String, Any>`. The shape per
  field is dictated by each 3rd-party connector at runtime, not by this schema.
  """
  value: JSON @suppressValidationRule(rules : ["JSON"])
}

