  """
  sourceWorkspace: AdminWorkspace
  "The counts grouped by breaching connection type."
  statistics: [AdminBreachingConnectionGroupedByWorkspaceStatistics!]
  "The target resource, hydrated from its ARI. An unresolved resource is a restricted workspace."
  target: AdminBreachingConnectionResource
  """
