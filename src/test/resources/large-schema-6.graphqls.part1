"""
Resolved tenant-scoped context. Extend this type by adding new nullable, typed fields
as further cloudId-derived resolutions are needed.
"""
type AssetsVerticalTenantContext {
  """
  Assets Vertical workspace ARI (ari:cloud:assets-vertical::workspace/{id}).
  Nullable: null when the tenant has no Assets Vertical workspace provisioned.
  """
  assetsVerticalWorkspaceAri: ID
  "Tenant security and compliance attributes resolved server-side from the tenant context."
  compliance: AssetsVerticalCompliance!
  """
  Whether this AVS shard has an active Data Residency (DaRe) suspension for the tenant, so the UI
  should treat writes as unavailable (banner / disable mutations). Resolved per request, like
  HIPAA/CMK.
  
  true  when an unexpired `SUSPENDED` row exists for this site in the `tenant_suspension`
        registry — the same condition that makes mutating APIs reject writes here.
  false when the site is not suspended here, the DaRe feature gate is off, or the registry lookup
        failed (fail-safe: do not show the migration UI). Mutating APIs stay fail-closed, so a
        failed lookup rejects writes while this still reads false.
  
  The suspension row is the source of truth, not TCS EntityMetadata `isMigrating`. TCS is the
  trigger that causes a row to be written on the source shard; it flips back to false at cutover,
  while the suspension must outlive it so leftover async work is still rejected here.
  
  This query is never blocked by DaRe, so the UI can always read the flag.
  """
  isDareSuspended: Boolean!
  """
  Provisioning state of the tenant's Assets-Vertical resources (presence-based).
  COMPLETED when Assets-Vertical resources are fully provisioned, else PENDING.
  """
  provisioningState: AssetsVerticalProvisioningState!
}

