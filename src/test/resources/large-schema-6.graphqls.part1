type Artifact {
  access: ArtifactAccess!
  "When the artifact was created, as an ISO-8601 timestamp."
  createdAt: DateTime!
  id: ID!
  name: String!
  "Who owns the artifact, as an Atlassian identity user ARI containing their account ID."
  ownerAri: ID!
  """
  Who this artifact is shared with.
  
  Three answers are distinct: a list names the audiences, `[]` says the
  artifact is shared with no one, and null says the audiences were not
  disclosed.
  """
  shares: [ArtifactShare!]
  type: String!
  url: URL!
}

type ArtifactAuthorContentPayload implements Payload {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  What the authoring checks observed about the submitted HTML. Advisory: a
  document is still authored when there are findings.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  findings: [ArtifactLintFinding!]
  """
  The authored document, whole and self-contained, ready to be uploaded as the
  artifact's content. Null when `success` is false.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  html: String
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
