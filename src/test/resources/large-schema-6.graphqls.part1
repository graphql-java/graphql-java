  creationDate: DateTime
  creator: User @hydrated(arguments : [{name : "accountIds", value : "$source.creator.aaid"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
