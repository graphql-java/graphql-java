type DevAiRovoDevIssueViewResponse {
  checks: DevAiEntitlementCheckResultResponse
  isFeatureEnabled: Boolean
  sessions(
    after: String,
    "The workspace related to the session"
    cloudId: ID @CloudID(owner : "jira"),
    first: Int,
    "The issue key of the sessions"
    issueKey: String,
    "Filter sessions by ownership. Defaults to ALL."
    ownershipFilter: DevAiOwnershipFilter,
    "Sort order of updatedAt"
    sort: DevAiRovoDevSessionSort,
    "Filter sessions by status category. Defaults to ALL."
    statusCategoryFilter: DevAiSessionStatusCategoryFilter
  ): DevAiRovoDevSessionConnection
}

"Repositories and their specific config required by Rovo Dev"
type DevAiRovoDevRepository {
  "Direct URL to the target branch in the repository (derived from url and targetBranch)"
  branchUrl: String
  "Rovo Dev will checkout the source branch prior to coding"
  sourceBranch: String
  "Target branch code will be pushed to"
  targetBranch: String
  "Repository URL where agent will code"
  url: String
}

"DevAiRovoDevSession represents a session in Rovo Dev"
type DevAiRovoDevSession implements Node @defaultHydration(batchSize : 50, field : "devai_rovodevSessionsByAri", idArgument : "sessionAris", identifiedBy : "id", timeout : -1) {
  "The A2A endpoint URL for this session."
  a2aUrl: URL
  "Atlassian Account ID the session belongs to"
  accountId: ID
  "Atlassian Account ID of the connection owner for the automation rule who created this session"
  automationConnectionAccountId: String
  "Atlassian Account ID of the automation user who triggered the rule"
  automationInvokerId: String
  "The ID of the automation rule that triggered this session"
  automationRuleId: String
  "Status of the most recent active build"
  buildStatus: DevAiRovoDevBuildStatus
  "Timestamp when the session was created"
  createdAt: DateTime
  "The URL Path to the VS Code editor for this session"
  editorPath(
    """
    When true, sends a heartbeat to keep the session's infrastructure active.
    Defaults to false.
    """
    keepAlive: Boolean = false
  ): String
  """
  The URL to the VS Code editor for this session
  
  
  This field is **deprecated** and will be removed in the future
  """
  editorUrl: URL
  "Error message will be provided to user when the agent fails"
  errorMessage: String
  "Unique identifier of the Rovo Dev Session"
  id: ID! @ARI(interpreted : false, owner : "devai", type : "session", usesActivationId : false)
  "Whether this session has been archived."
  isArchived: Boolean
  "The Jira issue that is the target subject associated with this session"
  issue: JiraIssue @idHydrated(idField : "issueAri", identifiedBy : null)
  "The ARI of the Jira issue that is the target subject associated with this session"
  issueAri: ID @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  "Additional options to adjust agent behaviour"
  options: DevAiRovoDevSessionOptions
  "Status of the associated PR"
  prStatus: DevAiRovoDevPrStatus
  "URL of the associated PR"
  prUrl: String
  "Initial prompt for the agent in ADF (Atlassian Document Format)"
  promptAdf: JSON @suppressValidationRule(rules : ["JSON"])
  "The repository that Rovo Dev will be coding in"
  repository: DevAiRovoDevRepository
  "Status of the sandbox"
  sandboxStatus: DevAiRovoDevSandboxStatus
  sessionSandbox: DevAiSandbox
  "Status of the session"
  sessionStatus: DevAiRovoDevSessionStatus
  "The title generated for this session, based on the issue summary and prompt"
  sessionTitle: String
  "Source that created the session, such as autofix."
  source: String
  "Timestamp when the session was last updated"
  updatedAt: DateTime
  "The Rovo Dev Workspace the session belongs to"
  workspaceAri: ID @ARI(interpreted : false, owner : "devai", type : "workspace", usesActivationId : false)
  "The experience ID (xid) that specifies which experience this session is used in"
  xid: String
}

