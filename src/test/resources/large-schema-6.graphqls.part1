  "HTTP status code returned by order preview, e.g. 401 when the API gateway rejects the request"
  orderPreviewStatusCode: Int
  "Recovery action if available for this error"
  recoveryAction: CommerceExpValidOrderRecoveryAction
}

"ValidOrderItem"
type CommerceExpValidOrderItem {
  itemId: String
  "The target Offering's media-storage usage limit in bytes"
  mediaStorageLimitBytes: Float
  orderEstimateItem: CommerceExpOrderBillEstimate
  orderPreviewItem: CommerceExpOrderItem
  recuringEstimateItem: CommerceExpOrderBillEstimate
}

"ValidOrderSuccess"
type CommerceExpValidOrderSuccess {
  "A recommendation for bundling entitlements into a collection"
  collectionRecommendation: CommerceExpCollectionRecommendation
  "Full period recurring estimates for the related existing entitlements being bundled into a collection"
  collectionStandaloneComparison: CommerceExpCollectionStandaloneComparison
  "The estimate of the order"
  estimate: CommerceExpOrderIntentEstimate
  "A compatible FREE Offering alternative for this reactivation; null when unavailable or ineligible"
  freeReactivationOption: CommerceExpFreeReactivationOption
  "A "
  order: CommerceExpOrderRequest
  "Successful response from order preview"
  orderPreview: CommerceExpCcpOrderPreview
  """
  When present, the consumer must create a provisioning request with this input before
  placing the Order, then attach the returned provisioningRequestId to the order options.
  Null when provisioning is not required.
  """
  provisioningRequestInput: JSON @suppressValidationRule(rules : ["JSON"])
  "The raw object of the order with all field intact"
  rawOrder: JSON @suppressValidationRule(rules : ["JSON"])
  "The recurring estimate of entitlements"
  recurringEstimate: CommerceExpOrderIntentEstimate
  "[EXPERIMENTAL] Gated by the servco_require_payment_details_for_2nd_retrial experiment; not a stable commerce rule - do not treat as a general capability yet. Whether the user should be prompted to add a payment method before upgrading. Applies to single-product upgrades (Jira, Confluence, JPD, Loom) and multi-item service collection upgrades (JSM/JCS). Eligibility is computed in BBF; experiment enrollment is still evaluated on the frontend."
  shouldAddPaymentBeforeUpgrade: Boolean
  "[EXPERIMENTAL] Gated by the servco_require_payment_details_for_2nd_retrial experiment; not a stable commerce rule - do not treat as a general capability yet. Whether the trial should be skipped on this second-retrial upgrade (the direct-buy case for billing admins). When true, the built order already has skipTrial applied and the order is charged immediately; when false but shouldAddPaymentBeforeUpgrade is true, the user adds payment and the trial continues. Experiment enrollment is still evaluated on the frontend."
  shouldSkipTrialOnUpgrade: Boolean
  "Trial history diagnostics for Service Collection qualification; does not record experiment exposure"
  trialHistoryLookup: CommerceExpTrialHistoryLookup
  "[EXPERIMENTAL] Action to take when a user upgrades a JSM/JCS service product (tracked under the servco_require_payment_details_for_2nd_retrial experiment): DIRECT_BUY for billing admins, REQUIRE_PAYMENT_DETAILS for others, NO_ACTION when the user is not eligible"
  upgradePaymentAction: CommerceExpServCoUpgradeAction
  "[EXPERIMENTAL] Action to take when a user upgrades a JSM/JCS service product (tracked under the servco_require_payment_details_for_2nd_retrial experiment): DIRECT_BUY for billing admins, REQUIRE_PAYMENT_DETAILS for others, NO_ACTION when the user is not eligible"
  upgradePaymentActionNoExposure: CommerceExpServCoUpgradeAction
  """
  Action to take when a user upgrades a JSM/JCS service product (tracked under the servco_require_payment_details_for_2nd_retrial experiment): DIRECT_BUY for billing admins, REQUIRE_PAYMENT_DETAILS for others, NO_ACTION when the user is not eligible
  
  
  This field is **deprecated** and will be removed in the future
  """
  upgradeServCoProductsAction: CommerceExpServCoUpgradeAction
  "ValidOrderItem"
  validOrderItems: [CommerceExpValidOrderItem]
}

"""
Returned by orderBuilder instead of ValidOrderSuccess when
`useUpgradeOrderResolver: true` is set and the order is a single-entitlement
upgrade that starts a trial. The order is built but not previewed; preview it
with validOrder before placing.
"""
type CommerceExpValidUpgradeOrder {
  "The order request, typed"
  order: CommerceExpOrderRequest
  "The raw object of the order with all field intact"
  rawOrder: JSON @suppressValidationRule(rules : ["JSON"])
  "The offering the upgrade moves the entitlement to"
  targetOffering: CcpOffering @hydrated(arguments : [{name : "ids", value : "$source.targetOfferingAri"}], batchSize : 90, field : "ccp_offerings", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  "ARI of the offering the upgrade moves the entitlement to, e.g. ari:cloud:commerce::offering/<uuid>"
  targetOfferingAri: String
}

"Address validation error"
type CommerceExpValidationErrorMessage {
  """
  Error code
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  code: String
  """
  Name of the address field that failed validation
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  fieldName: String
  """
  Human readable error message
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  validationMessage: String
}

"Version change context information"
type CommerceExpVersionChangeContext {
