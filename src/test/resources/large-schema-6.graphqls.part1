  iconKey: String
  iconUrl: String
  priority: Int!
  "All matching members, ordered by server name. This nested connection is complete and has no further pages."
  servers: GraphIntegrationMcpAdminManagementCuratedMcpServerTemplateConnection!
}

"""
Current state of an MCP server's custom auth configuration, shaped for an admin form.

Mirrors how values are submitted so a form can read and write through the same routing:
each input descriptor dispatches on the descriptor's target.

Reports nothing about the client secret: outbound auth does not return it, so whether one is set
cannot be established. A form renders the secret field empty and leaving it empty means keep the
existing secret.
"""
type GraphIntegrationMcpAdminManagementMcpServerAuthConfig @apiGroup(name : ACTIONS) @renamed(from : "McpAdminManagementMcpServerAuthConfig") {
  """
  Current value for the input whose target is AUTH_HEADER_NAME. Null for a gallery/templated server,
  which uses its declared header name instead.
  """
  authHeaderName: String
  """
  Current value for the input whose target is AUTH_HEADER_PREFIX. Null for a gallery/templated server,
  which uses its declared prefix instead.
  """
  authHeaderPrefix: String
  "The auth type this configuration is for. A form should render the descriptors for this type."
  authType: GraphIntegrationMcpAdminManagementMcpServerAuthType!
  "Current value for the input whose target is CLIENT_ID."
  clientId: String
  """
  Whether PKCE is currently in force, when the template lets an admin set it. Null when the template
  pins the flow, or when the stored configuration predates flow types being recorded.
  """
  pkceEnabled: Boolean
  """
  The descriptors that give this auth type's values labels, types and targets, so a form can render
  without a second query to a template query or the custom auth contract query. Null for an auth type
  with nothing to describe (OAUTH, NONE), or a gallery template with no declared custom auth config
  for its API_TOKEN auth type.
  """
  properties: GraphIntegrationMcpAdminManagementCustomOauthProperties
  """
  Scopes currently in force, when the template lets an admin set them. Null when the template pins the
  scopes, so a form has nothing to render.
  """
  scopes: [String!]
  """
  Keys whose current value could not be established. A form must render these as unavailable rather
  than empty: saving a blank over a value that merely failed to load would destroy a working
  configuration.
  """
  unavailableKeys: [String!]!
  """
  Current values for inputs whose target is VALUE, keyed by input key. Inputs collected elsewhere in
  the registration flow, and values the platform derives rather than asks for, are absent.
  """
  values: [GraphIntegrationMcpAdminManagementAuthConfigValue!]!
}

"Result of fetching an MCP server's custom auth configuration, including the configuration or any errors"
type GraphIntegrationMcpAdminManagementMcpServerAuthConfigPayload implements Payload @apiGroup(name : ACTIONS) @renamed(from : "McpAdminManagementMcpServerAuthConfigPayload") {
  """
  The current configuration. Null when the server has no custom auth configuration to describe, which
  is not an error.
  """
  authConfig: GraphIntegrationMcpAdminManagementMcpServerAuthConfig
  errors: [MutationError!]
  success: Boolean!
}

