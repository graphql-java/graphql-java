"""
Union result type for the latest investigation query.

AIOpsInvestigation is returned when a stored investigation exists for the issue.
AIOpsInvestigationNotFound is returned when no investigation has been created yet.
QueryError is reserved for genuine failures.
"""
union AIOpsInvestigationQueryResult = AIOpsInvestigation | AIOpsInvestigationNotFound | QueryError

"""
Terminal state of an RCA investigation.
AIOpsInvestigationInProgress is returned when the investigation is actively running.
AIOpsInvestigationCompleted is returned when the investigation finished successfully.
AIOpsInvestigationTerminated is returned when the investigation was cancelled or stopped early.
"""
union AIOpsInvestigationResult = AIOpsInvestigationCompleted | AIOpsInvestigationInProgress | AIOpsInvestigationTerminated

