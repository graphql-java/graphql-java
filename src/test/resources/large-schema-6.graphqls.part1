"A third-party app that an agent may interact with, requiring OAuth consent."
type AgentStudioThirdPartyApp implements AgentStudioApp @apiGroup(name : AGENT_STUDIO) {
  "Whether the current user has granted auth consent for this app."
  authConsentStatus: AgentStudioThirdPartyAuthConsentStatus!
  "The URL the user must visit to grant auth consent for this app."
  authConsentUrl: String
  displayName: String!
  iconUrl: String
  integrationKey: String!
  tools: [AgentStudioTool!]
}

"""
One third-party OAuth connection: exactly one token, and the tools that depend on it.

Disconnecting this connection revokes access for every tool listed in `tools`, which is why they
are grouped here rather than presented as independent cards.
"""
type AgentStudioThirdPartyConnection @apiGroup(name : AGENT_STUDIO) {
  """
  The URL the user must visit to grant consent, covering every tool under this connection at once.
  
  Null means connect is genuinely unavailable and MUST NOT be offered — the Connect affordance
  should be disabled rather than pointed at a fallback URL, because the only alternative URL would
  grant the token to the human who clicked it rather than to the agent.
  """
  authConsentUrl: String
  "When the connection was established. Null when there is no token."
  connectedAt: DateTime
  """
  Stable identifier for this connection, and the handle taken by
  `agentStudio_deleteThirdPartyConnection`. Opaque: pass it back verbatim and never parse, encode
  or decode it — it contains `/`, `+` and `=`, its segment count can vary, and its internal
  structure is Integrations Service's to change.
  
  Not always a submittable disconnect handle: when no token exists this is a synthesised
  placeholder. Gate any destructive action on `status` being CONNECTED, and treat this purely as
  a display/reference key otherwise.
  """
  connectionAccountId: ID!
  "Brand name of the connected app, e.g. \"Google\". Hydrated by convo-ai, not by Integrations Service."
  displayName: String!
  """
  The third-party account the token belongs to, e.g. 'alice@corp.com'.
  
  Whose account this is depends on the agent's access identity mode: for an agent running under
  its own identity it is the external account of whoever granted consent on the agent's behalf,
  NOT the viewer's. Do not label it as the current user's. Null when there is no token.
  """
  externalAccountLabel: String
  "Brand icon for the connected app."
  iconUrl: String
  """
  The integration this connection belongs to, e.g. ari:cloud:platform::integration/google.
  
  Null when the connection is not backed by a known integration — a customer-registered MCP server,
  for example. Independent of `mcpServerAri`: a connection can carry both, either, or neither.
  For display and telemetry only — use `tools` to join back to an agent's tools.
  """
  integrationAri: String
  """
  The MCP server this connection belongs to, when one is involved.
  
  Null when no MCP server backs the connection. Not an alternative to `integrationAri` — an MCP
  server can itself belong to an integration (the GitHub MCP server belongs to the GitHub
  integration), in which case both are populated. For display and telemetry only.
  """
  mcpServerAri: String
  """
  Products this connection spans, e.g. Gmail and Google Drive under one Google connection.
  
  Coverage is not guaranteed: this may be empty when no product could be inferred (common for MCP
  servers), and the union of `products[].toolIds` may be a strict subset of `tools`. Render tools
  from `tools` and use these only as sub-labels, or tools without a product will disappear.
  """
  products: [AgentStudioConnectionProduct!]
  "Whether a live token exists. See the caution on AgentStudioThirdPartyConnectionStatus.CONNECTED."
  status: AgentStudioThirdPartyConnectionStatus!
  "Ids of the tools in `tools` whose required scopes the current token covers."
  supportedToolIds: [ID!]
  "Every tool of this agent that depends on this connection — i.e. everything that loses access if it is disconnected."
  tools: [AgentStudioTool!]
  """
  Ids of the tools in `tools` whose required scopes the current token does NOT cover. These tools
  will fail at execution until the user re-consents, even while `status` is CONNECTED.
  
  Gate any 'working' indicator on this being empty rather than on `status`. A connection with
  `status: CONNECTED` and a non-empty `unsupportedToolIds` is the 'partially connected' state.
  
  Together with `supportedToolIds` this partitions `tools`: every id appears in exactly one of the
  two, and neither contains an id absent from `tools`.
  """
  unsupportedToolIds: [ID!]
}

