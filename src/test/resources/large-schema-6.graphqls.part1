"""
Base interface for cardLists that contain grouped issues

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
* __read:jira-work__
* __read:jira-platform:twg-cli__
"""
interface JiraBacklogViewCardList implements Node @defaultHydration(batchSize : 200, field : "jira_backlogViewCardListsByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [READ_JIRA_WORK]) @scopes(product : NO_GRANT_CHECKS, required : [READ_JIRA_PLATFORM_TWG_CLI]) {
  """
  Aggregated estimation details grouped by status category.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  estimationDetails(
    "Settings to apply to the issue query used to calculate estimations"
    settings: JiraBacklogViewSettings
  ): JiraBacklogViewEstimationDetails
  """
  Unique identifier for the cardList, using an ARI
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID! @ARI(interpreted : false, owner : "jira", type : "backlog-card-list", usesActivationId : false)
  """
  Issue counts for this card list.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  issueCounts(
    "Settings to apply to the issue query used to calculate counts."
    settings: JiraBacklogViewSettings
  ): JiraBacklogViewIssueCount
  """
  Paginated collection of issues within this cardList
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  issues(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The index based cursor to specify the bottom limit of the items.
    If not specified it's assumed as the cursor to the item after the last item.
    """
    before: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int,
    """
    The number of items before the cursor to be returned in a backward page.
    If not specified, it is up to the server to determine a page size.
    """
    last: Int,
    "Settings applied to the backlog view issue search."
    settings: JiraBacklogViewSettings
  ): JiraIssueConnection
}

"""
Shared metadata implemented by every per-category suggestion container.

Each implementer represents one category of next-action suggestions. When a
provider fails for a given category, the container is still returned, but with
its `queryError` field populated so the UI can render a per-category error
state alongside successful sibling categories.
"""
interface JiraBaseNextActionsEntity {
  "The kind of content this suggestion category produces."
  contentType: JiraNextActionContentType
  "Whether this suggestion category has been dismissed by the current viewer."
  dismissed: Boolean
  """
  Logical grouping that identifies the broad signal source / provider type for this
  suggestion category. One of `AI_FEATURES` (AI-driven recommendations such as
  work-breakdown, similar work items, related links), `SDLC` (software-development
  lifecycle signals such as open or mergeable pull requests), `LOOM_UPDATES`
  (Loom-recording-based updates), or `TRIAGE_AGENT` (Triage Agent updates).
  """
  group: JiraNextActionGroup
  "Stable identifier for this suggestion category instance."
  id: ID
  "How the user is expected to interact with this suggestion category."
  interactionType: JiraNextActionInteractionType
  """
  Whether this suggestion category should be hidden from the UI.
  Distinct from `dismissed` — a category may be hidden by config,
  feature-gate, or eligibility check without the user having dismissed it.
  """
  isHidden: Boolean
  """
  Per-category error. Populated when the provider for this category failed
  (timeout, upstream 5xx, validation, ...). When non-null, the type-specific
  payload fields (e.g. `items`) should be treated as best-effort / empty.
  Re-uses the shared `QueryError` type from the AGG schema.
  """
  queryError: QueryError
  rank: Float
  "User-facing source attribution explaining why this category is shown."
  rationale: String
}

"""
Interface capturing the fields shared between JiraTimelineView and JiraGroupedTimelineView.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
* __read:jira-work__
* __read:jira-platform:twg-cli__
"""
interface JiraBaseTimelineView implements JiraFieldSetsViewMetadata & JiraIssueSearchViewMetadata & JiraSpreadsheetView & JiraView & Node @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [READ_JIRA_WORK]) @scopes(product : NO_GRANT_CHECKS, required : [READ_JIRA_PLATFORM_TWG_CLI]) {
  """
  JQL matching the view's base scope: the issues it shows before any filter the view applies on top of it. Settings
  defining the scope still apply. Same as `viewJql` for views which do not apply filters on top of their scope.
  Null when the view cannot describe its scope as JQL, or when its scope resolves to no issues at all.
  
  Callers combining this with their own conditions must parenthesize both sides: the generated JQL can rely on JQL
  operator precedence (`AND` binding tighter than `OR`), so naive concatenation can change its meaning.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  baseJql: String
  """
  Whether the current user has permission to publish their customized config of the view for all users.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  canPublishViewConfig: Boolean
  """
  Jql used in child issue search during expand hierarchy operation.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  childIssuesJql: String
  """
  Get formatting rules for the view.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  conditionalFormattingRules(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int
  ): JiraFormattingRuleConnection
  """
  Errors which were encountered while fetching the connection.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  error: QueryError
  """
  A connection of included fields' configurations, grouped where logical (e.g. collapsed fields).
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  fieldSets(after: String, before: String, filter: JiraIssueSearchFieldSetsFilter, first: Int, last: Int, scope: JiraIssueSearchScope): JiraIssueSearchFieldSetConnection
  """
  The tenant specific id of the filter that will be used to get the JiraIssueSearchView
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  filterId: String
  """
  A nullable boolean indicating if the IssueSearchView is using default fieldSets
  true -> Issue search view is using default fieldSets
  false -> Issue search view has custom fieldSets
  null -> Not applicable for requested issue search view
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  hasDefaultFieldSets(scope: JiraIssueSearchScope): Boolean
  """
  An ARI-format value that encodes both namespace and viewId.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID!
  """
  A nullable boolean indicating if the Issue Hierarchy is enabled
  true -> Issue Hierarchy is enabled
  false -> Issue Hierarchy is disabled
  null -> If any error has occured in fetching the preference. The hierarchy will be disabled.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  isHierarchyEnabled: Boolean
  """
  Whether the user's config of the timeline view differs from the globally published or default settings of the view.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  isTimelineViewConfigModified(
    "Input for override settings applied to Timeline views"
    timelineViewSettings: JiraTimelineViewSettings
  ): Boolean
  """
  Whether the user's config of the view differs from that of the globally published or default settings of the view.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  isViewConfigModified(
    "Input for settings applied to Issue Search views."
    settings: JiraIssueSearchSettings
  ): Boolean
  """
  JQL built from provided search parameters
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  jql: String
  """
  A subscoping that affects where this view's last used data is stored and grouped by. If null, this view is in the global namespace.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  namespace: String
  """
  An ARI-format value which identifies the issue search saved view.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  savedViewId: ID
  """
  
  
  
  This field is **deprecated** and will be removed in the future
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  settings: JiraSpreadsheetViewSettings
  """
  Timeline specific project settings.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  timelineProjectSettings(input: JiraTimelineProjectOrBoardInput): JiraTimelineProjectSettings
  """
  Timeline specific view setting for the user.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  timelineSettings(
    """
    IssueSearch specific settings used by the timeline view
    but not only specific to timeline.
    """
    staticViewInput: JiraIssueSearchStaticViewInput,
    "Timeline specific settings."
    timelineStaticViewInput: JiraTimelineStaticViewInput
  ): JiraIssueSearchTimelineViewConfigSettings
  """
  Validates the search query.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  validateJql(
    "The issue search input containing the query to validate"
    issueSearchInput: JiraIssueSearchInput!,
    "Boolean deciding whether to store Issue Navigator JQL History or not."
    saveJQLToUserHistory: Boolean = false,
    """
    The scope in which the validation is being performed (e.g. PIN or Global NIN).
    Optional - defaults to Global NIN when not provided. Only relevant when saveJQLToUserHistory is true.
    """
    scope: JiraIssueSearchScope
  ): JiraJqlValidationResult
  """
  A unique identifier for this view within its namespace, or the global namespace if no namespace is defined.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  viewId: String
  """
  JQL matching the issues this view is currently showing: its scope with any filter the view applies on top of it.
  Null when the view cannot describe its scope as JQL, or when its scope resolves to no issues at all.
  
  Callers combining this with their own conditions must parenthesize both sides: the generated JQL can rely on JQL
  operator precedence (`AND` binding tighter than `OR`), so naive concatenation can change its meaning.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  viewJql: String
  """
  Jira view setting for the user.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  viewSettings(
    groupBy: String,
    issueSearchInput: JiraIssueSearchInput,
    "Input for settings applied to the Issue Search view."
    settings: JiraIssueSearchSettings,
    staticViewInput: JiraIssueSearchStaticViewInput
  ): JiraIssueSearchViewConfigSettings
}

