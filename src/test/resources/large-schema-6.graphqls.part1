  "Flag that identifies if the installation has been uninstalled but can be recovered"
  isRecoverable: Boolean!
  license: AppInstallationLicense @hydrated(arguments : [{name : "appInstallationLicenseDetails", value : "$source.appInstallationLicenseDetails"}], batchSize : 100, field : "licenses", identifiedBy : "id", indexed : true, inputIdentifiedBy : [], service : "cs_extensions", timeout : -1)
