" ---------------------------------------------------------------------------------------------"
type AVPAnalyticsMetricTemplate {
  "Display name of the model this metric is built on, for rendering context such as \"based on Work Item Details\"."
  baseModelTemplateName: String!
  "Authored default visualization, with column references bound to the same model. Absent when the template authors none."
  defaultVisualization: AVPAnalyticsVisualizationConfig
  "Human readable metric description for display."
  description: String
  "Metric definition with column references bound to the model definition returned alongside it. modelId is absent because the model does not exist until it is created."
  metricDefinition: AVPAnalyticsMetricDefinition!
  "Identifier of the metric within its bundle, for example count-of-incidents. Not unique on its own."
  metricId: ID!
  "Complete model definition resolved for modelCloudId, ready to pass to avpanalytics_createModel. Column references are bare keys rather than ARIs, because a column ARI requires the owning model key which does not exist until the model is created."
  modelDefinition: AVPAnalyticsModelDefinition!
  "Human readable metric name for display."
  name: String!
  "Identifier of the template bundle that ships this metric, for example work-item-details. Identity is the pair with metricId: a metric id is unique only within its bundle."
  templateId: ID!
}

