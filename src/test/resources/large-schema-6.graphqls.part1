type CplsFilterConfiguration {
  """
  Get all atlas projects associated with work in this scope.
  Includes data for populating filter options with atlas project details (max 1000 per request).
  """
  atlasProjects(after: String, before: String, first: Int, last: Int): CplsAtlasProjectConnection
  """
  Get all contributor data entities with their hydrated contributor information.
  Includes data for populating filter options with contributor details (max 1000 per request).
  """
  contributorDataEntities(after: String, before: String, first: Int, last: Int): CplsContributorDataEntityConnection
  """
  Get all custom contribution targets with their information.
  Includes data for populating filter options with custom contribution target details (max 1000 per request).
  """
  customContributionTargets(after: String, before: String, first: Int, last: Int): CplsCustomContributionTargetConnection
  """
  Get all jira work items with their hydrated issue information.
  Includes data for populating filter options with jira issue details (max 1000 per request).
  
  Jira-backed pagination is forward-only. Pass `pageInfo.endCursor` from the previous response
  as `after`. Intermediate edge cursors identify work items but cannot resume pagination.
  """
  jiraWorkItems(
    "Jira continuation token returned as `pageInfo.endCursor` by the previous page."
    after: String,
    "Not supported by Jira-backed pagination. Use `first` and `after`."
    before: String,
    first: Int,
    "Not supported by Jira-backed pagination. Use `first` and `after`."
    last: Int,
    "Optional Jira work-item summary or key search term."
    searchTerm: String
  ): CplsJiraWorkItemConnection
  "Work types available as filter options."
  workTypes: [CplsWorkType!]
}

type CplsFilters {
  atlasProjectStates: [String!]
  atlasProjects: [ID!] @ARI(interpreted : false, owner : "townsquare", type : "project", usesActivationId : false)
  contributorDataIds: [ID!] @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  customContributionTargets: [ID!] @ARI(interpreted : false, owner : "capacity-planning", type : "custom-contribution-target", usesActivationId : false)
  id: ID!
  includeCurrentUserAsContributor: Boolean!
  jiraWorkItemStatusNames: [String!]
  jiraWorkItemTypes: [String!]
  jiraWorkItems: [ID!] @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  searchTerm: String
  workTypes: [CplsWorkType!]
}

