  "Unique identifier for the client"
  clientKeyId: String!
  "client secret generated by oauth-clients"
  clientKeySecret: String!
  enabled: Boolean!
}

"Client key status (query type)"
type CsmAiWidgetClientKeyStatus @apiGroup(name : CSM_AI) {
  "Client key identifier"
  clientKeyId: String!
  "Date when the client key was created (timestamp in milliseconds)"
  createdTimestamp: Long!
  "Whether the client key is enabled (verified with IdGatekeeper)"
  enabled: Boolean!
}

"List of client keys for a widget"
type CsmAiWidgetClientKeys @apiGroup(name : CSM_AI) {
  "List of client key statuses"
  keys: [CsmAiWidgetClientKeyStatus!]!
}

"Configuration for the AI widget"
type CsmAiWidgetConfig @apiGroup(name : CSM_AI) {
  "Allowed domains for the widget"
  allowedDomains: [String!]
  "Client key IDs verified with IdGatekeeper (enabled status reflects IdGatekeeper verification)"
  clientKeys: CsmAiWidgetClientKeysResult
  "Optional consent form shown before the widget loads"
  consentForm: CsmAiWidgetConsentForm
  "Contact page experience, e.g. AI-FIRST or FORM. Defaults to FORM for support site widgets when available."
  contactPageExperience: String
  "Description of the widget"
  description: String
  id: ID!
  "Can the widget be accessed by anonymous users"
  isAnonymousAccessEnabled: Boolean
  "Is the widget enabled"
  isEnabled: Boolean
  "Name of the widget"
  name: String
  "Position of the widget on the page"
  position: CsmAiWidgetPosition!
  "Code snippets for widget integration"
  snippets(authType: CsmAiSnippetAuthType!): CsmAiWidgetSnippets
  "The theme details for the widget"
  theme: CsmAiWidgetBrandingTheme
  "The type of the widget"
  type: CsmAiWidgetType!
}

"Configuration for the optional consent form shown before the widget loads"
type CsmAiWidgetConsentForm @apiGroup(name : CSM_AI) {
  "Label on the accept button"
  acceptLabel: String
  "Label on the decline button"
  declineLabel: String
  "Master switch — when true, the consent form is shown before the widget loads"
  isEnabled: Boolean!
  "Consent policy body, expressed as Markdown. Rendered inside the form."
  policy: String
  "Heading shown at the top of the form (e.g. 'Before you continue...')"
  title: String
}

