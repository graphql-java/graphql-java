"""
Individual insight card.
Represents a single actionable insight about assets.
"""
type AssetsVerticalInsightCard {
  "Category identifier for the insight (e.g. \"Financial\", \"Security\")."
  category: String!
  "Pre-built Rovo prompt for the call-to-action button."
  ctaRovoPrompt: String!
  "Unique identifier for this insight card."
  id: ID!
  """
  BCP-47 language tag [summary] is actually written in. Usually matches the requested locale, but
  the read path's fallback chain (requested locale -> English -> the definition's absolute latest
  row in whatever locale that is) can return content in a different language when neither the
  request nor English has caught up with the latest data — callers that care should compare this
  against what they asked for.
  
  Nullable by convention (non-identifier field) so a resolver hiccup cannot null-propagate the
  whole card.
  """
  locale: String
  """
  Presentation state of the card: ACTIVE (a generated insight with data), NO_ISSUES (zero-count
  positive state), or NOT_TRACKED (required object types are not being tracked).
  
  Nullable by convention (non-identifier field) so a resolver hiccup cannot null-propagate the
  whole card; clients should treat an absent value as ACTIVE.
  """
  state: AssetsVerticalInsightCardState
  """
  Short, actionable summary displayed as the card heading (e.g. "Critical: 15 MacBooks Expiring Soon").
  For NO_ISSUES / NOT_TRACKED cards this carries the positive / informative empty-state message.
  """
  summary: String!
  "Programmatic title for the insight (e.g. \"Warranty Analyser\")."
  title: String!
}

"Provides enabled insight definitions from `insight_definition` table (tenant-scoped)."
type AssetsVerticalInsightDefinition {
  "Category identifier for the insight (for example FINANCIAL, OPERATIONAL, SECURITY)."
  category: String!
  "Description of the insight."
  description: String!
  "Unique identifier of the insight definition."
  id: ID!
  "Name of insight (User-facing title)."
  name: String!
}

type AssetsVerticalInsightDefinitionPayload {
  "Enabled insights definitions for the tenant."
  insights: [AssetsVerticalInsightDefinition!]!
  """
  Whether the Get Insights button should be shown for this tenant — mirrors
  `AssetsVerticalInsights.shouldShowGetInsights` so this surface can gate the CTA from the same
  response. Same backend gate (itam + Rovo + AI + not-CMK); fails closed to `false`.
  """
  shouldShowGetInsights: Boolean
}

"Provides enabled insight's details: definition fields, latest generated summary, and dashboard id."
type AssetsVerticalInsightDetail {
  "Category identifier for the insight (for example FINANCIAL, OPERATIONAL, SECURITY)."
  category: String!
  "Dashboard id associated with this insight."
  dashboardId: ID!
  "Description of the insight."
  description: String!
  "Insight definition id."
  insightDefinitionId: ID!
  "Latest generated insight summary text from `generated_insight`."
  insightSummary: String
  """
  BCP-47 language tag [insightSummary] is actually written in, or null when there is no generated
  summary. See `AssetsVerticalInsightCard.locale` for the same fallback-chain caveat.
  """
  insightSummaryLocale: String
  "Name of insight (User-facing title)."
  name: String!
}

"Successful payload for `assetsVertical_insightDetails`."
type AssetsVerticalInsightDetailsPayload {
  "Enabled insights with summaries for the tenant, ordered as returned by the service."
  insights: [AssetsVerticalInsightDetail!]!
  """
  Whether the Get Insights button should be shown for this tenant — mirrors
  `AssetsVerticalInsights.shouldShowGetInsights` so the detail view can gate the CTA from the same
  response. Same backend gate (itam + Rovo + AI + not-CMK); fails closed to `false`.
  """
  shouldShowGetInsights: Boolean
}

"Error details for failed jobs."
type AssetsVerticalInsightGenerationError {
  "Error code for programmatic handling."
  code: String!
  "Human-readable error message."
  message: String!
  "Whether the operation can be retried."
  retryable: Boolean!
}

"""
A single item in the unified OOTB + custom insights list.
OOTB items have insightType set; CUSTOM items have customInsightId set.
"""
type AssetsVerticalInsightItem {
  "Category used for ranking and grouping."
  category: AssetsVerticalInsightCategory!
  "Pre-built Rovo Chat follow-up prompt."
  ctaRovoPrompt: String!
  "Custom insight definition ID. Null for OOTB items."
  customInsightId: ID
  "OOTB insight type identifier (e.g. WARRANTY_ANALYSER). Null for CUSTOM items."
  insightType: ID
  "False if the insight has been disabled by an admin. Disabled insights appear but cannot be run."
  isEnabled: Boolean!
  "True if the calling user has pinned this insight."
  isPinned: Boolean!
  "Whether this item is OOTB or user-authored."
  itemType: AssetsVerticalInsightItemType!
  "Latest generation result, or null if this insight has never been run."
  lastResult: AssetsVerticalCustomInsightResult
  "Display name of the insight."
  name: String!
}

"""
Main response type for insights operations.
Represents an insights generation job and its results.
"""
type AssetsVerticalInsights {
  "Error details if status = FAILED."
  error: AssetsVerticalInsightGenerationError
  "Array of insight cards."
  insights: [AssetsVerticalInsightCard!]!
  """
  When `shouldShowGetInsights` is false, the first failing clause — so the FE can show a specific
  "not available because…" message. Null when the button should be shown.
  """
  insightsUnavailableReason: AssetsVerticalInsightsUnavailableReason
  "Timestamp when insights were last successfully generated (epoch milliseconds)."
  lastGeneratedAt: Long
  """
  Rovo Credits state for the calling user on this site, used to render the credit-enforcement
  banner on the insights page.
  
  Null when it was not evaluated — for example when `shouldShowGetInsights` is false (so the page
  does not also show a credit banner), or while the enforcement feature is disabled. The FE shows
  the banner only when this is present and `allowed` is false.
  """
  rovoCredits: AssetsVerticalRovoCredits
  """
  Whether the Get Insights button should be shown for this tenant, so the FE can gate the CTA.
  
  Sourced from the TCS `{cloudId}.itam-availability` record, requiring all of:
  `itam.available && products.rovo.ondemand.active && products.jira-servicedesk.ondemand.ai.enabled
   && products.cmdb.ai.enabled`
  (Rovo must be active; AI must be enabled on JSM and the synthetic CMDB product;
  AI is taken from JSM's Admin Hub toggle by transformerservice's ItamTransformer).
  
  - true  -> show the Get Insights button (ITAM-entitled, Rovo active, and AI enabled).
  - false -> hide the Get Insights button (entitlement / Rovo / AI missing or off, blank cloudId,
             unreadable record, or a legacy record without `products`).
  - null  -> could not be evaluated (AGG scope/resolution failure). FE should treat as hidden.
             The resolver fails closed to `false`, so this is not expected in practice.
  """
  shouldShowGetInsights: Boolean
  "Current job status."
  status: AssetsVerticalInsightsStatus!
  "Suggested polling interval in milliseconds."
  suggestedPollIntervalMs: Int
}

