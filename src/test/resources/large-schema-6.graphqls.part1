  "Selected credentials: discovery_job_credential rows. Empty until step 4 is saved; empty after that means skipped."
  credentialIds: [ID!]!
  "discovery_job.description."
  description: String
  id: ID!
  "True for every DRAFT_n status."
  isDraft: Boolean!
  "Steps not yet saved, in wizard order. Empty when the job can be configured or is configured."
  missingSteps: [DiscoveryJobStep!]!
  name: String!
  "The wizard step to resume at. Null when every step has been saved (DRAFT_5 or CONFIGURED)."
  nextStep: DiscoveryJobStep
  owner: DiscoveryJobOwner!
  provider: DiscoveryProviderId!
  "scan_schedule rows, combined with OR. Empty until step 5 is saved; empty after that means manual-only."
  schedules: [DiscoveryJobSchedule!]!
  "Included and excluded scopes: discovery_job_scope rows. Null until step 3 is saved."
  scopes: DiscoveryJobScopes
  status: DiscoveryJobStatus!
  summary: DiscoveryJobSummary!
  updatedAt: DateTime!
}

