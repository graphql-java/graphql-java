"""
The full capacity configuration for a project, covering both team-level and agent-level
capacity data.
"""
type AgentWorkspaceCapacityConfiguration {
  """
  The per-agent per-team capacity overrides for the project. Populated when agent-level
  capacity is in use.
  """
  agentTeamCapacities: [AgentWorkspaceAgentCapacityConfiguration!]!
  "The active capacity mode for the project."
  mode: AgentWorkspaceCapacityMode!
  "The per-team capacities for the project."
  teamCapacities: [AgentWorkspaceTeamCapacity!]!
}

type AgentWorkspaceCapacityConnection {
  "List of agent capacity edges with cursors"
  edges: [AgentWorkspaceAgentCapacityEdge!]!
  "Cursor-based pagination info"
  pageInfo: AgentWorkspaceCapacityPageInfo!
}

type AgentWorkspaceCapacityError {
  "Error code"
  code: String!
  "Field that caused the error"
  field: String
  "Error message"
  message: String!
}

type AgentWorkspaceCapacityPageInfo {
  "Cursor of the last item in this page"
  endCursor: String
  "Whether there are more results after the current page"
  hasNextPage: Boolean!
  "Whether there are results before the current page"
  hasPreviousPage: Boolean!
  "Cursor of the first item in this page"
  startCursor: String
  "Total number of agents matching the filter (across all pages)"
  totalCount: Int!
}

type AgentWorkspaceCapacitySummary {
  "Total number of agents"
  activeAgents: Int!
  "Number of agents with work assigned (currentLoad > 0)"
  agentsWithWorkItems: Int!
  "Overall utilization percentage"
  assignedPercent: Int!
  "Agents with OVERLOADED status"
  overloadedCount: Int!
  "Total assigned work items"
  totalAssignedWorkItems: Int!
  "Total capacity across all agents"
  totalCapacity: Int!
  "Total unassigned (unresolved) work items in the project"
  totalUnassignedWorkItems: Int!
  """
  Project-wide weighted utilization expressed as a percentage (e.g. 42.5 means 42.5%).
  Uses the same weighted-cases numerator as AgentWorkspaceAgentCapacity.utilizationPercent so the
  project-wide aggregate is consistent with per-agent figures. Can exceed 100 when over capacity.
  Returns 0 when there are no agents or total capacity is zero.
  """
  totalUtilizationPercent: Float!
}

