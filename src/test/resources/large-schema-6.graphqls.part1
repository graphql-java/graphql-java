"A change artefact identified as the likely cause of an incident."
type AIOpsFaultyChange {
  """
  Parent context associations for this faulty change.
  In the AGG implementation the actual change artefact (PR, deployment, commit, FF) is at the top
  level; associations contain the parent investigation context (e.g. the service context that owns
  this change), if one exists.
  """
  associations: [AIOpsFaultyChange!]
  "Artefact-type-specific attributes."
  attributes: AIOpsFaultyChangeAttributes
  "Identifier of the change artefact (e.g. deployment ID, commit SHA)."
  changeId: String
  "Jira work items related to this change, hydrated from relatedWorkItemIds."
  relatedWorkItems: [JiraIssue] @hydrated(arguments : [{name : "ids", value : "$source.relatedWorkItemIds"}], batchSize : 50, field : "jira_issuesByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "gira", timeout : -1)
  "Type of the change artefact."
  type: AIOpsFaultyChangeType
}

"A change-artefact tag attributed to a likely root cause hypothesis."
type AIOpsFaultyChangeTag {
  "Short label for the change artefact (e.g. DEP-114, PR-2535)."
  displayName: String
  "Category of the change artefact."
  type: AIOpsHypothesisEvidenceType
}

