"Tenant security and compliance attributes."
type AssetsVerticalCompliance {
  """
  Whether assets-vertical is CMK-enabled (customer-managed key / BYOK) for this tenant.
  
  - true  -> assets-vertical uses a customer-managed encryption key.
  - false -> not CMK-enabled.
  """
  isCustomerManagedKeyEnabled: Boolean!
  """
  Whether the tenant is HIPAA-enabled, used by HAM to decide whether to show the HIPAA-awareness banner.
  
  - true  -> tenant is HIPAA-enabled; the banner should be shown.
  - false -> tenant is not HIPAA-enabled, the cloudId is blank, or its TCS record is absent.
  - TCS lookup failure -> top-level GraphQL 5xx error; the status is not reported as false.
  """
  isHipaaEnabled: Boolean!
}

