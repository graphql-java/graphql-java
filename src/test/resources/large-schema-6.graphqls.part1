"A single false positive record for the Data Map UI."
type DlpFalsePositive {
  "Account ID of the user who added the sensitive data that triggered the finding"
  actorId: String
  "Application the finding originated from (Jira, Confluence). Will become FindingApp enum"
  app: String
  "Detector category the finding falls under (Identity, Financial, Credentials, Health, Custom, etc). Will become FindingCategory enum"
  category: String
  "Detector confidence bucket for the match: LOW, MEDIUM or HIGH. Will become FindingConfidence enum."
  confidence: String
  "Hash of the matched content"
  contentHash: String
  "Type of content that was scanned, in the form {product}_{entity}_{part} (e.g. confluence_page_body or jira_issue_description)"
  contentType: String
  "Identifier of the specific detector that produced the finding (e.g. detector-credit-card)"
  detectorId: String
  "The kind of detector that matched, e.g. CUSTOM_REGEX or CUSTOM_TERM"
  detectorType: String
  "Timestamp (ISO 8601) when the finding was excluded"
  excludedAt: String
  "Account ID of the org admin who marked the finding as a false positive"
  excludedBy: String
  "Deprecated: always null, removed in a follow up"
  findingId: String
  "Scoped identifier for the false positive record: scopeARI#detectorId#contentHash"
  id: String
  "Timestamp (ISO 8601) the finding's content was last detected/updated"
  lastDetectedAt: String
  "Where in the object the finding was located (title, body, comments, attachment or custom field). Will become FindingLocation enum"
  location: String
  "Human-readable title of the object containing the finding"
  objectTitle: String
  "ARI of the parent container that owns the scanned content, e.g. the Jira issue or Confluence page"
  parentResourceId: String
  "ARI of the exact scanned entity the finding was raised on, e.g. a specific comment, attachment or field"
  resourceId: String
  "Whether the finding is suppressed org-wide or only on this object. Needed to tell otherwise-identical rows apart and to rebuild the key when reverting"
  scope: DlpFalsePositiveScope
  "How the finding was detected: FULL_SITE_SCAN or NEAR_REAL_TIME. Will become FindingSource enum"
  source: String
  "ARI of the workspace/site the finding belongs to"
  workspaceId: String
}

"Per-item save failure for a create request so a bulk exclude can partially succeed."
type DlpFalsePositiveError {
  "Echo of the content hash on the item that failed, so FE can map the failure back to a row"
  contentHash: String
  "Echo of the detector on the item that failed, so FE can map the failure back to a row"
  detectorId: String
  "Deprecated: prefer detectorId/contentHash. Removed in a follow up"
  findingId: String
  message: String
}

"Aggregate counts across all supplied detector/snippet pairs within the organization."
type DlpFalsePositiveImpactResponse {
  findingCount: Int!
  "Exact count of distinct parent objects across all matching findings and supplied snippets."
  uniqueObjectCount: Int!
}

type DlpFalsePositiveOccurrence {
