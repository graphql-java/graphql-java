type AIOpsAutomationRuleUserPrompt {
  defaultValue: String
  displayName: String
  inputType: String
  required: Boolean
  variableName: String
}

"Funnel counts for change candidates evaluated during an RCA investigation."
type AIOpsChangeCandidateFunnelCounts {
  "Candidates remaining after the correlation filter."
  afterCorrelationFilter: Int
  "Candidates remaining after the reasoning filter."
  afterReasoningFilter: Int
  "Candidates remaining after the reviewer filter."
  afterReviewerFilter: Int
