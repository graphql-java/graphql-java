type ForgeObservabilityMutation {
  """
  Publishes a custom metric emitted by a Forge app's frontend (browser-side) module.
  
  The app and installation identity is supplied by the trusted Atlassian frontend host,
  not the app's iframe. The request is validated before the metric is recorded.
  """
  publishFrontendCustomMetric(input: ForgeObservabilityPublishFrontendCustomMetricInput!): ForgeObservabilityPublishFrontendCustomMetricResponse
  """
  Publishes browser-side logs emitted by a Forge app frontend module.
  
  The trusted Atlassian frontend host supplies app, installation, and extension context.
  XLI validates and enriches that context before the logs are forwarded to the ingestion pipeline.
  """
  publishFrontendLogs(input: ForgeObservabilityPublishFrontendLogsInput!): ForgeObservabilityPublishFrontendLogsResponse @rateLimited(disabled : false, properties : [{argumentPath : "input.installationId"}], rate : 1000, usePerIpPolicy : false, usePerUserPolicy : false) @rateLimited(disabled : false, rate : 300, usePerIpPolicy : false, usePerUserPolicy : true)
  """
  Test-only mutation for exercising rate-limit keys nested five levels inside an input.
  
  The field is resolved by AGG's stubbed data fetcher and never calls the XLI service.
  """
  testNestedRateLimit(input: ForgeObservabilityNestedRateLimitLevelOneInput!): Boolean @rateLimited(disabled : false, properties : [{argumentPath : "input.level1.level2.level3.level4.level5"}], rate : 5, usePerIpPolicy : false, usePerUserPolicy : true) @stubbed
}

"Result of publishFrontendCustomMetric."
type ForgeObservabilityPublishFrontendCustomMetricResponse {
  "Whether the metric was accepted for publishing."
  success: Boolean!
}

"Result of publishFrontendLogs."
type ForgeObservabilityPublishFrontendLogsResponse {
  "Whether the logs were accepted for processing."
  success: Boolean!
}

