    currency: CommerceExpPricingPlanCurrency,
    "The ARI of the offering, e.g. ari:cloud:commerce::offering/<uuid>"
    offeringId: ID!,
    "The life cycle status of the pricing plans to return"
    status: CommerceExpPricingPlanStatus! = ACTIVE,
    "Only return pricing plans of this pricing plan type, e.g. COMMERCIAL"
    type: String
  ): [CommerceExpCcpPricingPlan!]
  "Get product with the given ID"
