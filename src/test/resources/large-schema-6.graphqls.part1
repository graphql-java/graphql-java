}

"Structured details for one error; which fields are set depends on errorType."
type DiscoveryErrorDetails {
  "Offending ids (unknown_collector, collector_provider_mismatch, unsupported_by_provider)."
  collectorIds: [ID!]
  "Offending ids (unknown_credential, request_id_conflict)."
  credentialIds: [ID!]
  "The step that must be saved first (discovery_job_step_out_of_order)."
  expectedStep: DiscoveryJobStep
  "The status the job is in (illegal_transition)."
  from: DiscoveryJobStatus
  "Rejected target lines, fields or scope ids (invalid_scope)."
  invalid: [DiscoveryInvalidScopeEntry!]
  "Rejected input fields (invalid_credential)."
  invalidFields: [DiscoveryInvalidField!]
  "Steps still missing (discovery_job_incomplete)."
  missing: [DiscoveryJobStep!]
  "Why (invalid_schedule, provider_not_enabled)."
  reason: String
  "What the provider cannot run (unsupported_by_provider)."
  unsupported: [String!]
}

"One rejected input field (invalid_credential). Never echoes the value."
