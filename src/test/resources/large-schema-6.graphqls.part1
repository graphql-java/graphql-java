type AgentWorkspaceShift {
  "ID of the agent assigned to this shift"
  agentId: ID!
  "Duration of the shift in minutes"
  durationMinutes: Int!
  "When the shift ends"
  endTime: DateTime!
  "Unique shift identifier (derived from schedule ID and date)"
  id: ID!
  "True when this shift occurrence has been cancelled for this specific agent via agentWorkspace_deleteShift."
  isCancelled: Boolean!
  "When this shift occurrence has been edited via agentWorkspace_editShift, this field is populated with the original end time before the edit."
  originalEndTime: DateTime
  "When this shift occurrence has been edited via agentWorkspace_editShift, this field is populated with the original start time before the edit."
  originalStartTime: DateTime
  "ID of the schedule this shift was generated from"
  scheduleId: ID!
  "Name of the schedule for display"
  scheduleName: String!
  "When the shift starts"
  startTime: DateTime!
  "The agent's user profile - hydrated from Identity service via AGG"
  user: User @hydrated(arguments : [{name : "accountIds", value : "$source.agentId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
}

type AgentWorkspaceShiftEditBounds {
  editableWindow: AgentWorkspaceTimeRange!
  "The end (right) edge of the editable window, with the reason why the bound is here."
  endBound: AgentWorkspaceShiftEditBoundsEdge!
  "The start (left) edge of the editable window, with the reason why the bound is here."
  startBound: AgentWorkspaceShiftEditBoundsEdge!
}

"A single edge of the editable window with a reason explaining why it is set where it is."
type AgentWorkspaceShiftEditBoundsEdge {
  "Why this bound is at this time."
  reason: AgentWorkspaceEditBoundReason!
  "The boundary time — matches either editableWindow.startTime (for the start edge) or editableWindow.endTime (for the end edge)."
  time: DateTime!
}

"""
The authenticated agent's notification preferences for a single space (project). Absence of a
stored record is represented as all toggles enabled (default-on).
"""
type AgentWorkspaceShiftNotificationPreference {
  "Cloud ID of the space's tenant (used to hydrate project details via jira_projectByIdOrKey)."
  cloudId: ID! @CloudID(owner : "jira")
  "Whether new-shift-assignment emails are enabled for this space. false = \"Off\"."
  newShiftAssignmentEnabled: Boolean!
  """
  Project details hydrated from Jira via AGG using `jira_projectByIdOrKey` (returns a concrete
  JiraProject, unlike the generic `node` field which returns the un-narrowable Node interface).
  Null when Jira cannot resolve the project (deleted / permission-denied for the caller).
  """
  project: JiraProject @hydrated(arguments : [{name : "cloudId", value : "$source.cloudId"}, {name : "idOrKey", value : "$source.projectNumericId"}], batchSize : 200, field : "jira_projectByIdOrKey", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "jira", timeout : -1)
  "Jira project ARI of the space these preferences apply to (cloud-scoped: ari:cloud:jira:CLOUD:project/ID)."
  projectId: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  "Numeric Jira project id (used as idOrKey when hydrating project details)."
  projectNumericId: ID!
  "Whether upcoming-shift reminder emails are enabled for this space. false = \"Off\"."
  shiftReminderEnabled: Boolean!
}

