  apiRequestCountValue(query: ForgeMetricsApiRequestQueryInput!): ForgeMetricsApiRequestCountDrilldownResult!
  apiRequestLatency(query: ForgeMetricsApiRequestQueryInput!): ForgeMetricsApiRequestLatencyResult!
