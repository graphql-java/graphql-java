  "Identifier of the client for authentication in ARI format"
  clientARI: ID!
  "Identifier of the client for authentication"
  clientID: ID!
  "isolated context ID"
  icId: String
  "Rotating refresh token status for the auth client"
  refreshToken: RefreshToken
  systemUser: SystemUser
}

