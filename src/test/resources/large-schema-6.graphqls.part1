type AdminOrgUnitsSettings {
  """
  Whether Unit boundary enforcement is enabled for the organisation. This is the single source of
  truth for the value of the setting; boundaryEnforcedEditability answers whether it can be
  changed right now.
  """
  boundaryEnforced: Boolean
  """
  Whether the boundaryEnforced setting can be changed right now, and if not, what is blocking the
  change. Resolved lazily from collaboration-context-manager only when selected, so the rest of
  this type stays a single TCS read. Null when the organisation is not yet on the Units GA
  release, in which case the setting is not changeable through this API at all.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AdminUnitsBoundaryEnforcedEditabilityProd")' query directive to the 'boundaryEnforcedEditability' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  boundaryEnforcedEditability: AdminUnitsBoundaryEnforcedEditability @lifecycle(allowThirdParties : false, name : "AdminUnitsBoundaryEnforcedEditabilityProd", stage : EXPERIMENTAL)
  "Whether the Units experience has been launched to end users of the organisation."
  endUsersLaunched: Boolean
  "Whether users in the organisation are allowed to create new Units."
  unitsCreateAvailable: Boolean!
  """
  Controls the state of the Units experience.
  One of UNITS_NOT_ELIGIBLE, UNITS_ELIGIBLE, UNITS_ACTIVATED.
  """
  unitsEligibilityState: AdminUnitsEligibilityState!
}

"Organization in Admin Hub."
type AdminOrganization {
  id: ID!
  "Name of the org."
  name: String
  """
    Retrieves an individual third-party identity participating in a qualifying
    third-party email-link relationship within this organization.
  
  Requires organization-admin access, the feature rollout gate, and an enabled
    organization linking setting. The identity must be resolved within validated
    backend scopes belonging to this organization; supplying its ARI is not proof
    of membership. Authorization and required dependency failures are GraphQL errors.
    Returns null when an authorized lookup finds no qualifying identity in scope.
  """
  thirdPartyUser(
    "The third-party identity ARI to resolve within this organization."
    id: ID!
  ): AdminThirdPartyUserIdentity
  """
    Discovers providers with qualifying email-linked third-party users across this
    organization's validated backend scopes, independently of a user search.
  
  A provider qualifies when at least one of its identities in this organization
    participates at either endpoint of the third-party-to-third-party email-link
    relationship. An associated Atlassian account does not disqualify the identity.
    Providers without a qualifying identity are omitted. Each canonical provider ID
    appears once across all pages, regardless of matching users, duplicate or
    reciprocal edges, integrations, or observations across sites.
  
  Requires organization-admin access, the feature rollout gate, and an enabled
    organization linking setting. Authorization and required dependency or scope
    failures fail discovery with a GraphQL error, rather than returning a successful
    partial list. An empty list means no providers qualify in the validated scopes.
  
  Supports forward pagination only; backward pagination is not supported.
  """
  thirdPartyUserProviders(
    "An opaque continuation cursor for provider discovery within this organization."
    after: String,
    """
    The maximum number of distinct providers to return in this page, from 1 to 50;
    defaults to 10. This page size is independent of the user-search result cap.
    """
    first: Int = 10
  ): AdminThirdPartyUserProviderConnection
  """
    Searches third-party identities by given name or email across this organization's
    eligible backend scopes and providers, without requiring provider selection.
  
  Returns one result per qualifying email-linked identity group, including identities
    with or without an associated Atlassian account. At least one member must match
    the search and participate in the agreed third-party-to-third-party email-link
    relationship. Other members need not independently match. Multiple matching
    members or observations across scopes must not duplicate the group.
  
  The search returns at most 50 distinct groups across all pages. This total cap
    is independent of the requested page size and any member-detail limit.
  
  Requires organization-admin access, the feature rollout gate, and an enabled
    organization linking setting. A required dependency or scope failure fails the
    search with a GraphQL error, rather than returning a successful partial result.
  
  Supports forward pagination only; backward pagination is not supported.
  """
  thirdPartyUserSearch(
    "An opaque continuation cursor for the same organization and search."
    after: String,
    "The maximum number of groups to return in this page, from 1 to 50; defaults to 10."
    first: Int = 10,
    "The search mode and value."
    input: AdminThirdPartyUserSearchInput!
  ): AdminThirdPartyUserSearchConnection
  "Units in the org."
  units(after: String, before: String, first: Int, last: Int): AdminUnitConnection
}

