  edges: [ActionsActionableAppEdge]
  pageInfo: PageInfo!
}

"A single entry in an actionable-app connection, pairing a cursor with the app"
type ActionsActionableAppEdge @apiGroup(name : ACTIONS) @renamed(from : "ActionableAppEdge") {
  cursor: String!
  node: ActionsActionableApp
}

"An action unavailable because of an organization or site administrator policy"
