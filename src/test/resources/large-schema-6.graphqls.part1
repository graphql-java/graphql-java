"""
Interface for board view elements that contain cells. This interface is implemented by types that provide access to
a connection of board view cells, such as column layouts (single dimension grouping) or swimlanes (row-based grouping).
Cells represent the intersection points on a board where issues are displayed.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
* __read:jira-work__
"""
interface JiraBoardViewCellContainer @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [READ_JIRA_WORK]) {
  """
  Connection of cells representing the contents to be rendered within this container.
  Each cell provides access to issues grouped based on the board's configuration.
  """
  cells(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int,
    "Settings to use when resolving the cells."
    settings: JiraBoardViewSettings
  ): JiraBoardViewCellConnection
}

"""


### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
* __read:jira-work__
"""
interface JiraBoardViewColumn implements Node @defaultHydration(batchSize : 200, field : "jira_boardViewColumnsByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [READ_JIRA_WORK]) {
  """
  Whether the column is collapsed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  collapsed: Boolean
  """
  Globally unique ID identifying this column.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID! @ARI(interpreted : false, owner : "jira", type : "board-column", usesActivationId : false)
}

"""
Represents a swimlane within a board view. Note: any `groupBy` setting passed to fields on this type is ignored;
it is always inferred from this swimlane.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
* __read:jira-work__
"""
interface JiraBoardViewSwimlane implements JiraBoardViewCellContainer & Node @defaultHydration(batchSize : 200, field : "jira_boardViewSwimlanesByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [READ_JIRA_WORK]) {
  """
  The avatar of this swimlane, if any.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  avatar: JiraAvatar
  """
  Connection of cells representing the contents of the columns within this swimlane to be rendered.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  cells(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int,
    """
    Settings to use when resolving the cells. Note: `groupBy` is ignored here; it is always inferred from
    this swimlane.
    """
    settings: JiraBoardViewSettings
  ): JiraBoardViewCellConnection
  """
  Whether the swimlane is collapsed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  collapsed: Boolean
  """
  Globally unique ID (board-swimlane ARI) identifying this swimlane.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID! @ARI(interpreted : false, owner : "jira", type : "board-swimlane", usesActivationId : false)
  """
  The display name of this swimlane, if any.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  name: String
  """
  The total number of issues in this swimlane.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  totalIssueCount(
    """
    Input for settings applied to the board view. Note: `groupBy` is ignored here; it is always inferred
    from this swimlane.
    """
    settings: JiraBoardViewSettings
  ): Int
}

