"Represents a single vertical instantiation."
type AssetsVerticalVerticalInstantiation {
  "Audit information."
  auditInfo: AssetsVerticalAuditInfo!
  """
  Whether this instantiation is currently eligible for user-initiated retry.
  This field can only be true when status is FAILED; for all other statuses it is always false.
  The backend owns the retry policy, including retry limits, so clients should use this to decide whether
  to show Retry or Contact Support.
  """
  canRetry: Boolean!
  "Optional expansion of categories for this vertical instantiation."
  categories(
    "Cursor after which to continue pagination."
    after: String,
    "Optional filter by category type."
    category: AssetsVerticalVerticalInstantiationCategoryType,
    "Maximum number of items to return."
    first: Int,
    "Optional filter by category status."
    status: AssetsVerticalVerticalInstantiationCategoryStatus
  ): AssetsVerticalVerticalInstantiationCategoryConnection
  "The tenant cloud identifier."
  cloudId: ID! @CloudID(owner : "assets-vertical")
  "Depreciation rules associated with this vertical instantiation."
  depreciationRules(
    "Cursor after which to continue pagination."
    after: String,
    "Maximum number of items to return."
    first: Int,
    "Optional filter by object type identifiers associated with the rule's asset types."
    objTypeIds: [ID!],
    """
    Optional case-insensitive substring match against the depreciation rule name.
    Leading/trailing whitespace is trimmed. Null or blank returns all matching rules.
    """
    searchText: String,
    """
    Optional single-column sort. When omitted, rules remain ordered by createdAt ascending
    then id ascending (existing default).
    """
    sort: AssetsVerticalDepreciationRulesSortInput
  ): AssetsVerticalDepreciationRuleConnection
  "Unique identifier (UUID)."
  id: ID!
  "Current status of the instantiation."
  status: AssetsVerticalVerticalInstantiationStatus!
  "The vertical type (Eg. HAM)."
  type: AssetsVerticalVerticalType!
  "Version string for the instantiation template."
  version: String!
  "Workspace identifier associated with this instantiation."
  workspaceId: ID!
}

"Represents a single category record within a vertical instantiation."
type AssetsVerticalVerticalInstantiationCategory {
  """
  Selected asset types for this category.
  Typically used for HARDWARE_ASSET_TYPES_SELECTION category.
  
  When no items are configured for this category, returns an empty connection.
  """
  assetTypesTrackings(
    "Cursor after which to continue pagination."
    after: String,
    "Maximum number of items to return."
    first: Int,
    "Optional filter by tracked object schema identifiers."
    objSchemaIds: [ID!],
    """
    Optional multi-select OR filter by direct parent object type identifiers.
    Null or empty leaves parent filtering unset.
    """
    parentObjectTypeIds: [ID!],
    """
    Optional case-insensitive substring match on the object type (OT) user-facing label
    (Tempeh `displayName` when present, else technical `name`).
    Leading/trailing whitespace is trimmed; null or blank returns all rows (after other filters).
    """
    searchText: String,
    """
    Optional sort by object type user-facing label (Tempeh `displayName` when present,
    else technical `name`). When omitted, results keep the default createdAt / id order
    from persistence.
    """
    sort: AssetsVerticalAssetTypesTrackingSortInput
  ): AssetsVerticalAssetTypesTrackingConnection
  "Audit information."
  auditInfo: AssetsVerticalAuditInfo!
  "The category represented by this record."
  category: AssetsVerticalVerticalInstantiationCategoryType!
  "The tenant cloud identifier."
  cloudId: ID! @CloudID(owner : "assets-vertical")
  "Unique identifier (UUID)."
  id: ID!
  """
  Selected work / request types mapped to spaces for this category.
  Typically used for ITEM_SELECTION category.
  
  When no items are configured for this category, returns an empty connection.
  """
  items(
    "Cursor after which to continue pagination."
    after: String,
    "Maximum number of items to return."
    first: Int,
    "Optional filter by item type."
    itemType: AssetsVerticalItemType,
    """
    Optional case-insensitive substring match on the bare request type name
    (Jira `name`, matching Settings UI / AGG). Applied in AVS after ITAM lookup hydrate —
    not Jira `searchString` (which filters composite `displayName`). Leading/trailing
    whitespace is trimmed; null or blank leaves search unset.
    """
    searchText: String,
    """
    Optional sort by bare request type name (from Jira lookup `name`). When omitted, results
    keep the default createdAt / id order from persistence (among rows surviving filters/search).
    """
    sort: AssetsVerticalItemMappingSortInput,
    "Optional filter by space identifiers."
    spaceIds: [ID!]
  ): AssetsVerticalItemMappingConnection
  """
  Persisted metadata for the space associated with this SPACE_CREATION category.
  Returns null for other category types and legacy space-creation records without persisted metadata.
  This is historical onboarding data; it does not guarantee the space still exists.
  """
  spaceDetails: AssetsVerticalSpaceDetails
  "Current status of the category."
  status: AssetsVerticalVerticalInstantiationCategoryStatus!
  "Identifier of the parent vertical instantiation."
  verticalInstantiationId: ID!
  "Workspace identifier associated with this category."
  workspaceId: ID!
}

