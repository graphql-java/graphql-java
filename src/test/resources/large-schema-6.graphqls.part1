"""


### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:content.metadata:confluence__
* __confluence:atlassian-external__
"""
type ConfluenceContentMetadata @scopes(product : CONFLUENCE, required : [READ_CONFLUENCE_CONTENT_METADATA]) @scopes(product : CONFLUENCE, required : [CONFLUENCE_ATLASSIAN_EXTERNAL]) {
  "Collaborative editing service type associated with Content."
  collaborativeEditingService: ConfluenceCollaborativeEditingService
  "Blueprint templateEntityId associated with the Content."
  sourceTemplateEntityId: String
  "Emoji metadata associated with draft Content."
  titleEmojiDraft: ConfluenceContentTitleEmoji
  "Emoji metadata associated with published Content."
  titleEmojiPublished: ConfluenceContentTitleEmoji
}

"Requester-owned temporary export operation. File identifiers and download credentials are never exposed in status."
type ConfluenceContentMetricsExport @apiGroup(name : CONFLUENCE_LEGACY) {
  completedAt: String
  createdAt: String!
  "File expiry, 24 hours after successful preparation. Known expired operations retain this timestamp."
  expiresAt: String
  failureCategory: ConfluenceContentMetricsExportFailureCategory
  id: ID!
  "Data rows written so far, excluding the header; never exceeds rowLimit."
  processedRows: Int!
  rowCount: Int
  "Fixed maximum number of data rows across the entire export."
  rowLimit: Int!
  settings: ConfluenceContentMetricsExportSettings
  state: ConfluenceContentMetricsExportState!
  updatedAt: String!
}

"Fresh file-scoped Media handoff; expires within five minutes and never outlives the file. Do not cache or log it."
type ConfluenceContentMetricsExportDownloadLink @apiGroup(name : CONFLUENCE_LEGACY) {
  expiresAt: String!
  fileName: String!
  url: String!
}

"The export's immutable reporting window, rating filters and ordering; later table changes do not alter these settings."
type ConfluenceContentMetricsExportSettings @apiGroup(name : CONFLUENCE_LEGACY) {
  endTimestamp: String!
  isAscending: Boolean!
  orderBy: ConfluenceContentPerformanceByCriteriaOrder
  ratings: [ConfluenceLoadTimeRating!]!
  startTimestamp: String!
}

