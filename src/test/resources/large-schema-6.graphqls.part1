}

"A single key moment in the incident timeline."
type AIOpsIncidentTimelineIccEntry {
  "Display name of the person who caused this event, if available."
  actorName: String
  "Structured category of this event."
  category: AIOpsIncidentTimelineIccCategory
  "Human-readable description of the event (e.g. 'Responders added: Alice', 'Severity set to SEV-1')."
  description: String
  "Importance tier — consumers can use this for sort/filter without re-implementing server-side priority rules."
  importance: AIOpsIncidentTimelineIccImportance
  "When this event occurred."
  timestamp: DateTime
}

"""
Response for the aiops_incidentTimelineIcc query.
Contains a chronologically sorted list of key moments in the incident lifecycle.
"""
type AIOpsIncidentTimelineIccResponse {
  "Chronologically sorted (ASC by timestamp) list of selected key moments."
  entries: [AIOpsIncidentTimelineIccEntry!]
  "Total number of entries that existed before any server-side trim. Equal to entries.size when `limit` is null."
  totalAvailable: Int
}

"Details of a service examined during an RCA investigation."
type AIOpsInvestigatedServiceDetail {
  "Whether a source code repository is linked to this service."
  hasRepository: Boolean
  "ARI of the service in the DevOps service registry."
  serviceAri: String
  "Human-readable name of the service."
  serviceName: String
}

"RCA Investigation for a Jira incident issue."
type AIOpsInvestigation {
  """
  When the investigation was created (epoch millis).
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  createdAt: Long
  """
  The user who created the investigation, if applicable.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  createdBy: User @idHydrated(idField : "createdByAccountId", identifiedBy : "accountId")
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  id: ID!
  """
  The inputs used to create this investigation.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  input: AIOpsInvestigationInputContext!
  """
  When the investigation was last updated (epoch millis).
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  lastUpdatedAt: Long
  """
  What the current caller may do with this investigation. Gates Terminate and Re-run.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  permissions: AIOpsInvestigationPermissions
  """
  Current status of the investigation.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  status: AIOpsInvestigationStatus
  """
  Retrieve a single task by its identifier.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  task(taskId: String!): AIOpsInvestigationTask
  """
  Ordered list of tasks in this investigation.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  tasks: [AIOpsInvestigationTask!]
  """
  Terminal state of the investigation — present only when the investigation has reached a final state (completed or terminated).
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  terminalState: AIOpsInvestigationResult
  """
  Display label for this run's place in the incident's re-run sequence: "v1" for the original run,
  "v2" for the first re-run, and so on. Formatted server-side so every surface renders one label.
  
  Derived from the run's stored attempt number, not its position in a response, so the newest of 15
  runs is "v15" even at the top of a 10-row page.
  
  Null for classic (non-agentic) investigations, which keep no attempt counter.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  versionLabel: String
}

"The result produced by a completed RCA investigation."
type AIOpsInvestigationCompleted {
  """
  Funnel counts for change candidates evaluated during the investigation (stringified JSON). Deprecated: use changeCandidateFunnelMetrics.
  
  
  This field is **deprecated** and will be removed in the future
  """
  changeCandidateFunnelCounts: String
  "Funnel counts for change candidates evaluated during the investigation, as a typed object."
  changeCandidateFunnelMetrics: AIOpsChangeCandidateFunnelCounts
  "Top-level error message if the investigation encountered a fatal error."
  error: String
  "Summary of error context gathered during the investigation (stringified JSON)."
  errorContextSummary: String
  "Ranked list of hypotheses identified by the investigation."
  hypotheses: [AIOpsInvestigationHypothesis!]
  "Full investigation journey trace."
  investigationJourney: String
  """
  Ranked list of likely root causes identified by the investigation.
  
  
  This field is **deprecated** and will be removed in the future
  """
  likelyRootCauses: [AIOpsLikelyRootCause!]
  "High-level explanation of why no root cause was identified, when the investigation produced no root causes. Stringified ADF document for agentic investigations."
  noRCARationale: String
  "Count of entities processed during the investigation, keyed by entity type."
  processedEntitiesCount: [AIOpsEntityCount!]
}

"""
An incident's agentic investigations, newest first.

Paginated because runs accumulate per re-run and the table has no TTL, so the collection is
unbounded in principle.

For permissions, select `AIOpsInvestigation.permissions` on a node. A refusal arrives as a
FORBIDDEN error rather than as data: a Relay-paginated field must resolve statically to a
connection type, so it cannot be a result union.
"""
type AIOpsInvestigationConnection {
  "Edges with a per-item opaque cursor. The usual way to paginate."
  edges: [AIOpsInvestigationEdge!]
  """
  The same nodes as `edges`, collapsed for clients that do not need a cursor per item.
  
  Select this or `edges`, not both, or the payload carries each run twice.
  """
  nodes: [AIOpsInvestigation!]
  "Standard Relay page info. `endCursor` is the cursor of the last edge on this page."
  pageInfo: PageInfo!
}

type AIOpsInvestigationEdge {
  """
  Opaque cursor marking this investigation's place in the history order.
  
  Treat it as opaque and pass it back verbatim as `after`. Newer runs arriving above it do not
  invalidate it, and it stays stable for a run that shares its creation millisecond with another.
  """
  cursor: String!
  node: AIOpsInvestigation
}

"A root cause hypothesis produced by an RCA investigation."
type AIOpsInvestigationHypothesis implements AIOpsRootCauseHypothesis {
  "Human-readable confidence band."
  confidenceLabel: AIOpsLikelyRootCauseConfidenceLabel
  "Ranked evidence supporting this hypothesis."
  evidence: [AIOpsHypothesisEvidence!]
  "Change-artefact tags attributed to this hypothesis."
  faultyChangeTags: [AIOpsFaultyChangeTag!]
  "The faulty DevOps service resolved via hydration."
  faultyService: DevOpsService @hydrated(arguments : [{name : "id", value : "$source.faultyServiceId"}], batchSize : 100, field : "devOpsService", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "devops_service", timeout : -1)
  "Assets CMDB object for the faulty service."
  faultyServiceAssetObject: AIOpsAssetServiceObject
  "ARI of this hypothesis: ari:cloud:aiops::investigation-hypothesis/activation/{activationId}/{investigationId}/{hypothesisId}."
  id: ID!
  """
  The mitigation generated for this hypothesis, if one has been requested. Null otherwise.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "PlaybooksInJSM")' query directive to the 'mitigation' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  mitigation: HypothesisMitigation @hydrated(arguments : [{name : "cloudId", value : "$source.cloudId"}, {name : "investigationId", value : "$source.investigationId"}, {name : "hypothesisId", value : "$source.rootCauseSuggestionId"}], batchSize : 200, field : "playbook_hypothesisMitigationByHypothesis", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "automation_playbook", timeout : -1) @lifecycle(allowThirdParties : false, name : "PlaybooksInJSM", stage : EXPERIMENTAL)
  "Full reasoning trace (stringified JSON)."
  reasoning: String
  "Identifier of this hypothesis within its investigation."
  rootCauseSuggestionId: ID!
  "Short, ML-generated summary of this hypothesis."
  summary: String
}

"Investigation is actively running — exposes live task progress."
type AIOpsInvestigationInProgress {
  """
  Describes the investigation agent's current runtime activity while the
  investigation is IN_PROGRESS (e.g. planning/checking, waiting for tool
  responses, dispatching the next steps, or generally working). Derived from the
  agent's live runtime state and updated at least as frequently as tasks.
  Nullable: no activity is reported before the run has begun emitting, and none
  is present once the investigation is no longer in progress.
  """
  currentActivity: String
  """
  Tasks in display order. Each task maps 1:1 to a BE InvestigationSectionId.
  Use taskId to look up a specific task via investigation.task(taskId).
  """
  tasks: [AIOpsInvestigationTask!]
}

"The inputs used to create an RCA investigation."
type AIOpsInvestigationInputContext {
  "Assets CMDB objects for the in-scope services. Resolved via AssetsClient."
  inScopeServiceAssetObjects: [AIOpsAssetServiceObject!]
  "ARIs of the DevOps services in scope for this investigation."
  inScopeServiceIds: [ID!]
  "ID of the source entity (e.g. Jira issue ID) that triggered the investigation."
  sourceEntityId: String!
  "Type of the source entity."
  sourceEntityType: AIOpsInvestigationSourceEntityType!
  "The Jira issue that triggered this investigation. Hydrated from sourceEntityAri."
  sourceJiraIssue: JiraIssue @hydrated(arguments : [{name : "ids", value : "$source.sourceEntityAri"}], batchSize : 50, field : "jira_issuesByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "gira", timeout : -1)
}

"""
Returned when no investigation exists yet for the incident.

This is a normal outcome, not a failure. It carries permissions so clients can decide
whether to offer the "start investigation" action.
"""
type AIOpsInvestigationNotFound {
  "What the current caller may do for this incident."
  permissions: AIOpsInvestigationPermissions
}

"""
What the current caller may do, evaluated against their role on the source incident.

All flags are true while permission enforcement is disabled, so clients may adopt these
fields before enforcement is switched on.
"""
type AIOpsInvestigationPermissions {
  """
  Superseded by canUpdateInvestigation, which is named for the operation rather than one instance of it.
  
  
  This field is **deprecated** and will be removed in the future
  """
  canCancelInvestigation: Boolean
  "Whether the caller may start an investigation for this incident, including re-running a terminal one."
  canStartInvestigation: Boolean
  "Whether the caller may modify an in-flight investigation. Terminate is the only such action today."
  canUpdateInvestigation: Boolean
  "Whether the caller may view this investigation and its outputs."
  canViewInvestigation: Boolean
}

"A progress item emitted by a task during execution."
type AIOpsInvestigationProgressItem {
  "Human-readable progress message."
  text: String
  "Severity / category of the progress item."
  type: AIOpsInvestigationProgressItemType
}

"A single task within an RCA investigation plan."
type AIOpsInvestigationTask {
  "When the task finished executing."
  completedAt: DateTime
  "Documents this step read or cited, rendered as its source list. Absent when there are none."
  documents: [AIOpsInvestigationTaskDocument!]
  "Wall-clock duration of the task in seconds."
  durationSeconds: Int
  """
  Icon for the step, as an SVG URL. Usually relative to the product origin, so resolve it against the
  page the client is on. Absent means the client's default icon.
  """
  iconUrl: String
  "Output produced by the task — null until the task completes (implicitly @stubbed via the union type)."
  output: AIOpsInvestigationTaskOutput
  "Stored parent delegation task identifier for a child step."
  parentTaskId: String
  "Progress items emitted during task execution."
  progressInfo: [AIOpsInvestigationProgressItem!]
  """
  Ordered content segments, each one complete Markdown string. Clients render each segment
  separately and keep both the order and the segment boundaries. Segments are only ever
  appended. Null for classic (non-agentic) tasks.
  """
  separatedContent: [String!]
  "When the task started executing."
  startedAt: DateTime
  "Current execution state of the task."
  state: AIOpsInvestigationTaskState
  """
  Concise outcome summary for this step, describing what it did or concluded.
  For a FAILED step this carries the concrete failure reason; for a successfully
  finished step it carries the success summary. Single-sourced from the step's
  normalized presentation fields (failure reason on failure, otherwise the
  success summary). Use `state` to distinguish success from failure.
  Nullable: absent until the step produces an outcome.
  """
  summary: String
  "Stable identifier for this task within its investigation."
  taskId: String!
  "Stored execution scope, such as ROOT or a child execution identifier."
  taskScopeId: String
  "Human-readable title for the task."
  title: String
  "The kind of analysis this task performs."
  type: AIOpsInvestigationTaskType
}

"A document an investigation step read or cited."
type AIOpsInvestigationTaskDocument {
  """
  Icon for the document's source product, as an SVG URL. Usually relative to the product origin, so
  resolve it against the page the client is on.
  """
  iconUrl: String
  "Display title of the document."
  title: String
  "Link to the document."
  url: String
}

"Represents an investigation that was terminated before producing a result."
type AIOpsInvestigationTerminated {
  "When the investigation was terminated (epoch millis)."
  terminatedAt: Long
  "The user who terminated the investigation, if applicable."
  terminatedBy: User @idHydrated(idField : "terminatedByAccountId", identifiedBy : "accountId")
}

"A single likely root cause hypothesis produced by the RCA investigation."
type AIOpsLikelyRootCause implements AIOpsRootCauseHypothesis {
  "Human-readable confidence band."
  confidenceLabel: AIOpsLikelyRootCauseConfidenceLabel
  """
  The complete, ranked list of evidence supporting this hypothesis, rendered in
  the related-evidence section for the selected hypothesis. Includes any evidence
  category (e.g. METRIC, KB, ALERT, INCIDENT, PR, COMMIT, FF, DEPLOYMENT).
  """
  evidence: [AIOpsHypothesisEvidence!]
  "The change identified as the likely cause, if any."
  faultyChange: AIOpsFaultyChange
  """
  Curated set of change-artefact tags attributed to this hypothesis. The server
  determines which change artefacts are surfaced here. Contextual evidence the
  investigation read rather than attributed blame to — KB, ALERT and INCIDENT —
  is excluded; use `evidence` for the complete ranked list.
  """
  faultyChangeTags: [AIOpsFaultyChangeTag!]
  "The faulty DevOps service resolved via hydration."
  faultyService: DevOpsService @hydrated(arguments : [{name : "id", value : "$source.faultyServiceId"}], batchSize : 100, field : "devOpsService", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "devops_service", timeout : -1)
  "Assets CMDB object for the faulty service. Resolved via AssetsClient."
  faultyServiceAssetObject: AIOpsAssetServiceObject
  "Full reasoning trace (stringified JSON)."
  reasoning: String
  "Prose summary of the reasoning."
  reasoningSummary: String
  "Current review status for this hypothesis."
  reviewStatus: AIOpsLikelyRootCauseReviewStatus
  "When the hypothesis was reviewed (epoch millis)."
  reviewedAt: Long
  "The user who reviewed this hypothesis, if any."
  reviewedBy: User @idHydrated(idField : "reviewedByAccountId", identifiedBy : "accountId")
  "Stable identifier for this root cause suggestion."
  rootCauseSuggestionId: ID!
  "Confidence score for this hypothesis (0.0–1.0)."
  score: Float
  "Short, ML-generated summary of this hypothesis, shown as the hypothesis card blurb."
  summary: String
}

"A single alert linked to an incident. Reuses AIOpsRelatedAlertPriority/Status/Responder enums for consistency across alert tools."
type AIOpsLinkedAlert {
  acknowledged: Boolean
  "Deep link into JSM Ops' alert detail page."
  alertDetailsPagePath: String
  count: Int
  createdAt: Long
  id: ID!
  message: String
  owner: String
  ownerTeamId: String
  priority: AIOpsRelatedAlertPriority
  responders: [AIOpsRelatedAlertResponder!]!
  snoozed: Boolean
  status: AIOpsRelatedAlertStatus
  tinyId: String
}

