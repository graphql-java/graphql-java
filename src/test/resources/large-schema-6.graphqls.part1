  entries: [AgentWorkspaceDraftedRoutingTableEntry!]!
}

"""
A single drafted routing-table entry as exposed to the wizard Step 2 UI. Symmetric with
[AgentWorkspaceRoutingTableEntry] so a "promote draft → live" mutation can map field-by-field.
"""
type AgentWorkspaceDraftedRoutingTableEntry {
  "AI confidence score in `[0.0, 1.0]`. Null when the AI did not return a confidence value."
  confidence: Float
  "Drafted natural-language description of when to route here. May be null for partially-filled draft rows."
  description: String
  "Draft session UUID this row is persisted under."
  draftId: ID!
  "Whether this drafted service row should be promoted into the live routing table on submit."
  included: Boolean!
  "Stable service identifier (matches the source field option id; SK in the persistent draft)."
  serviceId: ID!
  "Display name of the service for this draft row."
  serviceName: String!
  """
  Skills required to handle work routed to this service. Nullable until the services-and-skills
  mapping table (owned by another team) is integrated; once integrated, this will reflect the
  per-service skill list. Empty list when the service has no skills configured. FE should select
  the subset of `AgentWorkspaceSkill` fields it needs (e.g. `{ id, name }`).
  """
  skills: [AgentWorkspaceSkill!]
  """
  Owning team hydrated from the Identity service via AGG (name + avatar for display).
  Resolved from `teamAri`; null when `teamAri` is null, or when the team has been deleted
  or is not visible to the caller.
  """
  team: TeamV2 @hydrated(arguments : [{name : "ids", value : "$source.teamAri"}], batchSize : 50, field : "team.teamsV2Hydration", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  "Drafted owning team ARI. Null when the AI was unable to pick a team confidently."
  teamAri: ID
  """
  Deprecated legacy row version. Always returned as `0`; callers should not use this for concurrency control.
  
  
  This field is **deprecated** and will be removed in the future
  """
  version: Int!
}

"""
Draft status for a project's routing table, returned by agentWorkspace_draftedRoutingTableStatus.
Never throws not-found; all fields are nullable when no status row exists.
"""
type AgentWorkspaceDraftedRoutingTableStatus {
  "Draft session UUID for the project's current draft, when one exists."
  draftId: ID
  """
  The custom field ID that the project's current draft is scoped to.
  Null when no draft has been created or when the draft has expired/been deleted.
  """
  serviceFieldId: String
}

