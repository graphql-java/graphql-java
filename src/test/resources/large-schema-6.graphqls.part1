type AIOpsIncidentSuggestedResource {
  """
  Direct link to the resource (e.g. URL of the Confluence page, Jira issue,
  Slack message, or third-party document).
  """
  link: String
  resourceAri: ID
  """
  Higher-level grouping of `type` (e.g. CONFLUENCE, INCIDENT, PIR, ARTICLES_3P).
  Useful for clients that want to render resources grouped by category.
  """
  resourceGroupType: AIOpsIncidentSuggestedResourceGroupType
  """
  Source-system identifier for this resource (e.g. Jira issue id, Confluence
  page id). This is **not** an Atlassian Resource Identifier (ARI).
  """
  resourceId: String
  """
  Source-system human-readable key for the resource, where applicable
  (e.g. Jira issue key such as `INC-123`).
  """
  resourceKey: String
  """
  Relevance score assigned by the ranking pipeline. Higher values indicate
  greater predicted relevance to the incident. Not a stable identifier and
  not directly comparable across resource types.
  """
  score: Float
  """
  Short, human-readable summary describing the resource's contents or
  relevance to the incident.
  """
  summary: String
  "The concrete type of the resource, e.g. KB article, past incident, PIR."
  type: AIOpsIncidentSuggestedResourceType
}

