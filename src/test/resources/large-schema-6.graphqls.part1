  defaultTeam: ID @ARI(interpreted : false, owner : "identity", type : "team", usesActivationId : false)
  "Whether smart routing is currently enabled for this project."
  enabled: Boolean!
  "Complete configurable-routing input mapping in enum declaration order."
  inputs: [AgentWorkspaceConfigurableRoutingInputSetting!]!
  "Routing target mode for this project. Null when the project has not selected a mode."
  routingMode: AgentWorkspaceSmartRoutingMode
  "Identifier of the Jira field used as the routing service field, if one has been selected."
  serviceFieldId: String
  "Human-readable name of the Jira field used as the routing service field, if one has been selected."
  serviceFieldName: String
  "Type of the Jira field used as the routing service field, if one has been selected."
  serviceFieldType: AgentWorkspaceSmartRoutingServiceFieldType
  "Deprecated legacy setup version. Always returned as `0`; callers should not use this for concurrency control."
  setupVersion: Int!
