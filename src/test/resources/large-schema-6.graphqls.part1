"An EntitlementReactivationForBac contains properties required to place reactivation order"
type CommerceExpEntitlementReactivationForBac {
  "BillingAnchorTime from CCP defaults API"
  billingAnchorTime: Float
  """
  Active paid entitlement whose billing anchor and end date the reactivation is aligned to.
  When present, the first bill is prorated to its next billing or end date. Null for FREE entitlements.
  """
  effectiveBillingEntitlement: CommerceExpCcpEntitlement
  "Endtimestamp from CCP default API"
  endTimestamp: Float
  "InvoiceGroup from CCP defaults API"
  invoiceGroup: CommerceExpCcpInvoiceGroup
  "The offering the entitlement reactivation is for"
  offering: CcpOffering @hydrated(arguments : [{name : "ids", value : "$source.offeringAri"}], batchSize : 90, field : "ccp_offerings", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  "Offering ID in ARI format"
  offeringAri: String
  "Offering ID"
  offeringId: ID
  "PricingPlan from CCP defaults API"
  pricingPlan: CommerceExpCcpPricingPlan
  "valid reactivation order request payload"
  validReactivationOrder: CommerceExpValidOrderResponse
}

"An EntitlementTransitionForBac contains properties necessary to render the comparison table"
type CommerceExpEntitlementTransitionForBac {
  "BillingAnchorTime from CCP defaults API"
  billingAnchorTime: Float
  "The offering Billing cycle"
  billingCycle: CommerceExpBillingCycle
  "InvoiceGroup from CCP defaults API"
  invoiceGroup: CommerceExpCcpInvoiceGroup
  "If the current transition is recommended transition"
  isRecommendedTransition: Boolean
  "If the current transition is eligible for trial"
  isTrialAvailable: Boolean
  "The target Offering's media-storage usage limit in bytes"
  mediaStorageLimitBytes: Float
  "The offering the entitlement transition is for"
  offering: CcpOffering @hydrated(arguments : [{name : "ids", value : "$source.offeringId"}], batchSize : 90, field : "ccp_offerings", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  "Feature in the offering, only available for apps"
  offeringFeatures: CommerceExpOfferingFeatures
  "The offering to transition to"
  offeringId: ID
  "CcpOrderPreview from CCP order preview API"
  orderPreview: CommerceExpCcpOrderPreview
  "CcpOderPreivew error response"
  orderPreviewError: CommerceExpCcpOrderValidationError
  "PricingPlan from CCP defaults API"
  pricingPlan: CommerceExpCcpPricingPlan
  "The Raw order payload sent to Order Preview"
  rawOrder: JSON @suppressValidationRule(rules : ["JSON"])
  "If this is the current selected offering this order has no effect"
  transitionResult: CommerceExpEntitlementTransitionResultForBac
}

