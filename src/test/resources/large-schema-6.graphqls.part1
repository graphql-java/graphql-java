type DevAiAutodevNextWorkItem {
  assignedAt: DateTime
  assignee: User @idHydrated(idField : "assigneeUserAri", identifiedBy : null)
  assigneeUserAri: ID @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false) @hidden
  """
  Details captured by the latest classification run for this work item. Null for items that
  have not been classified yet or whose origin does not produce classification metadata.
  """
  classification: DevAiAutodevNextWorkItemClassification
  id: ID!
  isOverdue: Boolean
  jiraIssue: JiraIssue @idHydrated(idField : "jiraWorkItemAri", identifiedBy : null)
  jiraWorkItemAri: ID @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false) @hidden
  """
  The most recently started execution session for this work item, when one exists.
  Resolved from autodev-next execution session records only when requested. Useful for
  telling whether a work item is currently being worked on (STARTING/RUNNING), stuck, or
  last failed, independent of whether it has produced a pull request yet.
  """
  latestExecutionSession: DevAiAutodevNextWorkExecutionSession
  """
  Decline reason recorded for the latest pull request created for this work item, when available.
  Resolved from the same execution session record as pullRequestUrl.
  """
  pullRequestDeclineReason: String
  """
  Status of the latest pull request created for this work item, when available. Resolved from
  the same execution session record as pullRequestUrl.
  """
  pullRequestStatus: ID
  """
  URL of the latest pull request created for this work item, when available. Resolved from
  autodev-next execution session records only when requested; null until an execution session
  has recorded a pull request URL.
  """
  pullRequestUrl: String
  """
  Identifier of the repository this work item targets, when known (the first entry of
  the underlying WorkItemMetadata.targetRepositories list). Populated for any work item
  whose origin already carries a repository association — for example, a standards scan,
  or a backlog item the classifier triaged into a specific repo. Null when no repository
  is associated yet. Owned by autodev-next; not available via Jira federation.
  """
  repository: String
  """
  When the work item was first ingested into autodev-next (i.e. row creation). Owned by
  autodev-next; distinct from the underlying Jira issue's created timestamp. UI uses this for
  the "date requested" column and overdue calculation.
  """
  requestedAt: DateTime
  state: DevAiAutodevNextWorkItemState
  workItemState: ID
  workstream: DevAiAutodevNextWorkstream
}

