type AVPAnalyticsManifestGraph {
  "All edges, or only those of the given types (empty, the default, means all)"
  edges(types: [AVPAnalyticsManifestGraphEdgeType!]! = []): [AVPAnalyticsManifestGraphEdge!]!
  "A node by ID, for example metric:rovo/average_converged_deflection_rate"
  node(id: ID!): AVPAnalyticsManifestGraphNode
  "All nodes, or only those of the given types (empty, the default, means all)"
  nodes(types: [AVPAnalyticsManifestGraphNodeType!]! = []): [AVPAnalyticsManifestGraphNode!]!
  "Version of the semantic layer the graph was built from"
  semanticLayerVersion: String
}

type AVPAnalyticsManifestGraphDimensionDetails {
  "categorical, time, dynamic or union"
  dimensionType: String
  isHistorical: Boolean!
  providerId: String
  scope: String
}

type AVPAnalyticsManifestGraphEdge {
  "COMPOSED_OF union members only: dimensions fixed for this member"
  fixedDimensions: [String!]
  source: AVPAnalyticsManifestGraphNode!
  target: AVPAnalyticsManifestGraphNode!
  type: AVPAnalyticsManifestGraphEdgeType!
  "CAN_GROUP_BY only: the historical alias dimension the service uses in place of the target"
  via: String
}

type AVPAnalyticsManifestGraphMetricDetails {
  "Union metrics only: how member values are combined"
  agg: String
  capabilities: [String!]!
  isDeprecated: Boolean!
  "simple, ratio, union, group or unaggregated"
  metricType: String
  "Ratio metrics only: the denominator is summed over the whole result"
  overTotal: Boolean!
  providerId: String
  unit: String
}

type AVPAnalyticsManifestGraphNode {
  "Set on resolved dimension nodes"
  dimension: AVPAnalyticsManifestGraphDimensionDetails
  "Text to embed for semantic search"
  embeddingText: String!
  "<type>:<product>/<name>, for example metric:jira/issue_count. Providers, products and dimensions whose product is unknown omit the product part."
  id: ID!
  "Edges arriving at this node, or only those of the given types (empty, the default, means all)"
  incoming(types: [AVPAnalyticsManifestGraphEdgeType!]! = []): [AVPAnalyticsManifestGraphEdge!]!
  label: String
  "Set on resolved metric nodes"
  metric: AVPAnalyticsManifestGraphMetricDetails
  name: String!
  "Edges leaving this node, or only those of the given types (empty, the default, means all)"
  outgoing(types: [AVPAnalyticsManifestGraphEdgeType!]! = []): [AVPAnalyticsManifestGraphEdge!]!
  product: String
  type: AVPAnalyticsManifestGraphNodeType!
  "True when the node is referenced but absent from the manifest: a hidden metric, a stripped alias dimension, or an item outside the source-app scope"
  unresolved: Boolean!
}

