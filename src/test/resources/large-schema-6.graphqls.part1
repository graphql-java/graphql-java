  edges: [DevAiScmAdminRepositoryEdge!]!
  """
  True when there are more repositories than `totalCount`, so `totalCount` and `triggerModeCounts` are lower bounds.
  Only computed when selected.
  """
  hasMoreThanTotalCount: Boolean
  pageInfo: PageInfo!
  """
  Number of repositories across all pages, up to a limit (500). Only computed when selected. When there are more,
  this is the limit and `hasMoreThanTotalCount` is true, so show it as "500+".
  """
  totalCount: Int
  """
  Number of repositories across all pages for each trigger mode. Every trigger mode is listed, with 0 when none match.
  Only computed when selected. Covers the same repositories as `totalCount`.
  """
  triggerModeCounts: [DevAiScmAdminTriggerModeCount!]
}

