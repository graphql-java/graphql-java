"Root cause hypothesis fields shared by AIOpsLikelyRootCause and AIOpsInvestigationHypothesis."
interface AIOpsRootCauseHypothesis {
  confidenceLabel: AIOpsLikelyRootCauseConfidenceLabel
  evidence: [AIOpsHypothesisEvidence!]
  faultyChangeTags: [AIOpsFaultyChangeTag!]
  faultyService: DevOpsService @hydrated(arguments : [{name : "id", value : "$source.faultyServiceId"}], batchSize : 100, field : "devOpsService", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "devops_service", timeout : -1)
  faultyServiceAssetObject: AIOpsAssetServiceObject
  reasoning: String
  rootCauseSuggestionId: ID!
  summary: String
}

"""
Common interface for all activity types in the service timeline.
Use __typename or type to discriminate concrete items and select type-specific fields.
"""
interface AIOpsServiceActivity {
  """
  Source-system identifier of the underlying entity. Pass this value unchanged
  as the entityId argument to aiops_entityDetail.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  entityId: ID!
  """
  When the activity occurred.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  timestamp: DateTime!
  """
  Type discriminator for this activity.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  type: AIOpsActivityEntityType!
}

interface AIOpsUnifiedConnector {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  authStatus: AIOpsConnectorAuthStatus!
