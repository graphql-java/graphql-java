  requestTypeId: String!
  "Echoed from the request input. Null when the input was tool-level (no skillName)."
  skillName: String
  "Echoed from the request input."
  tool: String!
  "Deduplicated total tickets in this bucket — the canonical SCARD value."
  totalTickets: Int!
  "True when totalTickets > workItemIds.size — i.e. the cap was hit upstream."
  truncated: Boolean!
  "Ticket IDs in this bucket. Server-side capped at SKILL_GAP_TICKET_CAP (2000). Empty list when no tickets matched."
  workItemIds: [ID!]!
}

"Returned by aiCoreApi_fetchRsaSkillTickets. Mirrors the job-status envelope used by aiCoreApi_fetchRsaReport."
type AiCoreApiRsaSkillTicketsPayload {
