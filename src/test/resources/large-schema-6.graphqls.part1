"""
Tenant-wide aggregates over active hardware (hardware rows with deleted_at IS NULL) across every integration of
the tenant. Day and month boundaries are UTC. Each section is read on its own and is internally consistent; a
section that cannot be read is null and carries its own error.
"""
type DiscoveryOverview {
  "Active hardware by CDM type, largest first; OTHER is the fallback type."
  assetsByType: [DiscoveryOverviewTypeCount!]
  "Active hardware matched against the tenant's IP, IP_RANGE and CIDR scan scopes."
  ipCoverage: DiscoveryOverviewIpCoverage
  "Active hardware by operating system family."
  operatingSystems: DiscoveryOverviewOperatingSystems
  "The four tiles shared by the Overview and Records tabs."
  summary: DiscoveryOverviewSummary
  "First-seen trend for the month-on-month chart."
  trend: DiscoveryOverviewTrend
}

"total = recognised + unrecognised. Unrecognised means hardware.entity_type is the fallback OTHER (legacy MISCELLANEOUS rows included)."
type DiscoveryOverviewAssetSplit {
  recognised: Long!
  total: Long!
  unrecognised: Long!
}

type DiscoveryOverviewIpCoverage {
  "Hardware whose ip_address parses but lies in no scope."
  outsideScopes: DiscoveryOverviewAssetSplit!
  """
  One row per scan_scope of type IP, IP_RANGE or CIDR in the tenant. Which jobs use a scope, and whether as an
  inclusion or an exclusion, is not considered (scan_scope has no action; discovery_job_scope is not read).
  HOSTNAME and ACTIVE_DIRECTORY scopes are not rows. Scopes may overlap, so one asset can count in several rows.
  """
  scanScopes: [DiscoveryOverviewScanScopeCoverage!]!
  "Hardware with no ip_address, or one that is not a single valid IPv4 or IPv6 address."
  withoutAddress: DiscoveryOverviewAssetSplit!
}

type DiscoveryOverviewMonth {
  "Active hardware first seen in or before this month. The last value plus trend.undated equals summary.discovered.total."
  cumulative: DiscoveryOverviewAssetSplit!
  "Active hardware first seen in this month."
  firstSeen: DiscoveryOverviewAssetSplit!
  "First day of the UTC month."
  month: Date!
}

type DiscoveryOverviewMonthlyChange {
  "hardware.first_seen_at in the current month, up to now."
  current: Long!
  "First day of the current UTC month, for the label."
  month: Date!
  "hardware.first_seen_at anywhere in the previous month."
  previous: Long!
}

type DiscoveryOverviewOperatingSystemCount {
  count: Long!
  family: String!
}

type DiscoveryOverviewOperatingSystems {
  "Known families, largest first. Grouped case-insensitively on operating_system.os_family."
  families: [DiscoveryOverviewOperatingSystemCount!]!
  "Hardware with no operating system, a deleted one, or one without a family."
  unknown: Long!
}

type DiscoveryOverviewRangeCoverage {
  assets: DiscoveryOverviewAssetSplit!
  "A single IP, an inclusive first-last range, or a CIDR network, as stored."
  range: String!
}

type DiscoveryOverviewScanScopeCoverage {
  "Each asset counted once for the scope."
  assets: DiscoveryOverviewAssetSplit!
  "The scope's valid, de-duplicated range literals in stored order, each with its own counts. Ranges may overlap, so they need not add up to assets."
  ranges: [DiscoveryOverviewRangeCoverage!]!
  "The scope itself; its definition lists every stored value, valid or not. Ids change whenever the job's scope step is saved."
  scanScope: DiscoveryScanScope!
}

"stale + recent + unknown = summary.discovered.total."
type DiscoveryOverviewStaleAssets {
  "Seen within staleAfterDays."
  recent: Long!
  "hardware.last_seen_at older than staleAfterDays."
  stale: Long!
  "The threshold, for the tile label (30)."
  staleAfterDays: Int!
  "No last_seen_at reported."
  unknown: Long!
}

type DiscoveryOverviewSummary {
  "Tile 'Billable assets'. Closed EAP definition: active hardware source records, not deduplicated across sources. Expected to change."
  billable: Long!
  "Tiles 'Total discovered assets' and 'Unrecognised assets'. Includes hardware without a first_seen_at."
  discovered: DiscoveryOverviewAssetSplit!
  "Trend of the total tile: hardware first seen this month so far versus the whole of last month."
  newThisMonth: DiscoveryOverviewMonthlyChange!
  "Tile 'Stale assets'."
  stale: DiscoveryOverviewStaleAssets!
}

type DiscoveryOverviewTrend {
  "The current month and the 11 before it, oldest first. A month with no discoveries is present with zeros."
  months: [DiscoveryOverviewMonth!]!
  "Active hardware with no first_seen_at; counted in summary.discovered but in no month."
  undated: Long!
}

type DiscoveryOverviewTypeCount {
  count: Long!
  "hardware.entity_type as stored, e.g. LAPTOP; legacy MISCELLANEOUS is reported as OTHER."
  type: String!
}

