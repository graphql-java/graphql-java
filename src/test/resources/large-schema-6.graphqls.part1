  teamAri: ID! @ARI(interpreted : false, owner : "identity", type : "team", usesActivationId : false)
}

"""
Payload returned when editing a covering shift for an agent. Returns all
covering shift segments in their final state after the edit so the client
can reconcile — any segment it previously held for the edited window that
does not appear in `resultingCoveringShifts` was deleted as part of the
edit (e.g. when the covering shift was reassigned to a different agent).
"""
type AgentWorkspaceEditCoverShiftPayload {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [AgentWorkspaceScheduleError!]
  """
  All covering shift segments produced by this edit in their final state.
  The client should reconcile these against its local state — any segment
  previously held for this window that does not appear here was deleted.
  Empty when `success` is false.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  resultingCoveringShifts: [AgentWorkspaceCoveringShift!]!
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

"""
Payload returned when editing a shift occurrence for an agent. Returns the
edited shift in its final state, plus any covering shifts that were
materialised as a side-effect of the edit (e.g. when the edit reassigned
part of the window to a different agent via `newAgentId`).
"""
type AgentWorkspaceEditShiftPayload {
  """
  Covering shifts created as a side-effect of this edit. Most commonly
  produced when `newAgentId` was set on the input: the back-end materialises
  the new owner's portion of the window as a covering shift so existing
  coverage UI works unchanged. Multiple entries are possible when the edit
  carves out a middle segment (e.g. Alice 09–17 → Alice 09–12, Bob 12–14,
  Alice 14–17). Always present; empty when no covering shifts were created.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  createdCoveringShifts: [AgentWorkspaceCoveringShift!]!
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [AgentWorkspaceScheduleError!]
  """
  The resulting shift with updated times and override details populated.
  Null only when `success` is false.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  shift: AgentWorkspaceShift
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

"A Jira group eligible for team creation (50 or fewer atlassian members)."
type AgentWorkspaceEligibleGroup {
  "Group details (name, etc.) - hydrated from Identity service via AGG"
  group: IdentityGroup @hydrated(arguments : [{name : "ids", value : "$source.groupAri"}], batchSize : 30, field : "identity_groupsByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "Scoped group ARI (ari:cloud:identity::scoped-group/site/{cloudId}/{groupId})"
  groupAri: ID! @ARI(interpreted : false, owner : "identity", type : "scoped-group", usesActivationId : false)
  "All atlassian-type members of the group (up to 50)"
  members: [AgentWorkspaceGroupMember!]!
}

