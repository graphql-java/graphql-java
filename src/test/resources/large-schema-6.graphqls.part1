  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  values(after: String, before: String, first: Int, fromDate: Date, last: Int, toDate: Date): JiraResourceUsageMetricValueConnection
  """
