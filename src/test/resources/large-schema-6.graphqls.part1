"""
One third-party account a user can connect or disconnect: the effective token for an OAuth
container and service, with the requested ARIs that resolve to it.
"""
type GraphIntegrationAccountConnectionInfo @apiGroup(name : ACTIONS) @renamed(from : "AccountConnectionInfo") {
  "Every requested ARI that resolves to this token's container."
  applicableActions: [ID!]!
  "ISO-8601 UTC timestamp for when the account was connected, or null when unavailable."
  connectedAt: String
  """
  The Outbound Auth account id. A placeholder ending in ':unconnected' is returned when no token
  exists; read status, not this field, to tell whether a connection is real.
  """
  connectionAccountId: ID!
  "Consent URL covering the union of every applicable action's scopes. Null means connect is unavailable."
  consentUrl: String
  "The third-party account the token belongs to, e.g. 'alice@corp.com'."
  externalAccountLabel: String
  "The integration backing this connection, or null."
  integrationAri: ID
  "The MCP server backing this connection, or null. A connection may carry both an integration and an MCP server."
  mcpServerAri: ID
  "Per-product display metadata and the action ARIs each product backs. May be empty."
  productMappings: [GraphIntegrationAccountConnectionProductMapping!]!
  "Whether the token is live. Binary; says nothing about scope coverage."
  status: GraphIntegrationAccountConnectionStatus!
  "The subset of applicableActions this token can serve today."
  supportedActions: [ID!]!
  "The subset of applicableActions needing re-consent. May be non-empty even when status is CONNECTED."
  unsupportedActions: [ID!]!
}

"The calling user's connection info, grouped by third-party account."
type GraphIntegrationAccountConnectionInfoResult @apiGroup(name : ACTIONS) @renamed(from : "AccountConnectionInfoResult") {
  "One entry per OAuth container and service. Requested ARIs that do not resolve to an OAuth container are omitted."
  connections: [GraphIntegrationAccountConnectionInfo!]!
}

"Display metadata for one product inside a connection, plus the requested action ARIs it backs."
type GraphIntegrationAccountConnectionProductMapping @apiGroup(name : ACTIONS) @renamed(from : "AccountConnectionProductMapping") {
  "The requested action ARIs backed by this product."
  actionAris: [ID!]!
  "The product display name, e.g. 'Gmail'."
  displayName: String
  "A relative or absolute URL to the product icon."
  iconUrl: String
  "The platform product ARI."
  productAri: ID!
}

