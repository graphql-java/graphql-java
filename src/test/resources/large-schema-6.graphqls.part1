"An action as shown in the component directory, with its display info, auth and input schema"
type GraphIntegrationActionDirectoryItem @apiGroup(name : ACTIONS) @renamed(from : "ActionDirectoryItem") {
  """
  Auth mechanisms this action can authenticate with, as the dimensions naming them — each `id` is an
  `authType:VALUE` string that can be passed back in `dimensionIds`.
  Plural, unlike McpServer.authType: this is a list and that is a single value, and one response key
  cannot hold both shapes — selecting `authType` on both in the same selection set fails validation
  with FieldsConflict.
  A list, unlike McpServer.authType, because an action may declare more than one — notably 3LO
  alongside 2LO, where the effective mechanism is selected at execution time from the tenant's
  provisioned outbound-auth service. Every declared candidate is reported, so an action surfaces under
  any mechanism it can run with once the matching connection exists.
  Empty for actions whose auth model has no DirectoryAuthType equivalent.
  """
  authTypes: [GraphIntegrationDirectoryFilterDimension!]!
  "Action description."
  description: String
  "A display name for the action. This can be different from action name."
  displayName: String!
  "A relative or absolute URL to the action icon."
  iconUrl: String
  "The ARI of the action."
  id: ID!
  "JSON schema describing the shape of the action's inputs."
  inputSchema: JSON @suppressValidationRule(rules : ["JSON"])
  "The integration key that the action belongs to."
  integrationKey: GraphIntegrationDirectoryFilterDimension
  "The name of the action."
  name: String!
  "Tags associated with actions that can be used as a dimension."
  tags: [GraphIntegrationDirectoryFilterDimension!]!
}

