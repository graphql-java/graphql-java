"""
Base interface for all agent-ready (AI-Ready) GraphQL errors emitted by
assets-vertical-service. Models the RFC 9457 "Problem Details" shape so that
agents and human callers receive the same recovery-oriented semantics across
REST and GraphQL.

Concrete error types in this service implement this interface and may add
their own extension fields. Service-local interface (prefixed) rather than a
gateway-shared one because AGG does not currently publish a cross-service
ProblemDetail interface.
"""
interface AssetsVerticalProblemDetail {
  """
  Machine-readable instructions describing how the caller should change the
  request so the next call succeeds. Should be terse and deterministic.
  """
  correctionGuidance: String
  "A specific explanation of what failed."
  detail: String!
  "A reference that identifies the specific occurrence of the problem."
  instance: String
  """
  HTTP-equivalent status code preserved for cross-protocol consistency.
  Mirrors the `status` field from RFC 9457 problem details.
  """
  status: Int
  "A short, human-readable summary of the error condition."
  title: String!
  "A stable URI identifier for the problem category."
  type: String
}

