"Represent Unit in Admin hub."
type AdminUnit {
  apps(after: String, before: String, first: Int, last: Int): AdminUnitAppsConnection
  appsV2(after: String, before: String, filter: AdminAppFilter, first: Int, last: Int): AdminWorkspaceConnection
  "Data residency configuration for this unit, including the realm where unit data is stored."
  dataResidency: AdminDataResidency
  description: String
  directory: AdminDirectory
  """
  The Unit's icons as signed CDN URLs, one per requested size. Backed by units-icon-service
  (GET /orgs/{orgId}/units/{unitId}/icons). Pass {@code sizes} to request specific sizes; omit it
  to receive the service default (MEDIUM). Sizes that have no stored icon are returned as null on
  the corresponding field rather than failing the whole request. A Unit with no stored icon at all
  resolves to a non-null AdminUnitIcons with every requested size null.
  """
  icons(sizes: [AdminUnitIconSize!]): AdminUnitIcons
  id: ID!
  linkedUnits(after: String, before: String, first: Int, last: Int): AdminLinkedUnitConnection
  name: String!
  orgId: ID!
  sites(after: String, before: String, first: Int, last: Int): AdminSiteConnection
