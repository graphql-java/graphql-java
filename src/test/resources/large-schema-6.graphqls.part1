"A recommended non-project work item, such as leave or on-call."
type CplsNonProjectWorkRecommendation {
  """
  Hydrated non-project work item containing detailed information.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "Cpls")' query directive to the 'nonProjectWork' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  nonProjectWork: CplsCustomContributionTarget @hydrated(arguments : [{name : "ids", value : "$source.nonProjectWorkId"}], batchSize : 50, field : "cpls_customContributionTargetsByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "capacity_planning_service", timeout : 3000) @lifecycle(allowThirdParties : false, name : "Cpls", stage : EXPERIMENTAL)
  "The non-project work ARI that can be hydrated to get full details."
  nonProjectWorkId: ID! @ARI(interpreted : false, owner : "capacity-planning", type : "custom-contribution-target", usesActivationId : false)
}

