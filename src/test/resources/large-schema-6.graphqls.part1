"""
A single comment within a comment thread, addressable as a `Node` by its ARI.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
"""
type AVPComment implements Node @defaultHydration(batchSize : 100, field : "avp_getCommentsByAris", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) {
  """
  The comment author's identity details (name, picture), hydrated by AGG from `authorPrincipalId`, so
  clients need not resolve the profile themselves. Null when the account is closed or hidden from the
  calling user by their privacy controls.
  """
  authorHydrated: User @idHydrated(idField : "authorPrincipalId", identifiedBy : null)
  "Identity user ARI of the comment author. AGG hydrates `authorHydrated` from this field."
  authorPrincipalId: ID @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  "Contextual metadata for the comment (e.g. applied chart filters) as a JSON object, or null."
  context: JSON @suppressValidationRule(rules : ["JSON"])
  "Time (microseconds since epoch) when the comment was created."
  createdAt: String
  "ARI of the comment."
  id: ID! @ARI(interpreted : false, owner : "avp", type : "comment", usesActivationId : false)
  """
  The comment body as an Atlassian Document Format (ADF) JSON object, returned exactly as authored.
  `mention` nodes are not re-rendered against the mentioned user's current profile, so `attrs.text`
  on a mention may be stale; resolve the current display name from `attrs.id` if you need it.
  """
  message: JSON @suppressValidationRule(rules : ["JSON"])
  "ARI of the thread this comment belongs to."
  threadId: ID! @ARI(interpreted : false, owner : "avp", type : "comment-thread", usesActivationId : false)
  "Time (microseconds since epoch) when the comment was last updated."
  updatedAt: String
}

"A Relay edge containing a comment node and its pagination cursor."
type AVPCommentEdge {
  "An opaque cursor for this comment's page in the current connection."
  cursor: String!
  "The comment node for this edge."
  node: AVPComment
}

"""
A comment thread on a dashboard or on one of its charts, hydrated with its comments and the
requesting user's read state. Addressable as a `Node` by its ARI.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
"""
type AVPCommentThread implements Node @defaultHydration(batchSize : 25, field : "avp_getCommentThreadsByAris", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) {
  """
  A page of comments in this thread, using Relay forward pagination. Pages walk backwards through
  time: edges are ordered newest-first, so the first page holds the most recent comments and each
  subsequent page (fetched by passing the previous page's `pageInfo.endCursor` as `after`) holds
  progressively older comments. Clients that want chronological order should reverse each page
  client-side.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AVP-graphql-comments")' query directive to the 'comments' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  comments(
    """
    Opaque cursor identifying the page to resume after; omit for the first page. Cursors are
    page-granular, so passing any edge's cursor resumes after that whole page rather than after
    that individual comment; pass `pageInfo.endCursor` to walk the connection, and a cursor from
    the final page returns an empty connection. A traversal is not a snapshot: comments already
    present are returned exactly once, including comments sharing a `createdAt`, but comments
    added partway through a traversal may not appear.
    """
    after: String,
    "Maximum number of edges to return in this page; must be between 1 and 100."
    first: Int!
  ): AVPCommentsConnection @lifecycle(allowThirdParties : false, name : "AVP-graphql-comments", stage : EXPERIMENTAL)
  "ARI of the thread."
  id: ID! @ARI(interpreted : false, owner : "avp", type : "comment-thread", usesActivationId : false)
  "Whether the thread has been resolved."
  resolved: Boolean!
  """
  Identity details (name, picture) of the user who last changed whether the thread is resolved,
  hydrated by AGG from `resolvedByPrincipalId`. Null when no one has changed it, or when the account
  is closed or hidden from the calling user by their privacy controls.
  """
  resolvedByHydrated: User @idHydrated(idField : "resolvedByPrincipalId", identifiedBy : null)
  """
  Identity user ARI of the user who last changed whether the thread is resolved, if any: the user who
  resolved it, or who unresolved it again. AGG hydrates `resolvedByHydrated` from this field.
  """
  resolvedByPrincipalId: ID @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  "The requesting user's read state for this thread, or null if none exists."
  threadUser: AVPCommentThreadUser
  "Time (microseconds since epoch) when the thread was last updated."
  updatedAt: String
}

"An edge in a comment thread connection."
type AVPCommentThreadEdge {
  "An opaque cursor for this thread in the current connection."
  cursor: String!
  "The comment thread for this edge."
  node: AVPCommentThread
}

"The requesting user's read/subscription state for a comment thread."
type AVPCommentThreadUser {
  "Time (microseconds since epoch) of the last comment the user has seen in this thread."
  lastSeen: String
  "ARI of the thread this record refers to."
  threadId: ID! @ARI(interpreted : false, owner : "avp", type : "comment-thread", usesActivationId : false)
  """
  Number of comments in the thread created after `lastSeen` (unread comments) for the calling user,
  excluding comments the caller authored. Saturates at 1000; a value of 1000 means "at least 1000".
  """
  unseenCommentCount: Int!
}

"A Relay connection for paginated comment thread results."
type AVPCommentThreadsConnection implements HasPageInfo {
  "The edges in the current page of comment thread results."
  edges: [AVPCommentThreadEdge!]!
  "Pagination metadata for the current result set."
  pageInfo: PageInfo!
}

"A Relay connection for paginated comment results within a thread."
type AVPCommentsConnection implements HasPageInfo {
  "The edges in the current page of comments, ordered newest-first."
