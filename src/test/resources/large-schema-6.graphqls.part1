  teamAssignmentMode: AgentWorkspaceTeamAssignmentMode!
  "Complete configurable-routing trigger mapping in enum declaration order."
  triggers: [AgentWorkspaceConfigurableRoutingTriggerSetting!]!
  "Warning to show admins when smart-routing system-user setup needs manual attention."
  warning: String
}

"""
Current state of the **latest** smart-routing dry-run for a project. Returned by both the poll
query and the cancel mutation so the FE always sees the post-operation state without a second
round-trip.

The settings page can call the poll query without knowing the runId — the latest run (across
all historical runs) is returned, including its final `result` snapshot if COMPLETED.
"""
type AgentWorkspaceSmartRoutingDryRun {
  """
  Sample size the worker actually obtained from JQL — 0 until the worker enters the loop, then
  whatever the search returned (≤ `requestedSampleSize`).
  """
  actualSampleSize: Int!
  "Time at which the run terminated. Null while still PENDING / RUNNING / CANCELLING."
  endedAt: DateTime
  """
  Stable error code surfaced on terminal-failure rows (FAILED / TIMEOUT). Never a stack trace.
  Examples: `NO_TICKETS`, `ROUTING_TABLE_EMPTY`, `TOO_MANY_ERRORS`, `INTERNAL_ERROR`.
  Null in all other states.
  """
  errorCode: String
  "Per-ticket classifier failures the worker tolerated. Bounded by an error-ratio guard."
  errorCount: Int!
  "Tickets the worker has finished classifying so far."
  processedCount: Int!
  """
  Progress as an integer percentage of `processedCount / totalCount`, clamped 0..100. Returns 0
  when `totalCount` is 0 (the run hasn't started its loop yet).
  """
  progressPct: Int!
  "Sample size the admin requested when starting the run (clamped server-side)."
  requestedSampleSize: Int!
  """
  The aggregated statistics snapshot. Populated **only when** `status == COMPLETED`; null in
  every other state (defensive guard at the response boundary — even if a future change
  accidentally persisted a snapshot in a non-terminal state the API still says null).
  """
  result: AgentWorkspaceSmartRoutingDryRunResult
  "Routing mode selected when the run started; workers use this frozen value."
  routingMode: AgentWorkspaceSmartRoutingMode!
  "The unique ID of this run."
  runId: ID!
  "Time at which the run was started."
  startedAt: DateTime!
  "Overall lifecycle status of the run."
  status: AgentWorkspaceSmartRoutingDryRunStatus!
  """
  Total tickets the worker plans to classify. 0 before the worker enters the loop; equals
  `actualSampleSize` after.
  """
  totalCount: Int!
}

"""
A skills-only ranked agent candidate for a dry-run ticket. Workload / availability / shift
signals are deliberately excluded — they reflect "right now", not when the historical ticket
came in.

All returned agents are binary-qualified — they hold every required skill for the predicted
service. The FE may render this as "Qualified: yes" or "3/3 required skills"; the
`matchedSkillIds` field carries the underlying skill ids if needed.
"""
type AgentWorkspaceSmartRoutingDryRunAgentRecommendation {
  "Atlassian accountId of the recommended agent."
  accountId: ID! @ARI(interpreted : false, owner : "jira", type : "user", usesActivationId : false)
  """
  Skills the agent holds that match the predicted service's required skills. Each entry carries
  the skill id and (when available) the current human-readable name. Every required skill
  appears here for every returned agent (binary qualification). A skill whose `name` is null
  has been archived between the dry-run write and the current read — the id is still meaningful
  for cross-reference but the FE should treat it as "(unavailable)".
  """
  matchedSkills: [AgentWorkspaceSmartRoutingDryRunSkill!]!
  """
  Total active required-skills count for the predicted service. Lets the FE render
  "3 required skills" alongside the qualification. Always > 0 when this row exists — when the
  service has no required skills configured the parent ticket's `agentRecommendations` list is
  empty entirely (no rows of this type are produced).
  """
  requiredSkillCount: Int!
  """
  Identity user profile (name, picture, accountStatus, email). Hydrated from the Identity service
  via AGG using `accountId`. Null only on accounts the Identity service cannot resolve.
  """
  user: User @hydrated(arguments : [{name : "accountIds", value : "$source.accountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
}

"""
The fully-aggregated effectiveness statistics from a completed dry-run. Combines the confusion
matrix and aggregate metrics; coverage uses the service or team destination selected by routingMode.

See the design doc at `docs/superpowers/specs/...-smart-routing-statistics-design.md` for how
each metric is computed.
"""
type AgentWorkspaceSmartRoutingDryRunResult {
  """
  `(TP + TN) / total` — fraction of all decisions that were correct. Null when the matrix is
  empty (divide-by-zero), surfaced as "n/a" rather than silently 0.
  """
  accuracy: Float
  """
  Fraction of distinct ground-truth destinations observed in the window that are configured in
  the routing table. Destination means service in SERVICE mode and team in TEAM mode. Null when
  no destination was observed.
  """
  configCoverage: Float
  """
  Outcomes with no prediction AND no ground truth — nothing to evaluate. Reported as a count so
  callers can surface data-quality issues; never enters the matrix or coverage.
  """
  excludedCount: Int!
  "Confusion matrix: TP / FP / FN / TN counts."
  matrix: AgentWorkspaceConfusionMatrix!
  """
  Per-service breakdown sorted by service id. Populated only in SERVICE mode. A FALSE_POSITIVE
  with no ground-truth service contributes to the global matrix but is not attributable to a
  service, so per-service sums may be less than `matrix` totals.
  """
  perService: [AgentWorkspaceSmartRoutingPerServiceStat!]!
  """
  `TP / (TP + FP)` — when we routed something, how often was it right? Null when nothing was
  routed.
  """
  precision: Float
  """
  `TP / (TP + FN)` — of the tickets that should have been routed, how many were? Null when
  no routable ground truth was observed.
  """
  recall: Float
  "Routing mode used to calculate this snapshot."
  routingMode: AgentWorkspaceSmartRoutingMode!
  "Total number of outcomes evaluated, including `excludedCount`."
  sampleSize: Int!
  """
  Fraction of evaluated tickets whose ground-truth destination is in the routing table. Null
  when no tickets had ground truth.
  """
  volumeCoverage: Float
}

"""
A skill held by a recommended agent on a dry-run ticket. The id is the stable identifier; the
name is the current human-readable label resolved at read-time and may be null when the skill
has been archived between the dry-run write and this read.
"""
type AgentWorkspaceSmartRoutingDryRunSkill {
  "Stable skill identifier."
  id: ID!
  "Human-readable name resolved from the current skill registry. Null when archived."
  name: String
}

"""
A single per-ticket row produced by a smart-routing dry-run statistics execution. The
classifier ran against the historical Done ticket and produced a `(predicted, label)` pair which
the worker persisted alongside the ground-truth service or team recorded on the ticket.
"""
type AgentWorkspaceSmartRoutingDryRunTicket {
  """
  Skills-only ranked agent recommendations. Up to 3 entries. The worker follows the predicted
  service to its team and ranks team members by skills alone — explicitly NOT by availability,
  shifts, or workload, because those are moment-in-time signals that don't reflect who would
  have been the best agent at the historical ticket's creation time. These recommendations are
  populated only in SERVICE mode. An agent is included iff
  their active skill set contains every required skill for the predicted service.
  
  Empty when the classifier declined to predict a service (FN / TN / EXCLUDED), when the
  predicted service has no required skills configured (a skills bar is a precondition for a
  meaningful skills-only recommendation — without one the worker honestly records nothing
  rather than synthesise "all team members"), when no team member is qualified for the
  required skills, or for rows written before this field existed.
  """
  agentRecommendations: [AgentWorkspaceSmartRoutingDryRunAgentRecommendation!]!
  """
  Whether the ground-truth destination is present in the live routing table. In SERVICE mode the
  destination is a service; in TEAM mode it is a connected team. Used to distinguish a correct
  abstention from a missed routing opportunity.
  """
  groundTruthInTable: Boolean!
  """
  The service id the ticket carried at sample-time in SERVICE mode. Null for TEAM runs or when
  the ticket had no service value.
  """
  groundTruthServiceId: String
  """
  Human-readable name for [groundTruthServiceId], resolved from the current live routing table.
  Null when [groundTruthServiceId] is null or when the ground-truth service is not currently in
  the routing table (a common case — that's exactly what `groundTruthInTable = false` signals).
  """
  groundTruthServiceName: String
  "The canonical team ARI currently stored in the Jira team field. Populated only for TEAM runs."
  groundTruthTeamARI: ID @ARI(interpreted : false, owner : "identity", type : "team", usesActivationId : false)
  "Current name for [groundTruthTeamARI], when the team still appears in the live table."
  groundTruthTeamName: String
  """
  Issue details hydrated from Jira via AGG (key, summary, status, assignee, etc.). The FE
  can request standard `JiraIssue` fields. Null only on issues Jira cannot resolve (deleted,
  permission-denied for the caller, etc.).
  """
  issue: JiraIssue @hydrated(arguments : [{name : "ids", value : "$source.issueARI"}], batchSize : 50, field : "jira.issuesById", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "jira", timeout : -1)
  "Jira issue ARI for AGG-hydration into `issue` (cloud-scoped: ari:cloud:jira:CLOUD:issue/ID)."
  issueARI: ID! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  "The Jira numeric issue id this row was produced for."
  issueId: ID!
  "Effectiveness label: TP / FP / FN / TN, or EXCLUDED for rows with no decision."
  label: AgentWorkspaceSmartRoutingRoutingOutcomeLabel!
  "When the worker wrote this row (i.e. roughly when it classified the ticket)."
  occurredAt: DateTime!
  """
  The service id the classifier predicted in SERVICE mode. Null for TEAM runs and when the
  classifier declined to classify (i.e. `label` is FALSE_NEGATIVE, TRUE_NEGATIVE, or EXCLUDED).
  """
  predictedServiceId: String
  """
  Human-readable name for [predictedServiceId], resolved from the current live routing table.
  Null when [predictedServiceId] is null, or when the service has since been removed from the
  routing table (e.g. an older dry-run row whose predicted service no longer exists).
  """
  predictedServiceName: String
  "The team ARI predicted by the classifier. Populated only for TEAM runs."
  predictedTeamARI: ID @ARI(interpreted : false, owner : "identity", type : "team", usesActivationId : false)
  "Current name for [predictedTeamARI], when the team still appears in the live table."
  predictedTeamName: String
  """
  Total count of agents on the matched team qualified by skills (i.e. holding every active
  required skill for the predicted service). Pair with `agentRecommendations` to render
  "Top 15 of N qualified agents". `qualifiedAgentCount >= agentRecommendations.length` always
  (the list is capped at 15). Null when no recommendation was attempted — TEAM-mode tickets,
  pre-feature rows, unmatched tickets (FN / TN / EXCLUDED), or services without required skills
  configured.
  """
  qualifiedAgentCount: Int
  "Routing mode frozen when this test run started."
  routingMode: AgentWorkspaceSmartRoutingMode!
}

"Pagination metadata for `AgentWorkspaceSmartRoutingDryRunTicketsPayload`."
type AgentWorkspaceSmartRoutingDryRunTicketsPageInfo {
  "Opaque cursor to pass back as `input.after` for the next page. Null when exhausted."
  endCursor: String
  "True when ERS reported more rows behind this page (regardless of label-filter survivability)."
  hasNextPage: Boolean!
}

"Page of per-ticket dry-run rows together with the cursor needed to fetch the next page."
type AgentWorkspaceSmartRoutingDryRunTicketsPayload {
  "Cursor + has-next-page flag for the next request."
  pageInfo: AgentWorkspaceSmartRoutingDryRunTicketsPageInfo!
  "The rows on this page, newest-first. May be fewer than `first` when `labels` filters apply."
  tickets: [AgentWorkspaceSmartRoutingDryRunTicket!]!
}

"Per-service breakdown row for a smart-routing dry-run result."
type AgentWorkspaceSmartRoutingPerServiceStat {
  "Whether this service is present (included = true) in the project's routing table."
  covered: Boolean!
  falseNegatives: Int!
  falsePositives: Int!
  "Total outcomes whose ground-truth service is this id."
  observed: Int!
  "Stable service id (the ground-truth value observed on tickets in the window)."
  serviceId: ID!
  trueNegatives: Int!
  truePositives: Int!
}

