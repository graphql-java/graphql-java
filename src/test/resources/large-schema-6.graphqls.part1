Payload for eligible groups query. Includes groups with 50 or fewer atlassian members
and groups filtered out because they exceed that limit.
"""
type AgentWorkspaceEligibleGroupsPayload {
  "Groups with 50 or fewer atlassian members (eligible for team creation)"
  eligibleGroups: [AgentWorkspaceEligibleGroup!]!
  "Groups filtered out because they have more than 50 atlassian members"
  groupsTooLarge: [AgentWorkspaceGroupTooLarge!]!
}

"""
An agent who was considered for a coverage gap but excluded, along with the
reason(s) they were excluded. The reasons list is always non-empty and is
modelled as a list to support multiple concurrent causes in future (e.g. an
agent who is both off-roster AND missing a required skill) without a
breaking change.
"""
type AgentWorkspaceExcludedAgent {
  "The excluded agent."
  agent: AgentWorkspaceAgent!
  """
  Why this agent was excluded. Always non-empty. Today only
  `ASSIGNED_TO_SAME_SCHEDULE` is produced by the back-end; the list shape
  exists so additional causes (skills, leave, working hours, etc.) can be
  added later non-breakingly.
  """
  exclusionReasons: [AgentWorkspaceAgentExclusionReason!]!
}

"A single group member, with user profile hydrated from Identity."
type AgentWorkspaceGroupMember {
  "Account ID of the member"
  accountId: String!
  "The member's user profile - hydrated from Identity service via AGG"
  user: User @hydrated(arguments : [{name : "accountIds", value : "$source.accountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
}

"A Jira group filtered out because it has more than 50 atlassian members."
type AgentWorkspaceGroupTooLarge {
  "Group details (name, etc.) - hydrated from Identity service via AGG"
  group: IdentityGroup @hydrated(arguments : [{name : "ids", value : "$source.groupAri"}], batchSize : 30, field : "identity_groupsByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "Scoped group ARI (ari:cloud:identity::scoped-group/site/{cloudId}/{groupId})"
  groupAri: ID! @ARI(interpreted : false, owner : "identity", type : "scoped-group", usesActivationId : false)
}

