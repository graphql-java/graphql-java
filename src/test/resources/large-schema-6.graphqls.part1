"An MCP server as shown in the component directory, with its display info, auth and tools"
type GraphIntegrationMcpServer @apiGroup(name : ACTIONS) @renamed(from : "McpServer") {
  """
  How this server authenticates, as the dimension naming that mechanism — its `id` is an
  `authType:VALUE` string that can be passed back in `dimensionIds`. Singular: a server is registered
  with one mechanism, chosen by the admin (custom URL registrations) or constrained to what the gallery
  template declares. Servers registered before auth types existed report OAUTH, which is what they used.
  """
  authType: GraphIntegrationDirectoryFilterDimension!
  "The display name of the MCP server. Global servers may include a qualifier such as \"(read-only)\"."
  displayName: String!
  "A relative or absolute URL to the MCP server icon. Derived from the MCP server icon."
  iconUrl: String
  "The ARI of the MCP server."
  id: ID!
  "The server product name."
  name: String!
  "The platform product ARI of the MCP server"
  productAri: String
  "Tags associated with the MCP server that can be used as a dimension."
  tags: [GraphIntegrationDirectoryFilterDimension!]!
  "The MCP tools that are registered to the MCP server."
  tools(after: String, first: Int = 100): GraphIntegrationMcpToolNodeConnection
}

"""
A workspace-scoped MCP server, with its display info and available tools

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:me__
"""
type GraphIntegrationMcpServerNode implements Node @defaultHydration(batchSize : 50, field : "graphIntegration_mcpServers", idArgument : "ids", identifiedBy : "id", timeout : -1) @renamed(from : "McpServerNode") @scopes(product : NO_GRANT_CHECKS, required : [READ_ME]) {
  displayName: String!
  iconUrl: String
  id: ID! @ARI(interpreted : false, owner : "graph", type : "mcp-server", usesActivationId : false)
  productAri: String
  tools(after: String, first: Int = 100): GraphIntegrationMcpToolNodeConnection
}

