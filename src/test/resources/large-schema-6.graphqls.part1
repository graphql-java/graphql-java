  recommendations: [AgentWorkspaceRebalancingRecommendation!]!
}

"""
Time an agent is away on leave. Unlike a coverage gap, a leave block stays when someone else
covers the time.
"""
type AgentWorkspaceLeaveBlock {
  "The agent on leave."
  agentId: ID!
  endTime: DateTime!
  "Stable across reads, so the client can address the same block after a reload."
  id: ID!
  """
  The leave record for this schedule. Pass as `leaveRecordId` to
  `agentWorkspace_clearLeaveReason` to clear the reason on this schedule only.
  """
  leaveRecordId: ID!
  """
  The submission the record belongs to. Pass as `leaveRequestId` to
  `agentWorkspace_clearLeaveReason` to clear the reason across every schedule it covered.
  """
  leaveRequestId: ID!
  leaveType: AgentWorkspaceLeaveType!
  "Original start time of the schedule occurrence the block falls in."
  occurrenceStartTime: DateTime!
  scheduleId: ID!
  scheduleName: String!
  startTime: DateTime!
}

"One agent's leave on one schedule, from one unassign action."
type AgentWorkspaceLeaveRecord {
  agentAccountId: ID!
  customEndTime: String
  customStartTime: String
  endTime: DateTime!
  id: ID!
  "Shared by every record created by the same unassign action."
  leaveRequestId: ID!
  "Null once the reason has been cleared."
  leaveType: AgentWorkspaceLeaveType
  scheduleId: ID!
  startTime: DateTime!
  timezone: String!
}

