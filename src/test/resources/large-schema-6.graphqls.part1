  companyName: String
  confluence: ConfluenceUser @hydrated(arguments : [{name : "accountId", value : "$source.id"}], batchSize : 80, field : "confluenceUser", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "confluence_monolith", timeout : -1)
