  resourceId: ID
  revocationDate: DateTime
  "If the token has been revoked, account ID of the user who revoked it."
  revokedBy: String
  "Defines what permissions/actions the token is authorized to perform, e.g. write:tokens:admin, read:policies:admin, etc."
  scopes: [String!]
  status: AdminTokenStatus
  type: AdminTokenType!
}

