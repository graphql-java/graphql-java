"An egress rule declared by an app definition."
type GlobalAppEgress {
  addresses: [String!]
  category: String
  inScopeEUD: Boolean
  type: String
}

"""
A single Forge app extension, flattened together with its parent app definition
metadata and per-installation config. Mirrors the cs-extensions app definition schema.
"""
type GlobalAppExtension {
  allowsConfigurableEgress: Boolean
  appId: String!
  appOwner: String!
  appVersion: String!
  appVersionId: String
  consentUrl: String
  definitionId: String!
  description: String
  distributionStatus: String!
  egress: [GlobalAppEgress!]!
  environmentId: String!
  environmentKey: String!
  environmentType: String!
  groupKey: String!
  installationConfig: [GlobalAppInstallationConfig!]
  installationContext: String
  installationId: String
  installationTarget: String
  isSystemApp: Boolean
  isSystemUserProvisioned: Boolean
  key: String
  license: GlobalAppLicense
  licenseIds: JSON @suppressValidationRule(rules : ["JSON"])
  manuallyAddedReadMeScope: Boolean
  migrationKeys: JSON @suppressValidationRule(rules : ["JSON"])
  name: String
  oauthClientId: String!
  outboundAuthContainerId: String
  principal: GlobalAppPrincipal!
  properties: JSON! @suppressValidationRule(rules : ["JSON"])
  requiresLicense: Boolean
  scopes: [String!]!
  secondaryInstallationContexts: [String!]
  securityPolicies: [GlobalAppSecurityPolicy!]!
  type: String!
  versionId: String!
}

type GlobalAppExtensionsResponse {
  extensions: [GlobalAppExtension!]
}

type GlobalAppForgeContextToken {
  "Time when token will expire, given in number of milliseconds elapsed since the UNIX epoch"
  expiresAt: String!
  "The ID of the extension this token is being signed for"
  extensionId: ID!
  "The actual Forge Context Token"
  jwt: String!
}

"A single per-installation configuration flag."
type GlobalAppInstallationConfig {
  key: String!
  value: Boolean!
}

"The license associated with an installed Global App"
type GlobalAppLicense {
  active: Boolean!
  billingPeriod: String
  capabilitySet: GlobalAppLicenseCapabilitySet
  ccpEntitlementId: String
  ccpEntitlementSlug: String
  isEvaluation: Boolean
  modes: [String!]
  state: String
  subscriptionEndDate: DateTime
  supportEntitlementNumber: String
  trialEndDate: DateTime
  type: String
}

"The app principal (bot user) associated with a definition."
type GlobalAppPrincipal {
  avatarUrl: String
  id: String
  mentionName: String
}

"A content-security policy declared by an app definition."
type GlobalAppSecurityPolicy {
  policies: [String!]
  type: String
}

