  "Optional text to render before the entered value."
  inputPrefix: String
  "Optional text to render after the entered value."
  inputSuffix: String
  "The stable field key."
  key: String!
  "Available options when type is SELECT. Each option has a display label and a value."
  options: [GraphIntegrationCustomAuthInputOption!]
  "Whether this input is required."
  required: Boolean!
  "Which part of the custom auth request the submitted value belongs to."
  target: GraphIntegrationCustomAuthInputTarget!
  "The type of input control to render."
  type: GraphIntegrationCustomAuthInputType!
  "An optional regex pattern used to validate the user-provided value for this input."
  validationPattern: String
}

"A selectable option for a SELECT type custom auth input field."
