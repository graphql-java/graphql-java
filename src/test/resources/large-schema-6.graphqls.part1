  "Teams the agent belongs to - hydrated from Team service via AGG"
  teams: [TeamV2!] @hydrated(arguments : [{name : "ids", value : "$source.teamARIs"}], batchSize : 50, field : "team.teamsV2Hydration", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  user: User @hydrated(arguments : [{name : "accountIds", value : "$source.id"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
}

type AgentWorkspaceAgentAvailability {
  "Agent ID"
  agentId: ID!
  "Agent display name"
  agentName: String!
  """
  Globally unique opaque identifier for this agent's availability record.
  
  The same agent has the same `id` across all project surfaces — availability is per-tenant,
  not per-project. Stable across mutations: a successful mutation returns the same `id`
  for the same agent.
  
  Used by Relay to deduplicate and normalize this record across multiple queries (e.g. the
  Global Profile Menu and the WFO Availability Page), so mutation responses propagate to
  every subscribing fragment automatically. The id is opaque — clients must not parse it.
  """
  id: ID!
  """
  When true, the agent has chosen not to have their status auto-changed ("never expire"): the
  automatic heartbeat/inactivity transitions will not move them out of `status`. Distinct from a
  null `statusExpiresAt` (which means "no timer" and still permits automatic management).
  """
  neverExpire: Boolean
  "Current availability status"
  status: AgentWorkspaceAvailabilityStatus!
  """
  Timestamp (ISO-8601) until which the agent holds the current `status`, or null when no timer is
  set. The timer is bidirectional: it may accompany `ON_BREAK` ("unavailable until") or
  `AVAILABLE` ("available until"). When this time passes, the status automatically reverts to the
  opposite status on next read.
  """
  statusExpiresAt: DateTime
  "Team ARIs the agent belongs to"
  teamARIs: [ID!]! @ARI(interpreted : false, owner : "identity", type : "team", usesActivationId : false)
  "Team IDs the agent belongs to"
  teamIds: [ID!]!
  "Team names for display"
  teamNames: [String!]!
  "Teams the agent belongs to - hydrated from Team service via AGG"
  teams: [TeamV2!] @hydrated(arguments : [{name : "ids", value : "$source.teamARIs"}], batchSize : 50, field : "team.teamsV2Hydration", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], timeout : -1)
  "When the status was last updated"
  updatedAt: DateTime
  "The account ID of the user who last updated the availability status"
  updatedBy: ID
  "User who last updated the availability status - hydrated from Identity service via AGG"
  updatedByUser: User @hydrated(arguments : [{name : "accountIds", value : "$source.updatedBy"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "The agent's user profile - hydrated from Identity service via AGG"
  user: User @hydrated(arguments : [{name : "accountIds", value : "$source.agentId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
}

