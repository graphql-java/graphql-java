"""
Response type for the aiSummary resolver on PopularFeedItem. Each item corresponds to one contentId in the batch.
Nadel uses contentId as the batch identifier (identifiedBy: contentId).
"""
type ConfluenceContentAISummaryByContentId @apiGroup(name : CONFLUENCE_SMARTS) {
  "The raw contentId — used by Nadel as the batch identifier."
  contentId: ID!
  "The content type (PAGE or BLOGPOST). Null on error when content type could not be resolved."
  contentType: KnowledgeGraphContentType
  "ISO-8601 timestamp of when the AI summary was created. Empty string on error."
  createdAt: String!
  "Error message if this item failed. Null on success."
  errorMessage: String
  "The AI-generated snippet data (JSON). Null on error."
  objectData: String
}

type ConfluenceContentAISummaryResponse @apiGroup(name : CONFLUENCE_SMARTS) {
  contentAri: ID!
  contentId: ID!
  contentType: KnowledgeGraphContentType!
  createdAt: String!
  errorMessage: String
  objectData: String
}

