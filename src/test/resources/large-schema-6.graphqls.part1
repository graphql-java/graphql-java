type AgentStudioAuthReadinessResult @apiGroup(name : AGENT_STUDIO) {
  firstPartyApps(includeGrantedApps: Boolean = false): [AgentStudioFirstPartyApp!]!
  """
  Third-party apps grouped by consent URL, one entry per distinct scope-set.
  
  Superseded by `thirdPartyConnections`, which groups by OAuth account instead. Because third-party
  tokens are stored per OAuth container and several tools routinely share one, this will not
  allow disconnect or connect of auth
  """
  thirdPartyApps: [AgentStudioThirdPartyApp!]!
  """
  An agent's third-party connections grouped by OAuth account — one entry per token, i.e. per
  thing the user can connect or disconnect, with the tools it covers listed underneath.
  
  Prefer this over `thirdPartyApps`.
  """
  thirdPartyConnections: [AgentStudioThirdPartyConnection!]
}

