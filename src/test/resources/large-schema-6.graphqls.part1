"""
Aggregate template-update status for a given workbench (OOTB Overview) dashboard view.

Either field may be `null` if the backing JSM Reporting call failed (e.g. service unavailable,
latest-template lookup not yet implemented server-side). The UI should degrade gracefully and only
render the corresponding control (Try-Now / Rollback) when the relevant section is present.
"""
type AssetsVerticalWorkbenchDashboardTemplateStatus {
  "Rollback availability info; null if the upstream list-published-versions call failed."
  rollback: AssetsVerticalWorkbenchDashboardRollbackStatus
  "Upgrade availability info; null if the upstream latest-template-version call failed."
  upgrade: AssetsVerticalWorkbenchDashboardUpgradeStatus
}

"""
Result of `assetsVertical_workbenchDashboardTryUpgrade`.

On success, returns the JSM Reporting **preview** view-version identifier the UI must use to poll
JSM Reporting (`GET /views/{viewId}/versions/{previewVersion}`) until the new preview dashboard
finishes provisioning. Preview is NOT the live version until the user explicitly accepts it via
JSM Reporting's accept API.
"""
type AssetsVerticalWorkbenchDashboardTryUpgradePayload {
  """
  Identifier of the preview dashboard once JSM Reporting starts provisioning it. May be null
  in the initial 202 response if Reporting populates it asynchronously.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  dashboardId: String
  """
  Initial status of the preview dashboard (e.g. IN_PROGRESS, ACTIVE). Free-form string to
  forward-compat with future status values added by JSM Reporting.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  dashboardStatus: String
  """
  Mutation-level errors (validation / authn / upstream failures). Empty on success.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  Newly-created **preview** view-version identifier. UI polls JSM Reporting with this id;
  null on failure.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  previewVersion: Int
  """
  True when the preview-creation request was accepted by JSM Reporting.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
  """
