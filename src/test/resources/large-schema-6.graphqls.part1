  overageCap: CommerceExpUtsMeterOverageCap
  systemLimit: Float
}

"Allowance metadata containing defaults for the meter"
type CommerceExpUtsMeterAllowanceMetadata {
  allowanceDefaults: CommerceExpUtsMeterAllowanceDefaults
}

"Meter configuration for a given usage key, as returned by UTS"
type CommerceExpUtsMeterConfiguration {
