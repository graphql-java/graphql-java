"""
Event payload emitted by convo-ai when a session association changes.
Exposes the full `AgentSessionAssociation` entity via SkyBridge hydration.
"""
type ConvoAiAgentSessionUpdatePayload {
  """
  Source field used by AGG to hydrate `association` via
  agent_skybridge.agent_sessionAssociationGetById.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  agentSessionId: String! @hidden
  """
  The full session association entity, hydrated from agent_skybridge using
  the event's `agentSessionId` (as `id`) and `cloudId` (as `shardingContext`).
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  association: AgentSessionAssociation @hydrated(arguments : [{name : "id", value : "$source.agentSessionId"}, {name : "shardingContext", value : "$source.cloudId"}], batchSize : 200, field : "agent_sessionAssociationGetById", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "agent_skybridge", timeout : -1)
  """
  Source field used by AGG as the SkyBridge `shardingContext` when
  hydrating `association`.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  cloudId: ID! @hidden
}

