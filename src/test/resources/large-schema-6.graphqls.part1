type AVPPermissionsCapabilityResult {
  "The ID of the capability"
  capabilityId: String
  "The result of checking this capability"
  result: AVPPermissionsHasCapabilityResponse
}

"""
Identity access details for a dashboard: a single list of users and groups
that have access, each with one access level (their maximum: READ, WRITE, or MANAGE).
"""
type AVPPermissionsDashboardIdentityAccess {
  "The ID (ARI) of the dashboard"
  dashboardId: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "List of groups with their access details (each principal appears once with max level)"
  groups: [AVPPermissionsGroupAccess!]!
  "List of users with their access details (each principal appears once with max level)"
  users: [AVPPermissionsUserAccess!]!
}

type AVPPermissionsDashboardUserAccessResult {
  "Access level for the user"
  accessLevel: AVPPermissionsAccessLevel!
  "Account ID of the user"
  accountId: String!
}

type AVPPermissionsFailedDashboardUserAccess {
  "Error message for the failure"
  errorMessage: String!
  "User access information that failed to update"
  user: AVPPermissionsDashboardUserAccessResult!
}

type AVPPermissionsGetCapabilitiesResponse {
  "List of capability results"
  capabilities: [AVPPermissionsCapabilityResult!]
}

"""
Details about a group with their access information.
Identity details (name) are automatically hydrated by AGG from the identity service via the
IdentityGroup type's default hydration.
"""
type AVPPermissionsGroupAccess {
  "The access level for this group (READ, WRITE, or MANAGE)"
  accessLevel: AVPPermissionsAccessLevel!
  "The group identity details (name)"
  group: IdentityGroup @idHydrated(idField : "principalId", identifiedBy : null)
  "The ARI of the group"
  principalId: ID! @ARI(interpreted : false, owner : "identity", type : "scoped-group", usesActivationId : false)
}

type AVPPermissionsHasCapabilityResponse {
  "Failure code if access is not granted (convenience field from DEFAULT product)"
  failureCode: String
  "Type of failure that occurred (convenience field from DEFAULT product)"
  failureType: AVPPermissionsCapabilityFailureType
  "Whether the user has access to the capability (convenience field from DEFAULT product)"
  hasAccess: Boolean
  "Whether the user has manage permission (convenience field from DEFAULT product)"
  hasManage: Boolean
  "Whether the user has write permission (convenience field from DEFAULT product)"
  hasWrite: Boolean
  "Product-specific capability results, keyed by product ID. DEFAULT key is used for non-product-specific responses."
  productResults: [AVPPermissionsProductCapabilityResult!]
  "Additional properties returned by the capability check (convenience field from DEFAULT product)"
  properties: [AVPPermissionsPropertyEntry!]
  "Reason for denial if access is not granted (convenience field from DEFAULT product)"
  reason: String
}

"Response for the avpPermissions_isPermitted query."
type AVPPermissionsIsPermittedResponse {
  "Whether the authenticated user has the requested permission on the resource."
  hasAccess: Boolean!
}

type AVPPermissionsProductCapabilityResponse {
  "Failure code if access is not granted"
  failureCode: String
  "Type of failure that occurred"
  failureType: AVPPermissionsCapabilityFailureType
  "Whether the user has access to the capability"
  hasAccess: Boolean
  "Whether the user has manage permission"
  hasManage: Boolean
  "Whether the user has write permission"
  hasWrite: Boolean
  "Additional properties returned by the capability check"
  properties: [AVPPermissionsPropertyEntry!]
  "Reason for denial if access is not granted"
  reason: String
}

type AVPPermissionsProductCapabilityResult {
  "The product ID (or 'DEFAULT' for non-product-specific responses)"
  productId: String
  "The capability response for this product"
  result: AVPPermissionsProductCapabilityResponse
}

"""
A property entry representing a key-value pair in the properties map.
The value can be either a string or a list of strings.
"""
type AVPPermissionsPropertyEntry {
  "The property key"
  key: String
  "The property value, which can be either a string or a list of strings"
  value: AVPPermissionsPropertyValue
}

"A property value that is a list of strings."
type AVPPermissionsPropertyValueList {
  "The list of string values"
  values: [String!]
}

"A property value that is a single string."
type AVPPermissionsPropertyValueString {
  "The string value"
  value: String
}

"""
The resource permission record for a given resource.
All fields are nullable. Returns null if no record exists for the resource.
"""
type AVPPermissionsResourcePermission {
  "The container ARI for container-inherited permissions (e.g., a Jira project ARI)"
  containerId: ID
  "The integration ID associated with this resource"
  integrationId: String
  "The ARI of the resource permission record (ari:cloud:avp:{siteId}:permission/activation/{activationId}/{permissionId})"
  permissionAri: ID
  "The permission type controlling open access"
  permissionType: AVPPermissionsResourcePermissionType
  "The ARI of the resource"
  resourceId: ID
  "The type of resource"
  resourceType: AVPPermissionsResourceType
}

