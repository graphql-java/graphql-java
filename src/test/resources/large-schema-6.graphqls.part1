  modelDefinition: AVPAnalyticsModelDefinition!
  "Human readable template name for display."
  name: String!
  "Stable identifier for the template, used to correlate list entries. Not an ARI: templates are authored artefacts, not tenant entities."
  templateId: ID!
}

