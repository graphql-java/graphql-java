"A single (tool, requestType) skill-gap group."
type AiCoreApiRsaSkillGapItem {
  "The Jira request type display name scoping these skills (e.g. \"How-to\", \"Troubleshooting\")."
  requestType: String!
  """
  Stable Jira request type ID (e.g. "10001"). Use this as the drill-down key when
  requesting the per-(tool, requestType[, skill]) ticket list — display names can
  collide or be renamed, IDs are unique and stable.
  """
  requestTypeId: String!
  "Skills identified for this tool and request type, sorted by totalTickets descending."
  skills: [AiCoreApiRsaSkill!]!
  "The Atlassian product or integration involved (e.g. \"Jira\", \"Confluence\")."
  tool: String!
  """
  Deduplicated count of unique tickets for this (tool, requestType) group.
  NOT the sum of skills[].totalTickets — a single ticket can contribute to multiple
  skills, so per-skill counts can sum to more than this value. Source of truth is
  SCARD of the (rt, tool) ticket SET.
  """
  totalTickets: Int!
}

"Returned in AiCoreApiRsaReportPayload.skillGap when SKILL_GAP is requested on an INSIGHT job."
type AiCoreApiRsaSkillGapResult {
  "List of skill-gap entries grouped by (tool, requestType). May be empty if no data."
  items: [AiCoreApiRsaSkillGapItem!]!
}

