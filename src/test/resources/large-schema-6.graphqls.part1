  """
  KB gap data. Present when KB_GAP was requested, status=COMPLETED, and reportType=INSIGHT.
  Null for OVERVIEW jobs.
  """
  kbGap: AiCoreApiRsaKbGapResult
  "Resolved rate data. Present when RESOLVED was requested and status=COMPLETED."
  resolved: AiCoreApiRsaResolvedResult
  "Request type distribution data. Present when RT_DISTRIBUTION was requested and status=COMPLETED."
  rtDistribution: AiCoreApiRsaRtDistributionResult
  """
  Skill gap data. Present when SKILL_GAP was requested, status=COMPLETED, and reportType=INSIGHT.
  Null for OVERVIEW jobs.
  """
  skillGap: AiCoreApiRsaSkillGapResult
  "Current job status. Poll until COMPLETED or FAILED."
  status: AiCoreApiRsaJobStatus!
  "True if result was capped — show truncation banner on the dashboard."
  truncated: Boolean
  "Time-to-resolution data across all closed tickets. Present when TTR was requested and status=COMPLETED."
  ttr: AiCoreApiRsaTtrResult
}

