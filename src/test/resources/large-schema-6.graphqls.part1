"""
A coverage gap (uncovered time window) the FE can render and assign an agent
to. Gaps are **derived, not persisted** — they have no stable id. The FE
addresses a gap by `(scheduleId, occurrenceStartTime, gapOwnerAgentId)` when
invoking `agentWorkspace_assignAgentToGap`, and by
`(scheduleId, gapOwnerAgentId)` when invoking
`agentWorkspace_recommendedAgentsForCoverageGap`.
"""
type AgentWorkspaceCoverageGap {
  """
  The gap-owner agent. Round-trip as `gapOwnerAgentId` on
  `agentWorkspace_assignAgentToGap`.
  """
  agentId: ID!
  "Duration of the gap in minutes."
  durationMinutes: Int!
  "When the gap ends."
  endTime: DateTime!
  """
  Why the agent is off, when the gap is leave. Null for a plain cancellation, once the reason
  has been cleared, or while leave is not enabled for the site.
  """
  leaveType: AgentWorkspaceLeaveType
  """
  Original start time of the schedule occurrence this gap derives from.
  Round-trip as `occurrenceStartTime` on `agentWorkspace_assignAgentToGap`.
  """
  occurrenceStartTime: DateTime!
  "ID of the schedule the gap belongs to."
  scheduleId: ID!
  "Name of the schedule the gap belongs to, for display."
  scheduleName: String!
  "When the gap starts."
  startTime: DateTime!
}

"""
A covering shift an agent has been assigned to, surfaced under
`AgentWorkspaceAgentShifts.coveringShifts`. The original (rostered) agent for
the schedule occurrence is deliberately not exposed on this type.
"""
type AgentWorkspaceCoveringShift {
  coveringAgentId: ID!
  coveringShiftId: ID!
  durationMinutes: Int!
  endTime: DateTime!
  "True when the covering agent is covering their own shift."
  isOwnCover: Boolean!
  """
  Start time of the occurrence this covering shift belongs to. Round-trip as
  `occurrenceStartTime` on covering-shift mutations for a precise lookup.
  """
  occurrenceStartTime: DateTime!
  scheduleId: ID!
  scheduleName: String!
  startTime: DateTime!
}

