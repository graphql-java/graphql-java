"Represents a single asset types tracking record within a vertical instantiation category."
type AssetsVerticalAssetTypesTracking {
  "Audit information."
  auditInfo: AssetsVerticalAuditInfo!
  "The tenant cloud identifier."
  cloudId: ID! @CloudID(owner : "assets-vertical")
  "Unique identifier (UUID)."
  id: ID!
  "Hydrated Assets schema."
  objSchema: AssetsSchema @idHydrated(idField : "objSchemaAri", identifiedBy : null)
  "Hydrated Assets object type."
  objType: AssetsObjectType @idHydrated(idField : "objTypeAri", identifiedBy : null)
  "Identifier of the parent vertical instantiation category."
  verticalInstantiationCategoryId: ID!
  "Workspace identifier associated with this tracking record."
  workspaceId: ID!
}

"""
A paginated list of asset types tracking records.
Uses the Relay-style connection pattern for forward pagination.
"""
type AssetsVerticalAssetTypesTrackingConnection {
  "Edges in the current page of results."
  edges: [AssetsVerticalAssetTypesTrackingEdge!]!
  "Pagination metadata for navigating the result set."
  pageInfo: PageInfo!
