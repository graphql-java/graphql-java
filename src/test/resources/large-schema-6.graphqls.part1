"""
Per-(principal, role) result row returned by the role assignment mutations.
Each row corresponds to a single underlying Identity create or delete call
and reports whether that specific edge succeeded.

This per-edge grain matches Identity's API and supports partial-failure
reporting: when some edges succeed and others fail, the payload reports each
edge's outcome individually.
"""
type AssetsVerticalRoleAssignmentResult {
  "Error details if this individual assignment failed. Null on success."
  error: AssetsVerticalRoleAssignmentError
  "The operation performed: CREATE or DELETE."
  operation: AssetsVerticalRoleAssignmentOperation
  "ARI of the principal this result row pertains to."
  principalId: ID!
  "ARI of the role this result row pertains to."
  roleId: ID!
  "Whether this specific (principal, role) operation succeeded."
  success: Boolean!
}

