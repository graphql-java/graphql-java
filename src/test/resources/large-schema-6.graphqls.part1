  excludedAt: String
  "Account ID of the org admin who marked the finding as a false positive"
  excludedBy: String
  occurrence: DlpFindingOccurrence
  "Scope the dismissal was recorded at; required to address the record on removal"
  scope: DlpFalsePositiveScope
}

type DlpFalsePositiveOccurrencesListResponse {
  cursor: String
  falsePositiveOccurrences: [DlpFalsePositiveOccurrence]
  pageSize: Int
  totalCount: Int
