  "PR title prefix, limited to 50 Unicode code points after trimming surrounding whitespace."
  pullRequestPrefix: String
  """
  Legacy single weekly scan schedule. New clients should prefer
  `scanScheduleConfiguration`, which supports one or more weekly schedules.
  """
  scanSchedule: DevAiAutodevNextScanSchedule
  """
  Preferred recurring scan configuration. Its timezone is shared by every
