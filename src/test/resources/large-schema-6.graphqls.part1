  "Deletes relationships between two nodes"
  deleteRelationships(input: AriGraphDeleteRelationshipsInput!): AriGraphDeleteRelationshipsPayload
  "Replaces all relationships for the given type and nodes with those supplied"
  replaceRelationships(input: AriGraphReplaceRelationshipsInput!): AriGraphReplaceRelationshipsPayload
}

