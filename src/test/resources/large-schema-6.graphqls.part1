"""
One page of the merged dashboard directory: AVP dashboards and Jira (classic) dashboards
interleaved into a single globally-sorted page.
"""
type AVPMergedDashboardDirectory {
  "The page's entries, in sort order"
  dashboards: [AVPMergedDirectoryDashboard!]!
  "Send as `afterCursor` for the page after this one. Null when this is the last page."
  nextCursor: String
  """
  This page's own position. Send it as `afterCursor` to read this same page again, or as `beforeCursor` to read
  the page before it. Null when this is the first page.
  """
  selfCursor: String
}

"""
An entry in the merged dashboard directory representing either an AVP dashboard or a Jira (classic)
dashboard. Fields follow Jira's GET /rest/api/2/dashboard so that the directory renders both sources
the same way, distinguished by additional property `type`.
"""
type AVPMergedDirectoryDashboard {
  description: String
  "The write and manage grants"
  editPermissions: [AVPMergedDirectoryPermission!]!
  "AVP dashboard UUID or Jira dashboard numeric id"
  id: ID!
  "Whether the calling user has starred the dashboard"
  isFavourite: Boolean!
  "Whether the calling user can edit the dashboard"
  isWritable: Boolean!
  "Title of dashboard"
  name: String
  "The dashboard's owner. Null on an AVP row, which has no owner to report."
  owner: AVPMergedDirectoryUser
  "The star count; Jira calls this popularity"
  popularity: Int
  "The read grants, or a single LOGGEDIN grant when the dashboard is open to the site"
  sharePermissions: [AVPMergedDirectoryPermission!]!
  "Whether this is a system default dashboard"
  systemDashboard: Boolean!
  "The kind of dashboard"
  type: AVPMergedDirectoryDashboardType!
}

"""
A group a directory grant names. A Jira row carries `name` directly; an AVP row replicates the group id
alone and reads its name off `identity`, the same split `AVPMergedDirectoryUser` makes for accounts.
"""
type AVPMergedDirectoryGroup {
  groupId: String
  """
  The group's identity details, hydrated by AGG from `principalId`: `name` to render it by. Null for a group
  identity will not serve — one that has been deleted, or is hidden from the calling user.
  """
  identity: IdentityGroup @idHydrated(idField : "principalId", identifiedBy : null)
  "The group's display name as Jira sends it. Null on an AVP row — read `identity.name` there."
  name: String
  """
  The site-scoped ARI of this group, derived from `groupId` so that AGG can hydrate `identity` from it.
  Null on a Jira row, which needs no hydration because it already carries `name`.
  """
  principalId: ID @ARI(interpreted : false, owner : "identity", type : "scoped-group", usesActivationId : false)
}

"""
A permission grant on a dashboard presented in the Jira Dashboards directory. It is shaped similarly
to Jira's GET /rest/api/2/dashboard. The populated principal field is whichever the `type` names.
"""
type AVPMergedDirectoryPermission {
  "The group a GROUP grant names"
  group: AVPMergedDirectoryGroup
  "Jira numbers each grant row. AVP does not, so will be null."
  id: String
  "The project a PROJECT grant names"
  project: AVPMergedDirectoryProject
  "The project role a PROJECT_ROLE grant names"
  role: AVPMergedDirectoryRole
  "The kind of grant principal. Null when Jira names a type this schema does not carry yet."
  type: AVPMergedDirectoryPermissionType
  "The user a USER grant names"
  user: AVPMergedDirectoryUser
}

"A project a directory grant names."
type AVPMergedDirectoryProject {
  "Avatar URLs keyed by Jira's pixel sizes, e.g. `48x48`."
  avatarUrls: JSON @suppressValidationRule(rules : ["JSON"])
  id: ID!
  key: String
  name: String
}

"A project role a directory grant names."
type AVPMergedDirectoryRole {
  id: String
  name: String
}

"""
A user on a directory row: the account, and the identity details AGG hydrates from it. Jira sends a display
name, avatars and account state of its own, and AVP replicates the account id alone — rather than carry a
shape only one source can fill, every row reports the account and reads its name and avatar off `identity`.
"""
type AVPMergedDirectoryUser {
  accountId: ID!
  """
  The user's identity details, hydrated by AGG from `principalId`: `name` to render them by, `picture` for
  their avatar, and `accountStatus` for whether the account is still active. Null for an account identity
  will not serve — one that is closed, or hidden from the calling user by their privacy controls.
  """
  identity: User @idHydrated(idField : "principalId", identifiedBy : null)
  "The ARI of this account, derived from `accountId` so that AGG can hydrate `identity` from it."
  principalId: ID @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
}

type AVPMetricsConfiguration {
  "Metric dimensions configuration"
  dimensions: [AVPMetricsDimension!]
  "Metric filters configuration"
  filters: [AVPMetricsFilter!]
  "Granularity for time-based metrics"
  granularity: String
  "Composed grouped filter for Metrics API queries"
  groupedFilter: JSON @suppressValidationRule(rules : ["JSON"])
  "Tagged-union JQL source for Jira-backed metrics queries. Null for non-Jira charts."
  jqlSource: AVPJqlSource
  "List of metrics to query"
  metrics: [String!]
  "Search conditions for metrics"
  searchCondition: String
  "Workspace ID for metrics context"
  workspaceId: String
}

type AVPMetricsDimension {
  "Name of the dimension"
  name: String!
  "Optional output configuration for this dimension"
  outputOptions: AVPMetricsDimensionOutputOptions
  "Type of dimension (e.g., categorical, temporal)"
  type: String!
}

"Output configuration for a metrics dimension"
type AVPMetricsDimensionOutputOptions {
  "Time bucketing for this dimension"
  timeGranularity: AVPMetricsTimeGranularity
}

type AVPMetricsFilter {
  "Comparison operator"
  comparison: String!
  "Dimension to filter on"
  dimension: String!
  "Values to filter by"
  operands: [String!]!
  "Product context (e.g., jira, devops)"
  product: String!
  "Whether null values should be included in the filter"
  withNullValue: Boolean
}

