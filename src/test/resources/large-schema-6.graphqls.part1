"""
One step of the agent's reasoning trace. `id` is stable across snapshots and the array is ordered by
the order steps started — the subscription replaces the whole summary record on every snapshot, so an
unstable id or a reordered array would collapse an expanded step mid-stream.
Contract: https://hello.atlassian.net/wiki/spaces/~610244461/pages/7753871336
"""
type ChangeManagementJSMPreventionCenterOverviewSummaryAnalysisStep {
  """
  Kept for backwards compatibility with clients that render `body ?? title` as a single line.
  Prefer `reasoning`.
  """
  body: String
  "Sources the step found while running."
  documents: [ChangeManagementJSMPreventionCenterOverviewSummaryAnalysisStepDocument!]
  id: ID!
  """
  The expandable reasoning body, in arrival order — one entry per upstream reasoning chunk. Empty
  until the step produces reasoning; clients use the first entry as the one-line preview.
  """
  reasoning: [String!]
  "Products whose icons are shown while the step runs."
  sourceProducts: [String!]
  status: ChangeManagementJSMPreventionCenterOverviewSummaryAnalysisStepStatus!
  """
  Human-readable label, e.g. "Invoking tool: Get work item". Safe to show to customers and
  localisable. Falls back to the upstream trace's own text when a step reports no title.
  """
  title: String!
  "Icon key for `toolName`. Without it every step renders a generic fallback icon."
  toolIcon: String
  "Tool the step invoked, for per-step attribution."
  toolName: String
}

type ChangeManagementJSMPreventionCenterOverviewSummaryAnalysisStepDocument {
  product: String
  title: String!
  url: String!
}

"""
 ── Response shape ─────────────────────────────────────────
 Single object type (NOT a union). `status` discriminates IN_PROGRESS vs AVAILABLE; used directly
 by Query, Subscription and Mutation. A plain object (not a union) is required so it works as a
 graphql-subscriptions subscription root field type.
"""
type ChangeManagementJSMPreventionCenterOverviewSummaryResponse {
  analysisSteps: [ChangeManagementJSMPreventionCenterOverviewSummaryAnalysisStep!]
  doneSoFar: String
  """
  Whether the REQUESTING USER has already run a Rovo risk assessment on this issue. Not part of the
  summary: carried here so the issue view can render the AI nudge banner on first load. Populated by
  the query and by the subscription's terminal AVAILABLE event — null on the mutations and on
  in-progress subscription events — and independent of `status`.
  """
  isRiskAssessmentDone: Boolean
  lastUpdatedAt: String
  potentialRisk: ChangeManagementJSMPreventionCenterOverviewSummaryRiskLevel
  """
  Risk level reported by that last risk assessment, as recorded by the client. Distinct from
  `potentialRisk`, which is the summary's own assessment. Null when no assessment has been run, or
  when it was recorded without a level.
  """
  riskLevel: ChangeManagementJSMPreventionCenterOverviewSummaryRiskLevel
  sources: [ChangeManagementJSMPreventionCenterOverviewSummarySource!]
  status: ChangeManagementJSMPreventionCenterOverviewSummaryStatus!
  suggestedNextSteps: String
  summary: String
}

type ChangeManagementJSMPreventionCenterOverviewSummarySource {
  ari: String!
  lastModified: String!
  title: String!
  type: String!
  url: String!
}

type ChangeManagementJSMPreventionCenterRiskAssessmentCategoryResult {
  category: ChangeManagementJSMPreventionCenterRiskAssessmentCategory!
  riskLevel: ChangeManagementJSMPreventionCenterOverviewSummaryRiskLevel!
  subCategories: [ChangeManagementJSMPreventionCenterRiskAssessmentSubCategoryResult!]!
}

type ChangeManagementJSMPreventionCenterRiskAssessmentMitigationCategoryRisk {
  category: ChangeManagementJSMPreventionCenterRiskAssessmentCategory!
  risk: ChangeManagementJSMPreventionCenterOverviewSummaryRiskLevel!
}

type ChangeManagementJSMPreventionCenterRiskAssessmentMitigationStep {
  description: String
  """
   Derived from the summary, so stable across reads.
  
  
  This field is **deprecated** and will be removed in the future
  """
  id: ID!
  likelyToMitigate: [ChangeManagementJSMPreventionCenterRiskAssessmentMitigationCategoryRisk!]
  suggestedAction: ChangeManagementJSMPreventionCenterRiskAssessmentMitigationSuggestedAction
  summary: String!
}

"""
 ══ Risk assessment ═══════════════════════════════════════════════════════════
 Run by the change-risk agent on the overview's lifecycle; reuses its status, risk-level, source and
 analysis-step types. Contract: https://hello.atlassian.net/wiki/spaces/ITSOL/pages/7630843536
"""
type ChangeManagementJSMPreventionCenterRiskAssessmentResponse {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
