"""
Recurring scan slot within a week.

`timezone` is an IANA zone ID (e.g. "America/New_York", "UTC"). When
absent, the value was resolved server-side from the workstream owner's
profile, falling back to "UTC" if no owner timezone is available.
`timeOfDay` is a local wall-clock time in HH:mm format. When absent on
legacy settings, the effective value is 00:00.
"""
type DevAiAutodevNextScanSchedule {
  dayOfWeek: DevAiAutodevNextDayOfWeek!
  timeOfDay: String
  timezone: String!
}

type DevAiAutodevNextScanScheduleSlot {
