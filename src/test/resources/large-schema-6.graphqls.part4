  set of Object Types (derived from the AVI) ex:
  issue
  page
  blogpost
  whiteboard
  database
  embed
  slide
  project (townsquare)
  goal
  """
  objectTypes: [String!]
  """
  set of products (derived from the AVI) ex:
  jira
  confluence
  townsquare
  """
  products: [String!]
  """
  arbitrary transition filters
  
  
  This field is **deprecated** and will be removed in the future
  """
  transitions: [TransitionFilter!]
}

