"""
Metrics are entities that are attached to metric targets. Metrics have a specific name and measurement type.
For example, the name of a metric could be “number of users” and it could have the measurement type “number.”

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:goal:goals__
* __read:goal:townsquare__
"""
type TownsquareMetric implements Node @defaultHydration(batchSize : 50, field : "goals_metricsByIds", idArgument : "metricIds", identifiedBy : "id", timeout : -1) @renamed(from : "Metric") @scopes(product : GOAL, required : [READ_GOAL]) @scopes(product : TOWNSQUARE, required : [READ_TOWNSQUARE_GOAL]) {
  """
  Represents a list of activity items for the metric
  - first: Maximum number of activity items to return
  - after: Cursor for pagination, indicating where to start fetching activity items after a specific activity item
  - sort: Optional sort order for the results (defaults to descending sort by creation date if not specified)
  """
  activityItems(after: String, first: Int, sort: [TownsquareActivityItemSortEnum]): TownsquareActivityItemConnection
  "The archived status of the metric."
  archived: Boolean
  "ID of the external entity providing the metric data. External entities being non-Atlassian providers."
  externalEntityId: String
  "The unique identifier (ID) of the metric."
  id: ID! @ARI(interpreted : false, owner : "townsquare", type : "metric", usesActivationId : false) @renamed(from : "ari")
  "Current value of the metric."
  latestValue: TownsquareMetricValue
  "The metric targets for this Metric"
  metricTargets: TownsquareMetricHasMetricTargetConnection
  "The name of the metric."
  name: String
  """
  Provider name of the metric data. If the the data syncs from the Goals app, the source will be "MANUAL". If data syncs from external providers, the source will be the name of the provider.
  For example: "AWS", "SNOWFLAKE", "DATABRICKS", etc.
  """
  source: String
  "The sub-type of the metric. Only applicable for metric type \"CURRENCY\"."
  subType: String
  "The type of the metric."
  type: TownsquareMetricType
  "Past values that the metric has had."
  values(
    after: String,
    "End of the period (exclusive)"
    endDate: DateTime,
    first: Int,
    sort: [TownsquareMetricValueSortEnum],
    "Start of the period (inclusive)"
    startDate: DateTime
  ): TownsquareMetricValueConnection
}

