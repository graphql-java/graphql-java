enum AppContainerServiceContextFilterType {
  """
  Filters app container services by placement, given as a bare EcosystemAppPlacementAri,
  for example "ari:cloud:ecosystem::app-placement/isolation-context/ic-dr6",
  "ari:cloud:ecosystem::app-placement/region/us-east-1" or
  "ari:cloud:ecosystem::app-placement/customer-data-plane/cdp-bb0".
  
  An "isolation-context" placement is narrowed to the Isolated Cloud it names, a "region"
  placement to the commercial cluster serving that region, and a "customer-data-plane"
  placement to the services deployed to that Customer Data Plane, which requires ASSP
  placements to be enabled for the app. A region placement names the region a service runs
  in, as reported by AppContainerService.placementAri, which is not necessarily the
  placement region an installation asked for.
  """
  PLACEMENT
}

