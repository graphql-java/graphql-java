input JiraSetAdminAgentRequestConfigInput {
  "Required when `requestsEnabled` is true, and must be absent when it is false."
  destination: JiraAdminAgentRequestDestinationInput
  """
  The complete allowlist, not a delta. Null when `enabledProjectsScope` is `ALL` — nothing to
  enumerate. An empty list (as opposed to null) clears a `SPECIFIC` selection down to none.
  
  First iteration: when `requestsEnabled` is false the client sends an empty list, `SPECIFIC`
  scope, and a null `destination`, so disabling the flow also clears the selection. Preserving a
  selection across a disable is a deliberate follow-up, not an oversight — see JIAA-343's plan
  notes.
  
  Takes plain project ids (`JiraProject.projectId`), not ARIs.
  """
  enabledProjectIds: [ID!]
  """
  Whether this write is "every eligible project" or a specific curated list. Optional rather
  than required: adding a required field to an existing input breaks any caller that predates
  it (AGG breaking-change rules apply to input shape regardless of `@stubbed`). Null is treated
  as `SPECIFIC`, matching every caller that existed before this field did.
  """
  enabledProjectsScope: JiraAdminAgentEnabledProjectsScope
  """
  Whether the site offers the champion request flow. Must be false when no `destination` is
  supplied.
  """
  requestsEnabled: Boolean!
}

