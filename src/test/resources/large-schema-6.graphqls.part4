}

"Input for `agentWorkspace_unassignShifts`."
input AgentWorkspaceUnassignShiftsInput {
  "The agent to take off their shifts. Omit to act on yourself."
  agentAccountId: ID
  """
  End of the daily time slice, as HH:mm. Must be after customStartTime, or 00:00 for the end of
  the day. Leave crossing midnight needs one request per day.
  """
  customEndTime: String
  "Start of the daily time slice, as HH:mm. Required when unassignEntireShift is false."
  customStartTime: String
  "Last date of the leave, inclusive. Equal to startDate for a single day."
  endDate: String!
  leaveType: AgentWorkspaceLeaveType!
  projectARI: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  """
  The schedules to unassign from. One leave record is written per shift occurrence,
  sharing a leaveRequestId across the submission.
  Schedules the agent isn't on are skipped; the request fails only if the agent
  is on none of them.
  """
  scheduleIds: [ID!]!
  "First date of the leave, inclusive, as an ISO-8601 date (e.g. \"2026-12-15\")."
  startDate: String!
  "IANA timezone the dates and times are read in (e.g. \"Australia/Sydney\")."
  timezone: String!
  """
  True to take the agent off whole shifts; false to remove only customStartTime to customEndTime of
  each day.
  """
  unassignEntireShift: Boolean!
}

