"""
The input for filtering and searching agents.
Note: Boolean filters (onlyMyAgents, onlyFavouriteAgents, onlyTemplateAgents, onlyEditableAgents,
onlyVerifiedAgents) are mutually exclusive—only one can be true at a time.
"""
input AgentStudioAgentQueryInput {
  "Filter by agent creator types. Explicitly selecting ROVO_CHAT or ROVO_DEV includes those agent types."
  creatorTypes: [AgentStudioAgentCreatorType!]
  """
  Include draft agents in the results. Only admins and collaborators can see draft agents. Defaults to false.
  
  
  This field is **deprecated** and will be removed in the future
  """
  includeDraftAgents: Boolean
  "Include the Jira Coding Agent in the results. It is excluded by default. This is additive and can be combined with the other filters."
  includeJiraCodingAgent: Boolean
  "Include the Rovo Chat Agent in the results. It is excluded by default. This is additive and can be combined with the other filters."
  includeRovoChatAgent: Boolean
  "Filter by agent name"
  name: String
  "Filter by only agents the user is able to edit"
  onlyEditableAgents: Boolean
  "Filter by only favourite agents"
  onlyFavouriteAgents: Boolean
  "Filter by only my agents"
  onlyMyAgents: Boolean
  "Filter by only published agents that the user can edit, i.e. agents with a LIVE version where the user has edit permission"
  onlyPublishedEditableAgents: Boolean
  "Filter by only published agents that the user can edit including Forge-managed agents, intended for surfaces like the JSM portal agent picker"
  onlyPublishedEditableAgentsWithForge: Boolean
  """
  Filter by at least one exact, case-sensitive workspace tag key (maximum 10 supplied keys).
  Omitted or null leaves tags unrestricted; an empty list returns no agents. Unknown or blank keys do not match.
  Currently supported through ACPS only, without name or only* Boolean filters.
  """
  onlyTagKeys: [String!]
  "Filter by only template agents"
  onlyTemplateAgents: Boolean
  "Filter by only unpublished agents, i.e. agent that has been created but there is no published version"
  onlyUnpublishedAgents: Boolean
  "Filter by only verified agents"
  onlyVerifiedAgents: Boolean
}

