  The accountId is optional, in case of missing accountId the logged in user will be added/removed as a watcher.
  
  
  This field is **deprecated** and will be removed in the future
  """
  accountId: ID
  """
  Accepts ARI(s): user
  The user is optional, in case of missing user the logged in user will be added/removed as a watcher.
  """
  id: ID @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  operation: JiraWatchesOperations!
}

"Input for creating or updating the site-level Jira watermark config."
input JiraWatermarkConfigInput {
  """
  Whether watermarking is enabled for the site.
  
  Required: `configHash` is only derived and persisted for a config saved with
  `enabled: true`, so omitting this would store a config that never mints a watermark
  pointer while the mutation still reports `success: true`.
  """
  enabled: Boolean!
  """
  Watermark modes to persist. Always required, regardless of `enabled`, and at least one
  of `user` or `image` must be supplied. Use `deleteWatermarkConfig` to clear the
  watermark config; a mode-less config is rejected.
  """
  modes: JiraWatermarkModesInput!
  "Settings Service resource ARI that owns this watermark config."
  resourceAri: ID! @ARI(interpreted : false, owner : "jira", type : "workspace", usesActivationId : false)
}

"Input for image watermark mode."
input JiraWatermarkImageModeInput {
  "Media file id of the watermark image."
  fileId: String!
  "Rendering metadata for this watermark mode. Required when the image mode is supplied."
  metadata: JiraWatermarkModeMetadataInput!
}

"Input rendering metadata shared by user and image watermark modes."
input JiraWatermarkModeMetadataInput {
  "Watermark color, for example `dark`. User mode only; image mode may omit this."
  color: String
  "Opacity between 0 and 1."
  opacity: Float
  "Placement strategy for the watermark, for example `bottom-right`."
  position: String
  "Scale between 0 and 1."
  scale: Float
}

"Input watermark rendering modes. Provide a user mode, an image mode, or both."
input JiraWatermarkModesInput {
  "Image watermark mode."
  image: JiraWatermarkImageModeInput
  "User-id based watermark mode."
  user: JiraWatermarkUserModeInput
}

"Input for user-id based watermark mode."
input JiraWatermarkUserModeInput {
  "Rendering metadata for this watermark mode. Required when the user mode is supplied."
  metadata: JiraWatermarkModeMetadataInput!
  "User identifier source. For the current implementation this is usually `aaid`."
  source: String!
}

