"""
A TrelloCardBatchScript is a list of commands to apply sequentially to each card matched by the batch job selection.
Each command transforms the card in some way.
If an earlier command fails, later commands will not be run _for that card_.
However, other cards in the selection _will_ still have the script run against them.
"""
input TrelloCardBatchScript {
  "A list of commands to apply to matched cards during execution."
  commands: [TrelloCardCommand!]
}

"""
A TrelloCardBatchSelection is a list of clauses treated as logically AND-ed together.
Each clause narrows the cards present on the parent board in some way.
Note that the default selection with zero clauses will select _every_ card on the board, including closed cards.
"""
input TrelloCardBatchSelection {
  "A list of clauses used to filter cards on a board."
  clauses: [TrelloCardClause!]
}

"""
The TrelloCardBatchSpecificationInput defines a specification for a batch job run against a board.
A batch job will specify a selection of cards to operate on, and a script to apply to each card.
The batch job is run in the background, so the mutation that submits the specification will return immediately.
The status of the job can be queried via the TrelloCardBatch type.
"""
input TrelloCardBatchSpecificationInput {
  "The ID of the board the batch is scoped to."
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "The operations to apply to the matched cards."
  script: TrelloCardBatchScript
  "The selection used to filter cards on the parent board."
  selection: TrelloCardBatchSelection
}

"""
Describes the potential clause bodies that may be supplied.
Uses @oneOf to work around lack of union support, which requires that all fields be nullable here.
"""
input TrelloCardClause @oneOf {
  closed: TrelloCardClosedClause
  completed: TrelloCardCompleteClause
  ids: TrelloCardIdsClause
  list: TrelloCardListClause
}

"Describes an operation to close or open a matched card."
input TrelloCardCloseCommand {
  "If true, the matched card will be closed; if false, it will be opened."
  close: Boolean!
}

"""
Describes a filter for the closed property on cards.
Note that by default _all_ cards are matched in a selection.
"""
input TrelloCardClosedClause {
  "True if only closed cards should be matched; false if only open cards should be matched."
  closed: Boolean!
}

"""
Describes the potential command bodies that may be supplied.
Uses @oneOf to work around lack of union support in inputs.
"""
input TrelloCardCommand @oneOf {
  addLabels: TrelloCardLabelsCommand
  close: TrelloCardCloseCommand
  complete: TrelloCardCompleteCommand
  delete: TrelloCardDeleteCommand
  removeLabels: TrelloCardLabelsCommand
}

"Describes a filter for the complete flag on cards."
input TrelloCardCompleteClause {
  "True if only completed cards should be matched; false if only incomplete cards should be matched."
  completed: Boolean!
}

"Describes an operation to mark a card complete or incomplete."
input TrelloCardCompleteCommand {
  "If true, the matched card will be marked complete; if false, it will be marked incomplete."
  complete: Boolean!
}

"Latitude and longitude input for a card's geographic location"
input TrelloCardCoordinatesInput {
  latitude: Float!
  longitude: Float!
}

"""
The cover of a card.
Includes a cover type and optional display properties.
"""
input TrelloCardCoverInput {
  brightness: String
  size: String
  type: TrelloCardCoverTypeInput!
  yPosition: Float
}

"The type of card cover. Exactly one of these options must be provided."
input TrelloCardCoverTypeInput @oneOf {
  attachmentId: String
  color: String
  uploadedBackgroundId: String
  url: String
}

"Describes an operation to delete a matched card."
input TrelloCardDeleteCommand {
  "If true, the matched card will be deleted; if false, the command is a no-op."
  delete: Boolean!
}

"""
Describes a filter for specific identified cards, based on their ARI.
Note that this filter will still be combined with other clauses to narrow the selection.
"""
input TrelloCardIdsClause {
  "The specific card IDs to process."
  cards: [ID!] @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
}

"""
Labels to add to or remove from each matched card, preserving other labels.
Requires the bulk-label feature to be enabled.
"""
input TrelloCardLabelsCommand {
  """
  The labels to add or remove. Labels must belong to the selected cards' board.
  An empty list leaves the cards unchanged.
  """
  labelIds: [ID!]! @ARI(interpreted : false, owner : "trello", type : "label", usesActivationId : false)
}

"Describes a filter for the parent list of cards."
input TrelloCardListClause {
  "The parent lists which contain matching cards."
  lists: [ID!] @ARI(interpreted : false, owner : "trello", type : "list", usesActivationId : false)
}

"These fields are related to info about when the check item is due"
input TrelloCheckItemDueInfoInput {
  "The due date of the check item."
  at: DateTime
  """
  The number of minutes before the due date that all members and followers of the card will be notified.
  Will be null if the due date was never set or if a reminder was never set.
  """
  reminder: Int
}

"Specifies either an existing checklist ARI or a new checklist name to create."
input TrelloChecklistTarget @oneOf {
  "The ARI of an existing checklist."
  id: ID @ARI(interpreted : false, owner : "trello", type : "checklist", usesActivationId : false)
  "The name of the new checklist to create."
  name: String
}

"Arguments passed into the close board mutation"
input TrelloCloseBoardInput {
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into the closeCard mutation"
input TrelloCloseCardInput {
  cardId: ID! @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
}

"Arguments passed into the closeList mutation"
input TrelloCloseListInput {
  listId: ID! @ARI(interpreted : false, owner : "trello", type : "list", usesActivationId : false)
}

"Arguments for the first board in completeOnboarding"
input TrelloCompleteOnboardingBoardInput {
  addStarterGuide: Boolean!
  background: String
  description: String
  firstListCards: [TrelloCompleteOnboardingCardInput]
  name: String!
}

"Arguments for a card in the first list in completeOnboarding"
input TrelloCompleteOnboardingCardInput {
  complete: Boolean
  description: String
  name: String!
  position: Float!
}

"Arguments passed into completeOnboarding mutation"
input TrelloCompleteOnboardingInput {
  board: TrelloCompleteOnboardingBoardInput!
  organizationName: String!
}

"Arguments passed into the convertBoardToTemplate mutation"
input TrelloConvertBoardToTemplateInput {
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into the convertTemplateToBoard mutation"
input TrelloConvertTemplateToBoardInput {
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into the copyCard mutation"
input TrelloCopyCardInput {
  "ARI of the card to copy."
  cardId: ID! @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
  "ARI of the destination list. Defaults to the source card's list when omitted."
  listId: ID @ARI(interpreted : false, owner : "trello", type : "list", usesActivationId : false)
  "Name for the new card. Defaults to the source card's name when omitted."
  name: String
  """
  Position of the copied card in the destination list.
  Use "top" or "bottom" (default: "bottom"), or an absolute float.
  """
  position: TrelloCardPosition
}

"Input type for creating a Trello application (Power-Up / Integration)"
input TrelloCreateApplicationInput {
  "Id of the developer agreement (which indicates the developer has read and agreed to terms and conditions)"
  agreementId: ID!
  "Name or company of the application developer"
  author: String!
  "Contact email if Trello needs to reach out to the application developer."
  email: String!
  "The iFrame connector url location. Only used for Power-Ups and is called by Trello to load the Power-Up"
  iframeUrl: URL
  "The locale of the application name"
  locale: String
  "The name of the application"
  name: String!
  "The scopes to register for the OAuth2 Client"
  scopes: [String!]
  "Email address or link for users to reach your support team."
  supportContact: String!
  "The workspace that the application belongs to"
  workspaceId: ID!
}

"Arguments passed into the createAutomationFromPrompt mutation"
input TrelloCreateAutomationFromPromptInput {
  "The user input to AI to help create the automation"
  userInput: TrelloCreateAutomationFromPromptUserInput!
  "The workspace to create the automation in"
  workspaceId: ID! @ARI(interpreted : false, owner : "trello", type : "workspace", usesActivationId : false)
}

"User input for creating an AI-generated automation"
input TrelloCreateAutomationFromPromptUserInput @oneOf {
  "User input for creating an automation from a natural-language prompt."
  automationCreationInput: TrelloAutomationCreationInput
}

"Either a color or url to make as the background of the board"
input TrelloCreateBoardBackgroundInput @oneOf {
  "Color name or built-in background preset"
  key: String
  "Background image URL"
  url: String
}

"Arguments passed into createBoardFromRecommendation mutation"
input TrelloCreateBoardFromRecommendationInput {
  """
  ARI of the recommendation to build the board from. Accepts the
  card-recommendation ARI, or the legacy recommendation ARI until that
  format is retired.
  """
  recommendationId: ID! @ARI(interpreted : false, owner : "trello", type : "card-recommendation", usesActivationId : false) @ARI(interpreted : false, owner : "trello", type : "recommendation", usesActivationId : false)
}

"Arguments passed into createBoard mutation"
input TrelloCreateBoardInput {
  "The board's creation method"
  creationMethod: TrelloBoardCreationMethod
  "The description of the board"
  description: String
  "The name of the new board"
  name: String!
  "Collection of preferences for the board"
  preferences: TrelloBoardPreferencesInput
  "How the board is setup and what content will be in the board on creation"
  setup: TrelloSetupInput
  "The workspace the board is created in"
  workspaceId: ID! @ARI(interpreted : false, owner : "trello", type : "workspace", usesActivationId : false)
}

"Arguments passed into createBoardWithAi mutation"
input TrelloCreateBoardWithAiInput {
  "The user input to AI to help create a personalized board"
  userInput: TrelloAiBoardUserInput!
  "The workspace to create the board in"
  workspaceId: ID! @ARI(interpreted : false, owner : "trello", type : "workspace", usesActivationId : false)
}

"The uploaded image and destination for creating a card."
input TrelloCreateCardFromImageInput {
  fileName: String!
  imageBase64: String!
  listId: ID! @ARI(interpreted : false, owner : "trello", type : "list", usesActivationId : false)
  mediaType: String!
  position: TrelloCardPosition
  "A stable UUID for this upload, reused when retrying the request."
  requestId: ID!
}

"Argument passed into createCard mutation"
input TrelloCreateCardInput {
  "The name of an agent to invoke, using the newly-created card as context"
  agentName: String
  "The way the card was created"
  creationMethod: TrelloCardCreationMethod
  """
  Whether the card is mid-creation via an async method like AI — sets the
  loading state
  """
  creationMethodLoading: Boolean
  "Description of the card"
  description: String
  "Due date for the card"
  due: DateTime
  externalSource: TrelloCardExternalSource
  faviconUrl: String
  listId: ID! @ARI(interpreted : false, owner : "trello", type : "list", usesActivationId : false)
  name: String!
  position: TrelloCardPosition
  urlSource: String
  urlSourceText: String
}

"Arguments passed into createCheckItem mutation"
input TrelloCreateCheckItemInput {
  "True if the check item is checked"
  checked: Boolean = false
  "The checklist the user wants to create the new check item in"
  checklistId: ID! @ARI(interpreted : false, owner : "trello", type : "checklist", usesActivationId : false)
  "The check item's creation method"
  creationMethod: TrelloCheckItemCreationMethod
  "Information about the due property of the check item. Null if check item has no due date."
  due: TrelloCheckItemDueInfoInput
  "The name of the new check item"
  name: String!
  "The check item's relative position"
  position: TrelloPosition = {relative : BOTTOM}
  "The member assigned to the check item"
  userId: ID @ARI(interpreted : false, owner : "trello", type : "user", usesActivationId : false)
}

"Arguments passed into the createChecklist mutation"
input TrelloCreateChecklistInput {
  "ARI of the card to create the checklist on"
  cardId: ID! @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
  "The way the checklist was created"
  creationMethod: TrelloChecklistCreationMethod
  "Image URL for the checklist"
  imageUrl: URL
  "Valid Anthropic media types when using Anthropic AI"
  mediaType: TrelloChecklistMediaType
  "Name of the new checklist"
  name: String!
  "Position of the checklist on the card"
  position: TrelloPosition
  "ARI of the checklist to copy data from"
  sourceChecklistId: ID @ARI(interpreted : false, owner : "trello", type : "checklist", usesActivationId : false)
}

"Arguments passed into the createComment mutation"
input TrelloCreateCommentInput {
  cardId: ID! @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
  text: String!
}

"Arguments passed into the createCustomField mutation"
input TrelloCreateCustomFieldInput {
  "The ID of the board to which to add the custom field"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "How the new custom field should be displayed."
  display: TrelloCustomFieldDisplayInput
  "Whether the new custom field was a pre-populated, suggested option in the client."
  isSuggestedField: Boolean = false
  "The name of the new custom field."
  name: String!
  "Options for the custom field. Should only be provided for list custom fields."
  options: [TrelloNewCustomFieldOptionInput!]
  "The position of the new custom field"
  position: Float
  "The type of the new custom field."
  type: TrelloCustomFieldType!
}

"Arguments passed into the createCustomFieldOption mutation"
input TrelloCreateCustomFieldOptionInput {
  "The ID of the list custom field to which to add the new option"
  customFieldId: ID! @ARI(interpreted : false, owner : "trello", type : "customField", usesActivationId : false)
  "Details about the new custom field option"
  option: TrelloNewCustomFieldOptionInput!
}

"Arguments passed into the createLabel mutation"
input TrelloCreateLabelInput {
  "The ID of the board on which to create the label"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  """
  The color of the new label. Pass null or omit to create a colorless label.
  
  One of: `green`, `yellow`, `orange`, `red`, `purple`, `blue`, `sky`, `lime`,
  `pink`, `black` — optionally suffixed with `_dark` or `_light` for a shade
  variant (for example `blue_dark`).
  """
  color: String
  """
  The name of the new label. Pass an empty string to create a color-only
  label, matching what the Trello UI allows.
  """
  name: String!
}

"Arguments passed into the createList mutation"
input TrelloCreateListInput {
  "ARI of the board to create the list on"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "The list color"
  color: TrelloListColor
  "The way the list was created"
  creationMethod: TrelloListCreationMethod
  "If this list is a smart list, the source of its data"
  dataSource: TrelloListDataSourceInput
  "Name of the new list"
  name: String!
  "Position of the list in the board"
  position: TrelloListPosition
  "The type of the list"
  type: TrelloListType
}

"Arguments passed into the createMemberAiRule mutation."
input TrelloCreateMemberAiRuleInput {
  "The position the rule should occupy relative to other rules."
  position: Float!
  "The free-form rule content provided by the member."
  rule: String!
  "The type of AI rule to create."
  type: TrelloAiRuleType
}

"Arguments passed into the createMemberFromAa mutation."
input TrelloCreateMemberFromAaInput {
  "The account ID of the Atlassian account to create a member from."
  atlassianAccountId: ID
}

"Input type for creating an OAuth2 Client for an existing Trello application that does not yet have one."
input TrelloCreateOAuth2ClientInput {
  "The client type of the OAuth2 Client. Defaults to 'public'."
  clientType: String
  "The id of the Trello application to create an OAuth2 Client for"
  id: ID!
  "The scopes to register for the OAuth2 Client"
  scopes: [String!]
}

"Arguments passed into createOrUpdatePlannerCalendar mutation"
input TrelloCreateOrUpdatePlannerCalendarInput {
  enabled: Boolean!
  primaryCalendar: Boolean
  "The account ID from the underlying calendar provider"
  providerAccountId: ID!
  providerCalendarId: ID
  type: TrelloSupportedPlannerProviders!
  workspaceId: ID! @ARI(interpreted : false, owner : "trello", type : "workspace", usesActivationId : false)
}

"Arguments passed into createPlannerCalendarEvent mutation"
input TrelloCreatePlannerCalendarEventInput {
  event: TrelloCreatePlannerCalendarEventOptions!
  plannerCalendarId: ID! @ARI(interpreted : false, owner : "trello", type : "plannerCalendar", usesActivationId : false)
  providerAccountId: ID!
}

"""
Arguments passed into createPlannerCalendarEvent mutation
specific to the event being created
"""
input TrelloCreatePlannerCalendarEventOptions {
  cardId: ID @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
  end: DateTime!
  start: DateTime!
  title: String!
  visibility: TrelloPlannerCalendarEventVisibility
}

"Arguments passed into the createVoiceCapturedCards mutation"
input TrelloCreateVoiceCapturedCardsInput {
  "The ARI of the voice capture session whose captured cards should be created"
  sessionId: ID!
}

"Arguments passed into the create tag in workspace mutation"
input TrelloCreateWorkspaceTagInput {
  name: String!
  workspaceId: ID! @ARI(interpreted : false, owner : "trello", type : "workspace", usesActivationId : false)
}

"Display settings for the custom field to be created."
input TrelloCustomFieldDisplayInput {
  "Whether or not to show the custom field on the card front."
  cardFront: Boolean = true
}

"""
Value input for a custom field item on a card.
Exactly one field should be set depending on the custom field type.
For list custom fields, use valueId on the parent input instead.
Pass null (or omit) to clear the field value.
"""
input TrelloCustomFieldItemValueInput {
  "For checkbox custom fields: whether the checkbox is checked."
  checked: Boolean
  "For date custom fields: the date value to set, in ISO 8601 format."
  date: String
  "For number custom fields: the number value to set, expressed as a string."
  number: String
  "For text custom fields: the text value to set."
  text: String
}

"The input for the new value of a custom field option."
input TrelloCustomFieldOptionValueInput {
  "The new text value of the custom field option."
  text: String!
}

"The TrelloDeleteAiRuleInput describes which AI rule to delete."
input TrelloDeleteAiRuleInput {
  "The ARI of the AI rule to delete."
  aiRuleId: ID!
}

"Arguments passed into the delete board background mutation"
input TrelloDeleteBoardBackgroundInput {
  boardBackgroundId: String!
}

"Arguments passed into the delete board mutation"
input TrelloDeleteBoardInput {
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into the deleteBoardPowerUpPrivateData mutation"
input TrelloDeleteBoardPowerUpPrivateDataInput {
  "The board whose private Power-Up data will be deleted for the current member"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "The application ARI of the Power-Up whose private data will be deleted"
  powerUpId: ID! @ARI(interpreted : false, owner : "trello", type : "application", usesActivationId : false)
}

"Arguments passed into the deleteBoardPowerUpSharedData mutation"
input TrelloDeleteBoardPowerUpSharedDataInput {
  "The board whose shared Power-Up data will be deleted"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "The application ARI of the Power-Up whose shared data will be deleted"
  powerUpId: ID! @ARI(interpreted : false, owner : "trello", type : "application", usesActivationId : false)
}

"Arguments passed into the deleteChecklist mutation"
input TrelloDeleteChecklistInput {
  "ID of the checklist to delete"
  id: ID! @ARI(interpreted : false, owner : "trello", type : "checklist", usesActivationId : false)
}

"Arguments passed into the deleteCustomField mutation"
input TrelloDeleteCustomFieldInput {
  "The ID of the custom field to delete"
  customFieldId: ID! @ARI(interpreted : false, owner : "trello", type : "customField", usesActivationId : false)
}

"Arguments passed into the deleteCustomFieldOption mutation"
input TrelloDeleteCustomFieldOptionInput {
  "The ID of the list custom field containing the option to be deleted"
  customFieldId: ID! @ARI(interpreted : false, owner : "trello", type : "customField", usesActivationId : false)
  "The ID of the custom field option to delete"
  customFieldOptionId: ID! @ARI(interpreted : false, owner : "trello", type : "customFieldOption", usesActivationId : false)
}

"Arguments passed into the deleteLabel mutation"
input TrelloDeleteLabelInput {
  "ID of the label to delete"
  id: ID! @ARI(interpreted : false, owner : "trello", type : "label", usesActivationId : false)
}

"Arguments passed into deletePlannerCalendarEvent mutation"
input TrelloDeletePlannerCalendarEventInput {
  "The ID of the event to delete"
  plannerCalendarEventId: ID!
  "The ID of the planner calendar containing the event"
  plannerCalendarId: ID! @ARI(interpreted : false, owner : "trello", type : "plannerCalendar", usesActivationId : false)
  "The ID of the provider account to use for the deletion"
  providerAccountId: ID!
}

"Arguments passed into the delete tag from workspace mutation"
input TrelloDeleteWorkspaceTagInput {
  tagId: ID!
  workspaceId: ID! @ARI(interpreted : false, owner : "trello", type : "workspace", usesActivationId : false)
}

"Arguments passed into the disableBoardPowerUp mutation"
input TrelloDisableBoardPowerUpInput {
  "The board on which the Power-Up will be disabled"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "The application ARI of the Power-Up to disable"
  powerUpId: ID! @ARI(interpreted : false, owner : "trello", type : "application", usesActivationId : false)
}

"Arguments passed into the disable board self join mutation"
input TrelloDisableBoardSelfJoinInput {
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into the disable card front complete toggle mutation"
input TrelloDisableCardFrontCompleteToggleInput {
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into the dismissRefinementCommandCenter mutation"
input TrelloDismissRefinementCommandCenterInput {
  "The board whose refinement command center is being dismissed"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"A wrapper for a string to echo."
input TrelloEchoInput {
  contents: String!
}

"Arguments passed into editBoardWithAi mutation"
input TrelloEditBoardWithAiInput {
  "The board to edit"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "Optional references to original creation or modification tasks"
  referenceTaskIds: [ID!]
  """
  The agent session in which to do the edits.
  If no session ID is provided, a new agent session will be created.
  """
  sessionId: ID @ARI(interpreted : false, owner : "trello", type : "agent-session", usesActivationId : false)
  "The user's prompt to AI to edit a board"
  userPrompt: String!
}

