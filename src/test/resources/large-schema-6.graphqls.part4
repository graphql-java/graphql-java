"Input required to change the offering for a single entitlement"
input CommerceExpEntitlementUpdateInput {
  "Optional behaviour at the end of this entitlement's subscription"
  behaviourAtEndOfSubscription: CommerceExpBehaviourAtEndOfSubscription
  "entitlementId of the entitlement"
  entitlementId: String!
  "The promotion to be applied during the plan change if provided"
  promotionId: String
  """
  Whether to skip the trial (if applicable) and bill immediately when the plan change occurs.
  Has no effect unless a specific offering is selected via `offeringKey`
  """
  skipTrial: Boolean
  """
  Start the change at the end of the current billing period (the subscription's next billing
  timestamp) instead of letting CCP pick the timing. CCP applies a change between plans with the
  same list price, such as a billing frequency change on a metered plan, immediately unless the
  order names a start time.
  """
  startAtEndOfBillingPeriod: Boolean
  "If not billing cycle then fallbacks to the enitlements current cycle, then MONTHLY by default, otherwise uses passed value"
  targetBillingCycle: CommerceExpBillingCycle
  "The offering name in the default group to which the user wants to switch to."
  targetOfferingName: String
}

