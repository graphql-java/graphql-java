  "An unexpected error occurred while enriching this service."
  ERROR
  "AI enrichment produced no usable clusters for this service."
  NO_CLUSTERS
  "No matching tickets were found in the scanned history window."
  NO_TICKETS
  "The per-service job exceeded its timeout budget."
  TIMEOUT
}

