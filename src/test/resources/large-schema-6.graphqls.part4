  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
}

input AVPCopyDashboardInput {
  "Category for the copy. Defaults to the source dashboard's category."
  category: String
  "The container the copy lives in, e.g. a Jira project. Defaults to the source dashboard's container."
  containerAri: ID @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  "The ARI of the dashboard to copy. The copy is created in the same cloud and workspace as the source."
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Description for the copy. Defaults to the source dashboard's description."
  description: String
  "Identifier of the AVP consumer which owns the copy. Defaults to the source dashboard's integrationId."
  integrationId: AVPIntegrationId
  "Title for the copy. Defaults to the source dashboard's title prefixed with 'Copy of '. A blank title is ignored, and a title longer than 100 characters is truncated."
  title: String
}

