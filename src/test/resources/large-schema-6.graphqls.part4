  single: [AdminSingle!]
}

"A connector-specific configuration property used when adding a Rovo Search connector instance."
input AdminConnectorPropertyInput {
  """
  Whether the property has been updated by the caller. Set on edit flows so the upstream
  can skip re-processing unchanged values (e.g. avoid re-encrypting sensitive fields).
  Optional.
  """
  isUpdated: Boolean
  "The property key."
  key: String!
  """
  The property value the caller is submitting. Modeled as a `JSON` scalar because each
  3rd-party connector defines its own property schema at runtime: values are
  heterogeneous (strings, numbers, booleans, lists, or nested objects) and the upstream
  `ai-3p-connector` service consumes them as a free-form `Map<String, Any>`. The
  accepted shape per field is dictated by each 3rd-party connector at runtime, not by
  this schema. Optional.
  """
  value: JSON @suppressValidationRule(rules : ["JSON"])
}

