    """
    The pointer to a place in the labels dataset (cursor). It's used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    "Number of labels to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloLabelConnection
  """
  Last time a change was made to the board. Note: this can be null when board
