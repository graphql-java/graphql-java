"""
Represents the state of an async archiveAllCardsInList job triggered by
the mutation of the same name. Clients should subscribe to
lifecycle updates via the TrelloJob interface.
"""
type TrelloArchiveAllCardsInListJob implements TrelloJob {
  """
  Error details for the job. Only populated when the job has failed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  errors: [TrelloJobError!]
  """
  The underlying ARI for the job
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID!
  """
  Job status, success or failure
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  status: TrelloArchiveAllCardsInListJobStatus
}

"Returned response from archiveAllCardsInList mutation"
type TrelloArchiveAllCardsInListPayload implements Payload {
  errors: [MutationError!]
  jobId: String
  success: Boolean!
}

