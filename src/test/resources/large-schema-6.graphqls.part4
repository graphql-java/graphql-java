input MarketplaceStoreDynamicRecommendationsInput {
  """
  Filters applied to the candidate search, mirroring the marketplace-search filter dimensions.
  Each key in `parentApplicationKeys` is searched and ranked separately. Supplied without a
  `searchQuery`, the candidate pool is the apps matching the filter — except for
  `parentApplicationKeys`, which only scopes which products are recommended for, and
  `hosting: cloud`, which every store surface asks for: a filter carrying only those returns
  homepage recommendations, scoped to those products.
  """
  filter: MarketplaceStoreSearchFilterInput
  """
  The search query used to fetch the candidate pool of apps. When omitted, and no filter
  narrows the pool either, the user's personalised homepage recommendations are returned
  instead.
  """
  searchQuery: String
  """
  Cloud id of the site the recommendations are for. Required: it decides which products are
  ranked and which of them the user may be personalised for.
  """
  tenantId: String!
}

input MarketplaceStoreEditionsByAppKeyInput {
  appKey: String
}

input MarketplaceStoreEditionsInput {
  appId: String
}

