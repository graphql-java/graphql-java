  "USR destination schema id."
  destinationSchemaId: ID
  "Snapshot of the destination schema name."
  destinationSchemaName: String
  "Control-plane mapping id (`destinations[].id` from GET) for `UPDATE` and `DELETE`."
  id: ID
  "Operation on this mapping (`CREATE`, `UPDATE`, `DELETE`), or null when created under a new group."
  operation: IrisMutateOperation
  "Canvas order when standalone (`CREATE` or `UPDATE`). Omit when inside a destination group."
  ordinal: Int
  "Evaluation priority inside a destination group (`1` runs first). Omit when standalone."
  priority: Int
