once that lock is lifted.
"""
input GravityAddCommentInput {
  "Annotation to anchor this comment to; omit/null for a general (unanchored) comment."
  annotationId: String
  content: String!
  draftId: String!
  parentCommentId: String
}

"""
@deprecated Retired V1 AI drafts API. This input is kept only because the AGG object-type
change lock blocks removal for now; see https://hello.atlassian.net/wiki/x/9AaPrgE. Remove
once that lock is lifted.
"""
input GravityAddInlineCommentInput {
  "Annotation the new comment is anchored to; omit/null for a general comment."
  annotationId: String
  "The comment body."
  commentContent: String!
  content: String!
  draftId: String!
  expectedRevision: Int!
  "Who authored the content edit; omit/null defaults to USER."
  origin: GravityDraftOrigin
  parentCommentId: String
}

"Input for the gravity_addReaction mutation."
input GravityAddReactionInput {
  "The emoji identifier for the reaction."
  emojiId: ID!
