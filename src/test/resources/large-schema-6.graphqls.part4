"Top-level container for multiboard data within a workspace."
type TrelloWorkspaceMultiboard {
  """
  Paginated access to boards within the workspace, with optional filtering
  by board status and/or a specific set of board IDs or short links.
  
  first: Maximum number of boards to return per page (default 20, max 100).
  
  after: Opaque cursor returned by a previous call. Pass it back verbatim
  to retrieve the next page.
  
  boardIds: Limits results to the specified board IDs (ARI-encoded). Composes
  with status using AND semantics. Boards matching either boardIds or
  shortLinks are included (OR semantics between the two arguments).
  
  shortLinks: Limits results to boards whose shortLink matches one of the
  supplied values. Composes with boardIds using OR semantics — a board is
  included if it matches either argument.
  
  status: Restricts boards by open/closed state. Multiple values are combined
  with OR semantics. Defaults to ALL when omitted.
  """
  boards(after: String, boardIds: [ID!] @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false), first: Int = 20, shortLinks: [String!], status: [TrelloWorkspaceBoardFilterValue!]): TrelloWorkspaceMultiboardBoardsConnection
  """
  Paginated, filtered access to cards across the workspace's boards.
  
  Filter arguments accept the same formats as the equivalent REST
  endpoint (POST /organization/:id/cards).
  
  sortBy: An ordered list of sort criteria applied left-to-right.
  Each entry specifies a field and an optional direction (defaults to
  ASC). Omit the argument entirely to use the default sort of
  [{ field: DUE, direction: DESC }].
  """
  cards(
    """
    Opaque pagination cursor. Pass as the after argument on the next
    request to retrieve the following page. The sort order encoded in
    the cursor must match the sortBy argument. Null when there are no
    more results.
    """
    after: String,
    boardIds: [ID!]! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false),
    "Restricts results to cards with one of the given roles (e.g. \"mirror\")."
    cardRoles: [String!],
    "Filter by card creation date."
    created: TrelloMultiboardDateRangeInput,
    """
    Date filter for cards. Supply date (shorthand for due OR start in
    range) or dueStart to filter due and/or start independently.
    """
    dateFilter: TrelloMultiboardCardDateFilterInput,
    dueComplete: Boolean,
    "Maximum number of cards to return per page. Defaults to 50, max 1000."
    first: Int,
    """
    Label filter. Supply exactly one of: any (cards with any label attached),
    none (cards with no labels), or labels (cards matching at least one of the
    supplied label matchers — combined with OR semantics).
    """
    labelFilter: TrelloMultiboardLabelFilterInput,
    listIds: [ID!] @ARI(interpreted : false, owner : "trello", type : "list", usesActivationId : false),
    memberFilter: TrelloMultiboardMemberFilterInput,
    """
    Ordered list of sort criteria applied left-to-right. Defaults to
    [{ field: DUE, direction: DESC }] when omitted.
    """
    sortBy: [TrelloMultiboardCardSortInput!]
