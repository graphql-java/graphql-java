  ids: [ID!]
  query: String
}

input DiscoveryCommunityStringInput {
  "Write-only."
  community: String!
}

"Exactly one method. Every type of the credential must accept it."
input DiscoveryCredentialAuthenticationInput @oneOf {
  communityString: DiscoveryCommunityStringInput
  usernamePassword: DiscoveryUsernamePasswordInput
}

input DiscoveryCredentialCreateInput {
  authentication: DiscoveryCredentialAuthenticationInput!
  "DiscoveryCollector.id values from discovery_collectors. At least one."
  collectorIds: [ID!]!
  "Display name; need not be unique."
  name: String!
  "Optional client-generated UUID; the credential id is derived from the tenant and this requestId. Resend the same requestId to retry safely."
  requestId: ID
  types: [DiscoveryCredentialType!]!
}

"Collector ids to add to or remove from a job; at least one."
input DiscoveryJobCollectorsInput {
  collectorIds: [ID!]!
}

" --- Mutations (top-level, discovery_ prefixed) -----------------------------------------------------------------"
input DiscoveryJobCreateInput {
  description: String
  name: String!
  provider: DiscoveryProviderId!
}

input DiscoveryJobCredentialsInput {
  "Empty is allowed and is how 'Skip' is saved."
  credentialIds: [ID!]!
}

input DiscoveryJobDetailsInput {
  description: String
  name: String!
}

" --- Queries (top-level, discovery_ prefixed) -------------------------------------------------------------------"
input DiscoveryJobFilter {
  ownerAccountId: ID
  provider: DiscoveryProviderId
  "Case-insensitive substring of the name."
  query: String
  "Exact statuses to include; list every DRAFT_n value to show all drafts."
  status: [DiscoveryJobStatus!]
}

input DiscoveryJobSchedulesInput {
  "One five-field cron expression per scan_schedule row, no duplicates. Empty means manual-only."
  cronExpressions: [String!]!
}

"Scopes to remove from a job, by DiscoveryScanScope.id; at least one, each a scope of this job."
input DiscoveryJobScopeIdsInput {
  scopeIds: [ID!]!
}

"Scopes to add to a job. Either list may be omitted, but at least one scope must be given in total."
input DiscoveryJobScopesInput {
  exclude: [DiscoveryScanScopeInput!]
  include: [DiscoveryScanScopeInput!]
}

"""
Exactly one of addresses or activeDirectory must be set.
addresses are the lines of the wizard's target box (single IP, IP range, CIDR or host name); the backend
classifies each line and creates one scope per type, so one input may become several DiscoveryScanScope rows.
"""
input DiscoveryScanScopeInput {
  activeDirectory: DiscoveryActiveDirectoryScopeInput
  addresses: [String!]
  "Optional name for the address scopes; defaults to a name per type."
  name: String
}

input DiscoveryUsernamePasswordInput {
  "Write-only."
  password: String!
  username: String!
}

"Confidence-band metadata supplied as part of a findings filter."
input DlpConfidenceBandInput {
  range: DlpConfidenceBand!
}

"Input for creating one or more false positives (individual or bulk exclude)."
input DlpCreateFalsePositivesInput {
  "One item = individual exclude, N items = bulk exclude"
  falsePositives: [DlpFalsePositiveInput!]!
  orgId: String!
}

"Input for detector classification mapping requests"
input DlpDetectorClassificationMappingRequestInput {
  "ARI (Atlassian Resource Identifier) for the classification"
