"""
Payload returned by playbook_toggleChecklistItem. On success contains the full
`playbookInstanceStep` so the FE can refresh the entire step (including all
other `checklistItems`) in a single round trip without an additional fetch.
On failure, `errors` carries the structured GraphQL error.
"""
type ToggleChecklistItemPayload implements Payload {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  errors: [MutationError!]
  """
  The full instance step after the toggle. `checklistItems` is resolved with
  live per-issue `done` state by the same resolver as the read path
  (`JiraPlaybookInstanceStep.checklistItems`), so the client receives every
  item with complete `label` / `order` / `done` in a single round trip. This
  mirrors the `CreateJiraPlaybookStepRunPayload` shape and lets the FE reuse
  the existing Mark-done update pattern.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  playbookInstanceStep: JiraPlaybookInstanceStep
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  success: Boolean!
}

