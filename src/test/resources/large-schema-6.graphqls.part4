  hostName: String
  "The ID of the offering to be created"
  offeringId: ID
  "The ID of the product to be created, must be provided if offeringId is not provided"
  productId: ID
  """
  Additional related entitlements to connect.
  For example when creating a collection, a related entitlement might be Jira,
  and the Jira itself might additionally relate to a new or existing Jira Family
  Container entitlement .
  """
  relatedEntitlements: [CommerceExpCreateEntitlementRelationship!]
}

"CreateEntitlementOrderOptions"
input CommerceExpCreateEntitlementOrderOptions {
  "Which billing cycle to create the entitlement for, only MONTH and YEAR is supported at the moment. Defaults to MONTH if not provided"
  billingCycle: CommerceExpPricingPlanInterval = MONTH
  """
  Charge quantities (charge element + quantity) for the creation order.
  When provided, these are used instead of values derived from order defaults / usage.
  """
  chargeQuantities: [CommerceExpChargeElementDetails!]
  "The invoice group ID to be used for creation of entitlement"
  invoiceGroupId: ID
  """
  When true, the trial of the entitlement being created ends at the latest active trial of
  the entitlements it relates to as a COLLECTION, with a minimum of 7 days from now.
  Only applies to the created entitlement itself, not to the collection's children.
  """
  matchTrialLength: Boolean = false
  "The pricing plan ID to create the entitlement on"
  pricingPlanId: ID
  "Ids used to build the provisioning request for the entitlement being created (e.g. usage packs)"
  provisioning: CommerceExpCreateEntitlementProvisioning
  "The provisioning request identifier"
  provisioningRequestId: ID
  "Trial intent"
  trial: CommerceExpTrialIntentInput
}

