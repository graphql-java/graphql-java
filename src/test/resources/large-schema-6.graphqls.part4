"""
Presentation state of an insight card. Cards are always returned regardless of count or tracking
status; the state tells the client how to render the card.
"""
enum AssetsVerticalInsightCardState {
  "A normally generated insight backed by real underlying data."
  ACTIVE
  """
  The insight could not be generated because no object types with the required attribute are being
  tracked. The `summary` carries an informative fallback message instead of a raw backend error.
  """
  NOT_TRACKED
  """
  The metric count is zero — nothing needs action. The `summary` carries an encouraging, positive
  message (e.g. "All asset warranties are in good standing. No action required.").
  """
  NO_ISSUES
}

