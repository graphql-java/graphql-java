"Timeline-specific settings for CSV issue export."
input JiraTimelineCustomExportInput {
  """
  Additional JQL applied on top of the board/project query in the visible timeline. Combined (AND)
  with the base query and any selected filters when resolving the exported issue set.
  """
  additionalJql: String
  "The child issue planning mode for the current timeline view."
  childIssuePlanningMode: JiraIssueSearchTimelineChildIssuePlanningMode
  """
  IDs of the custom filters selected in the visible timeline. Combined (AND) with the base query
  when resolving the exported issue set.
  """
  customFilterIds: [ID!]
  "The project or board ID that the timeline export is scoped to. Exactly one must be provided."
  projectOrBoardId: JiraTimelineExportProjectOrBoardIdInput!
  """
  IDs of the quick filters selected in the visible timeline. Combined (AND) with the base query
  when resolving the exported issue set.
  """
  quickFilterIds: [ID!]
  """
  Whether the timeline is using saved (last applied) filters. When false, the explicitly supplied
  customFilterIds/quickFilterIds are applied instead. Defaults to true when omitted.
  """
  useSavedFilters: Boolean
}

"Identifies whether the timeline export is scoped to a project or a board. Exactly one field must be provided."
input JiraTimelineExportProjectOrBoardIdInput @oneOf {
  "The ID of the board."
  boardId: ID
  "The ID of the project."
  projectId: ID
}

"""
Custom input for Timeline view issue search.
Used by JiraIssueSearchCustomInput in IssueSearch.nadel.
"""
input JiraTimelineIssueSearchCustomInput {
  "JQL search query if any additional filters(e.g. assignee, epic, issuetype etc.) are applied on top of the base JQL"
  additionalJql: String
  "The board ID to fetch the base JQL for the board"
  boardId: ID!
  "The custom filters ids. BE will fetch the JQL for each custom filter and combine them with the base JQL of the board"
  customFilterIds: [ID!]
  "A nullable boolean indicating if unparented items should be hidden from timeline roots."
  hideUnParentedItems: Boolean
  "The maximum hierarchy level to use as timeline roots."
  maxHierarchyLevel: Int
  "The quick filters ids. BE will fetch the JQL for each quick filter and combine them with the base JQL of the board"
  quickFilterIds: [ID!]
  """
  How long completed top-level items stay visible, as rendered by the client. Supplied by realtime view-context
  queries so a changed item is judged against the same completion range as the page the user is looking at.
  When null, the legacy hide-done input applies.
  """
  showCompleted: JiraTimelineShowCompletedRange
  """
  When true, use the lastAppliedFilters from the view configuration.
  When false or when quickFilterIds/customFilterIds are provided, use those instead.
  """
  useSavedFilters: Boolean
}

"Input for specifying either a project or board for timeline project settings."
input JiraTimelineProjectOrBoardInput @oneOf {
  boardId: Int
  projectKey: String
}

"Filter input for timeline search. Only one of quickFilterIds or customFilterIds can be provided."
input JiraTimelineSearchFilterInput @oneOf {
  "A list of custom filter IDs to apply to the timeline view."
  customFilterIds: [ID!]
  "A list of quick filter IDs to apply to the timeline view."
  quickFilterIds: [ID!]
}

"""
The input used for Timeline when FE needs to tell the BE the specific view configuration to be used for a Timeline query.
This would prevent scenarios where in user has two tabs open (one with warnings enabled and one with warnings disabled) and the BE needs to return
different results to respect the view configuration used on the initial load of each tab.
"""
input JiraTimelineStaticViewInput {
  """
  A nullable boolean indicating if the Hide dependencies setting is enabled.
  When true, dependencies are hidden. When false or null, dependencies are displayed.
  """
  hideDependencies: Boolean
  """
  A nullable boolean indicating if the Hide releases setting is enabled.
  When true, releases are hidden. When false or null, releases are displayed.
  """
  hideReleases: Boolean
  """
  A nullable boolean indicating if unparented items should be hidden from timeline roots.
  When true, L0 items without a parent in the project are hidden. When false they are displayed.
  Defaults to true when not explicitly set.
  """
  hideUnParentedItems: Boolean
  "A nullable boolean indicating if the Hide warnings setting is enabled"
  hideWarnings: Boolean
  """
  A nullable boolean indicating if the Hide weekends setting is enabled.
  When true, weekends are hidden. When false or null, weekends are displayed.
  """
  hideWeekends: Boolean
  """
  A nullable boolean indicating if 2-level filtered hierarchy is enabled.
  When true, a 2-level hierarchy is applied even when a view filter is active.
  When false or null, filtered hierarchy is disabled.
  """
  hierarchyWithFiltersEnabled: Boolean
  """
  The maximum hierarchy level to use as timeline roots.
  Defaults to 1 (Epic level) when not explicitly set.
  """
  maxHierarchyLevel: Int
  "Range mode (JiraTimelineViewRangeMode) to display the timeline view"
  rangeMode: JiraTimelineViewRangeMode
  """
  How long completed top-level items stay visible. Overrides the hide done setting for this request.
  When null, the view's stored setting applies.
  """
  showCompleted: JiraTimelineShowCompletedRange
}

"Input for filters applied to the timeline view as part of publishing view config."
input JiraTimelineViewAppliedFiltersInput {
  "Additional JQL to apply on top of the board query."
  additionalJql: String
  "A list of custom filter IDs to apply to the timeline view."
  customFilterIds: [ID!]
  "A list of quick filter IDs to apply to the timeline view."
  quickFilterIds: [ID!]
}

"Input for settings applied to the timeline view."
input JiraTimelineViewSettings {
  "The filters to apply to the timeline view."
  appliedFilters: JiraTimelineViewAppliedFiltersInput
  "A boolean indicating whether or not to hide dependencies on the timeline."
  hideDependencies: Boolean
  "Boolean indicating whether the completed issues should be hidden from the search result"
  hideDone: Boolean
  "A boolean indicating whether or not to hide releases on the timeline."
  hideReleases: Boolean
  """
  Whether unparented items are hidden from timeline roots.
  When true, items without a parent in the project are excluded.
  """
  hideUnParentedItems: Boolean
  "A boolean indicating whether or not to hide warnings on the timeline."
  hideWarnings: Boolean
  "A boolean indicating whether or not to hide weekends on the timeline."
  hideWeekends: Boolean
  "Whether 2-level filtered hierarchy is enabled when a view filter is active."
  hierarchyWithFiltersEnabled: Boolean
  "JQL applied to the timeline view."
  jql: String
  """
  The maximum hierarchy level used as timeline roots.
  Clamped to the project's top level. Null means no override.
  """
  maxHierarchyLevel: Int
  "Range mode (JiraTimelineViewRangeMode) to display the timeline view"
  rangeMode: JiraTimelineViewRangeMode
  "How long completed top-level items stay visible. Takes precedence over hideDone when both are given."
  showCompleted: JiraTimelineShowCompletedRange
}

