  "Status to set for this mapping"
  status: DlpMappingStatus
}

"Detector metadata supplied as part of a findings filter."
input DlpDetectorInput {
  ari: String!
  category: String
  platformCategory: String
  title: String!
  type: String!
}

"Filters for listing false positives (server-side pagination applied separately)."
input DlpFalsePositiveFiltersInput {
  "categories will be changed to FindingCategory enum"
  categories: [String]
  detectorIds: [String]
  workspaceIds: [String]
}

"Caller supplies detector/snippet pairs; workspace scope is resolved for the org by the service."
input DlpFalsePositiveImpactFiltersInput {
  "Between 1 and 100 detector/snippet pairs are required."
  snippets: [DlpFalsePositiveImpactSnippetInput!]!
}

"Detector metadata and an exact snippet content hash to match together."
input DlpFalsePositiveImpactSnippetInput {
  detector: DlpDetectorInput!
  snippetId: String!
}

"A single finding to be excluded as a false positive."
input DlpFalsePositiveInput {
  actorId: String
  app: String
  category: String
  confidence: String
  contentHash: String!
  contentType: String!
  detectorId: String!
  detectorType: String
  "Deprecated and ignored, optional so callers need not synthesise one. Removed in a follow up"
  findingId: String
  lastDetectedAt: String
  location: String
  objectTitle: String
  parentResourceId: String!
  resourceId: String!
  scope: DlpFalsePositiveScope
  source: String
  workspaceId: String!
}

"Optional filters for the Data Map findings query."
input DlpFindingsFiltersInput {
  "Confidence bands to include; empty or omitted means all confidence levels"
  confidenceBands: [DlpConfidenceBandInput!]
  "Detector IDs to include; empty or omitted means all detectors"
  detectorIds: [String]
  "Detectors to include; when provided, each detector's type is used for filtering"
  detectors: [DlpDetectorInput!]
  "Inclusive end of the created-on date range, in epoch milliseconds; defaults to now"
  endEpochMillis: String
  "Snippet ID to match against the beginning of the content hash"
  snippetId: String
  "Inclusive start of the created-on date range, in epoch milliseconds; omitted means no lower bound"
  startEpochMillis: String
}

"""
Input for removing a false positive by its scoped composite key; the scoped schema has no
FP UUID.
"""
input DlpRemoveFalsePositiveInput {
  "SHA256 of the matched content"
  contentHash: String!
  "Identifier of the detector that produced the finding"
  detectorId: String!
  orgId: String!
  "Scope ARI for OBJECT scope (the parent resource); unused for ORG scope, where the org ARI is used"
  parentResourceId: String
  "Scope the false positive was recorded at"
  scope: DlpFalsePositiveScope!
}

"Scope input containing type and values"
input DlpScopeInput {
  "Type of the scope"
  scopeType: DlpScopeType
  "List of values for the scope"
  values: [String]
}

input EcosystemAppInstallationOverridesInput {
  """
  Override the license mode for the installation.
  This is used for app developers to test the app behaviour in different license modes.
  This field is only allowed by Forge CLI for non-production environments.
  This field will only be accepted when the user agent is Forge CLI
  """
  licenseModes: [EcosystemLicenseMode!]
  """
  Set the user with access when the license mode is 'USER_ACCESS'.
  This field is only allowed when licenseMode='USER_ACCESS'.
  This is a temporary field to support the license mode 'USER_ACCESS'. It will be removed
  after user access configuration is supported in Admin Hub.
  See https://hello.atlassian.net/wiki/spaces/ECON/pages/4352978134/RFC+How+will+developers+test+license+de-coupling+in+their+apps?focusedCommentId=4365058508
  We can clean up once https://hello.jira.atlassian.cloud/browse/COMMIT-12345 is delivered and the 6-month deprecation period is over.
  """
  usersWithAccess: [ID!]
}

