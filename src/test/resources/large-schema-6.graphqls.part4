  "Whether issue links are cloned. Defaults to false if omitted."
  includeLinks: Boolean
  "Refers to issue IDs selected by user for bulk clone. Must contain between 1 and 50 unique issue ARIs."
  selectedIssueIds: [ID!]!
  """
  Text put in front of each selected issue's summary, separated by a space, to form its clone's summary.
  Leading and trailing whitespace is trimmed, and a blank value is treated as omitted. If omitted, each
  clone keeps its source's summary. Cloned children and subtasks always get the site's clone prefix.
  At most 253 characters after trimming, with no line breaks or null characters. If a work item's
  resulting summary would be longer than 255 characters, that work item fails with an error and the
  others are still cloned.
  """
  summaryPrefix: String
}

input JiraBulkCreateIssueLinksInput {
  "The direction of the issue link. Default is OUTWARD."
  direction: JiraIssueLinkDirection = OUTWARD
  "The ID of the type of issue link being created."
  issueLinkTypeId: ID!
  "The ID of the source issue."
  sourceIssueId: ID!
  "The IDs of the target issues."
  targetIssueIds: [ID!]!
}

"Input type for bulk delete"
input JiraBulkDeleteInput {
  "Refers to issue IDs selected by user for bulk delete"
  selectedIssueIds: [ID!]!
}

"Input to drag and drop several Jira issues on the board view in a single operation."
input JiraBulkDragAndDropBoardViewIssuesInput {
  """
  Shared destination cell applied to every item, updating relevant field values on all issues if required.
  Encoded as an ARI. To re-rank or transition issues within their current cell, pass that cell's ID.
  """
  destinationCellId: ID! @ARI(interpreted : false, owner : "jira", type : "board-cell", usesActivationId : false)
  "IDs of the issues being actioned, each resolved and applied individually. Encoded as ARIs."
  issueIds: [ID!]! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  """
  Optional shared rank position applied to the operation. All issues are ranked as a contiguous block
  relative to the anchor issue, preserving their relative order.
  """
  rank: JiraIssueRankInput
  """
  Optional cells the corresponding issues were dragged from. Encoded as ARIs.
  An issue's field update implied by the destination cell is skipped if its current
  field value no longer matches the value implied by its source cell, e.g. because it was changed on a transition
  screen during the drag and drop operation.
  """
  sourceCellIds: [ID!] @ARI(interpreted : false, owner : "jira", type : "board-cell", usesActivationId : false)
  """
  Optional shared transition ID applied to every issue. Only valid when all selected issues share the
  same workflow transition to reach the destination.
  """
  transitionId: Int
}

