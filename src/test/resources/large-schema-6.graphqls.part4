"Which part of a custom auth request an input field's value belongs to."
enum GraphIntegrationCustomAuthInputTarget @renamed(from : "CustomAuthInputTarget") {
  "The value is the api_token secret itself."
  API_TOKEN
  "The value is the api_token request header name, e.g. 'Authorization' or 'Api-Key'."
  AUTH_HEADER_NAME
  "The value is the api_token request header value prefix, e.g. 'Bearer'."
  AUTH_HEADER_PREFIX
  "The value is the OAuth client ID."
  CLIENT_ID
  "The value is the OAuth client secret."
  CLIENT_SECRET
  "The value is whether PKCE is used instead of a client secret."
  PKCE_ENABLED
  "The value is the set of scopes the connection requests."
  SCOPES
  "The value fills a placeholder in the custom auth template."
  VALUE
}

"The kind of input control the UI should render for a custom auth input field."
enum GraphIntegrationCustomAuthInputType @renamed(from : "CustomAuthInputType") {
  "A two-state flag, such as whether PKCE is used."
  BOOLEAN
  "An ordered list of free-text values, such as OAuth scopes."
  MULTI_TEXT
  "A secret value, which must be masked on entry and never rendered back."
  SECRET
  "A dropdown or select input with predefined options."
  SELECT
  "Free-form text input."
  TEXT_FIELD
}

