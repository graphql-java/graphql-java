"""
enum GravityViewFilterEnumType {
  "Match against board column values."
  BOARD_COLUMN
  "Match against view group values."
  VIEW_GROUP
}

"Filter kind - defines the type of filtering logic to apply."
enum GravityViewFilterKind {
  "Filter connections by field identity."
  CONNECTION_FIELD_IDENTITY
  "Exclude ideas whose field value is one of the given values."
  FIELD_EXCLUDES
  "Filter by whether a field has any value (is not empty)."
  FIELD_HAS_VALUE
  "Filter by exact field identity/value match. Legacy form of FIELD_INCLUDES/FIELD_EXCLUDES."
  FIELD_IDENTITY
  "Include only ideas whose field value is one of the given values."
  FIELD_INCLUDES
  "Filter by numeric comparison (GT, LT, EQ, etc.)."
  FIELD_NUMERIC
  "Filter by time interval (for date fields)."
  INTERVAL
  "Filter by text matching."
  TEXT
}

"Filter operator for numeric and interval comparisons."
enum GravityViewFilterOperator {
  "End date is after now"
  END_AFTER_NOW
  "End date is before now"
  END_BEFORE_NOW
  "Equal to"
  EQ
  "Greater than"
  GT
  "Greater than or equal"
  GTE
  "Item ends after (date comparison)"
  ITEM_ENDS_AFTER
  "Item ends after past N period"
  ITEM_ENDS_AFTER_PAST
  "Item starts before (date comparison)"
  ITEM_STARTS_BEFORE
  "Item starts before next N period"
  ITEM_STARTS_BEFORE_NEXT
  "Less than"
  LT
  "Less than or equal"
  LTE
  "Not equal to"
  NEQ
  "Start date is after now"
  START_AFTER_NOW
  "Start date is before now"
  START_BEFORE_NOW
}

