  "Project ARIs the issues reside in."
  projectARIs: [ID!] @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  "Account ARIs of the issue reporters."
  reporterARIs: [ID!] @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  "The status category the issue is currently in."
