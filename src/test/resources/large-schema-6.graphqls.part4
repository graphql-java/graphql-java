}

input AVPUpdateCommentInput {
  "ARI of the comment to edit."
  commentAri: ID! @ARI(interpreted : false, owner : "avp", type : "comment", usesActivationId : false)
  """
  New contextual metadata for the comment, as a JSON object: `filterData`, an object holding the chart's
  applied filter values, and optionally `cacheKey`, a string or null. When omitted, the comment keeps its
  existing context.
  """
  context: JSON @suppressValidationRule(rules : ["JSON"])
  """
  The new body of the comment, as an Atlassian Document Format (ADF) document: a JSON object with `type`
  "doc", `version` 1 and a `content` array of ADF nodes. It replaces the existing body. A message that is
  not a valid ADF document is rejected.
  """
  message: JSON! @suppressValidationRule(rules : ["JSON"])
}

input AVPUpdateCustomTemplateInput {
  "Identifies the template to edit. A custom template's id is the dashboard's own id, so this also supplies the cloudId and activationId used for gating and shard routing."
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "New description for the template. Required — the metadata row rejects a blank description."
  description: String!
  "New thumbnail image to show on the template's gallery card."
  thumbnail: AVPTemplateThumbnail!
  "New title for the template. Required — the metadata row rejects a blank title."
  title: String!
}

"""
Filter configuration for updating a dashboard-level filter. Currently only supports updating
the env var fields default values and metadata, and does not update any data for connected charts.
"""
input AVPUpdateDashboardFilterInput {
  "The ARI of the dashboard which has the filter to update"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "The filter configuration to update a dashboard-level filter"
  envVar: AVPFilterEnvVarInput!
}

"""
Input for updating identity-level access on a dashboard.
Uses PUT semantics: the provided list completely replaces the current access list.
Omitting a principal removes their access. Including a principal sets their access level.
Provide either `principals` (preferred) or `users` — if both are provided, `principals` takes precedence.
"""
input AVPUpdateDashboardIdentityAccessInput {
  "The ARI of the dashboard to update"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "The complete list of principals (users and/or groups) and their desired access levels. Takes precedence over `users` if both are provided."
  principals: [AVPDashboardPrincipalAccessInput!]
  """
  The complete list of users and their desired access levels
  
  
  This field is **deprecated** and will be removed in the future
  """
  users: [AVPDashboardUserAccessInput!]
}

input AVPUpdateDashboardInput {
  dashboard: AVPDashboardInput!
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
}

