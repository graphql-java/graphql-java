input SearchLoomFilters {
  """
  Accepts raw Loom folder IDs or canonical Loom folder ARIs for the requested site. Invalid values are ignored; a
  non-empty list containing no valid IDs returns no folder or video results and reports a filter error.
  """
  folderIds: [String!]
  """
  Accepts raw Loom playlist UUIDs or canonical Loom playlist ARIs for the requested site. Invalid values are
  ignored; a non-empty list containing no valid IDs returns no playlist results and reports a filter error.
  """
  playlistIds: [String!]
  """
  Accepts raw Loom space UUIDs, legacy numeric IDs, or canonical Loom space ARIs for the requested site. Invalid
  values are ignored; a non-empty list containing no valid IDs returns no space or video results and reports a
  filter error.
  """
  spaceIds: [String!]
  """
  Values are trimmed using Loom's whitespace rules. Blank values are ignored; a non-empty list containing no valid
  names returns no tag or video results and reports a filter error.
  """
  tagNames: [String!]
  videoTypes: [SearchLoomVideoType!]
}

