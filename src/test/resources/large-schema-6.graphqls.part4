  viewId: ID! @ARI(interpreted : false, owner : "jira", type : "view", usesActivationId : false)
}

"Options for KNN similar-issues predictions."
input JiraKnnSimilarIssuesPredictionOptionsInput {
  """
  Controls candidate discovery and returned values for KNN_SIMILAR_ISSUES when the caller has not supplied
  a non-empty candidates list. Other prediction services are unaffected.
  
  - false, null, or omitted: the server attempts to resolve candidates and passes the
    resulting pool to KNN, preserving the existing empty-pool fallback behaviour.
  - true, when discovery is enabled: returns values supported by similar-issue evidence,
    excluding unmatched candidates that KNN would otherwise pad into the result.
  - A non-empty caller-supplied candidates list takes precedence over this option.
    If discovery is not enabled for this environment, the option is ignored.
  
  Discovery does not eliminate server-side candidate resolution for eligibility checks.
  Priority, assignee, components, parent, issue type, and custom single/multi-select fields
  still resolve an eligible pool and pass it to KNN so eligibility is applied before
  confidence thresholds and score normalization. Results are also filtered against that
  pool before maxResults is applied, so the resolver's pool-size limits still restrict
  returned values. Returned display values come from the current resolver pool.
  An empty required eligibility pool produces a field error.
  
  Labels and custom labels also resolve a pool when issueId is supplied, preserving the
  exclusion of labels already selected on that issue. Without issueId, these free-text
  fields send an empty candidate list to KNN, skip candidate resolution, and filter
  discovered values by searchFilter.
  In a mixed-model request, other models may still require server-resolved candidates.
  
  This option does not add model support to a field: status remains unsupported by KNN.
  """
  isCandidateDiscoveryEnabled: Boolean = false
}

input JiraLabelColorUpdateInput {
  "The color of the label"
