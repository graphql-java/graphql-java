"Lightweight board reference"
type TrelloQuickCaptureBoard {
  "The board ARI"
  id: ID!
  "Id used for (legacy) interaction with the REST API."
  objectId: ID!
}

"Lightweight card reference"
type TrelloQuickCaptureCard {
  "The card ARI"
  id: ID!
  "Id used for (legacy) interaction with the REST API."
  objectId: ID!
}

"A quick capture card notification"
type TrelloQuickCaptureNotification {
  "The board where the card was created (lightweight, only IDs)"
  board: TrelloQuickCaptureBoard
  "The inbox card that was created (lightweight, only IDs)"
  card: TrelloQuickCaptureCard
  "Timestamp when the card was created"
  dateCreated: DateTime
  "Notification ARI"
  id: ID!
  "Id used for (legacy) interaction with the REST API."
  objectId: ID!
  "The source of the quick capture (EMAIL, SLACK, MSTEAMS, etc.)"
  source: TrelloCardExternalSource
