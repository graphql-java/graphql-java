"Secret key configuration for an hmac authenticated webtrigger URL."
input WebTriggerSecretKeyConfigInput {
  "Secret key for hmac authenticated URLs"
  key: String!
  """
  When true, the provided key will not expire. Defaults to false, in which case the key
  expires 12 months after it is written.
  See https://hello.atlassian.net/wiki/spaces/~367895636/pages/7563611142/Lightweight+RFC+Opt-Out+Web+Trigger+Authentication+Key+Expiry
  """
  noExpiry: Boolean
}

input WebTriggerUrlInput {
  "Id of the application"
  appId: ID!
  """
  context in which function should run, usually a site context.
  E.g.: ari:cloud:jira::site/{siteId}
  """
  contextId: ID!
  "Environment id of the application"
  envId: ID!
  "Optional secret key configuration for hmac authenticated URLs"
  secretKeyConfig: WebTriggerSecretKeyConfigInput
  "Web trigger module key"
  triggerKey: String!
}

