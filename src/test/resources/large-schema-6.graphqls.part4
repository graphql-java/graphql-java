"""
Date filter for multiboard cards. Supply exactly one of:

- date: convenience shorthand — matches cards whose due OR start date falls
  within the given range.
- dueStart: field-specific filter — provide due, start, or both
  simultaneously. Both fields are optional; supply one or both.
"""
input TrelloMultiboardCardDateFilterInput @oneOf {
  """
  Convenience shorthand: matches cards whose due OR start date falls
  within this range.
  """
  date: TrelloMultiboardDateRangeInput
  """
  Filter by due and/or start independently. Both fields are optional; supply
  one or both.
  """
  dueStart: TrelloMultiboardDueStartFilterInput
}

"""
A single sort criterion: a field to sort on and an optional direction.
Direction defaults to ASC when omitted.
"""
input TrelloMultiboardCardSortInput {
  "Sort direction. Defaults to ASC when omitted."
  direction: TrelloMultiboardSortDirection
  field: TrelloMultiboardCardSortField!
}

"""
Filter on a date field. Supply exactly one of: any, none, range, or
noneOrRange. noneOrRange matches cards that have no date set OR whose
date falls within the given range (equivalent to the REST
"none,from...to" syntax).
"""
input TrelloMultiboardDateFieldFilterInput @oneOf {
  "Match cards where the field has any date set."
  any: Boolean
  "Match cards where the field has no date set."
  none: Boolean
  "Match cards with no date set, or whose date falls within the range."
  noneOrRange: TrelloMultiboardDateRangeInput
  "Match cards where the field falls within the given range."
  range: TrelloMultiboardDateRangeInput
}

"""
An inclusive date range. Both boundaries are optional; omitting one
creates an open-ended range. Values must be ISO 8601 datetime strings
with a timezone offset (e.g. "2026-05-21T23:03:00.000Z"). Plain
date-only strings ("YYYY-MM-DD") are also accepted and treated as
midnight UTC on that day.
"""
input TrelloMultiboardDateRangeInput {
  from: String
  to: String
}

"""
Field-specific date filter that can target due, start, or both simultaneously.
At least one of due or start should be supplied.
"""
input TrelloMultiboardDueStartFilterInput {
  "Filter by the card's due date; supports any, none, range, or noneOrRange."
  due: TrelloMultiboardDateFieldFilterInput
  "Filter by the card's start date; supports any, none, range, or noneOrRange."
  start: TrelloMultiboardDateFieldFilterInput
}

"""
Filter by label. All supplied fields are combined with OR semantics — a card
matches if it satisfies at least one of the active conditions. Omitting a
field means that condition is not applied.
"""
input TrelloMultiboardLabelFilterInput {
  "Match cards that have any label attached."
  any: Boolean
  """
  Match cards that have at least one label matching any entry in this list.
  Each entry is matched by color, name, or both; at least one of color or
  name must be supplied per entry.
  """
  labels: [TrelloMultiboardLabelInput!]
  "Match cards that have no labels attached."
  none: Boolean
}

"""
A label selector matched by color, name, or both. At least one of color
or name must be supplied.
"""
input TrelloMultiboardLabelInput {
  "The label color to match (e.g. \"red\", \"blue\"). Omit to match any color."
  color: String
  "The label name to match. Omit to match any name."
  name: String
}

"""
Filter by member assignment. Supply exactly one of: any, none, or
memberIds.
"""
input TrelloMultiboardMemberFilterInput @oneOf {
  "Match cards with any member assigned."
  any: Boolean
  "Match cards assigned to one or more of the given members."
  memberIds: [ID!]
  "Match cards with no members assigned."
  none: Boolean
}

"The input for creating a new custom field option"
input TrelloNewCustomFieldOptionInput {
  "The color of the new custom field option"
  color: String
  "The position of the new custom field option"
  position: Float
  "The value of the new custom field option."
  value: TrelloCustomFieldOptionValueInput!
}

"Arguments for creating an AI-generated New Year's Resolution board"
input TrelloNewYearsResolutionAiBoardInput {
