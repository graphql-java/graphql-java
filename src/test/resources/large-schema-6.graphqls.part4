"Represents argument input type for `fieldOptions` query to provide capability to filter field options by list of IDs"
input JiraFieldOptionIdsFilterInput {
  "Filter operation to perform on the list of optionsIds provided in input."
  operation: JiraFieldOptionIdsFilterOperation!
  """
  Filter the available field options with provided option ids by specifying a filter operation.
  Upto maximum 100 Option Ids are can be provided in the input.
  Accepts ARI(s): OptionID
  """
  optionIds: [ID!]!
}

input JiraFieldPredictionCandidateInput {
  "Identifier for the candidate option."
  id: String!
  "Value of the prediction candidate."
  value: String
}

"Per-field prediction request input."
input JiraFieldPredictionFieldInput {
  """
  Candidate id/value pairs to score/rank. A non-empty caller-supplied list takes precedence
  over knnSimilarIssuesOptions.isCandidateDiscoveryEnabled. If validation removes all supplied candidates,
  the field returns an error rather than falling back to discovery.
  
  When omitted or empty, the server normally resolves candidates using project, issue type,
  and issue context and passes that pool to the prediction services. When enabled,
  knnSimilarIssuesOptions.isCandidateDiscoveryEnabled returns values backed by similar-issue
  evidence. Constrained fields still pass the resolved pool to KNN before scoring; only
  labels without issue context can omit it. See that option for eligibility details.
  """
  candidates: [JiraFieldPredictionCandidateInput!]
  "Issue field ID (e.g. \"priority\", \"assignee\", \"customfield_10001\")."
  fieldId: String!
  """
  Options for KNN_SIMILAR_ISSUES. Explicitly requested prediction services must include
  KNN_SIMILAR_ISSUES when these options are supplied. If predictionTypes is omitted or
  empty and the server selects another model, these options are ignored. Other services
  are unaffected.
  """
  knnSimilarIssuesOptions: JiraKnnSimilarIssuesPredictionOptionsInput
  """
  Max number of ranked candidates to return for this field. Defaults to 10 when omitted;
  values are clamped to the server-enforced maximum (20). Server-side candidate resolution
  may fetch a larger internal candidate pool before ranking and final response truncation.
  """
  maxResults: Int
  """
  Optional: explicitly request specific prediction service(s) to run for this field.
  When omitted, the server selects services based on the field's type and the configured
  experiment lineup.
  """
  predictionTypes: [JiraFieldPredictionType!]
  "Optional search filter used to narrow candidate values (partial string match)."
  searchFilter: String
}

input JiraFieldSchemeAssociatedFieldsInput {
  "Search fields by associated issue types. If null or empty, fields will not be filtered by associated issue types."
  associatedIssueTypesFilter: [JiraFieldsAssociatedIssueTypesFilterInput!]
  "Search fields by list of field type groups. If empty, fields will not be filtered by field type group."
  fieldTypeGroupsFilter: [String!]
  "Search fields by field name or description. If null or empty, fields will not be filtered by field name or description."
  nameOrDescriptionFilter: String
  "Search fields by whether they are required on the given issue types. If null or empty, fields will not be filtered by required on issue types."
  requiredOnIssueTypesFilter: [JiraFieldsRequiredOnIssueTypesFilterInput!]
  "Unique identifier of the field scheme."
  schemeId: ID!
  "Sort order. Note: only a single sort order is supported at present. Supplying multiples would result in an error."
  sortBy: [JiraFieldSchemesSort!]
}

input JiraFieldSchemeAssociatedIssueTypesInput {
  nameFilter: String
}

input JiraFieldSchemeAvailableFieldsInput {
  "Search fields by field name or description. If null or empty, fields will not be filtered by field name or description."
  nameOrDescriptionFilter: String
  "Unique identifier of the field scheme."
  schemeId: ID!
}

input JiraFieldSchemeRequiredOnIssueTypesInput {
  nameFilter: String
}

