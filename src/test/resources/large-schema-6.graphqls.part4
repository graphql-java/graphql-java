  skillId: ID! @ARI(interpreted : false, owner : "jira-servicedesk", type : "skill", usesActivationId : false)
  """
  The desired final set of agent ARIs assigned to the skill. Duplicates are ignored. An empty
  list removes all current assignments.
  """
  userAris: [ID!]! @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
}

"""
============================================
Availability Types
============================================
"""
input AgentWorkspaceAvailabilityInput {
  "Filter by multiple agent IDs (optional)"
  agentIds: [ID!]
  "Cloud ID (required)"
  cloudId: ID! @CloudID(owner : "jira")
  """
  [DEPRECATED] Signals the first page load. Use query-level 'isInitialFetch' argument instead.
  When true and the caller is a non-admin agent,
  the backend auto-filters results to the current user and returns initialFilters.
  
  
  This field is **deprecated** and will be removed in the future
  """
  isInitialFetch: Boolean
  """
  [DEPRECATED] Page number (1-based). Use query parameter 'after' instead.
  
  
  This field is **deprecated** and will be removed in the future
  """
  page: Int
  """
  [DEPRECATED] Number of agents to return per page. Use query parameter 'first' instead.
  
  
  This field is **deprecated** and will be removed in the future
  """
  pageSize: Int
  "Project ID (optional)"
  projectId: ID
  "Project key (optional)"
  projectKey: String
  "Sort field (optional)"
  sortBy: AgentWorkspaceAvailabilitySortField
  "Sort direction (optional, defaults to ASC)"
  sortOrder: AgentWorkspaceSortDirection
  "Filter by multiple statuses (optional)"
  statuses: [AgentWorkspaceAvailabilityStatus!]
  "Filter by multiple team ARIs (optional). Alternative to teamIds — accepts full team ARIs."
  teamARIs: [ID!] @ARI(interpreted : false, owner : "identity", type : "team", usesActivationId : false)
  "Filter by multiple team IDs (optional) - only include agents belonging to these teams"
  teamIds: [ID!]
}

input AgentWorkspaceAvailabilityInputPayload {
  "Filter by multiple agent IDs (optional)"
  agentIds: [ID!]
  "Cloud ID (required)"
  cloudId: ID! @CloudID(owner : "jira")
  "Project ID (required)"
  projectId: ID!
  "Sort field (optional)"
  sortBy: AgentWorkspaceAvailabilitySortField
  "Sort direction (optional, defaults to ASC)"
  sortOrder: AgentWorkspaceSortDirection
  "Filter by multiple statuses (optional)"
  statuses: [AgentWorkspaceAvailabilityStatus!]
  "Filter by  team IDs - only include agents belonging to this team (required)"
  teamId: ID!
}

"Input for updating agent availability status"
input AgentWorkspaceAvailabilityStatusInput {
  "The account ID of the agent whose availability status is being updated"
  agentAccountId: ID! @ARI(interpreted : false, owner : "jira", type : "user", usesActivationId : false)
  "Cloud ID (required)"
  cloudId: ID! @CloudID(owner : "jira")
  """
  When true, the agent has explicitly chosen not to have their status auto-changed ("never
  expire"): the automatic heartbeat/inactivity transitions must never move them out of `status`.
  This is distinct from omitting `statusExpiresAt`, which means "no timer" and still allows
  automatic management (e.g. a status picked directly from the profile dropdown). Defaults to
  false. Gated behind the availability improvements rollout.
  """
  neverExpire: Boolean
  "Project ID (required)"
  projectId: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  "The desired availability status"
  status: AgentWorkspaceAvailabilityStatus!
  """
  Optional timestamp (ISO-8601) until which the agent should hold `status`. The timer is
  bidirectional: set with `ON_BREAK` for "unavailable until", or with `AVAILABLE` for
  "available until". When the timestamp elapses the status automatically reverts to the opposite
  status. Omit or null for no timer.
  """
  statusExpiresAt: DateTime
}

"Input for bulk upserting drafted routing table entries."
input AgentWorkspaceBulkUpsertDraftedRoutingTableEntriesInput {
  "The Jira cloud ID."
  cloudId: ID! @CloudID(owner : "jira")
  "Draft session UUID these entries belong to. Empty entries replace this draft with no rows."
  draftId: ID
  "Entries to upsert. No server-side item limit is applied."
  entries: [AgentWorkspaceBulkUpsertDraftedRoutingTableEntryInput!]!
  "The Jira project key."
  projectKey: String!
