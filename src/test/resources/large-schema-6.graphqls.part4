"Input to move issues into a card list and/or rank them within it."
input JiraMoveAndRankCardListIssuesInput {
  """
  ARIs of the issues to move and/or rank. The order of this list is preserved as the relative order of the
  issues when they are ranked to the top or the bottom of the card list.
  """
  issueIds: [ID!]! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  """
  Where the issues are placed within the card list.
  Omit to move the issues without changing their rank.
  """
  placement: JiraCardListPlacementInput
  """
  ARI of the card list the issues are moved into.
  Omit for a rank-only request that leaves the issues in their current card list.
  """
  targetCardListId: ID @ARI(interpreted : false, owner : "jira", type : "backlog-card-list", usesActivationId : false)
  """
  Numeric ID of the workflow transition to apply, used when the target column maps to more than one valid
  transition. Only applies to card lists of a company-managed Kanban board.
  """
  transitionId: ID
}

