"Validate or atomically publish the submitted Focus Area and Organization canvases. At least one node is required; the combined limit is 500."
input MercuryCreateFocusAreasFromOnboardingInput {
  "The workspace containing the onboarding model."
  cloudId: ID! @CloudID(owner : "mercury")
  """
  When true (default), validate both canvases, configuration, permissions, owner ID format and references without writes.
  Owner metadata must contain account IDs, not ARIs; existence and membership are caller assumptions in V1.
  Validation does not reserve configuration or guarantee a later Publish succeeds.
  When false, create both canvases and contributor links in one transaction.
  """
  dryRun: Boolean = true
  "The Focus Area canvas. Omit or submit an empty canvas for Organizations-only Publish."
  model: MercuryOnboardingModelInput
  "The Organization canvas. Focus Area references resolve only within the submitted Focus Area canvas."
  organizationModel: MercuryOnboardingModelInput
}

