"""
This is a top level query type under which all of Trello's supported queries
are under. It is used to group Trello's GraphQL queries from other Atlassian
queries.
"""
type TrelloQueryApi {
  """
  Fetches an existing agent session by ID.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  agentSession(id: ID! @ARI(interpreted : false, owner : "trello", type : "agent-session", usesActivationId : false)): TrelloAgentSession @rateLimit(cost : 10, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Fetches the viewer's own agent sessions, by attributes such as creator and
  board ID. Never returns sessions created by other members.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  agentSessions(
    """
    A pointer to a place in the agent sessions dataset (cursor). Used as the
    starting point for the next page of agent sessions. If not specified, the
    page will start from the beginning of the dataset.
    """
    after: String,
    "Filter to specify which sessions to fetch. At least one filter field must be specified."
    filter: TrelloAgentSessionFilter!,
    "Number of messages to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloAgentSessionConnection @rateLimit(cost : 10, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
    Uses AI to suggest Butler automations for the current member, based on the
    actions they have regularly taken on a board (or on a list on that board)
    over the last 30 days and the automations they already have enabled there.
  
  At least one of `boardId` or `listId` must be provided. Suggestions are
    plain-English descriptions; to create one, pass its `description` as the
    prompt to `createAutomationFromPrompt`, which turns it into a Butler command.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:board:trello__
  * __trello:atlassian-external__
  """
  aiAutomationSuggestions(
    """
    The board to suggest automations for. May be omitted when `listId` is
    provided, in which case the list's board is used.
    """
    boardId: ID @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false),
    """
    A list to focus the suggestions on. When `boardId` is also provided, the
    list must be on that board.
    """
    listId: ID @ARI(interpreted : false, owner : "trello", type : "list", usesActivationId : false)
  ): TrelloAiAutomationSuggestions @rateLimit(cost : 1000, currency : TRELLO_AI_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_BOARD]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Get a Trello application (Power-Up / Integration) by id.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  application(id: ID!): TrelloApplication @rateLimit(cost : 50, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Fetch the archived (closed) cards for a board.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:board:trello__
  * __read:member.inbox:trello__
  * __trello:atlassian-external__
  """
  archivedCards(
    """
    The pointer to a place in the dataset (cursor). It’s used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false),
    "Number of items to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloArchivedCardConnection @rateLimit(cost : 100, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_BOARD]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_MEMBER_INBOX]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Fetch attachments information for the passed ids. A maximum of 50 attachments can be
  fetched at a time.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:board:trello__
  * __trello:atlassian-external__
  """
  attachmentsById(ids: [ID!]! @ARI(interpreted : false, owner : "trello", type : "attachment", usesActivationId : false)): [TrelloAttachment] @costArgLengthRateLimited(currency : TRELLO_CURRENCY, unitArgument : "ids", unitCost : 10) @rateLimit(cost : 100, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_BOARD]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Get a Trello board by id.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:board:trello__
  * __trello:atlassian-external__
  * __read:trello:twg-cli__
  * __read:trello:agent-interface__
  """
  board(id: ID!): TrelloBoard @rateLimit(cost : 50, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_BOARD]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL]) @scopes(product : NO_GRANT_CHECKS, required : [READ_TRELLO_TWG_CLI]) @scopes(product : NO_GRANT_CHECKS, required : [READ_TRELLO_AGENT_INTERFACE])
  """
  Get a Trello board by shortlink.  Cost is higher due to non-routable nature
  of shortLink vs Id
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:board:trello__
  * __trello:atlassian-external__
  * __read:trello:twg-cli__
  * __read:trello:agent-interface__
  """
  boardByShortLink(shortLink: TrelloShortLink!): TrelloBoard @rateLimit(cost : 100, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_BOARD]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL]) @scopes(product : NO_GRANT_CHECKS, required : [READ_TRELLO_TWG_CLI]) @scopes(product : NO_GRANT_CHECKS, required : [READ_TRELLO_AGENT_INTERFACE])
  """
    Board history aggregations for timeline views.
  
  Requires the board's workspace to have the Views premium feature.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:board:trello__
  * __trello:atlassian-external__
  """
  boardHistory(
    boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false),
    """
    Start of the time window for all sub-field queries. Defaults to the
    server-configured maximum look-back limit (usually 30 days).
    """
    from: DateTime,
    """
    IANA timezone used to bucket actions into calendar days for all
    sub-field queries. Defaults to UTC.
    """
    timezone: String
  ): TrelloBoardHistory @rateLimit(cost : 100, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_BOARD]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Fetch mirror card information for the board with the given id.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  boardMirrorCardInfo(id: ID @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false), shortLink: TrelloShortLink): TrelloBoardMirrorCards @rateLimit(cost : 50, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Get a Trello board or inbox by id.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:board:trello__
  * __read:member.inbox:trello__
  * __trello:atlassian-external__
  """
  boardOrInbox(id: ID!): TrelloBaseBoard @rateLimit(cost : 50, currency : TRELLO_CURRENCY) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_BOARD]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_READ_MEMBER_INBOX]) @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Fetch board information for the passed ids. A maximum of 10 boards can be
