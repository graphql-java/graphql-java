input SearchSalesforceAttributeFilter {
  "Salesforce field API name (for example status, dealClosedAt, Forecast_Category__c)."
  field: String!
  """
  Lower bound for BETWEEN.
  Values are normalized to strings by the mapper.
  """
  from: String
  "Comparison operator to apply to this field."
  operator: SearchSalesforceAttributeFilterOperator!
  "Indexed source bucket for this field."
  source: SearchSalesforceAttributeFilterSource!
  """
  Upper bound for BETWEEN.
  Values are normalized to strings by the mapper.
  """
  to: String
  """
  Single operand for EQ/GT/GTE/LT/LTE.
  Values are normalized to strings by the mapper.
  """
  value: String
  """
  Multi-value operand for IN.
  Values are normalized to strings by the mapper.
  """
  values: [String!]
}

input SearchSalesforceFilters {
  "Generic Salesforce attribute filters for indexed fields across relationships/custom properties."
  attributeFilters: [SearchSalesforceAttributeFilter!]
  """
  Filter Salesforce Campaign entities by member status (API name). Matches relationships tokens
  indexed as campaignStatus/<value> (same pattern as stage/<value> for opportunities).
  """
  campaignStatuses: [String!]
  """
  Filter Salesforce Case entities by status (API name). Matches relationships tokens indexed as
  caseStatus/<value>.
  """
  caseStatuses: [String!]
  "Search for only entities that match the Close Date"
  closeDate: String
  """
  Filter Salesforce Event entities by type (API name). Matches relationships tokens indexed as
  eventType/<value>.
  """
  eventTypes: [String!]
  "Filter deals by their closed state. true = closed deals, false = open deals."
  isClosed: Boolean
  """
  Filter Salesforce KnowledgeArticle entities by publish status. Fixed values: Online, Draft, Archived.
  Matches relationships tokens indexed as status/<value>.
  """
  knowledgeArticlePublishStatuses: [String!]
  """
  Filter Salesforce Lead entities by status (API name). Matches relationships tokens indexed as
  status/<value>.
  """
  leadStatuses: [String!]
  "Search for only entities from the Owners, values should be 1P Atlassian account Ids."
  owners: [String!]
  "Search for only entities that match the given Stage"
  stage: [String!]
  """
  Filter Salesforce Task entities by status (API name). Matches relationships tokens indexed as
  status/<value>.
  """
  taskStatuses: [String!]
  """
  Filter Salesforce Task entities by type (API name). Matches relationships tokens indexed as
  taskType/<value>.
  """
  taskTypes: [String!]
}

input SearchServiceNowAttributeFilter {
  field: String!
  from: String
  operator: SearchServiceNowAttributeFilterOperator!
  source: SearchServiceNowAttributeFilterSource!
  to: String
  value: String
  values: [String!]
}

input SearchServiceNowFilters {
  attributeFilters: [SearchServiceNowAttributeFilter!]
  """
  Atlassian account IDs of record owners or assignees. Targets the top-level `owners` field,
  which FDS populates from the ServiceNow owners and assignee values (falling back to the
  record creator when neither is present).
  """
  owners: [String!]
}

"Fields used to sort the query"
input SearchSortInput {
  "Name of the document field on which to sort. May be a computed field such as \"_score\"."
  field: String!
  """
  Field to sort by if a content property was specified in the field section. This is ignored if the field is not
  a content property.
  """
  key: String
  "Order to sort the result by."
  order: SearchSortOrder!
}

input SearchTalentFilter {
  "Search for position with specific employment types"
  employmentTypes: [String!]
  "Search for position under focus areas."
  focusAreas: [String!]
  "Search for position belonging to specific job family"
  jobFamilies: [String!]
  "Search for position owned by particular users. The values should be Atlassian Account IDs."
  owners: [String!]
  "Search for position with the identified statuses"
  statuses: [String!]
  "Search for position from a specific team"
  teams: [String!]
}

input SearchTeamsFilters {
  "Search for only entities that have the given attachment file types"
  attachmentFileTypes: [String!]
  "Search for only entities that has attachments"
  hasAttachment: Boolean
  "Search for only entities that has links"
  hasLink: Boolean
  """
  Search for only entities that match the given Teams message type
  (e.g. "announcement"). Today only "announcement" is supported by the
  messageType field in the chat-chunking index in xpsearch-content.
  Intentionally singular for now; may evolve into a list in the future.
  """
  messageType: String
  """
  Search for only entities belonging to the given Teams workspace names
  (sourced from the workspaceName field in the DevopsConversation index).
  Accepts one or more workspace name strings.
  """
  workspaceName: [String!]
}

input SearchThirdPartyFilter {
  "Search for text stored under additional text field; for BYOD we can index domain URLs."
  additionalTexts: [String!]
  "Restrict search only to the given ancestors represented by ARIs"
  ancestorAris: [String!]
  "Search for only entities that have assignee ids specified"
  assignees: [String!]
  "Search for only entities that have the containerARIs specified"
  containerAris: [String!]
  "Search for only entities that have the containerNames specified"
  containerNames: [String!]
  "Search for only entities that have the specified container types."
  containerTypes: [String!]
  "Search for only the entities that have createdBy account ids specified"
  createdBy: [String!]
  "Exclude the entities that have the subtypes specified"
  excludeSubtypes: [String!] = ["folder"]
  "Git provider search filters (Bitbucket, GitHub, GitLab)"
  gitFilters: SearchGitFilters
  "Gong video search filters"
  gongFilters: SearchGongFilters
  "Search for only entities that have the integration ids specified"
  integrations: [ID!] @ARI(interpreted : false, owner : "platform", type : "integration", usesActivationId : false)
  "Search for labels in any thirdparty filter"
  labels: [String!]
  "Search entities by user who last modified them"
  lastUpdatedBy: [String!]
  "Search for only entities that have match the date range for the specified field"
  range: [SearchThirdPartyRangeFilter]
  "Salesforce search filters"
  salesforceFilters: SearchSalesforceFilters
  "ServiceNow search filters"
  serviceNowFilters: SearchServiceNowFilters
  "Search for only entities that have the subtypes specified"
  subtypes: [String]
  "Microsoft Teams search filters"
  teamsFilters: SearchTeamsFilters
  "Mapping of each third party product and its subtypes, providerId and integrationId"
  thirdPartyProducts: [SearchThirdPartyProduct!]
  "Search for only entities that have the types specified"
  thirdPartyTypes: [String!]
  "Search for only entities that have a title that contains the given query"
  titleMatchOnly: Boolean
}

input SearchThirdPartyProduct {
  """
  Optional list of Slack channel names to restrict the search to specific channels.
  Only applicable for Slack third-party product searches.
  """
  channels: [String]
  "Optional array of connection IDs to filter results by specific connections"
  connectionIds: [String!]
  "Indicates if the product is a smartlink connector, full connector, or both"
  connectorSources: [String!]
  """
  Subset of connectorSources for which impersonation auth is enabled
  (i.e. connectors where isUserOAuthed=false AND isImpersonated=true).
  Used by the aggregator purely for observability/logging of impersonated requests.
  """
  connectorSourcesImpersonationEnabled: [String!]
  "Specifies any container types eg: for slack we may want to limit to [\"direct-message\", \"group-direct-message\"]"
  containerTypes: [String!]
  "Specifies the datasourceId (aka connectorId) for 3P products (e.g. \"471293c5-0de9-47ca-be18-fc8a244e1279\")"
  datasourceId: String
  """
  Optional list of entity types to search within this third-party product.
  If provided, only these entities will be searched (filtered against both the main query's entities and the product's supported entities).
  If not provided, all entities from the main query that are supported by the product will be searched.
  This works for all third-party products, including dynamic Forge connectors and predefined products like Google Drive, SharePoint, etc.
  """
  entities: [String!]
  "The given product's integration ari"
  integrationId: String
  """
  Backward-compatibility field only. This input is ignored by the aggregator.
  Linked comments are now always returned according to linkedEntityGranularity and upstream defaults.
  
  
  This field is **deprecated** and will be removed in the future
  """
  linkedEntities: [String!]
  "Specifies how much content to return for linked entities"
  linkedEntityGranularity: SearchLinkedEntityGranularity = DEFAULT
  "ProductKey from frontend code to identify the product for feature gate purposes"
  product: String
  "The given product's provider id from twg"
  providerId: String
  "Subtypes mapped to this product for the given query"
  subtypes: [String!]
}

input SearchThirdPartyRangeFilter {
  "The field to use to calculate the range"
  field: SearchThirdPartyRangeField!
  "Specify the timestamp that the field should be greater than"
  gt: String
  "Specify the timestamp that the field should be less than"
  lt: String
}

"""
Search-tool-specific request metadata, attached to AGG search requests when the request
originates from a CAP chat-tool / agent fanout.
"""
input SearchToolContext {
  "Eval dataset row or item identifier associated with this request. Null for non-eval traffic."
  dataId: String
  "Eval dataset name associated with this request. Null for non-eval traffic."
  datasetName: String
  "Assistance Service Eval job identifier that produced this request. Null for non-eval traffic."
  evalJobId: String
  "Atlassian account ID of the eval owner. Null for non-eval traffic or when unavailable."
  evalOwnerAccountId: String
  """
  Exclude native Slack retrieval for this search-agent request. Other experiences ignore this
  setting. Omitted, false, or null preserves the existing search behavior.
  """
  excludeSlack: Boolean = false
  """
  Rovo eval experiment arm associated with this search-tool request. Null if not associated
  with an experiment arm.
  """
  experimentArm: String
  """
  Rovo eval experiment identifier associated with this search-tool request. Null if not
  associated with an experiment.
  """
  experimentId: String
  """
  Whether this request should be considered shadow traffic by search tooling.
  Omitted, false, or null preserves the existing search behavior.
  """
  isShadow: Boolean = false
  "Whether this request is synthetic / evaluation / replay traffic. Defaults to false."
  isSynthetic: Boolean = false
}

input SearchTrelloFilter {
  "Whether to search for recent boards"
  isRecentBias: Boolean
}

input SetAppEnvironmentVariableInput {
  environment: AppEnvironmentInput!
  "The input identifying the environment variable to insert"
  environmentVariable: AppEnvironmentVariableInput!
}

"Input payload for setAppLicenseId mutation"
input SetAppLicenseIdInput {
  appHostKey: String!
  appId: ID!
  environmentKey: String!
  licenseId: ID!
}

input SetAppStoredCustomEntityMutationInput {
  "The ARI to store this entity within"
  contextAri: ID
  "Specify the entity name for custom schema"
  entityName: String!
  "The identifier for the entity"
  key: ID!
  """
  Entities may be up to ${maxValidContentLength} bytes long. Note that size within ESS may differ from
  the size of the entity sent to this service. The entity size is counted within this service.
  """
  value: JSON! @suppressValidationRule(rules : ["JSON"])
}

input SetAppStoredEntityMutationInput {
  "The ARI to store this entity within"
  contextAri: ID
  "Specify whether value should be encrypted"
  encrypted: Boolean
  """
  The identifier for the entity
  
  Keys must be between 1-100 characters long and must match the following pattern /^[a-zA-Z0-9:._\s-]+$/
  """
  key: ID!
  """
  Entities may be up to 2000 bytes long. Note that size within ESS may differ from
  the size of the entity sent to this service. The entity size is counted within this service.
  """
