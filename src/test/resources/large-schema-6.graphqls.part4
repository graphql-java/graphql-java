"""
Input for querying contribution aggregations for contributors across all capacity plans.
This query is scope-free so that MCP and other non-UI consumers do not need a board or scope ID.
"""
input CplsGetContributorContributionAggregationsInput {
  capacityPlanId: ID
  cloudId: ID! @CloudID(owner : "jira")
  """
  Optional aggregation window. A missing bound is resolved to the standard two-year window.
  The returned window expands to complete time-scale periods and includes contributions in
  those periods even where they fall outside the requested dates.
  """
  contributionDateRange: CplsContributionDateRange
  "The contributors whose allocations should be aggregated."
  contributorDataIds: [ID!]! @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  scopeId: ID
  scopeView: CplsScopeViewEnum
  """
  Optional aggregation granularity. When omitted, the service selects it adaptively from the
  requested date range.
  """
  timeScale: CplsTimeScaleType
}

"Input for querying the contributors in a plan along with the work they are allocated to."
input CplsGetContributorScopeAssociationsInput {
  after: String
  before: String
  """
  Optional date range for the nested contribution cells. It does not filter contributors.
  The resolved range is bounded: no dates uses [today - 1 year, today + 1 year]; a start date
  only uses [startDate, startDate + 2 years]; and an end date only uses [endDate - 2 years,
  endDate]. Both dates must be ordered and span no more than two years.
  """
  contributionDateRange: CplsContributionDateRange
  """
  Optional filters selecting which contributors are returned. When omitted, no filtering is
  applied - persisted filters are deliberately not consulted.
  """
  filters: CplsFiltersInput
  "Number of results to return from the start (1-100)."
  first: Int
  "Number of results to return from the end (1-100)."
  last: Int
  "The plan (scope) whose contributors to return."
  scopeId: ID! @ARI(interpreted : false, owner : "capacity-planning", type : "scope", usesActivationId : false)
  """
  Optional granularity for the nested contribution cells. When omitted, granularity is selected
  from the resolved date range: weekly through three months, monthly through one year, and
  quarterly thereafter.
  """
  timeScale: CplsTimeScaleType
}

"""
Input for querying contributor-work associations across plans (scope-free).
At least one of contributorDataIds or workDataIds is required.
"""
input CplsGetContributorWorkAssociationsInput {
  after: String
  before: String
  """
  Optional capacity plan ARI. Behaves like scopeId for the plan it identifies.
  Mutually exclusive with scopeId.
  """
  capacityPlanId: ID
  cloudId: ID! @CloudID(owner : "jira")
  """
  Optional date range for the nested contribution cells. It does not filter associations.
  The resolved range is bounded: no dates uses [today - 1 year,
  today + 1 year]; a start date only uses [startDate, startDate + 2 years]; and an end date
  only uses [endDate - 2 years, endDate]. Both dates must be ordered and span no more than
  two years. The resolved range also determines the cell granularity: weekly through three
  months, monthly through one year, and quarterly thereafter. Returned cells are expanded to
  complete periods, including contributions in boundary periods outside the requested dates.
  """
  contributionDateRange: CplsContributionDateRange
  """
  Contributor data IDs to filter by. Max 20 items.
  At least one of contributorDataIds or workDataIds must be provided.
  """
  contributorDataIds: [ID!]
  "Number of results to return from the start (1-100)."
  first: Int
  "Number of results to return from the end (1-100)."
  last: Int
  """
  Optional capacity plan scope, as a board ARI or project ARI. When supplied, only allocations
  whose contributor (People view) or work item (Work view) belongs to that plan are returned.
  Mutually exclusive with capacityPlanId.
  """
  scopeId: ID
  "Which association table defines plan membership. Defaults to PEOPLE when scopeId or capacityPlanId is supplied."
  scopeView: CplsScopeViewEnum
  """
  Work data IDs to filter by. Max 20 items.
  At least one of contributorDataIds or workDataIds must be provided.
  """
  workDataIds: [ID!]
}

"""
Input for querying contribution aggregations for work items across all capacity plans.
This query is scope-free so that MCP and other non-UI consumers do not need a board or scope ID.
"""
input CplsGetWorkContributionAggregationsInput {
  capacityPlanId: ID
  cloudId: ID! @CloudID(owner : "jira")
  """
  Optional aggregation window. A missing bound is resolved to the standard two-year window.
  The returned window expands to complete time-scale periods and includes contributions in
  those periods even where they fall outside the requested dates.
  """
  contributionDateRange: CplsContributionDateRange
  scopeId: ID
  scopeView: CplsScopeViewEnum
  """
  Optional aggregation granularity. When omitted, the service selects it adaptively from the
  requested date range.
  """
  timeScale: CplsTimeScaleType
  "The work items whose allocations should be aggregated. Max 20 items."
  workDataIds: [ID!]!
}

"""
Bulk import for coordinated creation of contributors, work assignments, and capacity data.
This mutation combines multiple bulk operations that would otherwise require separate calls.
"""
input CplsImportCapacityDataInput {
  "Cloud ID for tenant context - required once at root level for all operations."
  cloudId: ID! @CloudID(owner : "jira")
  "Bulk add contributions with capacity data."
  contributions: [CplsAddContributionInput!]
  "Bulk add contributors to a scope."
  contributorDataIds: [ID!]
  "Bulk add contributor-work associations."
  contributorWorkAssociations: [CplsContributorWorkAssociation!]
  "Scope ID - used across all operations in this import."
  scopeId: ID!
}

"Jira-specific context for scoping work recommendations."
input CplsJiraRecommendationContext {
  "The Jira board JQL used to scope recommendations when available."
  jql: String
  "The Jira project ARI, used to scope recommendations to a Jira space."
  projectId: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
}

"Input for reordering a contributor group at the top level of the People view."
input CplsReorderContributorInput {
  cloudId: ID! @CloudID(owner : "jira")
  contributorDataId: ID!
  position: CplsReorderPosition!
  scopeId: ID!
}

"""
Input for reordering a work item within a contributor's child list in the People view.
contributorDataId identifies the parent list; the moved workId must already belong to it.
"""
input CplsReorderContributorWorkInput {
  cloudId: ID! @CloudID(owner : "jira")
  contributorDataId: ID!
  position: CplsReorderPosition!
  scopeId: ID!
  workId: ID!
}

"""
Symbolic position used by the reorder mutations to describe where a moved
item should land in the canonical (server-side) list. Anchored kinds carry
a node id of a sibling that is currently visible in the user's filtered slice;
node ids are invariant across filters and pagination, so the backend can
resolve the anchor against the canonical list regardless of any filtered-out
or unloaded edges between them.
"""
input CplsReorderPosition {
  """
  The node id of the anchor item.
  Required when kind is BEFORE or AFTER. Must be omitted when kind is FIRST or LAST.
  """
  anchorId: ID
  "The kind of position (FIRST, LAST, BEFORE, AFTER)."
  kind: CplsReorderPositionKind!
}

"""
Input for reordering a contributor within a work item's child list in the Work view.
workId identifies the parent list; the moved contributorDataId must already belong to it.
"""
input CplsReorderWorkContributorInput {
  cloudId: ID! @CloudID(owner : "jira")
  contributorDataId: ID!
  position: CplsReorderPosition!
  scopeId: ID!
  workId: ID!
}

"Input for reordering a work group at the top level of the Work view."
input CplsReorderWorkInput {
  cloudId: ID! @CloudID(owner : "jira")
  position: CplsReorderPosition!
  scopeId: ID!
  workId: ID!
}

"Input for searching custom contribution targets."
input CplsSearchCustomContributionTargetsInput {
  after: String
  before: String
  cloudId: ID! @CloudID(owner : "jira")
  first: Int
  last: Int
  query: String
}

