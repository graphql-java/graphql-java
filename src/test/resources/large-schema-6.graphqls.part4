    cloudId: ID! @CloudID(owner : "jira"),
    first: Int = 12,
    "We will take maximum of 3 project ARIs"
    projectAris: [ID!]! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false),
    "Maximum number of sprints (default 3) to be included for a project"
