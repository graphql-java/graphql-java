  expectedSetupVersion: Int
  "The custom field ID for the service field (e.g. customfield_10054)"
  fieldId: String!
  "The Jira project key (e.g. JSM)."
  projectKey: String!
  "Deprecated legacy field. Accepted for compatibility and ignored; submit uses the persisted draft rows instead."
  selectedServiceIds: [String!]
  """
  Optional. Human-readable name of the Jira field referenced by `fieldId`. When provided it is persisted onto
  `SmartRoutingProjectConfig.serviceFieldName` alongside `fieldId`. Omit to preserve the existing
  persisted value.
  """
  serviceFieldName: String
  """
  Optional. Type of the Jira field referenced by `fieldId`. When provided it is persisted onto
  `SmartRoutingProjectConfig.serviceFieldType` alongside `fieldId`. Omit to preserve the existing
  persisted value.
  """
  serviceFieldType: AgentWorkspaceSmartRoutingServiceFieldType
}

