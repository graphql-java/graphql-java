  helpCenterCreateTopicInputItem: [HelpCenterCreateTopicInput!]!
}

input HelpCenterBulkDeleteTopicInput {
  helpCenterTopicDeleteInput: [HelpCenterTopicDeleteInput!]!
}

input HelpCenterBulkUpdateTopicInput {
  "The new updated topic for the given help center"
  helpCenterUpdateTopicInputItem: [HelpCenterUpdateTopicInput!]!
}

input HelpCenterCreateFolderInput {
  helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
  isDraft: Boolean! = false
  name: String!
}

"""
#########################
 Mutation Inputs
#########################
"""
input HelpCenterCreateInput {
  "Branding of the help center (e.g. colors, logo, banner, home page title)"
  helpCenterBranding: HelpCenterBrandingInput
  "Help Center Type"
  helpCenterType: HelpCenterTypeInput
  "Layout Input"
  homePageLayout: HelpCenterHomePageLayoutInput
  "Name of the help center."
  name: HelpCenterNameInput!
  "Add Project Mapping"
  projectMapping: HelpCenterAddProjectMappingInput
  "Rovo Config"
  rovoConfig: HelpCenterRovoConfig
  "Slug of the help center."
  slug: String!
  "Template used to provision the Help Hub."
  templateType: HelpCenterTemplateType = DEFAULT
  "workspaceARI can be used to get the correct help center node"
  workspaceARI: String! @ARI(interpreted : false, owner : "jira", type : "workspace", usesActivationId : false)
}

input HelpCenterCreateTopicInput {
  "Description about the topic as visible on help center page"
  description: String
  "HelpCenterARI can be used to retrieve helpCenterId"
  helpCenterAri: String @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
  "The help objects ARI which this topic contains"
  items: [HelpCenterTopicItemInput!]!
  "Name about the topic as visible on the help center page"
  name: String!
  "The id of help center where the topics needs to be created"
  productName: String
  """
   This includes additional properties to the topics.
  Such as whether the topic is visible to the helpseekers on help center or not etc.
  """
  properties: JSON @suppressValidationRule(rules : ["JSON"])
}

input HelpCenterDeleteFolderInput {
  folderAri: ID! @ARI(interpreted : false, owner : "help", type : "folder", usesActivationId : false)
  isDraft: Boolean! = false
}

"Identifies the single layout + locale whose translations should be removed."
input HelpCenterDeleteHubTranslationsInput {
  "Help center ARI the layout belongs to."
  helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
  "When true, the mutation writes to the draft copy instead of the live layout translations."
  isDraft: Boolean = false
  "BCP-47 locale to remove, e.g. `fr-FR`."
  locale: String!
  "Parent (layout/page) ARI the translations are scoped to."
  parentAri: ID! @ARI(interpreted : false, owner : "help", type : "page", usesActivationId : false)
}

input HelpCenterDeleteInput {
  "HelpCenterARI can be used to get the correct help center node"
  helpCenterAri: String! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
}

input HelpCenterDraftDiscardInput {
  "HelpCenterARI can be used to get the correct help center node"
  helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
}

input HelpCenterDraftPublishInput {
  "HelpCenterARI can be used to get the correct help center node"
  helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
}

input HelpCenterFilter {
  "When set, only return help centers whose auto-linking (sync new projects) state matches this value"
  autoLinkingEnabled: Boolean
  "Status to filter by. INACTIVE and SANDBOX are admin-only; defaults to ACTIVE."
  status: HelpCenterStatusFilter = ACTIVE
  type: HelpCenterType
}

input HelpCenterHomePageLayoutInput {
  "Adf Content"
  layoutAdf: String
  "Metadata for the page layout"
  metadata: String
}

input HelpCenterHomePageTitleInput {
  "Default name of the helpcenter."
  default: String!
  "Translations of title the helpcenter."
  translations: [HelpCenterTranslationInput]
}

input HelpCenterHubGoLiveHelpCenterInput {
  "ARI of the migrated help center to go-live (make live)"
  helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
}

"All translated blocks for a single locale, used by the multi-locale `setLayoutTranslations` form."
input HelpCenterHubLocaleAndTranslationsBlockInput {
  "Translations grouped by base block."
  blocks: [HelpCenterHubTranslationBlockInput!]!
  "BCP-47 locale these translations are for, e.g. `fr-FR`."
  locale: String!
}

input HelpCenterHubMigrateHelpCenterInput {
  "ARI of the source help center to migrate to a help hub"
  helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
}

"All translated fields for one base block, tagged with the block's `extensionType` for validation."
input HelpCenterHubTranslationBlockInput {
  "ADF extension type, e.g. `com.atlassian.confluence.spotlight`."
  extensionType: String!
  "Translated fields for this block."
  fields: [HelpCenterHubTranslationFieldInput!]!
  "Stable localId of the base block (extension) in the layout ADF."
  localId: ID!
}

"A single translated field: a path relative to the base block and the translated value."
input HelpCenterHubTranslationFieldInput {
  "Path relative to the base block, e.g. `content.text.title` or `cards.{cardId}.title`."
  fieldPath: String!
  "Translated text for the locale."
  value: String!
}

"The full set of translations for one layout + locale (replaces the locale's stored translations)."
input HelpCenterHubTranslationsInput {
  "Legacy single-locale form. Optional — the translated blocks for `locale`."
  blocks: [HelpCenterHubTranslationBlockInput!]
  "Help center ARI the layout belongs to."
  helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
  "When true, the mutation writes to the draft copy instead of the live layout translations."
  isDraft: Boolean = false
  "Legacy single-locale form. Optional — provide EITHER this (+ blocks) OR `translations`, not both. Kept for backward compatibility."
  locale: String
  "Parent (layout/page) ARI the translations are scoped to."
  parentAri: ID! @ARI(interpreted : false, owner : "help", type : "page", usesActivationId : false)
  "Multi-locale form: write several locales in one call (each entry replaces that locale's stored node). The FE includes the base/default locale here alongside others so every language always has a stored node."
  translations: [HelpCenterHubLocaleAndTranslationsBlockInput!]
}

input HelpCenterLogoInput {
  fileId: String
}

input HelpCenterMoveSiteTreeNodeInput {
  """
  Insert immediately before this sibling within destinationParentId.
  Null means append at the end. The sibling must currently belong to destinationParentId.
  """
  beforeSiblingId: ID
  """
  Destination folder id. Null means the invisible ROOT folder.
  For folder moves, this must be null (folders live only at root).
  """
  destinationParentId: ID @ARI(interpreted : false, owner : "help", type : "folder", usesActivationId : false)
  """
  ARI of the help center that owns the moved node.
  
  Required so the gateway can resolve which activation to route the request to. It derives that
  from the ARIs it can see, and every other id here can legitimately be absent or is polymorphic:
  destinationParentId is null whenever a node is moved to the root level, while siteTreeNodeId and
  beforeSiblingId may each be a folder or a page and so cannot carry a single-typed @ARI.
  
  This is not trusted for ownership. The server validates that the moved node, the destination and
  the sibling really do belong to this help center.
  """
  helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
  isDraft: Boolean! = false
  "The node being moved. Its type (folder / page) is derived from the id."
  siteTreeNodeId: ID!
}

input HelpCenterNameInput {
  "Default name of the helpcenter to be updated"
  default: String!
  "Translations of description the helpcenter."
  translations: [HelpCenterTranslationInput]
}

input HelpCenterNavigationBarInput {
  "Background color of the navigation bar"
  backgroundColor: String
  "Border color of the navigation bar"
  borderColor: String
  "Border type of the navigation bar"
  borderType: HelpCenterNavigationBarBorderType
  "Corner radius of the navigation bar"
  cornerRadius: Int
  "Navigation bar menus hidden for this help center"
  hiddenMenus: [HelpCenterNavMenuItemType!]
  "Whether to show padding around the navigation bar"
  padding: Boolean
  "Position type of the navigation bar"
  positionType: HelpCenterNavigationBarPositionType
  "Text color of the navigation bar"
  textColor: String
}

input HelpCenterPageCreateInput {
  "Ari of existing page, if page is being cloned"
  clonePageAri: String
  "Description of the help center page."
  description: String
  "helpCenterAri for the Help center under which page is being created"
  helpCenterAri: String! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
  """
  When true, this mutation creates a draft variant of the page instead of a live one.
  Defaults to false for backwards compatibility.
  """
  isDraft: Boolean = false
  "Name of the help center page."
  name: String!
  "Layout Input"
  pageLayout: HelpCenterPageLayoutInput
  """
  Type of the page to create. Defaults to CUSTOM when omitted.
  Only CUSTOM and TOPIC may be created: CUSTOM_HOME is seeded with the help center and PORTAL
  pages are derived from mapped projects. Ignored when clonePageAri is set, because a cloned page
  inherits the type of its source.
  """
  pageType: HelpCenterPageType
}

input HelpCenterPageDeleteInput {
  "HelpCenterARI can be used to get the correct help center node"
  helpCenterPageAri: String! @ARI(interpreted : false, owner : "help", type : "page", usesActivationId : false)
  """
  When true, this mutation deletes only the draft variant of the page, leaving the live version untouched.
  When the draft-mode feature flag is off, this argument is ignored and the standard delete-live behaviour applies.
  Defaults to false for backwards compatibility.
  """
  isDraft: Boolean = false
}

input HelpCenterPageLayoutInput {
  "Adf Content"
  layoutAdf: String
  "Metadata for the page layout"
  metadata: String
}

input HelpCenterPageUpdateInput {
  "Description of the help center page."
  description: String
  "helpCenterPageAri for the Help center page being updated"
  helpCenterPageAri: String! @ARI(interpreted : false, owner : "help", type : "page", usesActivationId : false)
  """
  When true, this mutation writes to the draft variant of the page instead of the live one.
  Defaults to false for backwards compatibility.
  """
  isDraft: Boolean = false
  "Name of the help center page."
  name: String!
  "Layout Input"
  pageLayout: HelpCenterPageLayoutInput
}

"The ids can be Help Center ARI or Page ARI"
input HelpCenterPagesFilter {
  ids: [ID!]!
  """
  When true, returns the raw base layout ADF WITHOUT applying the
  per-locale translation overlay.
  """
  isEditMode: Boolean = false
  """
  Deprecated no-op retained for backward compatibility until the FE stops
  sending it. Draft-vs-live page selection is now driven by the query-level
  isDraft argument, not this filter flag. Has no effect on the response.
  """
  sendDraftPages: Boolean = false
  type: HelpCenterPageType
}

