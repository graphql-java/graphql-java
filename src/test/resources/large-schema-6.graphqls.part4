"A list within a Trello Board"
type TrelloList implements Node @defaultHydration(batchSize : 50, field : "trello.listsById", idArgument : "ids", identifiedBy : "id", timeout : -1) {
  """
  The board the list belongs to
  
  
  This field is **deprecated** and will be removed in the future
  """
  board: TrelloBoard @rateLimit(cost : 50, currency : TRELLO_CURRENCY)
  "The board the list belongs to"
  boardOrInbox: TrelloBaseBoard @rateLimit(cost : 50, currency : TRELLO_CURRENCY)
  "The cards in the list, ordered by position ascending."
  cards(
    """
    The pointer to a place in the dataset (cursor). It’s used as the starting
    point for the next page. If not specified, the page will start from the very
    beginning of the dataset.
    """
    after: String,
    """
    Filters the list items. This inherits some visibility from the visibility of
    the list that contains it. Defaults to open cards.
    """
    filter: TrelloListCardFilterInput = {closed : false},
    "Number of items to retrieve after the given \"after\" cursor."
    first: Int = 20
  ): TrelloCardConnection @rateLimit(cost : 200, currency : TRELLO_CURRENCY)
  "True if the list has been closed. False otherwise."
  closed: Boolean!
