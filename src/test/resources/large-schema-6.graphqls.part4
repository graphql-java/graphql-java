input JsmAnalyticsInputOptions @renamed(from : "InputOptions") {
  timeZone: String!
}

"""
Input for the `insightSettings` query that populates the Insights settings panel.
`accountId` is intentionally not an argument — it is derived from the user-context
token on the request so a caller can only read their own settings.
"""
input JsmAnalyticsInsightSettingsQueryInput @renamed(from : "InsightSettingsQueryInput") {
  cloudId: ID! @CloudID(owner : "any")
  projectId: String!
  workspaceAri: ID! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
}

"""
`subjectType` and `subjectId` are optional informational echoes of the subject the
client thinks the configId points at. They are NOT cross-checked against the stored
row and are only used for logs/audit; `configId` is the ground truth.
"""
input JsmAnalyticsInsightSubjectStatusInput @renamed(from : "InsightSubjectStatusInput") {
  configId: ID!
  enabled: Boolean!
  subjectId: String
  subjectType: JsmAnalyticsInsightSubjectType
}

input JsmAnalyticsInsightsDetailInput @renamed(from : "InsightsDetailInput") {
  cloudId: ID! @CloudID(owner : "any")
  insightId: ID!
  isMock: Boolean
  options: JsmAnalyticsInputOptions!
  projectId: String!
  workspaceAri: ID! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
}

input JsmAnalyticsInsightsQueryInput @renamed(from : "InsightsQueryInput") {
  after: String
  cloudId: ID! @CloudID(owner : "any")
  direction: SortDirection
  first: Int = 20
  isMock: Boolean
  options: JsmAnalyticsInputOptions!
  projectId: String!
  workspaceAri: ID! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
}

input JsmAnalyticsRecordUserConsentInput @renamed(from : "RecordUserConsentInput") {
  cloudId: ID! @CloudID(owner : "any")
  projectId: String!
  workspaceAri: ID! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
}

"""
Exactly one of `enabled` or `subjects` must be set; a request that provides both or
neither is rejected with a `MutationError` and no row is written. The `configId` lookup
inside PATCH mode is scoped to the caller's `(cloudId, accountId, projectId)` and
`insightType`, derived from the user-context token; a mismatched row is treated the
same as not-found so existence is not leaked.
"""
input JsmAnalyticsUpdateInsightConfigInput @renamed(from : "UpdateInsightConfigInput") {
  cloudId: ID! @CloudID(owner : "any")
  enabled: Boolean
  insightType: JsmAnalyticsInsightType!
  projectId: String!
  subjects: [JsmAnalyticsInsightSubjectStatusInput!]
  workspaceAri: ID! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
}

