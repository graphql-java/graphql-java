"""
Columns / field sets to apply to a saved List view via jira_saveListViewConfig. Exactly one of the fields must be
supplied: replace/reset the whole set, or add/remove on top of the current columns.
"""
input JiraFieldSetsInput @oneOf {
  """
  Add and/or remove columns on top of the view's current columns (falling back to the view's default field sets when
  it has none).
  """
  fieldSetsUpdateInput: JiraFieldSetsUpdateInput
  "Replace or reset the view's whole column set (reuses the existing JiraFieldSetsMutationInput)."
  replaceFieldSetsInput: JiraFieldSetsMutationInput
}

input JiraFieldSetsMutationInput @oneOf {
  "Input object which contains the new fieldSets"
  replaceFieldSetsInput: JiraReplaceIssueSearchViewFieldSetsInput
  """
  Boolean which resets the fieldSets of a view to default fieldSets
  
  
  This field is **deprecated** and will be removed in the future
  """
  resetToDefaultFieldSets: Boolean
  "Resets the fieldSets of a view to default fieldSets for given fieldset context, the logic depends on the context provided."
  scopedResetToDefaultFieldSets: JiraScopedResetFieldsetsInput
}

"A list of field-set (column) node ids, used by JiraFieldSetsUpdateInput."
input JiraFieldSetsNodesInput {
  "The field-set ids."
  nodes: [String!]!
}

"""
Incremental add / remove of columns (field sets) for a saved List view, used by jira_saveListViewConfig. The new column
set is the view's current columns (or its default field sets when it has none), minus removeFieldSetsInput, plus
addFieldSetsInput (appended, de-duplicated).
"""
input JiraFieldSetsUpdateInput {
  "Field-set ids to add on top of the current columns. Already-present ids are ignored."
  addFieldSetsInput: JiraFieldSetsNodesInput
  "Field-set ids to remove from the current columns. Ids not present are ignored."
  removeFieldSetsInput: JiraFieldSetsNodesInput
}

