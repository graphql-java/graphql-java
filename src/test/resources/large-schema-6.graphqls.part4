  READ_ONLY
}

"""
How a directory item authenticates against the system it calls. Mirrors the MCP server auth
vocabulary (see McpAdminManagementMcpServerAuthType) so a single filter spans MCP servers,
MCP tools and actions.
"""
enum GraphIntegrationDirectoryAuthType @renamed(from : "DirectoryAuthType") {
  "An admin-supplied API token or key."
  API_TOKEN
  """
  2LO / client_credentials. An app-level token minted from stored client credentials; no user
  consent and no user in context is required.
  """
  CLIENT_CREDENTIALS
  "No credential is required to call the item."
  NONE
  """
  3LO / authorization_code. Requires per-user consent, so the item is unusable when there is
  no end user in context (e.g. an autonomous agent).
  """
  OAUTH
}

