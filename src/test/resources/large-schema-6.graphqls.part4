  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  createChatChannel(input: VirtualAgentCreateChatChannelInput!, virtualAgentConfigurationId: ID! @ARI(interpreted : false, owner : "virtual-agent", type : "configuration", usesActivationId : false)): VirtualAgentCreateChatChannelPayload
