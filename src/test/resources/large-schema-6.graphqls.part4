Input for updating an existing skill. At least one of name, description, categoryId, or category
must be provided. categoryId and category are mutually exclusive.
"""
input AgentWorkspaceSkillUpdateInput {
  "Optional input to create a new category and reattach the skill to it. Mutually exclusive with `categoryId`."
  category: AgentWorkspaceSkillCategoryCreateInput
  "Optional new category (by ARI) to reattach the skill to. Mutually exclusive with `category`."
  categoryId: ID @ARI(interpreted : false, owner : "jira-servicedesk", type : "skill-category", usesActivationId : false)
  "Optional new description. Omitted/null leaves the description unchanged. Empty string clears it."
  description: String
  "Optional new name for the skill. Trimmed; blank after trim is rejected. If omitted, name is unchanged."
  name: String
  "ARI of the skill being edited."
  skillId: ID! @ARI(interpreted : false, owner : "jira-servicedesk", type : "skill", usesActivationId : false)
}

"Input for paginating the per-ticket history rows of a smart-routing dry-run."
input AgentWorkspaceSmartRoutingDryRunTicketsInput {
  "Opaque cursor returned in `pageInfo.endCursor` of a prior page. Omit for the first page."
  after: String
  "The cloud ID of the Jira site."
  cloudId: ID! @CloudID(owner : "jira")
  """
  Maximum number of rows to scan in this page. Defaults to 50; capped server-side at 100. Note
  that this bounds the *scan*, not the *return* — when `labels` filters out some rows the page
  may contain fewer than `first` tickets.
  """
  first: Int
  """
  Optional outcome-label filter. Null or empty list = no filter (all labels returned). When
  provided, only rows whose label is in this set are returned; pagination still walks the full
  partition so a narrow filter can yield sparse pages.
  """
  labels: [AgentWorkspaceSmartRoutingRoutingOutcomeLabel!]
  "The Jira project key the run belongs to."
  projectKey: String!
  "The dry-run id (echoed back on `AgentWorkspaceSmartRoutingDryRun.runId`)."
  runId: ID!
}

"""
============================================
Bulk Import Inputs
============================================
"""
input AgentWorkspaceStartBulkImportInput {
  "Cloud ID (required)"
  cloudId: ID! @CloudID(owner : "jira")
  "The job ID returned from the upload endpoint (required)"
  jobId: ID!
  "Project ID (required)"
  projectId: ID!
}

"Input for starting an asynchronous routing-table generation job."
input AgentWorkspaceStartGenerateRoutingTableInput {
  "The cloud ID of the Jira site"
  cloudId: ID! @CloudID(owner : "jira")
  "Number of days of history to scan (default: 30)"
  days: Int
  """
  Optional draft session UUID. The worker tags every generated row with this id so the FE's
  draft-scoped reads / mutations stay isolated from any prior draft on the same project. When
  omitted, the BE skips the IDOR guard and behaves as a legacy single-draft call.
  """
  draftId: ID
  "Maximum number of issues to fetch (default: 5000)"
  maxIssues: Int
  "The Jira project key (e.g. ITSD)"
  projectKey: String!
  """
  Selected drafted rows for AI enrichment. Legacy `expectedVersion` values are accepted and ignored.
  Empty/omitted means "no services selected" — the worker completes the run with zero drafted rows.
  """
  selectedRows: [AgentWorkspaceSelectedRowVersion!]
  "The custom field ID for the service field used to bucket tickets (e.g. customfield_10054)"
  serviceFieldId: String!
  "The type of the service field as understood by the Jira routing-context API (e.g. \"select\", \"multiselect\"). Required."
  serviceFieldType: String!
}

"""
Input for `agentWorkspace_startGenerateRoutingTableV2`. Same shape as
`AgentWorkspaceStartGenerateRoutingTableInput` except `serviceFieldType` is the strongly-typed
`AgentWorkspaceSmartRoutingServiceFieldType` enum instead of a raw String — the GraphQL layer
rejects unknown values at the schema layer rather than the controller silently coercing them.
"""
input AgentWorkspaceStartGenerateRoutingTableInputV2 {
  "The cloud ID of the Jira site"
  cloudId: ID! @CloudID(owner : "jira")
  "Number of days of history to scan (default: 30)"
  days: Int
  """
  Optional draft session UUID. See `AgentWorkspaceStartGenerateRoutingTableInput.draftId`
  for the full semantics.
  """
  draftId: ID
  "Maximum number of issues to fetch (default: 5000)"
  maxIssues: Int
  "The Jira project key (e.g. ITSD)"
  projectKey: String!
  "Selected drafted rows for AI enrichment. Legacy `expectedVersion` values are accepted and ignored."
  selectedRows: [AgentWorkspaceSelectedRowVersion!]
  "The custom field ID for the service field used to bucket tickets (e.g. customfield_10054)"
  serviceFieldId: String!
  "Type of Jira custom field used as the routing service field."
  serviceFieldType: AgentWorkspaceSmartRoutingServiceFieldType!
}

"""
Input for `agentWorkspace_startGenerateTeamRoutingTable`, which generates routing-table draft
rows from teams connected to a project rather than service buckets.
"""
input AgentWorkspaceStartGenerateTeamRoutingTableInput {
  "The cloud ID of the Jira site"
  cloudId: ID! @CloudID(owner : "jira")
  "Draft session UUID to populate with generated team recommendations."
  draftId: ID!
  "Maximum number of historical issues sampled per team (default: 20)"
  maxIssues: Int
  "The Jira project key (e.g. ITSD)"
  projectKey: String!
  "Optional team ARIs to generate. Omit to use every team connected to the project."
  selectedTeamAris: [ID!]
}

"Input for starting a smart-routing dry-run statistics execution."
input AgentWorkspaceStartSmartRoutingDryRunInput {
  "The cloud ID of the Jira site."
  cloudId: ID! @CloudID(owner : "jira")
  "The Jira project key (e.g. ITSD) the dry-run will sample tickets from."
  projectKey: String!
  """
  Number of historical Done tickets to re-classify and label. Clamped to [20, 200] server-side;
  null defaults to 100. Each ticket costs one LLM classification, so larger values trade run
  duration + cost for tighter statistical confidence.
  """
  sampleSize: Int
}

"""
Input for submitting the drafted routing table. Promotes drafted entries to live
RoutingTableEntry, preserving each row's included flag, and updates SmartRoutingProjectConfig.
The legacy selectedServiceIds input is accepted and ignored.
"""
