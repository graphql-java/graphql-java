  message: String
}

"""
A subscription update event for a voice capture session. Each event is a
partial update carrying only the field that changed — the preview cards or the
transcript — with the other field null. Clients should ignore the null field
and merge the changed one into their existing state.
"""
type TrelloVoiceCaptureSessionUpdated implements TrelloStatefulSessionUpdated {
  """
  Represents which null fields in the update represent an actual
  null value, rather than representing no update.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  _deltas: [String!]
  """
  The latest preview cards proposed by the realtime model, when this event
  reflects a preview-card change. Null when only the transcript changed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  cards: TrelloVoiceCaptureSessionCardConnectionUpdated
  """
  Session-level errors emitted by the worker (for example when the session is
  expired before start because capacity was reached). Null when no error changed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  errors: [TrelloVoiceCaptureSessionError!]
  """
  The object ID of the session.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  objectId: ID!
  """
  The ARI of the session.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  sessionId: ID!
  """
  The full transcript accumulated so far, when this event reflects a transcript
  change. Null when only the preview cards changed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  transcript: String
}

