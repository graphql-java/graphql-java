  incidentId: ID! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  """
  The ids of the issues to link to an incident. This can be a JSW issue as an
  action item or a JSM issues as a post incident review.
  """
  issueIds: [ID!]! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
