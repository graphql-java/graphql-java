  REMEDIATION_STARTED
  REMEDIATION_SUPERSEDED
  REMEDIATION_WITHDRAWN
}

"Lifecycle status of a notification template version."
enum PsmNotificationTemplateStatus {
  ACTIVE
  INACTIVE
}

"Onboarding status"
enum PsmOnboardTenantStatus {
  CONFIGURATION_UPLOAD_SUCCESS
  FAILED
  INITIATED
  ONBOARDED
}

"Why an onboarding-status lookup could not be served."
enum PsmOnboardTenantStatusErrorCode {
