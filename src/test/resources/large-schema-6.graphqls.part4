"""
@deprecated Retired V1 AI drafts API. This input is kept only because the AGG object-type
change lock blocks removal for now; see https://hello.atlassian.net/wiki/x/9AaPrgE. Remove
once that lock is lifted.
"""
input GravityCreateDraftInput {
  ari: String!
  content: String!
  origin: GravityDraftOrigin
  """
  When true, atomically discards any existing active draft for the same (ari, type) before
  creating this one (the old draft is retained as DISCARDED history). When false or omitted,
  creation fails with ACTIVE_DRAFT_EXISTS if an active draft already exists.
  """
  replaceActive: Boolean
  type: String!
  """
  Actions to create together with the draft, in a single atomic call.
  Lets the AI produce a usable draft (content + actions) with one mutation / one confirmation.
  The per-item draftId and id are ignored; the new draft's id is authoritative and each action gets a fresh id.
  """
  upsertActions: [GravityUpsertActionInput!]
}

input GravityCreateSectionInput {
  """
  Jira project ARI or JPD collection ARI.
  Determines routing, permissions, limits, and initial navigation placement.
  """
  containerId: ID!
  name: String!
}

"Input for creating a view instance from an inline (client-provided) template definition."
input GravityCreateViewFromInlinedTemplateInput {
  "Optional override for the view name. Defaults to the template name if not provided."
  name: String
  "The project where the view will be created."
  projectId: ID!
  "Optional explicit field mappings. If omitted, the server applies the resolution strategy."
  refMappings: GravityRefMappingsInput
  """
  Strategy used to resolve template field references to concrete project fields.
  Defaults to MATCH_THEN_CREATE_IF_UNMAPPED.
  """
  refResolutionStrategy: GravityRefResolutionStrategy = MATCH_THEN_CREATE_IF_UNMAPPED
  "Optional ID of the section where the view will be created."
  sectionId: String
  "The inline template definition to instantiate."
  template: GravityViewTemplateInput!
}

"Input for creating a view instance from a server-side template by ID."
input GravityCreateViewFromTemplateInput {
  """
  Optional user locale as an RFC 5646 language tag (e.g. "fr-FR", "ja") used to localize the
  created view's name, description, and field names/descriptions. When omitted or unrecognized,
  English is used. The caller (the frontend) is responsible for supplying the user's preferred
  locale.
  """
  locale: String
  """
  Optional custom name for the created view.
  If not provided, uses the template's default view name.
  """
  name: String
  "The project where the view will be created."
  projectId: ID!
  """
  Explicit mapping from template references (fields) to concrete instances.
  Optional - if omitted, resolutionStrategy decides how to handle missing mappings.
  """
  refMappings: GravityRefMappingsInput
  """
  Strategy for resolving template references (fields) to concrete instances.
  Defaults to MATCH_THEN_CREATE_IF_UNMAPPED.
  """
  refResolutionStrategy: GravityRefResolutionStrategy = MATCH_THEN_CREATE_IF_UNMAPPED
  "Optional ID of the section where the view will be created."
  sectionId: String
  "The ID of the server-side template from which to create the view."
  templateId: ID
}

