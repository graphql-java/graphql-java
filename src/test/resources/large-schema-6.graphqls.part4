  "Filter by action type(s)"
  actions: [JsmChannelsOrchestratorConversationActionType!]
  "Filter by channel"
  channels: [JsmChannelsOrchestratorConversationChannel!]
  "Filter by csat score(s)"
  csatOptions: [JsmChannelsOrchestratorConversationCsatOptionType!]
  "The end date of a period to filter conversations"
  endDate: DateTime!
  "The start date of a period to filter conversations"
  startDate: DateTime!
  "Filter by state(s)"
  states: [JsmChannelsOrchestratorConversationState!]
}

