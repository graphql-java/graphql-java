"""
Input for the upsertDraftedRoutingTableEntry mutation. Used to update a single drafted
routing table row's data, its included/excluded flag, or both.
"""
input AgentWorkspaceUpsertDraftedRoutingTableEntryInput {
  "The Jira cloud ID."
  cloudId: ID! @CloudID(owner : "jira")
  "Draft session UUID this row belongs to. Optional — pre-draftId callers can omit, the BE falls back to the legacy (project, serviceFieldId) partition. When supplied, the BE rejects mismatched draftId↔projectId pairs with FORBIDDEN."
  draftId: ID
  """
  Deprecated legacy row version. Accepted and ignored.
  
  
  This field is **deprecated** and will be removed in the future
  """
  expectedVersion: Int
  """
  Optional: update the included/excluded state of this row. If omitted, existing value is
  kept (or `true` for new rows).
  """
  included: Boolean
  "The Jira project key."
  projectKey: String!
  """
  Optional: partial row data to update. Only fields present are updated (PATCH semantics).
  Either `row` or `included` (or both) must be specified.
  """
  row: AgentWorkspaceDraftedRoutingTableEntryPatch
  """
  The custom field id (e.g. `customfield_10054`) that this draft is being built against.
  Required because a project can host multiple parallel drafts (one per distinct field) and
  the row's identity is `(draftId, serviceId)`.
  """
  serviceFieldId: ID!
  "The stable service identifier (matches source field option id)."
  serviceId: ID!
}

