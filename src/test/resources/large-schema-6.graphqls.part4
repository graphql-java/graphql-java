The terminal outcome of a propose-planner-events job. Set once `status` is
FINISHED.
"""
enum TrelloProposePlannerEventsJobOutcome {
  """
  The job hit a fatal error. See `errors` for details. Clients should show
  a one-time message.
  """
  FAILED
  """
  The job ran successfully but found no cards to schedule. Clients should
  show a one-time message.
  """
  NO_CARDS
  """
  The job ran successfully and found cards but found no openings on the
  calendar.
  """
  NO_EVENTS
  "Proposals were generated and written to the member's planner."
  SUCCEEDED
}

