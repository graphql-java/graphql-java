"""
A card manifest represents a UI tree that can be rendered somewhere on the card.
Manifests are versioned according to the schema used to generate and render them.
The client is responsible for parsing the manifest contents according to the corresponding schema version.
That schema is NOT represented in GraphQL to allow it to evolve in incompatible ways over time.
"""
type TrelloCardManifest {
  """
  The contents of the manifest, representing the UI tree.
  This is deliberately typed as an opaque JSON blob, as it must be interpreted according to the corresponding schema
  version and rendered by clients.
  """
  contents: JSON @suppressValidationRule(rules : ["JSON"])
  """
  The major version of the schema this manifest supports.
  This is intentionally non-nullable, as without knowing the schema version, the manifest contents _cannot_ be
  interpreted safely, and thus access to the contents is useless.
  """
  schemaVersion: Int!
  "The source of the manifest, such as an LLM prompt."
  source: TrelloCardManifestSource
}

"Describes the user prompt and system prompt version used to generate a manifest."
type TrelloCardManifestPromptSource {
  "The original user prompt provided to generate the parent manifest."
  prompt: String
  """
  The version of the system prompt the user prompt was paired with.
  This field has been deprecated and should not be relied upon.
  
  
  This field is **deprecated** and will be removed in the future
  """
  version: Int
}

"Describes an unknown source used to generate a manifest."
type TrelloCardManifestUnknownSource {
  " eslint-disable-next-line @graphql-eslint/naming-convention"
  _empty: String
}

