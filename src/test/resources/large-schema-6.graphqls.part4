"""
Input for `agentWorkspace_assignAgentToGap`. Identifies the schedule
occurrence by `(scheduleId, occurrenceStartTime, gapOwnerAgentId)` and writes
a covering segment for `assignedAgentId` over `(startTime, endTime)`; the
back-end intersects that range against the occurrence's uncovered windows.
"""
input AgentWorkspaceAssignAgentToGapInput {
  assignedAgentId: ID!
  endTime: DateTime!
  gapOwnerAgentId: ID!
  occurrenceStartTime: DateTime!
  projectARI: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  scheduleId: ID!
  startTime: DateTime!
}

