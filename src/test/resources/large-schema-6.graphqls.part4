  newTicketsByTeam: [AgentWorkspacePendingTicketsByTeamInput!]!
  "Tickets that would be removed from this agent, grouped by team. Null team means unmapped."
  removedTicketsByTeam: [AgentWorkspacePendingTicketsByTeamInput!]!
}

input AgentWorkspacePendingTicketsByTeamInput {
