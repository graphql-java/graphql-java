"The input for choosing invocations of interest."
input LogQueryInput {
  """
  Limits the search to a particular version of the app.
  Optional: if empty will search all versions of the app
  """
  appVersion: String
  """
  Limits the search to a list of versions of the app.
  Optional: if empty will search all versions of the app
  """
  appVersions: [String]
  """
  Filters frontend (UI) logs by browser name (e.g. "Chrome").
  Optional: if empty will search all browsers.
  """
  browserName: String
  "Filters logs by container name. Use `containers` field instead."
  container: String
  """
  Filters logs by container name.
  Optional: if empty then look for all the logs
  """
  containers: [String]
  """
  Filters logs by products.
  Optional: if empty then look for all the logs
  """
  contexts: [Context]
  """
  Limits the search to a particular date range.
  
  Note: Logs may have a TTL on them so older logs may not be available
  despite search parameters.
  """
  dates: DateSearchInput
  """
  Filters logs by edition.
  Optional: if empty will search all editions types.
  """
  editions: [EditionValue]
  """
  Filters frontend (UI) logs by error type (e.g. "TypeError").
  Optional: if empty will search all error types.
  """
  errorType: String
  """
  Filters frontend (UI) logs by extension type (e.g. "confluence:globalPage").
  Optional: if empty will search all extension types.
  """
  extensionType: String
  """
  Limits the search to a particular function in the app.
  Optional: if empty will search all functions.
  """
  functionKey: String
  """
  Limits the search to a particular functionKeys of the app.
  Optional: if empty will search all functionKeys of the app
  """
  functionKeys: [String]
  """
  Specify which installations you want to search.
  Optional: if empty will search all installations user has access to.
  """
  installationContexts: [ID!]
  """
  Filters logs by installation id.
  Optional: if empty will search all installations.
  """
  installationId: String
  "Filters logs by container instance. Use `instances` field instead."
  instance: String
  """
  Filters logs by container instance.
  Optional: if empty then look for all the logs
  """
  instances: [String]
  """
  Filters logs by a specific invocation ID.
  Optional: if empty will search all invocation IDs.
  """
  invocationId: String
  """
  Indicates that this query originated from Admin Hub. Admin Hub queries exclude
  logs without an installation context.
  """
  isAdminHub: Boolean
  """
  Filters logs by license state.
  Optional: if empty will search all licenseState types.
  """
  licenseStates: [LicenseValue]
  """
  Filters frontend (UI) logs by log source (e.g. CONSOLE, UNCAUGHT_EXCEPTION, UNHANDLED_REJECTION).
  Optional: if empty will search all log sources.
  """
  logSource: FrontendLogSource
  """
  Limits the search to a particular log level type of message.
  Optional: if empty will search all log levels
  """
  lvl: [String]
  """
  Filters logs by module type.
  Optional: if empty will search all module types.
  """
  moduleType: String
  """
  Searches all logs matching the search input from user.
  Optional: if empty will search all logs
  """
  msg: String
  "Filters logs by organization id. Applies to any log (backend or frontend) that carries this attribute."
  orgId: String
  """
  Filters logs by any of the supplied organization ids. Applies to any log (backend or frontend) that carries this
  attribute.
  """
  orgIds: [String!]
  """
  Filters frontend (UI) logs by operating system name (e.g. "Mac OS X").
  Optional: if empty will search all operating systems.
  """
  osName: String
  """
  Filters logs by container placement.
  Optional: if empty then look for all the logs
  """
  placements: [String]
  """
  Filters frontend (UI) logs by render type (e.g. "ui-kit").
  Optional: if empty will search all render types.
  """
  renderType: String
  """
  Filters logs by runtime (node runtime, containers, etc)
  Optional: if empty will search all runtimes.
  """
  runtime: String
  """
  Filters logs by one or more runtimes.
  Optional: if empty will search all runtimes.
  """
  runtimes: [String!]
  "Filters logs by container service. Use `services` field instead."
  service: String
  """
  Filters logs by container service.
  Optional: if empty then look for all the logs
  """
  services: [String]
  """
  Filters logs by a specific trace ID.
  Optional: if empty will search all trace IDs.
  """
  traceId: String
  "Filters logs by unit id. Applies to any log (backend or frontend) that carries this attribute."
  unitId: String
  """
  Filters logs by any of the supplied unit ids. Applies to any log (backend or frontend) that carries this
  attribute.
  """
  unitIds: [String!]
}

