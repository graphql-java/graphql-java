input AVPCreateChartCommentThreadInput {
  "ARI of the chart to start the thread on."
  chartAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard-chart", usesActivationId : false)
  """
  Contextual metadata for the first comment, as a JSON object: `filterData`, an object holding the
  chart's applied filter values, and optionally `cacheKey`, a string or null.
  """
  context: JSON! @suppressValidationRule(rules : ["JSON"])
  """
  Body of the thread's first comment, as an Atlassian Document Format (ADF) document: a JSON object
  with `type` "doc", `version` 1 and a `content` array of ADF nodes. A message that is not a valid ADF
  document is rejected.
  """
  message: JSON! @suppressValidationRule(rules : ["JSON"])
}

input AVPCreateChartInput {
  """
  The ID of the canvas element slot in which to create the new chart.
  If null, then the chart will be added to the first empty element on the dashboard.
  If there are no empty elements, then the chart will be added to a new row on the dashboard.
  """
  canvasElementId: ID
  chart: AVPChartInput!
  "The ARI of the dashboard on which to create the new chart"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
}

"""
Input for avp_createCharts. All charts in `charts` are created on the same
dashboard, with a single permission check, a single canvas-layout write, and
a single batched ERS write for the surviving items.

The current request-body cap is 1 MB; clients with very large per-chart
payloads should reduce the batch size accordingly. The hard server-side
upper bound on `charts.length` is 25.
"""
input AVPCreateChartsInput {
  "Charts to create. Must contain between 1 and 25 items (inclusive); larger batches are rejected with BAD_REQUEST."
  charts: [AVPCreateChartsItemInput!]!
  "The ARI of the dashboard on which to create the new charts."
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
}

"""
A single chart to create as part of an avp_createCharts batch. Each item is
processed independently against the same dashboard; per-item validation
failures are surfaced in AVPCreateChartsItemResult and do not fail the whole
call.
"""
input AVPCreateChartsItemInput {
  """
  The ID of the canvas element slot in which to create the new chart.
  If null, the chart will be added to the first empty element on the dashboard.
  If there are no empty elements, the chart will be added to a new row.
  Slot assignment is computed left-to-right over the input list; two items
  with the same `canvasElementId` will conflict (the second loses the slot).
  """
  canvasElementId: ID
  "The chart definition to create. Env-var charts are not supported in batch mode."
  chart: AVPChartInput!
  """
  Client-supplied idempotency key, echoed back on the corresponding
  AVPCreateChartsItemResult. Must be unique within the batch.
  """
  idempotencyKey: String!
}

input AVPCreateCommentInput {
  """
  Contextual metadata for the comment, as a JSON object: `filterData`, an object holding the chart's
  applied filter values, and optionally `cacheKey`, a string or null.
  """
  context: JSON! @suppressValidationRule(rules : ["JSON"])
  """
  Body of the comment, as an Atlassian Document Format (ADF) document: a JSON object with `type`
  "doc", `version` 1 and a `content` array of ADF nodes. A message that is not a valid ADF document is
  rejected.
  """
  message: JSON! @suppressValidationRule(rules : ["JSON"])
  "ARI of the thread to add the comment to."
  threadAri: ID! @ARI(interpreted : false, owner : "avp", type : "comment-thread", usesActivationId : false)
}

input AVPCreateCustomTemplateInput {
  "ARI of the dashboard to publish as a template. Also supplies the cloudId and activationId used for gating and shard routing."
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Which data source the template's charts read from. Used as the gallery filter."
  datasourceType: AVPTemplateDatasourceType!
  "Description for the new template. Required — the metadata row rejects a blank description."
  description: String!
  "How much scrubbing to apply when exporting the body. Defaults to PLATFORM, which strips tenant workspace ids from hot-tier locators."
  exportType: AVPExportTemplateType
  "The static thumbnail image to show on the template's gallery card."
  thumbnail: AVPTemplateThumbnail!
  "Title for the new template. Required — the metadata row rejects a blank title."
  title: String!
}

input AVPCreateDashboardFilterInput {
  "The ARI of the dashboard on which to create the new filter"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "The filter configuration to create a dashboard-level filter"
  filter: AVPDashboardFilterInput!
}

input AVPCreateDashboardFromCustomTemplateInput {
  cloudId: ID! @CloudID(owner : "any")
  " the container where the dashboard lives, e.g. a Jira project."
  containerAri: ID @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  "The permissions configuration for the dashboard, defaults to MANAGE"
  dashboardPermissionType: AVPDashboardPermissionType
  " identifier of the AVP consumer which owns the dashboard, e.g. for limiting the dashboard list to relevant dashboards."
  integrationId: AVPIntegrationId
  "BCP 47 locale tag (e.g. 'ja', 'de-DE') for translating dashboard and chart titles/descriptions. Falls back to English when omitted or when no translation is available."
  locale: String
  "The custom template to create the dashboard from, as returned by avp_getCustomTemplates."
  templateId: ID!
  "The workspace ARI of the consumer product (e.g. ari:cloud:townsquare:{cloudId}:workspace/{workspaceId}) used as the ERS partition key for shard routing."
  workspaceAri: ID! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
}

input AVPCreateDashboardFromJSONInput {
  cloudId: ID! @CloudID(owner : "any")
  " the container where the dashboard lives, e.g. a Jira project."
  containerAri: ID @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  "The permissions configuration for the dashboard, defaults to MANAGE"
  dashboardPermissionType: AVPDashboardPermissionType
  "The full dashboard body as a JSON string — the same shape produced by avp_getDashboardTemplateJson/avp_getDashboardTemplate."
  dashboardTemplateJson: String!
  " identifier of the AVP consumer which owns the dashboard, e.g. for limiting the dashboard list to relevant dashboards."
  integrationId: AVPIntegrationId
  "BCP 47 locale tag (e.g. 'ja', 'de-DE') for translating dashboard and chart titles/descriptions found in the JSON body. Falls back to English when omitted or when no translation is available."
  locale: String
  "The workspace ARI of the consumer product (e.g. ari:cloud:townsquare:{cloudId}:workspace/{workspaceId}) used as the ERS partition key for shard routing. When provided, it is used directly as the contextAriId, bypassing TCS lookup. Falls back to workspaceId if not provided."
  workspaceAri: ID @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
  """
  The workspace ID (activation ID). Deprecated — use workspaceAri instead for correct shard routing.
  
  
  This field is **deprecated** and will be removed in the future
  """
  workspaceId: ID
}

input AVPCreateDashboardFromTemplateInput {
  cloudId: ID! @CloudID(owner : "any")
  dashboard: AVPDashboardTemplateInput!
  "The permissions configuration for the dashboard, defaults to MANAGE"
  dashboardPermissionType: AVPDashboardPermissionType
  "BCP 47 locale tag (e.g. 'ja', 'de-DE') for translating dashboard and chart titles/descriptions when creating from a template. Falls back to English when omitted or when no translation is available."
  locale: String
  "The workspace ARI of the consumer product (e.g. ari:cloud:townsquare:{cloudId}:workspace/{workspaceId}) used as the ERS partition key for shard routing. When provided, it is used directly as the contextAriId, bypassing TCS lookup. Falls back to workspaceId if not provided."
  workspaceAri: ID @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
  """
  The workspace ID (activation ID). Deprecated — use workspaceAri instead for correct shard routing.
  
  
  This field is **deprecated** and will be removed in the future
  """
  workspaceId: ID
}

input AVPCreateDashboardInput {
  cloudId: ID! @CloudID(owner : "any")
  " the container where the dashboard lives, e.g. a Jira project."
  containerAri: ID @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  dashboard: AVPDashboardInput!
  "The permissions configuration for the dashboard, defaults to MANAGE"
  dashboardPermissionType: AVPDashboardPermissionType
  " identifier of the AVP consumer which owns the dashboard, e.g. for limiting the dashboard list to relevant dashboards."
  integrationId: AVPIntegrationId
  "BCP 47 locale tag (e.g. 'ja', 'de-DE') for translating the default title given to a dashboard created without one. Falls back to English when omitted or when no translation is available."
  locale: String
  "The workspace ARI of the consumer product (e.g. ari:cloud:townsquare:{cloudId}:workspace/{workspaceId}) used as the ERS partition key for shard routing. When provided, it is used directly as the contextAriId, bypassing TCS lookup. Falls back to workspaceId if not provided."
  workspaceAri: ID @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
  """
  The workspace ID (activation ID). Deprecated — use workspaceAri instead for correct shard routing.
  
  
  This field is **deprecated** and will be removed in the future
  """
  workspaceId: ID
}

input AVPCreateStandaloneChartInput {
  chart: AVPChartInput!
  cloudId: ID! @CloudID(owner : "any")
  "The container where the dashboard wrapper lives, e.g. a Jira project."
  containerAri: ID @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  "Identifier of the AVP consumer which owns the dashboard wrapper, e.g. for limiting the dashboard list to relevant dashboards. When enabled for the tenant, this endpoint writes ROVO_CHAT instead."
  integrationId: AVPIntegrationId
  "The Rovo workspace ARI (e.g. ari:cloud:rovo::workspace/{activationId}) used as the ERS partition key for shard routing. When provided, it is used directly as the contextAriId, bypassing TCS lookup. Falls back to workspaceId or Rovo activation lookup if not provided."
  workspaceAri: ID @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
  """
  The workspace ID (activation ID). Deprecated — use workspaceAri instead for correct shard routing.
  
  
  This field is **deprecated** and will be removed in the future
  """
  workspaceId: ID
}

"""
Configuration for creating a dashboard-level variable. Unlike a filter, the env var representing
the variable does not have its own chart.
When a variable is created, no charts are auto-updated with the value; we currently only support
BYOD platform which requires external handling of connecting the variable to charts.
"""
input AVPCreateVariableInput {
  "The ARI of the dashboard which should have the new variable"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "The data configuration to create a dashboard-level variable"
  variable: AVPVariableInput!
}

"Filter configuration for creating a dashboard-level filter, made up of an env var and a chart"
input AVPDashboardFilterInput {
  "The type of filter to create; must be one of the values in EnvVarChartType"
  chartType: String
  "The default values of the filter"
  defaultValues: [String]
  "A single object that contains the Hot Tier product context (e.g., jira, devops); this data will be stored in an array on the EnvVar"
  hotTierFilterConfig: AVPHotTierFilterConfigInput
  "Filter metadata as a JSON string, used by BYOD filters."
  metadata: String
  "The name of the filter, unique within the dashboard"
  name: String
}

input AVPDashboardInput {
  category: String
  description: String
  settings: AVPDashboardSettingsInput
  title: String
  "The layout type of the dashboard. SIMPLE for canvas layout dashboards, ADVANCED for grid layout dashboards (legacy AA dashboards). Defaults to SIMPLE when omitted."
  type: AVPDashboardType
}

"""
A single principal's desired access level for a dashboard.
Supports both user ARIs (ari:cloud:identity::user/<uuid>) and group ARIs (ari:cloud:identity::group/<uuid>).
"""
input AVPDashboardPrincipalAccessInput {
  "The desired access level for this principal"
  accessLevel: AVPDashboardIdentityAccessLevel!
  "The ARI of the principal — either a user or a group"
  principalAri: ID!
}

input AVPDashboardSettingsInput {
  "If true, convert dates and times to viewer's local time zone"
  allowTzOverride: Boolean
  "If true, show UI elements allowing the user to refresh one or more charts"
  allowViewerRefresh: Boolean
  "If true, automatically update dashboard when a control's value changes"
  autoApplyVars: Boolean
  "Chart data refresh interval, in seconds"
  autoRefreshInterval: Int
  "How long dashboard data should be considered up to date, in seconds"
  cacheDuration: Int
  "Per-source global config (e.g. Ops business hours/days) applied to the dashboard's metrics"
  productSettings: AVPProductSettingsInput
  "Method of refreshing dashboard data automatically"
  refreshMethod: AVPRefreshMethod
  "If true, users can create email subscriptions for this dashboard"
  subscriptionsEnabled: Boolean
  "The configured timezone of the dashboard"
  timezone: String
}

input AVPDashboardTemplateInput {
  " the container where the dashboard lives, e.g. a Jira project."
  containerAri: ID @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  fromTemplate: String!
  " identifier of the AVP consumer which owns the dashboard, e.g. for limiting the dashboard list to relevant dashboards."
  integrationId: AVPIntegrationId
  productWorkspaceList: [AVPProductWorkspaceMapEntry!]
  " template placeholder replacements mapping placeholder names to their replacement values (ARIs)"
  templatePlaceholderReplacements: [AVPTemplatePlaceholderReplacement!]
  templateVersion: Int
}

"""
A single user's desired access level for a dashboard.
@deprecated Use AVPDashboardPrincipalAccessInput instead, which supports both users and groups.
"""
input AVPDashboardUserAccessInput {
  "The desired access level for this user"
  accessLevel: AVPDashboardIdentityAccessLevel!
  "The ARI of the user (e.g. ari:cloud:identity::user/<uuid>)"
  principalAri: ID! @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
}

"Data source locator configuration"
input AVPDatasourceLocatorInput {
  datasourceId: String
  "Type of data source (e.g., HotTier)"
  dstype: String!
  "Workspace identifier"
  workspaceId: String!
}

input AVPDeleteChartInput {
  "The ARI of the chart to delete"
  chartAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard-chart", usesActivationId : false)
  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
}

input AVPDeleteCommentInput {
  "ARI of the comment to delete."
  commentAri: ID! @ARI(interpreted : false, owner : "avp", type : "comment", usesActivationId : false)
}

input AVPDeleteCustomTemplateInput {
  "Identifies the template to delete. A custom template's id is the dashboard's own id, so this also supplies the cloudId and activationId used for gating and shard routing."
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
}

"Filter configuration for deleting a dashboard-level filter"
input AVPDeleteDashboardFilterInput {
  "The ARI of the dashboard on which to delete the filter"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "The name of the filter to delete, unique within the dashboard"
  name: String!
}

"""
Input type for deleting filter expressions from the tree.
Supports deleting single or multiple expressions.
"""
input AVPDeleteFilterExpressionsInput {
  "Dashboard ARI"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "IDs of expressions to delete (can be groups or filters)"
  expressionIds: [ID!]!
  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
}

"Input for deleting a dashboard-level variable."
input AVPDeleteVariableInput {
  "The ARI of the dashboard on which to delete the variable"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "The name of the variable to delete, unique within the dashboard"
  name: String!
}

"Input for external resource associated with a chart"
input AVPExternalResourceInput {
  "Cloud ID associated with the external resource. Ignored when the tenant-context gate is off."
  cloudId: String
  "The external resource provider"
  provider: AVPExternalResourceProvider!
  "UUID for the resource within the provider"
  resourceId: ID!
  "Workspace ID associated with the external resource. Ignored when the tenant-context gate is off."
  workspaceId: String
}

input AVPFilterEnvVarInput {
  "The default values (optional - only include if updating)"
  defaultValues: [String]
  "The ID of the env var (optional - can use name for identification instead)"
  id: ID
  "Filter metadata as a JSON string (optional - only include if updating)"
  metadata: String
  "The name of the env var (required for identification if ID not provided)"
  name: String
}

"Input for a child of an updated filter group."
input AVPFilterExpressionChildUpdateInput @oneOf {
  "Filter-specific updates"
  filter: AVPPlatformFilterChildUpdateInput
  "Group-specific updates"
  group: AVPFilterGroupChildUpdateInput
}

"Union-like input type for filter expression nodes."
input AVPFilterExpressionInput @oneOf {
  "Platform filter input (leaf node)"
  filter: AVPPlatformFilterInput
  "Filter group input (branch node)"
  group: AVPFilterGroupInput
}

input AVPFilterExpressionUpdateInput @oneOf {
  "Filter-specific updates (only if updating a filter)"
  filter: AVPPlatformFilterUpdateInput
  "Group-specific updates (only if updating a group)"
  group: AVPFilterGroupUpdateInput
}

"""
Input for a group child. An ID preserves and updates an existing direct child; omitting it creates a
new child.
"""
input AVPFilterGroupChildUpdateInput {
  "New child nodes, replaces existing if provided"
  groups: [AVPFilterExpressionChildUpdateInput!]
  "Existing direct child ID"
  id: ID
  "New metadata"
  metadata: String
  "New operator"
  operator: AVPFilterOperator
}

"Input for a filter group node."
input AVPFilterGroupInput {
  "Child nodes"
  groups: [AVPFilterExpressionInput!]!
  "Optional pre-generated ID for the filter group. Generated server-side if omitted."
  id: ID
  "Optional metadata"
  metadata: String
  "Operator for combining child nodes"
  operator: AVPFilterOperator!
}

"Input for updating a filter group (merge semantics)."
input AVPFilterGroupUpdateInput {
  "New child nodes, replaces existing if provided"
  groups: [AVPFilterExpressionChildUpdateInput!]
  "New metadata"
  metadata: String
  "New operator"
  operator: AVPFilterOperator
}

"Extension context for a Forge Context Token request. Fields are whitelisted before signing."
input AVPForgeExtensionContextInput {
  "The dashboard id — must match the dashboard ARI in the enclosing input."
  dashboardId: ID!
  "The widget/chart id, if the token is scoped to a specific widget."
  widgetId: ID
}

"The extensionData describing the Forge module the token is being minted for."
input AVPForgeExtensionDataInput {
  "The extension context (dashboard/widget the module renders in)."
  context: AVPForgeExtensionContextInput!
  "If `edit`, the caller must have edit access to the dashboard."
  entryPoint: String
  "The Forge module type. Must be `dashboards:widget`, `dashboards:backgroundScript`, or `dashboards:filter`."
  type: String!
}

"""
Input for querying dashboard identity access details.
Allows filtering by permission levels, including/excluding groups, and direct vs inherited access.
Mirrors the shape of `AVPPermissionsGetDashboardIdentityAccessInput` (with `dashboardId`
renamed to `dashboardAri` to follow the dashboards-service ARI naming convention).
"""
input AVPGetDashboardIdentityAccessInput {
  "The ARI of the dashboard"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Whether to only include direct access assignments (not inherited). If not specified, defaults to false."
  directAccess: Boolean
  "Whether to include groups in the results. If not specified, defaults to true."
  includeGroups: Boolean
  "Which permission levels to retrieve. If not specified, returns all levels (READ, WRITE, MANAGE)."
  permissions: [AVPDashboardIdentityAccessLevel!]
}

"Input for querying the resource-level (open-access) permission record for a dashboard."
input AVPGetDashboardResourcePermissionInput {
  "The ARI of the dashboard"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
}

input AVPGetDashboardTemplatesInput {
  cloudId: ID! @CloudID(owner : "any")
  "BCP 47 locale tag (e.g. 'ja', 'de-DE') for translating template titles and descriptions. Falls back to English when omitted or when no translation is available for the requested locale."
  locale: String
  "optional filter to only return templates for a specific product, e.g. `jira`, `confluence`"
  productKey: String
  "The workspace ARI of the consumer product (e.g. ari:cloud:townsquare:{cloudId}:workspace/{workspaceId}) used as the ERS partition key for shard routing. When provided, it is used directly as the contextAriId, bypassing TCS lookup. Falls back to workspaceId if not provided."
  workspaceAri: ID @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
  """
  The workspace ID (activation ID). Deprecated — use workspaceAri instead for correct shard routing.
  
  
  This field is **deprecated** and will be removed in the future
  """
  workspaceId: ID
}

"Input for `avp_getJiraDashboardMigrationStatus`."
input AVPGetJiraDashboardMigrationStatusInput {
  cloudId: ID! @CloudID(owner : "any")
  "The source Jira Dashboard ID (e.g. 10000)"
  jiraDashboardId: ID!
  "The Jira workspace ARI (e.g. ari:cloud:jira:{siteId}:workspace/{activationId})"
  workspaceAri: ID! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
}

input AVPGetReadOnlyDashboardInput {
  cloudId: ID! @CloudID(owner : "any")
  "Optional integration ID used for permission checks, e.g. JSM_ASSETS."
  integrationId: AVPIntegrationId
  "Optional product-to-workspaceId mappings for hot-tier dashboards."
  productWorkspaceList: [AVPProductWorkspaceMapEntry!]
  "The template identifier used to provision this dashboard, e.g. `jira_summary_page`."
  templateId: String!
  "The hosting product workspace ARI (e.g. ari:cloud:jira:{siteId}:workspace/{activationId}) used for PMR shard routing. This is used directly as the ERS partition key, bypassing TCS lookup."
  workspaceAri: ID! @ARI(interpreted : false, owner : "any", type : "workspace", usesActivationId : true)
}

"The Hot Tier product context (e.g., jira, devops) to represent the filter data source; data will be stored in an array on the EnvVar"
input AVPHotTierFilterConfigInput {
  datasourceLocator: AVPDatasourceLocatorInput
  dimension: String
  product: String
  semanticModel: String
}

"""
Tagged-union input for the JQL source backing a metrics query. Currently only the
FILTER_ID variant is accepted; `filterId` must be set when `type == FILTER_ID`.
"""
input AVPJqlSourceInput {
  "Required iff `type` == FILTER_ID."
  filterId: ID
  "Discriminator selecting which scalar must be set."
  type: AVPJqlSourceType!
}

input AVPMarkCommentThreadAsReadInput {
  "ARI of the thread to mark as read."
  threadAri: ID! @ARI(interpreted : false, owner : "avp", type : "comment-thread", usesActivationId : false)
}

"""
The search terms, filters and sort for one merged directory page. Mirrors the query params of Jira's
GET /rest/api/2/dashboard/search, so a client can pass what it already passes Jira.
"""
input AVPMergedDashboardDirectoryInput {
  """
  Match rows this account owns. An AVP row has no owner, so it matches when the account is named by one of
  the row's edit grants — the nearest thing an AVP dashboard has to an owner is whoever manages it.
  """
  accountId: String
  """
  Read the page starting at this cursor, taken from a previous page's `selfCursor` or `nextCursor`. Omit for
  the first page. A cursor expires an hour after it was issued, after which the first page is served instead.
  """
  afterCursor: String
  """
  Read the page ending at this cursor, taken from a previous page's `selfCursor`. Pass this or `afterCursor`, not
  both.
  """
  beforeCursor: String
  "Match rows whose name contains every whitespace-separated term, ignoring case."
  dashboardName: String
  "Which way to sort. Defaults to ascending, as Jira's directory does."
  direction: AVPMergedDirectorySortDirection! = ASC
  """
  Match rows shared with this group, by id. This is what the AVP source filters on, its group grants carrying
  the id rather than the name. Pass it alongside `groupName` — a group picker holds both — or AVP rows are
  dropped from a group-filtered listing.
  """
  groupId: String
  """
  Match rows shared with this group, by name. Jira's directory filters on the name, so this is what the Jira
  source passes upstream. An AVP row's group grant carries only the group id, so pass `groupId` as well or no
  AVP row can match.
  """
  groupName: String
  "How many rows the page holds, from 1 to 100. Defaults to 25."
  maxResults: Int! = 25
  "Which column to sort on. Jira's owner sort is not supported: an AVP row reports no owner to sort by."
  orderBy: AVPMergedDirectorySortField! = NAME
  "Match rows shared with this Jira project id."
  projectId: Int
}

"Dimension configuration for metrics"
input AVPMetricsConfigurationDimensionInput {
  "Name of the dimension"
  name: String!
  "Optional output configuration for this dimension"
  outputOptions: AVPMetricsDimensionOutputOptionsInput
  "Type of dimension (e.g., categorical, temporal)"
  type: String!
}

"Filter configuration for metrics"
input AVPMetricsConfigurationFilterInput {
  "Comparison operator"
  comparison: String!
  "Dimension to filter on"
  dimension: String!
  "Values to filter by"
  operands: [String!]!
  "Product context (e.g., jira, devops)"
  product: String!
  "Whether null values should be included in the filter"
  withNullValue: Boolean
}

"Metrics-based query configuration"
input AVPMetricsConfigurationInput {
  "Metric dimensions configuration"
  dimensions: [AVPMetricsConfigurationDimensionInput!]
  "Metric filters configuration"
  filters: [AVPMetricsConfigurationFilterInput!]
  "Granularity for time-based metrics"
  granularity: String
  "Composed grouped filter for Metrics API queries"
  groupedFilter: JSON @suppressValidationRule(rules : ["JSON"])
  """
  Tagged-union JQL source for Jira-backed metrics queries. Null for non-Jira charts.
  Currently only the FILTER_ID variant is accepted; `filterId` is required when set.
  """
  jqlSource: AVPJqlSourceInput
  "List of metrics to query"
  metrics: [String!]
  "Search conditions for metrics"
  searchCondition: String
  "Workspace ID for metrics context"
  workspaceId: String
}

"Output configuration for a metrics dimension"
input AVPMetricsDimensionOutputOptionsInput {
  "Time bucketing for this dimension"
