  "If true, indicates this is a board template or false if it's a typical board"
  isTemplate: Boolean
  "The board's visibility."
  permissionLevel: TrelloBoardPrefsPermissionLevel = PRIVATE
  "If true, allows a workspace member to add themselves to the board"
  selfJoin: Boolean
  "If true, show the new 'done state' UI on the board"
  showCompleteStatus: Boolean
  "The group level who has permissions to vote on cards"
  voting: TrelloBoardVotingPermissions = DISABLED
}

