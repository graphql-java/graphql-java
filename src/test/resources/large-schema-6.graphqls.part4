"""
Nested category input accepted by vertical instantiation update.
If `id` is provided, the category should be treated as an update.
If `id` is omitted, the category should be treated as a create.
Category processing is async-only for now.
"""
input AssetsVerticalVerticalInstantiationCategoryWithSelectionsInput {
  "Optional asset type selections. When provided, processing is handled asynchronously."
  assetTypes: [AssetsVerticalAssetTypeSelectionInput!]
  "The category type to create or update."
  category: AssetsVerticalVerticalInstantiationCategoryType!
  "Optional existing category identifier; omit to signal create."
  id: ID
  """
  Optional metadata field. For SPACE_CREATION this carries the space details: `spaceName`
  (human-readable name) and `spaceKey` (project key, e.g. "ITAM9"), both required. The Jira project
  `templateKey` is NOT accepted here — it is derived server-side from the vertical type.
  """
  metadata: [AssetsVerticalKeyValueInput!]
  "Optional role assignments. Used when category = USER_ROLES_ASSIGNMENT. verticalType is inferred from the parent VerticalInstantiation."
  roles: [AssetsVerticalRoleAssignmentEntryInput!]
}

"Input for initialising a category inline as part of vertical instantiation creation."
input AssetsVerticalVerticalInstantiationInlineCategoryInput {
  """
  The category type to create.
  Currently only BUNDLE_INSTANTIATION is supported at creation time.
  """
  category: AssetsVerticalVerticalInstantiationCategoryType
}

" ---------------------------------------------------------------------------------------------"
input AssetsVerticalWorkbenchColumnInput {
  """
  Stable field key. Unique within `columns`. Compared exactly: no trim, no case folding.
  A duplicate `key` is rejected.
  """
  key: String!
  """
  Display order, ascending. Must be >= 0 and unique within `columns`.
  Gaps are allowed. This value is the order, not the list index.
  A duplicate `position` is rejected.
  """
  position: Int!
  "Width in pixels. Omit or send null for \"not resized\"."
  width: Int
}

"""
The full list of currently shown columns. Omitting a column hides it.
A column with key "key" (the asset identifier column) must be present,
and its position must be strictly less than every other column's position.
"""
input AssetsVerticalWorkbenchColumnPreferencesInput {
  "The tenant cloud identifier."
  cloudId: ID! @CloudID(owner : "assets-vertical")
  columns: [AssetsVerticalWorkbenchColumnInput!]!
  "Omit or send null to clear the saved sort."
  sortBy: AssetsVerticalWorkbenchColumnSortInput
  tab: AssetsVerticalWorkbenchTab!
}

input AssetsVerticalWorkbenchColumnSortInput {
  "Ascending or descending order for the column named by `key` above. That column may be any shown column."
  direction: SortDirection!
  """
  Field key of the column to sort by. Any key in `columns` on this same input, for example "name" or "model".
  Not limited to the identifier column ("key"). A key that is not in `columns` is rejected.
  """
  key: String!
}

"""
Input for `assetsVertical_workbenchDashboardTryUpgrade`.

`cloudId` is used to initialise tenant context; the CMDB workspace id is then derived from the
tenant context (callers do not need to pass it).

`verticalInstantiationId` is needed so AVS can look up the hardware category and rebuild the same
template placeholder mappings used when the dashboard was originally created (schema, workspace,
object types, and required attribute ARIs). It is declared nullable in the schema (this mutation
is `@lifecycle(EXPERIMENTAL)` and the AGG validator treats adding a required input field as a
breaking change), but the resolver rejects the request with a `BAD_REQUEST` failure payload if
the caller omits it. The UI is expected to always supply it.
"""
input AssetsVerticalWorkbenchDashboardTryUpgradeInput {
  cloudId: ID! @CloudID(owner : "assets-vertical")
  verticalInstantiationId: ID
  viewId: ID!
}

