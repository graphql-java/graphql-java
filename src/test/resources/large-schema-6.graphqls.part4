"""
Inline template definition provided by the client.
Exactly one of 'templateId' or 'template' must be set on GravityCreateViewFromTemplateInput.
Only 'name', 'view', and 'definitions' are required — display-only fields (thumbnail,
screenshot, colorScheme, descriptions) are not relevant for view instantiation.
"""
input GravityViewTemplateInput {
  """
  Field reference definitions needed to resolve vtri:field:ref:* identifiers used in 'view'.
  Required when the view config references any vtri:field:ref:* identifiers.
  """
  definitions: GravityViewTemplateDefinitionsInput
  """
  Optional template identifier (e.g. 'product-roadmap-template'). Accepted for
  round-tripping exported templates; ignored on import since the created view's
  identity is server-managed.
  """
  id: ID
  "Human-readable name of the template."
  name: String!
  """
  URN of the template schema this template conforms to
  (e.g. 'urn:atlassian:jpd:view-template:v1.0.0'). Nullable; when omitted
  the current schema version is assumed.
  """
  schema: String
  "The view configuration to instantiate."
  view: GravityViewInput!
}

