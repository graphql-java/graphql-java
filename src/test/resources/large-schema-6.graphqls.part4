"""
Filters for a marketplace search, mirroring the marketplace-search service's
supported filter dimensions. All fields are optional.
"""
input MarketplaceStoreSearchFilterInput {
  """
  Restrict by cloud compliance boundary: commercial, fedramp_moderate,
  isolated_cloud.
  """
  cloudComplianceBoundaries: [String!]
  "Filter to apps with specific compliance certifications: soc2, iso27k."
  compliance: [String!]
  "Filter to apps based on governance criteria."
  governance: [MarketplaceStoreSearchFilterGovernanceInput!]
  "Restrict by hosting type: cloud, dataCenter, server."
  hosting: String
  "Restrict by object type: app, agent, mcp."
  objectType: String
  "Filter to paid apps (true) or free apps (false)."
  paid: Boolean
  """
  Restrict to apps compatible with these parent products, e.g.
  jira, jira-service-desk, confluence, bitbucket, fecru, bamboo, crowd,
  compass, trello.
  """
  parentApplicationKeys: [String!]
  "Filter to apps supported by an Atlassian partner."
  partnerSupported: Boolean
  "Filter to apps participating in specific security programs."
  securityPrograms: [MarketplaceStoreSearchFilterSecurityProgramInput!]
  "Restrict to apps in the given marketplace category names."
  tagsCategories: [String!]
  "Filter by Atlassian trust program participation."
  trustPrograms: [MarketplaceStoreSearchFilterTrustProgramInput!]
  "Restrict results to a single vendor by numeric id."
  vendorId: Int
}

input MarketplaceStoreSearchFilterSecurityProgramInput {
  "One of: penetrationTesting, bugBounty."
  program: String!
  """
  Optional program status: approved, rejected, applied, not_a_participant.
  Defaults to approved when omitted.
  """
  status: String
}

"""
Reusable GraphQL representation of the marketplace-search service's request
`Filter` object. Any query that fetches marketplace search results can accept a
`MarketplaceStoreSearchFilterInput` to constrain the candidate set.

Values mirror the marketplace-search service's native wire values exactly
(e.g. hosting `dataCenter`, parentApplicationKey `jira-service-desk`,
status `not_a_participant`) so they are forwarded through without translation.
"""
input MarketplaceStoreSearchFilterTrustProgramInput {
  "One of: cloudFortified, runsOnAtlassian, architectedForAtlassian."
  program: String!
  "Optional program status: approved, rejected, applied, not_a_participant."
  status: String
  "Optional marketing label UUID (required in practice for runsOnAtlassian)."
  value: String
}

