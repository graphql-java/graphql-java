input AIOpsUnifiedConnectorFilter {
  "Returns connectors whose resolved authentication status matches any supplied value."
  authStatuses: [AIOpsConnectorAuthStatus!]
}

input AVPAddDashboardElementInput {
  canvasRowId: ID!
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  """
  The index in the row's elements array where the new element will be added.  Any existing elements with an index
  greater than or equal to this index will be shifted to the right. If 0, the element will be inserted at the start of
  the row.
  """
  insertIndex: Int
  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
}

input AVPAddDashboardRowInput {
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "The height of the row. If not specified, then the height will be medium."
  height: AVPCanvasRowHeight
  """
  The number of empty elements/slots to include in the new row.  Maximum of 4 allowed, minimum 1.
  If not specified, then will default to 3 elements.
  """
  numElements: Int
  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
  "The index where the row should be added. If not specified, then the row will be added to the end of the dashboard."
  rowIndex: Int
}

"""
Input type for adding filter expressions (groups or filters) to the tree.
Supports both single and batch operations.

Root Creation Rules:
- When parentGroupId is null, this creates/replaces the root
- Only 1 expression allowed when parentGroupId is null
- Attempting to add multiple expressions as root will fail

Append Rules:
- When parentGroupId is provided, appends all expressions to that parent
- Can add multiple expressions (1+) when appending to existing parent
"""
input AVPAddFilterExpressionsInput {
  "Dashboard ARI"
  dashboardAri: ID! @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Filter expressions to add (groups or filters). If parentGroupId is null, must contain exactly 1 expression."
  expressions: [AVPFilterExpressionInput!]!
  "Publish this committed change to AI dashboard-update subscribers. Defaults to USER."
  origin: AVPDashboardUpdateOrigin = USER
  "Parent group ID to append to (null = create root, must provide exactly 1 expression)"
  parentGroupId: ID
}

