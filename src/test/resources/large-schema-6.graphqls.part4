  "Whether the operation was successful."
  success: Boolean!
}

"""
Represents the state of an async propose-planner-events job triggered by
the enqueueProposePlannerEventsJob mutation. Clients should subscribe to
lifecycle updates via the TrelloJob interface.
"""
type TrelloProposePlannerEventsJob implements TrelloJob {
  "Error details for the job. Only populated when `outcome` is FAILED."
  errors: [TrelloJobError!]
  "The underlying ARI for the job."
  id: ID!
  "The terminal outcome of the job. Null while the job is still running."
  outcome: TrelloProposePlannerEventsJobOutcome
  "The lifecycle state of the job."
  status: TrelloProposePlannerEventsJobStatus!
}

"""
Returned response from the enqueueProposePlannerEventsJob mutation. The
returned job can be subscribed to via onJobUpdated to receive lifecycle
updates as the worker processes the job.
"""
type TrelloProposePlannerEventsJobPayload implements Payload {
  "Any errors that occurred during enqueuing."
  errors: [MutationError!]
  """
  The enqueued job. Clients should subscribe to this job's id via
  onJobUpdated to receive lifecycle updates.
  """
  job: TrelloProposePlannerEventsJob
  "Whether the job was successfully enqueued."
  success: Boolean!
}

"""
Returned response from proposePlannerEvents mutation.
The TrelloPlanner will contain the proposed events.
"""
type TrelloProposePlannerEventsPayload implements Payload {
  "Any errors that occurred during the operation."
  errors: [MutationError!]
  "The planner with the proposed events."
  planner: TrelloPlanner
  "Whether the operation was successful."
  success: Boolean!
}

