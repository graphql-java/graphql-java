  "Filter plans by Jira project key. Resolves to an ARI via AGG before filtering."
  jiraProjectKey: String
  "Filter plans by the Atlassian account ID of their owner. Returns only plans owned by this user."
  ownerId: String
  "Filter plans by the Atlassian account IDs of their owners. Returns plans owned by any of these users."
  ownerIds: [String!]
  "Filter plans whose name contains this substring, case-insensitively."
  planName: String
  "Filter plans by their published state."
  publishedState: PlanPublishedStateFilter
  "When true, returns only plans where the authenticated viewer is an explicit collaborator but is not the owner."
  sharedWithViewer: Boolean
  "Filter plans by archived state. Defaults to active plans when omitted."
  status: PlanStatusFilter
}

