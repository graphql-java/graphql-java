"""
Typed account catalog filter. Compiled to SalesQL inside the gateway.
Lists are IN. Fields AND. Ranges are inclusive.
"""
input GtmAccountsFilter {
  accountDomain: [String!]
  accountName: [String!]
  accountOwnerId: [String!]
  accountSegment: [String!]
  accountSfdcId: [String!]
  accountType: [String!]
  annualContractValue: GtmFloatRange
  country: [String!]
  createdAt: GtmDateRange
  customerSince: [String!]
  enterpriseAccountStatus: [String!]
  naicsIndustry: [String!]
  nbpPotential: GtmFloatRange
  region: [String!]
  salesTerritory: [String!]
  sfdcAccountOwnerName: [String!]
  updatedAt: GtmDateRange
}

input GtmDateRange {
  endDate: String
  startDate: String
}

input GtmFloatRange {
  max: Float
  min: Float
}

