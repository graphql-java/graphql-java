  "The object ID of the task"
  objectId: ID!
  "The agent session that the task exists in"
  session: TrelloAgentSession
  "The ID of the session that the task exists in"
  sessionId: ID!
  "The status of the task"
  status: TrelloAgentTaskStatus!
}

"Connection to tasks."
type TrelloAgentTaskConnection {
  "The list of edges between the session and its tasks."
  edges: [TrelloAgentTaskEdge!]
  "The list of tasks."
  nodes: [TrelloAgentTask!]
  "Contains information related to the current page of information."
  pageInfo: PageInfo!
}

"Represents a basic relationship to a TrelloAgentTask."
type TrelloAgentTaskEdge {
  "The cursor to this edge."
  cursor: String!
  "The task."
  node: TrelloAgentTask!
}

"A single task update edge."
type TrelloAgentTaskEdgeUpdated {
  " eslint-disable-next-line trello-server/graphql-require-nullable-fields -- Pre-existing non-nullable field before enforcement"
  node: TrelloAgentTaskUpdated!
}

"The status of a TrelloAgentTask"
type TrelloAgentTaskStatus {
  """
  A status message for the task. For AI Board Builder (`create-ai-board`)
  tasks, `content` is a message key, not display text:
  `preparing-board`, `searching-web`, `verifying-web-links`,
  `generating-board`, and `creating-lists-and-cards` while working, and
  `invalid-input` or `ai-generation-error` when it ends. Clients localize
  these keys and show a generic label for any other value from these tasks.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  message: TrelloAgentMessage
  """
  The current state of the task
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  state: TrelloAgentTaskState!
  """
  The timestamp of this status
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  timestamp: DateTime!
}

"A single task update."
type TrelloAgentTaskUpdated {
  """
  Message updates for this task, when included in this task delta.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  history: TrelloAgentMessageUpdatedConnection
  """
  The Trello Agent Task ID for the task that changed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  id: ID!
  """
  A static key representing the kind of task this is
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  key: String
  """
  The object ID of the TrelloAgentTask that changed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  objectId: ID!
  """
  The parent Trello Agent Session ARI, when included in this task delta.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  sessionId: ID
  """
  Status for this task update.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  status: TrelloAgentTaskStatus
}

"Connection of task updates pushed during an agent session subscription."
type TrelloAgentTaskUpdatedConnection {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  edges: [TrelloAgentTaskEdgeUpdated!]
}

"Updated TrelloAgent"
type TrelloAgentUpdated implements TrelloRecommendationOwner {
