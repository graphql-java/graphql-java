  This field is **deprecated** and will be removed in the future
  """
  isHidden: Boolean
  "Optional label"
  label: String
  "Optional metadata"
  metadata: String
  "What modes this filter is visible in. Defaults to VIEW_AND_EDIT."
  visibility: AVPPlatformFilterVisibility
}

