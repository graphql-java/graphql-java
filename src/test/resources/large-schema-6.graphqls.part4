  """
  attachmentVersion: Int
  """
  The ARI of the page or blog post the attachment belongs to. Confluence only; used to reference the
  container in the audit log, which does not accept an attachment ARI. Ignored for Jira.
  """
  containerAri: ID @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  "The content ARI of the attachment (a Confluence or Jira attachment ARI)."
  contentAri: ID! @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  "The Media Platform file ID of the attachment to tombstone."
