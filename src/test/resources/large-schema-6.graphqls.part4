  """
  activeWithin: JiraDateTimeWindow
  "The Project ids to filter Versions to."
  projectIds: [ID!] @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  "The raw Project keys to filter Versions to."
