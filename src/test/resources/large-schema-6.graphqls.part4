"Lifecycle states for a smart-routing dry-run statistics execution."
enum AgentWorkspaceSmartRoutingDryRunStatus {
  "Terminal acknowledgement that a `CANCELLING` run was honoured."
  CANCELLED
  """
  Admin requested cancel via `agentWorkspace_cancelSmartRoutingDryRun`. The worker observes
  this between tickets and exits cooperatively, transitioning to `CANCELLED`.
  """
  CANCELLING
  "Natural success; the `result` snapshot has been written."
  COMPLETED
  "Pre-flight validation failed (e.g. `NO_TICKETS`) or an unhandled error."
  FAILED
  "Persisted; the worker has not yet picked it up."
  PENDING
  "Worker is actively classifying tickets."
  RUNNING
  "Worker exceeded the per-run wall-clock cap. Partial progress was discarded."
  TIMEOUT
}

"Target type selected for smart routing."
enum AgentWorkspaceSmartRoutingMode {
  "Route through a configured Jira service field before selecting a team."
  SERVICE
  "Route directly to a team without discovering or writing a service field."
  TEAM
}

"Per-ticket effectiveness label — mirrors `RoutingOutcomeLabel` in the api module."
enum AgentWorkspaceSmartRoutingRoutingOutcomeLabel {
  """
  Nothing to evaluate: no prediction was produced and no ground truth was recorded on the
  ticket. Reported as a count so callers can surface data-quality issues; never enters the
  confusion matrix.
  """
  EXCLUDED
  """
  Declined to classify, but the ground-truth destination IS present in the routing table. Routing
  missed an opportunity.
  """
  FALSE_NEGATIVE
  """
  Classified, but the prediction does not match ground truth — either the ground truth differs,
  is missing, or is not in the routing table. Routing acted when it should not have, or routed
  to the wrong destination.
  """
  FALSE_POSITIVE
  """
  Declined to classify, and the ground-truth destination is not in the routing table. Correct
  abstention (the table has no valid destination for this ticket).
  """
  TRUE_NEGATIVE
  "Classified, prediction matches ground truth. Routing did the right thing."
  TRUE_POSITIVE
}

