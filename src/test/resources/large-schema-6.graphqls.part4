"""
This is a top level subscription type under which all of Trello's supported subscriptions
are under. It is used to group Trello's GraphQL subscriptions from other Atlassian
subscriptions.
"""
type TrelloSubscriptionApi {
  """
  
  
  
  This field is **deprecated** and will be removed in the future
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onBoardCardSetUpdated(cardIds: [ID], id: ID!): TrelloBoardUpdated @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onBoardUpdated(cardIds: [ID], id: ID!, noInitialResponse: Boolean = false): TrelloBoardUpdated @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Allows clients to receive updates to an existing card batch submitted via a mutation.
  An alternative to querying the card batch job for status updates.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onCardBatchUpdated(id: ID!): TrelloCardBatch @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onEchoUpdated(input: TrelloEchoInput!): TrelloEchoUpdated @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onInboxUpdated(memberId: ID!, noInitialResponse: Boolean = false): TrelloInboxUpdated @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Subscribe to lifecycle updates for any async job identified by its ARI.
  The concrete event shape is determined by the job's TrelloJob implementer;
  clients should spread fragments on concrete implementations to read
  job-type-specific fields.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onJobUpdated(id: ID!): TrelloJob @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Subscribe to planner event card updates for all boards.
  Updates include board ID so client can filter to current board.
  Routes via member channel for proper scope alignment.
  
  WARNING: Uses third-party calendar APIs. Will close on webhook expiry (~8 hours).
  Keep SEPARATE from main board/card/inbox subscriptions to avoid unintended disconnections.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onMemberPlannerEventCardsUpdated(memberId: ID!, noInitialResponse: Boolean = false): TrelloMemberPlannerEventCardsUpdated @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onMemberUpdated(id: ID!, noInitialResponse: Boolean = false): TrelloMemberUpdated @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  Subscribe to updates for a stateful session identified by a sessionId.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onStatefulSessionUpdated(noInitialResponse: Boolean = false, sessionId: ID!): TrelloStatefulSessionUpdated @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __trello:atlassian-external__
  """
  onWorkOverviewDashboardJobUpdated(id: ID!): TrelloWorkOverviewDashboardJobUpdated @scopes(product : NO_GRANT_CHECKS, required : [TRELLO_ATLASSIAN_EXTERNAL])
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
