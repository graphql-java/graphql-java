  operation: IrisMutateOperation
  "USR source attribute id when present."
  sourceAttributeId: ID
  "Snapshot of the USR source attribute name to ignore."
  sourceAttributeName: String
}

"One source-identifier attribute in a configuration mutation tree slice."
