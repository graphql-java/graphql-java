}

"""
Edge type emulating relay-style paging
Label edge for new or updated label
"""
type TrelloLabelEdgeUpdated {
  "The new or updated label"
  node: TrelloLabelUpdated!
}

"The id of a label"
type TrelloLabelId {
  " eslint-disable-next-line trello-server/graphql-require-object-id -- TODO: add objectId"
