"""
A scalar that enables us to spike [3D](https://relay.dev/docs/glossary/#3d) aka data-driven dependencies
This scalar is a requirement for using @match and @module directive supported by Relay GraphQL client
Please talk to #uip-app-framework before using this.
The definition of the scalar is yet to be decided based on spike insights.
To learn about current state see https://go.atlassian.com/JSDependency
DO NOT USE: Platform teams are iterating on the final shape of data returned
"""
scalar JSDependency

"""
The `JSON` scalar type represents JSON values as specified
by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).

Note to schema designers - use this scalar with caution as the resultant data becomes untyped
from a consumers point of view.  There are legitimate use cases for this scalar type
but it SHOULD not be a common scalar.
"""
scalar JSON

"The `JSONObject` scalar type represents JSON objects as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf)."
scalar JSONObject

"""
Atlassian Document Format (ADF) - A JSON format for rich text content.
@see https://developer.atlassian.com/cloud/jira/platform/apis/document/structure/

TODO: Implement custom scalar with ADF validation
"""
scalar KitsuneADF

"A scalar that is a 64-bit signed Java primitive data type. Its range is -2^63 to 2^63 – 1"
scalar Long

"MercuryJSONString"
scalar MercuryJSONString @renamed(from : "JSONString")

"A cohort value, preserved as a string or boolean without coercion."
scalar PostOfficeExperimentCohort

"SoftwareBoardFeatureKey"
scalar SoftwareBoardFeatureKey @renamed(from : "BoardFeatureKey")

"SoftwareBoardPermission"
scalar SoftwareBoardPermission @renamed(from : "BoardPermission")

"SprintScopeChangeEventType"
scalar SprintScopeChangeEventType @renamed(from : "ScopeChangeEventType")

"Position for a card - can be a numeric position or relative position ('top' or 'bottom')"
scalar TrelloCardPosition

"""
A unique short string that can be used to fetch a board, card, etc. It's
usually used as a part of the entity URL. In some cases can be used as
as the ID.
"""
scalar TrelloShortLink

"An URL scalar that accepts string values like [https://www.w3.org/Addressing/URL/url-spec.txt]( https://www.w3.org/Addressing/URL/url-spec.txt)"
scalar URL

"UUID"
scalar UUID

"Upload"
scalar Upload

"Input for `aiops_incidentLinkedAlerts`."
input AIOpsIncidentLinkedAlertsInput {
  "The Jira issue key of the incident (e.g. HOT-304598)."
  incidentId: String!
}

"""
============================================
Incident-related alerts
============================================
"""
input AIOpsIncidentRelatedAlertsInput {
  "Jira incident issue id or key."
  incidentId: String!
  "When true, alert-group merging is skipped."
  onlyAlerts: Boolean = false
  "Defaults to [\"P1\", \"P2\"] when omitted."
  priorities: [String!]
  "Override for the incident's affected-services list (Graph service ARIs / bare UUIDs; emitted as an Opsgenie `services:` clause). Falls back to the incident's own affected services when both `serviceIds` and `serviceNames` are omitted."
  serviceIds: [String!]
  "Optional human-readable micros service names (e.g. `[\"xen-invocation-service\", \"mimir\"]`); each is emitted as an Opsgenie `tags: \"service_id:<name>\"` clause and OR'd with the `services:` clause. Supply this when the alert integration (CloudWatch / Prometheus / Splunk / …) tags alerts by service name rather than by Opsgenie service UUID."
  serviceNames: [String!]
}

"Input for regenerating suggested resources for an incident."
input AIOpsRegenerateIncidentSuggestedResourcesInput {
  "Cloud ID for the Jira site containing the incident."
  cloudId: ID! @CloudID(collabContextProduct : JIRA_SERVICE_DESK, owner : "jira")
  "Jira issue key or issue ID for the incident."
  issueKeyOrId: String!
}

"Input for regenerating an incident suggestion."
input AIOpsRegenerateIncidentSuggestionInput {
  "Cloud ID for the Jira site containing the incident."
  cloudId: ID! @CloudID(collabContextProduct : JIRA_SERVICE_DESK, owner : "jira")
  "Jira issue key or issue ID for the incident."
  issueKeyOrId: String!
}

"Input for creating a new RCA investigation."
input AIOpsTriggerInvestigationInput {
  """
  Opt-in to the agentic RCA branch. When true, the request is routed to the
  agentic kickoff flow (deterministic UUIDv5 id per ADR-014). When false (the
  default), the legacy/deterministic Jira-fetch flow runs unchanged.
  """
  agentic: Boolean = false
  "ARIs of DevOps services in scope for this investigation."
  inScopeServiceIds: [ID!]!
  """
  Requested depth of the agentic investigation. Honoured only when `agentic = true`.
  Defaults to FAST when omitted.
  """
  rcaMode: AIOpsRcaMode = FAST
  """
  Agentic re-run intent. Honoured only when `agentic = true`. When `true`, requests a fresh
  investigation subject to the single-active guard (blocked while a non-terminal investigation
  is still running for the incident); when `false` (the default), the trigger is get-or-create
  and returns the existing investigation. The server owns attempt allocation and idempotency;
  clients never supply attempt numbers or idempotency keys.
  """
  rerun: Boolean = false
  "ID of the source entity (e.g. Jira incident issue ID) to investigate."
  sourceEntityId: ID!
  "Type of the source entity."
  sourceEntityType: AIOpsInvestigationSourceEntityType!
  "Optional responder-provided context to seed the agentic investigation. Max 2,000 characters; treated as untrusted responder context downstream."
  userContext: String
}

