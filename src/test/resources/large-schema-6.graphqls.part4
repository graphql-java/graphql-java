  descriptionType: HelpCenterDescriptionType!
  "HelpCenterARI can be used to get the correct help center node"
  helpCenterAri: String! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
  "Name and its all translations in raw format"
  nameTranslations: [HelpCenterTranslationInput!]
}

input HelpCenterBannerInput {
  filedId: String
  useDefaultBanner: Boolean
}

input HelpCenterBrandingColorsInput {
  "Banner text color of the Help Center"
  bannerTextColor: String
  "primary brand color of the Help Center"
  primary: String
  """
  Secondary brand color — paired with `primary` to drive the 20-shade hub
  palette (10 primary + 10 secondary).
  """
  secondaryColor: String
  "primary color of the Top Bar"
  topBarColor: String
  "Top bar text color"
  topBarTextColor: String
}

input HelpCenterBrandingInput {
  banner: HelpCenterBannerInput
  "Brand colors of the Help Center"
  colors: HelpCenterBrandingColorsInput
  """
  Corner radius (in whole pixels) applied to bespoke hub extension cards
  and banners. When null the framework uses 8. BE rejects values outside [0, 32] with a 400.
  """
  cornerRadius: Int
  """
  Icon chosen for the Help Center from the predefined catalog. Accepts the
  stable catalog key (e.g. "compass", "flask"); null leaves it unchanged.
  Format: lowercase letters, digits and hyphens (max 64 chars); BE rejects
  values outside this format with a 400.
  """
  helpCenterIcon: String
  "Title of the Help Center"
  homePageTitle: HelpCenterHomePageTitleInput
  "Logo of Help Center"
  logo: HelpCenterLogoInput
  "Navigation bar configuration for the Help Center"
  navigationBar: HelpCenterNavigationBarInput
  """
  Space density preset applied inside bespoke hub extensions. When null
  the framework uses DEFAULT.
  """
  spaceDensity: HelpCenterSpaceDensity
  "Typography configuration for the Help Center"
  typography: HelpCenterBrandingTypographyInput
}

input HelpCenterBrandingTypographyInput {
  "Paragraph (body) font — applied to all hub body text."
  bodyFont: String
  "Heading font — applied to all hub heading text."
  headingFont: String
}

input HelpCenterBulkCreateTopicsInput {
