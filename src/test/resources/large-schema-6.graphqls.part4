"""
Criteria for narrowing the scopes returned by `admin_oauthScopes`. All fields are optional and
combine with AND.
"""
input AdminOAuthScopeFilter {
  """
  Return only scopes granting this kind of access, matched against `AdminOAuthScope.action`.
  Omit to return every action.
  """
  action: AdminOAuthScopeAction
  """
  Free-text search, matched as a case-insensitive substring against a scope's `id`. Matching
  is deliberately limited to `id` so that every result is explained by the scope string the
  caller can see. Omit to return the whole catalogue.
  """
  query: String
}

"""
How to order the scopes returned by `admin_oauthScopes`. Omit for the default ordering, `id`
ascending.
"""
input AdminOAuthScopeSortInput {
  "The direction to order in."
  direction: SortDirection!
  "The field to order results by."
  field: AdminOAuthScopeSortField!
}

"Arguments for `admin_oauthScopes`, excluding the Relay paging arguments."
input AdminOAuthScopesInput {
  "Narrows the catalogue. Omit to return every scope."
  filter: AdminOAuthScopeFilter
  """
  The organization to authorize the caller against. Required only so that the caller can be
  checked as an admin of that organization - the catalogue is global, so this does not filter
  the result.
  """
  orgId: ID! @OrgID
  "Orders the catalogue. Omit for `id` ascending."
  sortBy: AdminOAuthScopeSortInput
}

