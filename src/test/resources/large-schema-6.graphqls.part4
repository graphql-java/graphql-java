input TeamMembershipFilter {
  "List of members AccountIDs"
  memberIds: [ID]
}

"""
A single (source, destination) team pair to merge. Both teams must belong to
the scope specified in TeamMergeTeamsInput.scopeId.
"""
input TeamMergePair {
  "ID of the destination team. The destination team will receive the source team's members."
  destinationTeamId: ID!
  "ID of the source team. The source team will be archived after the merge completes."
  sourceTeamId: ID!
}

"""
Input for the mergeTeams mutation. Pairs are validated and scheduled
independently — per-pair failures do not stop other pairs in the same batch.
"""
input TeamMergeTeamsInput {
  "Pairs of (source, destination) teams to merge. Min 1, max 50 entries."
  merges: [TeamMergePair!]!
  "The scope (eg userbase) that all merge pairs belong to."
  scopeId: ID!
}

