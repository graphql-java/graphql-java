  "The Jira cloud ID (site ID) of the tenant."
  cloudId: ID! @CloudID(owner : "jira")
  "Draft session UUID to promote. Optional — pre-draftId callers can omit, the BE falls back to the legacy (project, serviceFieldId) partition."
  draftId: ID
