  id: ID
  "Operation (`CREATE` to add, `DELETE` to remove). Omit under a SOURCE `CREATE` parent."
  operation: IrisMutateOperation
  "Order in the composite source record key. Defaults to append when omitted on CREATE."
  ordinal: Int
  "USR source attribute id when present."
  sourceAttributeId: ID
  "Snapshot of the USR source attribute name."
  sourceAttributeName: String
}

