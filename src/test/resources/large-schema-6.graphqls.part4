"""
Per-help-center migration lifecycle. Mirrors the values persisted on the
`ati:cloud:help:hub-migration` ERS node's per-HC entry. The admin help center
card label is derived from this (plus nullability of `HelpCenter.migration`):
null migration => "Live"; NOT_STARTED => "Live"; IN_PROGRESS => "Migration in progress";
MIGRATED => "Pending review" ("Review migration"); PUBLISHED => "Live" (on the new hub).
"""
enum HelpCenterMigrationState {
  "Migration failed; a rollback was attempted."
  FAILED
  "Migration has started but not yet finished for this help center."
  IN_PROGRESS
  "All migration steps completed successfully; the migrated hub exists as a draft, pending admin review."
  MIGRATED
  "Migration has never been initiated for this help center."
  NOT_STARTED
  "The migrated hub has been published (made live): target hub is ACTIVE, source HC is INACTIVE."
  PUBLISHED
}

