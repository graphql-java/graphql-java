"""
The source from which a `JiraSpaceSearchForYouEdge` recommendation was derived.

For default recommendations (no `input` supplied) the connection may contain a mix of
`CROSS_PRODUCT_COLLABORATOR_ACTIVITY`, `INVITER_SPACES`, and `POPULAR_SPACES` edges.
When an explicit `input` principal is supplied, edges will share the same type (or types,
in the case of `input.teamId` which may return both `TEAM_ACTIVITY` and `TEAM_SPACE_LINK`).
"""
enum JiraSpaceSearchForYouRecommendationType {
  """
  Personalised recommendation derived by bridging the calling user's cross-product
  collaboration activity (e.g. Slack, Confluence) to Jira project activity of the
  users they collaborate with. Used when no `input` principal is supplied.
  """
  CROSS_PRODUCT_COLLABORATOR_ACTIVITY
  "Result returned because it matched the supplied `input.spaceId` directly."
  DIRECT_SPACE
  "Fallback recommendation: a space that the calling user's inviter actively uses."
  INVITER_SPACES
  "Fallback recommendation: a space that is generally popular across the tenant."
  POPULAR_SPACES
  """
  Result returned because it was recommended for the supplied `input.teamId`
  based on the team members' Jira activity via the collaboration graph.
  """
  TEAM_ACTIVITY
  """
  Result returned because the supplied `input.teamId` has an explicit
  Team → Project link configured.
  """
  TEAM_SPACE_LINK
  """
  Result returned because it was recommended for the supplied `input.userId`
  based on that user's Jira activity via the collaboration graph.
  """
  USER_ACTIVITY
}

