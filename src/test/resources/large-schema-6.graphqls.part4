input MarketplaceConsoleEditionsFilterInput {
  """
  When provided, the returned `tieredPricing` is restricted to a single billing
  cycle: ANNUAL selects the flat `items` priced for 12 months, MONTHLY selects
  the 1-month flat items. When omitted, the default (mixed seat-based) pricing
  ladder is returned unchanged for backwards compatibility.
  """
  billingCycle: MarketplaceConsoleBillingCycle
  editionsGroup: MarketplaceConsoleEditionsGroup
  """
  When provided (e.g. LIVE), the pricing plans are fetched from App Catalog at that status.
  When omitted, the default (PENDING) behaviour is unchanged for backwards compatibility.
  """
  pricingPlanStatus: MarketplaceConsolePricingPlanFetchStatus
}

