"Inputs for registering a new MCP server in a workspace"
input GraphIntegrationMcpAdminManagementRegisterMcpServerInput @renamed(from : "McpAdminManagementRegisterMcpServerInput") {
  """
  The access mode for an MCP server whose access is governed by RBAC — API_TOKEN or
  CUSTOM_OAUTH_CLIENT_CREDENTIALS. Either mode may be chosen: DEFAULT_DENY enforces the allowlist in
  allowedPrincipalAris / allowedPrincipalIds, DEFAULT_ALLOW enforces the blocklist in
  deniedPrincipalAris. When omitted, these servers default to DEFAULT_DENY. Supplying it for any
  other auth type is rejected.
  """
  accessMode: GraphIntegrationMcpAdminManagementMcpServerAccessMode
  """
  An optional list of Identity user or group ARIs that are allowed to use this MCP server in DEFAULT_DENY mode.
  This must be empty when accessMode is DEFAULT_ALLOW.
  """
  allowedPrincipalAris: [ID!]
  """
  An optional list of legacy group IDs that are allowed to use this MCP server. Prefer allowedPrincipalAris for new
  callers. API-token authentication requires this field unless allowedPrincipalAris is provided.
  """
  allowedPrincipalIds: [String!]
  "The auth configuration for the MCP server."
  authConfig: GraphIntegrationMcpAdminManagementMcpServerAuthConfigInput
  "The authentication type for the remote MCP server. Defaults to OAUTH when omitted."
  authType: GraphIntegrationMcpAdminManagementMcpServerAuthType
  "Whether newly discovered tools should be automatically enabled after a tool sync. Defaults to false."
  autoEnableNewTools: Boolean
  "The cloudId where the operation is being performed."
  cloudId: ID! @CloudID
  """
  An optional list of Identity user or group ARIs that are denied access to this MCP server in DEFAULT_ALLOW mode.
  This must be empty when accessMode is DEFAULT_DENY.
  """
  deniedPrincipalAris: [ID!]
  "The display name of the MCP server"
  displayName: String!
  "The MCP endpoint of the server. If not provided, the default based on convention will be used."
  endpointPath: String
  "Extra input values used to resolve template placeholders in the server URL (e.g. tenantId). Required when the gallery template has extraInputs defined."
  extraInputs: [GraphIntegrationMcpAdminManagementExtraInputEntry!]
  "The key for the icon of the MCP server"
  icon: String
  "The type of the MCP server. If not provided, the default based on convention will be used."
  serverType: GraphIntegrationMcpAdminManagementMcpServerType
  "A list of tags for the MCP server"
  tags: [String!]
  "The ID of the Gallery template used for registering the server"
  templateId: String
  "The URL of the MCP server. Optional when templateId and extraInputs are provided to resolve the URL from the template."
  url: URL
}

"Inputs for triggering a re-sync of an MCP server's tools"
input GraphIntegrationMcpAdminManagementTriggerToolSyncInput @renamed(from : "McpAdminManagementTriggerToolSyncInput") {
  "The cloudId where the operation is being performed."
  cloudId: ID! @CloudID
