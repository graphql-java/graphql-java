  "The vertical to delete sample data from."
  verticalType: AssetsVerticalVerticalType!
}

"""
Links a hardware object type to a depreciation rule, specifying which
object type attributes map to acquisition cost and book value.
"""
input AssetsVerticalDepreciationRuleAssetTypeInput {
  "Object type attribute identifier for the acquisition cost field."
  acquisitionCostObjTypeAttributeId: ID!
  """
  Optional object type attribute identifier holding the asset's acquisition (purchase) date.
  If omitted, the field defaults to an empty string at the DB layer; the book-value operator
  treats empty values as missing-purchase-date and surfaces a stable per-id failure.
  """
  acquisitionDateObjTypeAttributeId: ID
  "Object type attribute identifier for the book value field."
  bookValueObjTypeAttributeId: ID!
  "Object schema identifier."
  objSchemaId: ID!
  "Object type identifier."
  objTypeId: ID!
}

