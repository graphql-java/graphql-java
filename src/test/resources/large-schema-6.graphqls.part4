"""
Update input for an existing workstream.

Note: there is intentionally no findWorkMode field — the work mode is
immutable after creation. Clients attempting to send findWorkMode here will
be rejected by the GraphQL layer.
"""
input DevAiAutodevNextUpdateWorkstreamInput {
  cloudId: ID! @CloudID(owner : "jira")
  """
  New loop type. Omission or null preserves the existing type. Only site
  admins are allowed to provide a non-null value, including the existing type.
  """
  loopType: DevAiAutodevNextWorkstreamLoopTypeInput
  name: String
  settings: DevAiAutodevNextWorkstreamSettingsInput
  status: DevAiAutodevNextWorkstreamStatus
  workstreamId: ID!
}

input DevAiAutodevNextWorkstreamFilter {
  ownership: DevAiAutodevNextWorkstreamOwnershipFilter
  "Jira project ID (full ARI). Only explicitly associated loops are returned, filtered before pagination."
  projectId: ID @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  searchQuery: String
}

input DevAiAutodevNextWorkstreamOwnershipFilter {
  isOwner: Boolean!
  userAri: ID! @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
}

input DevAiAutodevNextWorkstreamSettingsInput {
  assigneeAllowlist: [ID!] @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  assigneeDenylist: [ID!] @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  assigneeSelectionMode: String
  assignees: [ID!] @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  boysenberrySessionInitiator: DevAiAutodevNextBoysenberrySessionInitiatorInput
  "Prefix prepended to branches created by AutoDev. Explicit null clears the configured prefix."
  branchPrefix: String
  classificationRepositoryUrl: String
  "Model ID to use by default for coding sessions created by this workstream."
  defaultCodingModel: ID
  defaultJiraProjectAri: ID
  eligibilityCriteria: String
  notifications: DevAiAutodevNextNotificationSettingsInput
  """
  Configuration captured by future PR Nursing registrations. Omission preserves
  the current configuration and explicit null resets it to defaults.
  """
  prNursingConfiguration: DevAiAutodevNextPullRequestNursingConfigurationInput
  "Whether AutoDev PR Nursing should run for this workstream. Defaults to false."
  prNursingEnabled: Boolean
  """
  Markdown template used to structure generated pull request descriptions.
  Omission preserves the current template and null clears it.
  """
  pullRequestDescriptionTemplate: String
  pullRequestMessage: String
  "PR title prefix, limited to 50 Unicode code points after trimming surrounding whitespace."
  pullRequestPrefix: String
  """
  Legacy single weekly scan schedule. When `null`, the existing schedule
  (if any) is preserved on update. New clients should prefer
  `scanScheduleConfiguration`. `timezone` is optional: if omitted the server resolves
  it from the workstream owner's profile, falling back to "UTC".
  """
  scanSchedule: DevAiAutodevNextScanScheduleInput
  """
  Preferred recurring scan configuration. Omission preserves the explicit
  configuration; null removes it. Workstreams without an explicit configuration
  use the default Sunday 00:00 UTC schedule. Within the object, omitted fields
  preserve their current value and null resets that component to its default.
  """
  scanScheduleConfiguration: DevAiAutodevNextScanSchedulesInput
  """
  Deprecated recurring scan schedules. Values supplied to this field are
  ignored. Use `scanScheduleConfiguration` instead.
  
  
  This field is **deprecated** and will be removed in the future
  """
  scanSchedules: [DevAiAutodevNextScanScheduleInput!]
  "Whether AutoDev work execution sessions should use self-correction for this workstream. Defaults to true."
  selfCorrectionEnabled: Boolean
  sessionPrompt: String
  suggestedJql: String
  taskOverdueAfterDays: Int
  wipLimit: Int
  "Whether AutoDev should post comments to Jira work items. Defaults to true."
  workItemCommentsEnabled: Boolean
}

