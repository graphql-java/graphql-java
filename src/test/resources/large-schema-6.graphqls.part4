  "The supplied spaceId was blank, or not a Jira project id or ARI."
  INVALID_INPUT
  "The caller is not an admin of the space."
  PERMISSION_DENIED
}

"""
Operating-system type of a device. Shared vocabulary for any PSM surface that
distinguishes OS so OS-type values are referenced consistently rather than
redefined per contract.
"""
enum PsmOsType {
  "Apple Mac."
  MAC
  "OS type could not be determined."
  UNKNOWN
  "Microsoft Windows."
  WINDOWS
}

"Coarse remediation grouping shown on the Active Sensors row and used by the remediation-category filter."
enum PsmRemediationCategory {
  "Remediation runs automatically with no user involvement."
  AUTOMATIC
  "Requires an agent/admin to manually remediate; no automation or approval step involved."
  MANUAL
  "Automated remediation available, but pending employee/user approval before it runs."
  USER_PROMPTED
}

"How an open issue is remediated. Backs the remediation-mode filter on the Active Sensors screen."
enum PsmRemediationMode {
  "Needs a JSM agent/admin to manually intervene before it can be remediated."
  AGENT_ACTION
  "Remediation triggered automatically by PSM; no agent intervention required."
  AUTOMATED
}

"Resolution type for a remediation outcome."
enum PsmRemediationResolutionType {
  AGENT_RESOLVED
  EMPLOYEE_APPROVED
  SILENT_SAVE
}

"Outcome of a remediation. Mirrors the remediation outcomes used elsewhere in PSM."
enum PsmRemediationResult {
  FAILED
  PENDING
  SUCCESS
}

"The lifecycle state of the fix. Driven by the automation feed and, for some transitions, by user actions."
enum PsmRemediationState {
  "Approval prompt unanswered."
  AWAITING_ACTION
  "Employee denied — no automation runs."
  DECLINED
  "A support ticket was raised."
  ESCALATED
  "Automation failed."
  FAILED
  "Automation running."
  IN_PROGRESS
  "Automation succeeded, or the triggering condition cleared on its own."
  RESOLVED
  "The employee confirmed the issue is resolved (KB-assisted remediations). Self-reported, unlike the automation-verified RESOLVED. Terminal."
  USER_RESOLVED
  "The notification was withdrawn before it was actioned (stale / superseded / system shutdown)."
  WITHDRAWN
}

"Lifecycle status of the remediation for a device's open issue."
enum PsmRemediationStatus {
  "Last remediation attempt failed, fault still active."
  FAILED
  "Fault detected, no remediation attempted."
  NOT_ATTEMPTED
  "Waiting for employee approval on device."
  PENDING_APPROVAL
  "Remediation currently executing."
  RUNNING
  "Remediation completed successfully; fault resolved."
  SUCCESS
}

"How a remediation was triggered. Maps to the 'Triggered by' column."
enum PsmRemediationTrigger {
  "Triggered by a JSM agent/admin."
  AGENT
  "Fired automatically by a sensor rule (silent save); no human actor."
  AUTO
  "Triggered by the end user (help-seeker)."
  END_USER
}

"The bulk enablement action requested for sensors."
enum PsmSensorEnablementAction {
  DISABLE
  ENABLE
}

"""
The sensor notification lifecycle event being ingested for a conversation, emitted by a device
management provider: consent request/response, silent execution, execution attempts,
withdrawals (with reason), and transport/plumbing events.
"""
enum PsmSensorEventType {
  "Approval prompt shown to the employee; conversation created."
  CONSENT_REQUESTED
  "Employee responded to the approval prompt (approve / deny / snooze)."
  CONSENT_RESPONDED
  "Silent RemediationExecuted arrived (no consent needed); conversation created."
  EXECUTED
  "An execution attempt finished (may be retried; not terminal on its own)."
  EXECUTION_ATTEMPT_COMPLETED
  "An execution attempt started running (one of possibly several attempts)."
  EXECUTION_ATTEMPT_STARTED
  "Automation finished overall; carries the final outcome (succeeded / failed / skipped)."
  EXECUTION_COMPLETED
  "Transport/plumbing: the client's resume cursor was too old; a range was missed and must be resynced."
  LAGGED
  "Transport/plumbing: the event stream is shutting down."
  SHUTDOWN
  "A support ticket was raised for the conversation (from an agent workspace) and recorded on the timeline; carries the JSM ticket reference. Not relayed from the provider."
  TICKET_RAISED
  "User-originated (actor: USER, no sensor trigger): the employee confirmed the issue is resolved. Written via psm_recordUserAction, not relayed from the provider."
  USER_RESOLVED
  "Notification withdrawn: the triggering condition cleared on its own."
  WITHDRAW_CONDITION_CLEARED
  "Notification withdrawn: a scheduled timing was approved but the schedule registry was full; the approval is rolled back. Terminal even after CONSENT_RESPONDED."
  WITHDRAW_SCHEDULED_FULL
  "Notification withdrawn: the prompt expired (stale)."
  WITHDRAW_STALE
  "Notification withdrawn: superseded by a newer notification for the same issue."
  WITHDRAW_SUPERSEDED
  "Notification withdrawn: the device is shutting down."
  WITHDRAW_SYSTEM_SHUTDOWN
}

"How a sensor's remediation is handled."
enum PsmSensorRemediationType {
  AGENT_PUSHED
  AUTO_REMEDIATION_NOTIFY
  AUTO_REMEDIATION_SILENT
  KB_ASSISTED
  REQUIRES_APPROVAL
  USER_GUIDED
}

