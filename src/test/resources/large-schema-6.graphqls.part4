"# Inputs"
input KitsuneFormFieldInput {
  "Per-form help text."
  description: String
  "A FEEDBACK custom field or the Content system field. Other system fields are rejected."
  fieldId: ID! @ARI(interpreted : false, owner : "feedback", type : "field", usesActivationId : false)
  "Defaults to STANDARD."
  fieldMode: KitsuneFormFieldMode
  """
  Required when `fieldMode` is FIXED_VALUE and rejected otherwise. Must be coercible to the
  referenced field's `valueType`. SELECT and MULTISELECT take a JSON array of option ids,
  e.g. '["option1","option2"]'; SELECT accepts exactly one. Other types take a plain string.
  """
  fixedValue: String
  "Display order within the form (lower = earlier). Must be >= 0 and unique within the form."
  order: Int!
  "Defaults to false. Forced to false when `fieldMode` is FIXED_VALUE. Must be true for the Content system field."
  required: Boolean
}

