"""
One key/value entry of an action's attribute map.

GraphQL has no native map type, so per-action payload is modelled as a list of entries. Present so
future actions can carry data without a contract change; unused by RESOLVED.
"""
input PsmActionAttributeInput {
  "Attribute name. Max 64 characters."
  key: String!
  "Attribute value. Max 512 characters."
  value: String!
}

"Filters for the Active Sensors query. Fields combine with AND."
input PsmActiveSensorsFilter {
  "Restrict to sensors in this category (exact match, e.g. \"storage\"); null returns all categories."
  category: String
  "Restrict to issues with these remediation categories; null or empty returns all remediation categories."
  remediationCategories: [PsmRemediationCategory!]
  "Restrict to issues with these remediation modes; null or empty returns all remediation modes."
  remediationModes: [PsmRemediationMode!]
}

"""
Audit-log filters. Conjunctive (AND) across fields, disjunctive (OR) within an
array field — e.g. triggerTypes:[AGENT] AND results:[FAILED,PENDING] = AGENT
actions that are FAILED or PENDING.
"""
input PsmAuditLogFilter {
  "Specific actor account ids to include (OR-ed). Backs the user-account rows of 'Triggered by'."
  actorAccountIds: [ID!]
  "Optional time-range restriction; used when timeWindow is CUSTOM (or on its own). No span cap today."
  dateRange: PsmDateRangeInput
  deviceSerialNumber: String
  "Remediation categories to include (OR-ed). Backs the 'Remediation type' multi-select."
  remediationTypes: [PsmRemediationCategory!]
  results: [PsmRemediationResult!]
  "Sensor names to include (OR-ed). Backs the 'Sensor' searchable multi-select."
  sensorNames: [String!]
  "Status pills to include (OR-ed). Backs the 'Status' multi-select."
  statuses: [PsmAuditStatus!]
  "Relative preset window; CUSTOM (and only CUSTOM) reads dateRange. Backs the 'Date' dropdown."
  timeWindow: PsmAuditTimeWindow
  "'Triggered by' facet (OR-ed): AUTO = System, AGENT, END_USER. Pair with actorAccountIds to narrow to specific users."
  triggerTypes: [PsmRemediationTrigger!]
}

"Input for a permitted poll. Read-only: nothing here is persisted."
input PsmCheckDevicePermittanceInput {
  "The Atlassian account id of the device owner (help-seeker). Must be the authenticated caller's own."
  atlassianAccountId: ID!
  "Raw device serial number; normalized (C6) before lookup, same as register."
  serialNumber: String!
}

