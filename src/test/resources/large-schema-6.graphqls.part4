"""
A single entry in a classification mapping, mapping one target classification to one or more
source classifications.
"""
input JiraBulkMoveClassificationInput {
  "The IDs of the source classifications that will be mapped to the target classification."
  sourceClassificationIds: [ID!]!
  "The ID of the target classification."
  targetClassificationId: ID!
}

"Specifies inputs for searching destination projects."
input JiraBulkMoveDestinationProjectSearch {
  "Specifies the search text for destination projects."
  searchByText: String
}

"""
Represents a single bulk move request: a set of issues to be moved to a specific target
project, issue type, and optional parent, along with all the configuration needed to
resolve mandatory fields, status mappings, and classification mappings for that destination.
"""
input JiraBulkMoveInput {
  """
  When true, the system will automatically map source data classifications to valid
  target classifications where possible.
  When false, you must supply explicit classification mappings via targetClassifications.
  """
  inferClassificationDefaults: Boolean!
  """
  When true, the system will automatically infer default values for mandatory fields
  in the target project and issue type configuration where possible.
  When false, you must supply explicit field mappings via targetMandatoryFields.
  """
  inferFieldDefaults: Boolean!
  """
  When true, the system will automatically map source statuses to valid target statuses
  where possible.
  When false, you must supply explicit status mappings via targetStatuses.
  """
  inferStatusDefaults: Boolean!
  """
  When true, subtasks being moved will automatically be assigned a default subtask type
  in the target project if their current type is not available there.
  """
  inferSubtaskTypeDefaults: Boolean!
  """
  A client-supplied identifier for this move request. Echoed back in the corresponding
  per-input submission result to allow the caller to correlate each result with
  its submitted input.
  """
  inputId: String!
  "IDs of the issues to be moved to this target destination."
  selectedIssueIds: [ID!]! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  """
  Explicit data classification mappings from source classifications to valid target classifications.
  Only required when inferClassificationDefaults is false.
  """
  targetClassifications: [JiraBulkMoveClassificationInput!]
  "The ID of the target issue type."
  targetIssueTypeId: ID! @ARI(interpreted : false, owner : "jira", type : "issue-type", usesActivationId : false)
  """
  Explicit mandatory field value overrides for this target destination.
  Only required when inferFieldDefaults is false, or when the field context differs
  between source and target (e.g. project-scoped version fields).
  """
  targetMandatoryFields: [JiraBulkMoveMandatoryFieldInput!]
  """
  The ID of the target parent issue. Required when moving subtasks or when converting
  standard issues into subtasks in the target project.
  """
  targetParentIssueId: ID @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  "The ID of the target project to move issues into."
  targetProjectId: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  """
  Explicit status mappings from source workflow statuses to valid target workflow statuses.
  Only required when inferStatusDefaults is false and one or more source statuses are not
  valid in the target project and issue type workflow.
  """
  targetStatuses: [JiraBulkMoveStatusInput!]
}

"""
A logical bulk move operation that creates one asynchronous task.

Multiple target contexts are supported only when explicitly supplied
subtask target mappings accompany their parent mapping.

Generic N:N target-context moves are rejected during validation.
"""
input JiraBulkMoveInputV2 {
  "Client-supplied identifier echoed in the corresponding task progress result."
  inputId: String!
  "Target mappings submitted together as one bulk-move operation."
  targetMappings: [JiraBulkMoveTargetMappingInputV2!]!
}

"A single mandatory field override: the ID of the field and the value to set for it."
input JiraBulkMoveMandatoryFieldInput {
  "The ID of the field to override."
  fieldId: ID!
  "The value to set for this mandatory field."
  value: JiraBulkMoveMandatoryFieldValueInput!
}

"""
The value for a mandatory field override. Supports both raw (list of strings) and
ADF (Atlassian Document Format) field values, plus an optional retain flag.
"""
input JiraBulkMoveMandatoryFieldValueInput {
  "For type = ADF: the Atlassian Document Format value serialised as a JSON string."
  adfValue: String
  "For type = RAW: a list of string values (e.g. option IDs, user account IDs)."
  rawValues: [String!]
  "When true, the current field value is retained rather than overridden."
  retain: Boolean
  "The type of value being provided."
  type: JiraBulkMoveMandatoryFieldValueType!
}

"A single entry in a status mapping, mapping one target status to one or more source statuses."
input JiraBulkMoveStatusInput {
  "The IDs of the source statuses that will be mapped to the target status."
  sourceStatusIds: [ID!]! @ARI(interpreted : false, owner : "jira", type : "issue-status", usesActivationId : false)
  "The ID of the target status that source statuses will be mapped to."
  targetStatusId: ID! @ARI(interpreted : false, owner : "jira", type : "issue-status", usesActivationId : false)
}

"A bulk move destination together with the selected issues that will be moved into it."
input JiraBulkMoveStatusMappingTargetInput {
  """
  ARIs of the selected issues moving into this destination. Must be a subset of the
  issue IDs passed to jiraFetchBulkOperationDetails.
  """
  selectedIssueIds: [ID!]!
  "ARI of the destination work type."
  targetIssueTypeId: ID!
  "ARI of the destination project."
  targetProjectId: ID!
}

"A single destination target mapping within a V2 bulk move operation."
input JiraBulkMoveTargetMappingInputV2 {
  inferClassificationDefaults: Boolean!
  inferFieldDefaults: Boolean!
  inferStatusDefaults: Boolean!
  inferSubtaskTypeDefaults: Boolean!
  selectedIssueIds: [ID!]! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  targetClassifications: [JiraBulkMoveClassificationInput!]
  targetIssueTypeId: ID! @ARI(interpreted : false, owner : "jira", type : "issue-type", usesActivationId : false)
  targetMandatoryFields: [JiraBulkMoveMandatoryFieldInput!]
  targetParentIssueId: ID @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)
  targetProjectId: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  targetStatuses: [JiraBulkMoveStatusInput!]
}

"Specified bulk operation input"
input JiraBulkOperationInput {
  """
  Specifies bulk clone payload. Payload which comes as an input for bulk clone operations.
  The bulk-clone API is in beta.
  """
  bulkCloneInput: JiraBulkCloneInput
  "Specifies bulk delete payload. Payload which comes as an input for bulk delete"
  bulkDeleteInput: JiraBulkDeleteInput
  "Specifies bulk edit input. Payload which comes as an input for bulk edit"
  bulkEditInput: JiraBulkEditInput
  """
  Specifies bulk move payload. Payload which comes as an input for bulk move operations
  
  
  This field is **deprecated** and will be removed in the future
  """
  bulkMoveInput: [JiraBulkMoveInput!]
  "Specifies bulk move V2 payloads. Each input creates one asynchronous task and can contain multiple target mappings."
  bulkMoveInputV2: [JiraBulkMoveInputV2!]
  "Specifies bulk transitions payload. Payload which comes as an input for bulk transition"
  bulkTransitionsInput: [JiraBulkTransitionsInput!]
  "Specifies bulk watch or unwatch payload. Payload which comes as an input for bulk watch or unwatch operations"
  bulkWatchOrUnwatchInput: JiraBulkWatchOrUnwatchInput
  """
  Refers to whether to send bulk change notification or not.
  This flag is not applicable to bulk watch or unwatch operations.
  """
  sendBulkNotification: Boolean
}

