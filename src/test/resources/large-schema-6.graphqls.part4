  authMode: JsmChannelsAuthMode
  clientId: String!
  clientSecret: String
  connectionType: JsmChannelsConnectionType!
  displayName: String!
  exchangeUrl: String
  "Base URL for the third-party service. Required for OKTA and IDENTITYNOW connections."
