}

"Customer-facing result of a routing attempt, based on its effective team and team-member writes."
enum AgentWorkspaceRoutingHistoryStatus {
  ASSIGNED_AND_ROUTED
  ASSIGNED_TEAM_MEMBER
  ROUTED_TEAM
  SKIPPED
}

"Phase of work being executed by a routing-table generation job."
enum AgentWorkspaceRoutingTableGenerationPhase {
  "Enriching each ticket bucket using Rovo (AI) to derive service name, owning team and rules."
  ANALYSING_WITH_AI
  "Persisting drafted routing-table entries to ERS."
  SAVING_RESULTS
  "Scanning historical Jira tickets and bucketing them by service field value."
  SCANNING_TICKETS
}

"Overall status of a routing-table generation job."
enum AgentWorkspaceRoutingTableGenerationStatus {
  "The job was cancelled cooperatively by the worker after a `CANCELLING` request was observed."
  CANCELLED
  """
  The job has been requested to cancel by the admin (via `agentWorkspace_cancelRoutingTableGeneration`)
  and the worker has not yet acknowledged. The worker will observe this between buckets and
  exit cooperatively, transitioning to `CANCELLED`.
  """
  CANCELLING
  "The job has finished successfully and drafted entries are available."
  COMPLETED
  "The job has failed; see `errorMessage` for details."
  FAILED
  "The job is still running."
  IN_PROGRESS
  """
  The job exceeded its wall-clock budget (5 minutes). Drafted rows already persisted before the
  cap are preserved; the run will not produce any more rows. Distinct from `FAILED` so callers
  can surface a "took too long; partial results preserved" message.
  """
  TIMEOUT
}

