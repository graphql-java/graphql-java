"Terminal export failure. After correcting the cause, use a fresh clientRequestId to start new work; retrying the original initiation retains its failed result."
enum ConfluenceContentMetricsExportFailureCategory {
  "The content analytics service failed after permitted retries."
  CFO_FAILURE
  "Export generation was disabled by the feature gate."
  FEATURE_DISABLED
  "An internal error prevented the export from completing."
  INTERNAL_FAILURE
  "Export lifecycle persistence or completion failed after permitted retries."
  LIFECYCLE_FAILURE
  "Media upload or file processing failed after permitted retries."
  MEDIA_FAILURE
  "The original requester is unavailable or inactive."
  REQUESTER_UNAVAILABLE
  "Legacy worker no-progress failure retained for compatibility; current end-to-end budget expiry is reported as TIMED_OUT."
  TASK_STALLED
  "The five-minute preparation budget from creation expired, including queue time, generation and retries. A new attempt requires a fresh clientRequestId."
  TIMED_OUT
  "The captured export settings could not be processed."
  VALIDATION
}

"Result of an export initiation. Retry the same clientRequestId with unchanged input to recover that initiation; use a fresh ID for new work, including rerunning a terminal export."
enum ConfluenceContentMetricsExportStartOutcome {
  "Another initiation for this requester is active. No export is returned. Wait for retryAfterSeconds before retrying the same clientRequestId and input."
  ACTIVE_EXPORT_CONFLICT
  "The same initiation already exists. The export field contains its current or terminal status; a fresh clientRequestId is required to start different work."
  ATTACHED
  "Export settings were rejected during processing. Correct the settings and use a fresh clientRequestId for the corrected initiation. No export or retry delay is returned."
  INVALID_REQUEST
  "The requester or tenant initiation rate limit was reached. No export is returned. Wait for retryAfterSeconds before retrying the same clientRequestId and input."
  RATE_LIMITED
  "A new export was queued. The export field contains its status; poll its ID from the initiating page."
  STARTED
  "Start processing or subsequent status retrieval failed. Retry the same clientRequestId and unchanged input to recover any accepted initiation without creating duplicate work. No export or retry delay is returned."
  START_FAILED
  "The task could not be submitted. No export is returned. Retry the same clientRequestId and unchanged input, observing retryAfterSeconds when provided."
  TASK_SUBMISSION_REJECTED
  "Tenant export concurrency is full. No export is returned. Wait for retryAfterSeconds before retrying the same clientRequestId and input."
  TENANT_CAPACITY_REACHED
}

