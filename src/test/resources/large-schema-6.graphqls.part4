"""
Canonical, stable status keys for the CSM Conversation workflow. These keys are independent of
the localized status `name` and the user-customizable workflow, and are intended for clients
that need to branch behaviour based on the workflow stage.
"""
enum JiraCsmConversationStatusKey {
  "The conversation is actively being handled by an agent."
  ACTIVE
  "The conversation has been closed."
  CLOSED
  "The conversation is being reassigned to another agent."
  REASSIGNING
  "The conversation is waiting for an agent to respond."
  WAITING_FOR_AGENT
  "The conversation is being wrapped up before closure."
  WRAPPING_UP
}

