  unitValue: String!
  "The preset value type."
  valueType: AgentStudioPresetValueType!
}

"Input for publishing an agent version"
input AgentStudioPublishAgentVersionInput {
  """
  Entity version of the current LIVE agent version, used for optimistic locking to prevent race conditions.
  If provided, the publish will fail with a conflict error (HTTP 409) if another publish has occurred
  since this etag was read (i.e. the LIVE version has changed concurrently).
  The etag value is the 'id' field of the current LIVE AgentVersion, returned in the agent version history.
  If omitted, the publish proceeds without optimistic locking (backwards compatible behaviour).
  """
  etag: String
}

"""
An ACPS-owned filter for this root. Convo AI declares the public shape of
`AgentStudioLiveConversationFilterInput`, so that input can only ever be a superset
of its contract; this one evolves with the Rovo projections ACPS actually implements.
Supplying both filters is rejected.
"""
input AgentStudioRovoConversationFilterInput {
  containment: AgentStudioConversationContainment
  createdAfter: String
  createdBefore: String
  "`LIKE` or `DISLIKE`, case-insensitive. Any other value is rejected."
  customerFeedback: [String]
  "`true` selects conversations in which a tool invocation failed on any message; `false` selects every other conversation. Omitting the field returns both."
  hasError: Boolean
  "Search message content within this agent. Omit or leave blank for ordinary listing."
  searchQuery: String
  surfaces: [String]
  updatedAfter: String
  updatedBefore: String
}

