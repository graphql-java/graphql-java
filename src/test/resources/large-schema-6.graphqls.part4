"An AI-suggested Butler automation."
type TrelloAiAutomationSuggestion {
  """
  The suggested automation. This is the same plain-English description as
  `description`, and is not necessarily valid Butler grammar.
  
  
  This field is **deprecated** and will be removed in the future
  """
  command: String!
  """
  A plain-English description of the automation, close to Butler's phrasing
  but not necessarily valid Butler grammar. Pass it as the prompt to
  `createAutomationFromPrompt` to create the automation.
  """
  description: String
  "A short title for the automation, suitable as a button label."
  name: String!
  """
  Why the automation is being suggested, referring to the member's repeated
  actions that it automates.
  """
  reason: String!
  """
  The type of automation being suggested. The command created from the
  description determines the actual type.
  """
  type: TrelloAutomationType!
}

"AI-suggested Butler automations for a member on a board."
type TrelloAiAutomationSuggestions {
  """
  The suggested automations, most useful first. Empty when the member has no
  repeated activity to automate.
  """
  suggestions: [TrelloAiAutomationSuggestion!]!
}

"A record of an AI feature that was used to create or update a Trello object."
type TrelloAiFeature {
  "Any error that occurred during the AI feature invocation. Null if no error occurred."
  creationMethodError: String
  "The time the AI feature started loading. Null if loading state was not tracked."
  creationMethodLoadingStartedAt: DateTime
  """
  The date when the AI-created or AI-updated object was viewed by its creator.
  Null if not tracked.
  """
  dateViewedByCreator: DateTime
  "The entities that were created or updated by this AI feature."
  entities: [TrelloAiFeatureEntity!]
  "The name of the AI feature that was used."
  feature: String!
  """
  Metadata about each LLM call made during this AI feature invocation, including
  the model, use case, and token count.
  """
  modelMetadata: [TrelloModelMetadata!]
  "The instrumentation ID for the AI interaction. Null if not tracked."
  singleInstrumentationId: String
  """
  The stage the AI feature is currently in (e.g. 'RESEARCHING', 'SUMMARIZING', etc.)
  Various implementations will define different enumerated values based on the feature, so clients must agree on
  meaningful values out-of-band and must be able to handle unexpected values gracefully.
  """
  stage: String
}

"An entity that was created or updated as a result of an AI feature invocation."
type TrelloAiFeatureEntity {
  "The action taken on the entity."
  action: TrelloAiFeatureEntityAction!
  "The ID of the entity, if applicable."
  id: ID
  "The type of the entity (e.g. checklist, card)."
  type: String!
}

"""
Read-only progress of one agent operation on a card, derived from the backing
agent session and task.
"""
type TrelloAiProgress {
  "The agent performing the work (kind and display identity), not a unique run ID."
  agent: TrelloAgent
  """
  The `ai-progress` ARI of this operation, one per session, task, and target
  entity. For example:
  `ari:cloud:trello::ai-progress/<sessionId>/<taskId>/card/<cardId>`.
  It embeds the session, task, and target IDs, but clients treat it as opaque.
  """
  id: ID!
  "The member who invoked this operation."
  invokingMember: TrelloMember
  """
  When the task's status was last written (a state change or a new status
  message). The same value for every viewer.
  """
  lastUpdatedAt: DateTime
  "Invoker-only details; null for other viewers."
  privilegedDetails: TrelloAiProgressDetail
  """
  Task state, mapped 1:1. The same value for every viewer; clients decide how
  each viewer sees it (for example, a non-invoker might see "Agent working"
  for INPUT_REQUIRED).
  """
  state: TrelloAgentTaskState
}

"Connection type between a card and the progress of its agent operations."
type TrelloAiProgressConnection {
  "This page of visible operations, ordered by stable operation ID."
  edges: [TrelloAiProgressEdge!]
  "Pagination metadata, including hasNextPage and endCursor."
  pageInfo: PageInfo!
}

"Connection of AI progress deltas (edges only, relay-style)."
type TrelloAiProgressConnectionUpdated {
  "Included operation updates; not a replacement for the full collection."
  edges: [TrelloAiProgressEdgeUpdated!]
}

"An AI progress operation removed from a card."
type TrelloAiProgressDeleted {
  """
  The `ai-progress` ARI of this operation, one per session, task, and target
  entity. For example:
  `ari:cloud:trello::ai-progress/<sessionId>/<taskId>/card/<cardId>`.
  It embeds the session, task, and target IDs, but clients treat it as opaque.
  Remove the operation with this ID from the viewer's cached connection.
  """
  id: ID!
}

"Details of an agent operation that only the invoking member can see."
type TrelloAiProgressDetail {
  """
  The task's latest status message; null if none. For AI Board Builder, it's
  one of the message keys listed on TrelloAgentTaskStatus.message.
  """
  message: String
  "ARI of the backing session; use with session APIs to act on the work."
  sessionId: ID
  "ARI of the backing task for this specific operation."
  taskId: ID
}

"Represents a basic relationship between a card and a TrelloAiProgress."
type TrelloAiProgressEdge {
  "Opaque pagination position for this operation."
  cursor: String!
  "The operation's current progress view."
  node: TrelloAiProgress
}

"Edge wrapping a single updated AI progress operation."
type TrelloAiProgressEdgeUpdated {
  "An operation identified by its stable ID, with fields to merge."
  node: TrelloAiProgressUpdated
}

"Realtime projection of a TrelloAiProgress delivered over `onBoardUpdated`."
type TrelloAiProgressUpdated {
  "The agent performing the work, when included in this update."
  agent: TrelloAgentUpdated
  """
  The `ai-progress` ARI of this operation, one per session, task, and target
  entity. For example:
  `ari:cloud:trello::ai-progress/<sessionId>/<taskId>/card/<cardId>`.
  It embeds the session, task, and target IDs, but clients treat it as opaque.
  Matches TrelloAiProgress.id so deltas normalize onto the same cache entry.
  """
  id: ID!
  "The member who invoked this operation, when included in this update."
  invokingMember: TrelloMemberUpdated
  """
  When the task's status was last written (a state change or a new status
  message), when included in this update. The same value for every viewer.
  """
  lastUpdatedAt: DateTime
  """
  Invoker-only detail update; omitted from events sent to general viewers.
  Reuses TrelloAiProgressDetail, whose fields are all nullable, rather than a
  separate update type. An explicit null message clears a previous message.
  """
  privilegedDetails: TrelloAiProgressDetail
  """
  Task state, mapped 1:1, when included in this update. The same value for
  every viewer; clients decide how each viewer sees it (for example, a
  non-invoker might see "Agent working" for INPUT_REQUIRED).
  """
  state: TrelloAgentTaskState
}

"A TrelloAiRule represents an existing AI rule created by a member to guide AI on their behalf."
