"BundleCollectionEntitlementInput"
input CommerceExpBundleCollectionEntitlementInput {
  "Override of the charge quantities used when comparing recurring estimate with bundle recurring estimate"
  chargeQuantitiesForRecurringEstimate: [CommerceExpChargeQuantityInput!]
  entitlementId: ID!
}

"BundleCollectionInput"
input CommerceExpBundleCollectionInput {
  """
  Which billing cycle to create the collection for, only MONTH and YEAR is
  supported at the moment. Defaults to MONTH if not provided
  """
  billingCycle: CommerceExpPricingPlanInterval = MONTH
  """
  Charge quantities (charge element + quantity) for the creation order.
  When provided, these are used instead of values derived from order defaults / usage.
  """
  chargeQuantities: [CommerceExpChargeElementDetails!]
  """
  The collection offering to create, e.g. a Teamwork Collection offering. Must be
  a collection parent offering
  """
  collectionOfferingKey: ID!
  """
  Requires at least one existing entitlement to move into the collection.
  
  Any new collection instances which need to be created are determined based on the
  collectionOfferingId required relationships
  """
  entitlements: [CommerceExpBundleCollectionEntitlementInput!]!
  """
  Trial intent for the collection being created.
  
  Unless the trial is skipped, the collection's trial always ends at the latest
  active trial among the entitlements being bundled, with a minimum of 7 days from
  now, so nobody loses trial time they already had. Instances created by this
  order have no trial of their own to match and inherit the collection's.
  """
  trial: CommerceExpTrialIntentInput
}

