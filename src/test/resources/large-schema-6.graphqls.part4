  "When the activity started."
  startedAt: DateTime
  "Overall lifecycle state of the activity."
  status: TrelloAgenticActivityStatus
  "Human-readable label for the work, e.g. \"Triaging stale cards\"."
  summary: String
  "The id of the entity the agent is working on (e.g. a card id)."
  targetId: ID
  "The kind of entity the agent is working on."
  targetType: TrelloAgenticActivityTargetType
