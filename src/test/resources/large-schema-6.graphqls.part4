"""
Filters and sort options for avp_searchDashboards. All filter fields are optional; when omitted, the
filter is not applied. Pagination is controlled separately via the query's `first` / `after` arguments.
"""
input AVPSearchDashboardsInput {
  "Sort order. Defaults to descending when omitted."
  ascending: Boolean
  "Filter by category (substring match, wildcards applied server-side)."
  category: String
  "Optional container ARI to filter dashboards by their container relationship. When provided, only dashboards linked to this container are returned."
  containerAri: ID @ARI(interpreted : false, owner : "any", type : "any", usesActivationId : false)
  "Filter by one or more creator (initial contributor) identity user ARIs."
  creatorAris: [ID!] @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  "Filter to a specific set of dashboard ARIs. When provided, only dashboards whose IDs are in this list will be returned. Can be combined with title and other filters."
  ids: [ID!] @ARI(interpreted : false, owner : "avp", type : "dashboard", usesActivationId : false)
  "Optional integration ID to scope the search to a specific integration (e.g. jsm-assets). When omitted, no integration filter is applied."
  integrationId: String
  "Optional permission type to filter dashboards by the current user's access level. READ returns dashboards the user can view; WRITE returns dashboards the user can edit. When omitted, no permission filter is applied."
  permissionType: AVPSearchPermissionType
  "Field to sort results by. Omit for default (relevance) ordering."
  sortKey: AVPDashboardSortKey
  "When true, only return dashboards starred by the current user. Defaults to false when omitted."
  starredOnly: Boolean
  "Filter by dashboard status. Omit to include dashboards of all statuses."
  status: AVPDashboardStatus
  "Free-text search over the dashboard title."
  title: String
  "Filter by dashboard layout type. SIMPLE for canvas layout (platform) dashboards, ADVANCED for grid layout (legacy AA) dashboards. When omitted, dashboards of all types are returned."
  type: AVPDashboardType
}

"""
Input for avp_signForgeContextToken: the caller must have access to the dashboard and to the
site named in `contextIds`.
