"""
A single rule within a policy create/update request.
The rule's domain is taken from its enclosing key in rulesByDomain, and its
ruleId is allocated by the server, so neither is supplied by the client here.
"""
input JiraPolicyRuleInput {
  "A human-readable description of the rule."
  description: String
  "Optional configuration properties for the rule, as a JSON object."
  properties: JSON @suppressValidationRule(rules : ["JSON"])
  """
  The existing rule id to preserve across an update. Omit on create (the server allocates one);
  a rule submitted without a ruleId on update is treated as newly added and receives a fresh id.
  """
  ruleId: ID
  "The rule type identifier (e.g. system:workflow:no-local-status)."
  ruleTypeId: String!
}

"A set of rules for a single domain within a policy create/update request."
input JiraPolicyRulesByDomainInput {
  "The domain these rules apply to (e.g. \"workflow\", \"field\")."
  domain: String!
  "The rules for this domain."
  rules: [JiraPolicyRuleInput!]!
}

