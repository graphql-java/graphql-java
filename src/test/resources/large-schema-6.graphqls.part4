"Configuration for detecting and monitoring usage patterns"
type UtsAlertDetector {
  "The consumer key for usage tracking"
  consumerKey: String
  "The consumer key type for usage tracking"
  consumerKeyType: String
  "The expression used to evaluate alert conditions"
  expression: String
  "The formula used to calculate usage metrics"
  formula: String
  id: ID!
  "Policy defining whether the alert can be retriggered"
  retriggerPolicy: UtsAlertRetriggerPolicy
  "The usage key in usage tracking service (UTS) that this detector monitors"
  usageKey: String!
}

"Defines the threshold value that triggers an alert"
type UtsAlertThreshold {
  "The unique identifier for the usage being tracked"
  usageIdentifier: String!
  "The threshold value that triggers the alert when crossed"
  value: Float
}

"Represents an allowance exemption returned by UTS for a given scope and usage key."
type UtsAllowanceExemption {
  effectiveFrom: String
  effectiveTo: String
  """
  
  
  
  This field is **deprecated** and will be removed in the future
  """
  exemptionType: String
  expiresAt: String
  id: ID
  reason: String
  scopeId: ID
  scopeType: UtsAllowanceExemptionScopeType
  status: UtsAllowanceExemptionStatus
  type: UtsAllowanceExemptionType
  usageKey: String
}

"""
Paginated list of allowance exemptions returned by UTS.

Maps to UTS REST API response: { count, nextPageToken, exemptions }.
"""
type UtsAllowanceExemptionList {
  count: Int
  exemptions: [UtsAllowanceExemption]
  nextPageToken: String
}

"""
Allowance pool returned by UTS for a given owner.

Maps to UTS REST API response AllowancePoolResponse.
Exposes id, owner, usageKey, allowance (Float for GraphQL; UTS int64), and status.
Fields are nullable per CCP GraphQL schema-evolution guidelines.
"""
type UtsAllowancePool {
  allowance: Float
  id: ID
  owner: String
  """
  Prepaid drawdown packs attached to the pool.
  
  Maps to UTS REST API: GET /api/v1/allowance-pool/{id}/members?includePacks=true
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "UtsPrepaidDrawdownPack")' query directive to the 'packs' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  packs: [UtsPrepaidDrawdownPack] @lifecycle(allowThirdParties : false, name : "UtsPrepaidDrawdownPack", stage : EXPERIMENTAL)
  status: UtsAllowancePoolStatus
  usageKey: String
}

"Result of an asynchronous allowance pool allocation update."
type UtsAllowancePoolAllocationUpdateResult {
  """
  The id of the updated allocation.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ✅ Yes |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  allocationId: ID
  """
  The pool that the allocation belongs to.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ✅ Yes |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  poolId: ID
  """
  The id of the asynchronous transaction that was created to apply the update.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ✅ Yes |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  transactionId: ID
}

"Default allowance values for the meter, including the system-level limit."
type UtsMeterAllowanceDefaults {
  enforcementMode: String
  overageCap: UtsMeterOverageCap
  systemLimit: Float
}

"Allowance metadata containing defaults for the meter."
type UtsMeterAllowanceMetadata {
  allowanceDefaults: UtsMeterAllowanceDefaults
}

"Meter configuration for a given usage key, as returned by UTS."
type UtsMeterConfiguration {
  allowanceMetadata: UtsMeterAllowanceMetadata
  usageKey: String
}

"Overage cap configuration for the meter."
type UtsMeterOverageCap {
  type: String
  value: Float
}

type UtsPrepaidDrawdownPack {
  archivedAt: Float
  balance: Float
  baseAllowance: Float
  ceiling: Float
  createdAt: Float
  displayStatus: UtsPrepaidDrawdownPackDisplayStatus
  expiresAt: Float
  id: ID!
  lastRefreshedAt: Float
  startsAt: Float
  status: UtsPrepaidDrawdownPackStatus
  updatedAt: Float
  usageKey: String
}

"""
Reset-policy time windows for an allowance pool. UTS computes the windows as calendar days in UTC;
each date is returned as Unix epoch milliseconds at midnight UTC on that day.
"""
type UtsResetPolicy {
  "When the current window ends: midnight UTC after its last day. Same moment as nextResetWindowStart."
  currentWindowEnd: Float
  "The first day of the current window."
  currentWindowStart: Float
  frequency: String
  "The first day of the next window. The allowance resets at midnight UTC on this day."
  nextResetWindowStart: Float
  status: String
}

"""
A usage alert represents a threshold-based notification for usage tracking.
Alerts are triggered when usage metrics cross defined thresholds.
"""
type UtsUsageAlert {
  "Timestamp when the alert was created"
  createdAt: Float
  "The detector configuration that monitors and triggers this alert"
  detector: UtsAlertDetector
  id: ID!
  "The initial usage value when the alert was created"
  initialValue: Float
  "The most recent usage value recorded"
  lastUpdatedValue: Float
  "The current state of the alert"
  state: UtsAlertState
  "The threshold configuration that defines when this alert should trigger"
  threshold: UtsAlertThreshold
  "Timestamp when the alert was last updated"
  updatedAt: Float
  "The unique identifier for the usage being tracked"
  usageIdentifier: String!
  "The version of this alert, incremented with each update"
  version: Float
}

