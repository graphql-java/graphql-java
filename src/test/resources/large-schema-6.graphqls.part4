enum GraphIntegrationTwgCapabilityStatus @renamed(from : "TwgCapabilityStatus") {
  DISABLED
  ENABLED
}

"A platform capability that can be globally toggled by an admin"
enum GraphIntegrationTwgCapabilityType @renamed(from : "TwgCapabilityType") {
  PLATFORM_MCP_SERVER
  THIRD_PARTY_ACTION
}

"The RBAC access mode for a TWG product — controls how per-user access to the product's actions and tools is enforced."
enum GraphIntegrationTwgProductAccessMode @renamed(from : "TwgProductAccessMode") {
  "All users have access unless explicitly denied (RBAC blacklist enforcement)."
  DEFAULT_ALLOW
  "No users have access unless explicitly allowed (RBAC whitelist enforcement)."
  DEFAULT_DENY
}

