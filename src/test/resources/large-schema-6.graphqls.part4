  "Control-plane destination group id (`destinationGroups[].id` from GET) for `UPDATE`, `DELETE`, or path."
  id: ID
  "Display label of the group on the canvas."
  name: String
  "Operation on this group (`CREATE`, `UPDATE`, `DELETE`), or null when used as a path."
