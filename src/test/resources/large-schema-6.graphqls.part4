"Enum to define a filter operation on the optionIds in input JiraFieldOptionIdsFilterInput"
enum JiraFieldOptionIdsFilterOperation {
  """
  Allow the optionIds provided in the JiraFieldOptionIdsFilterInput from available options
  with intersection of result from searchBy query string.
  """
  ALLOW
  """
  Exclude the optionIds provided in the JiraFieldOptionIdsFilterInput from available options
  with intersection of result from searchBy query string.
  """
  EXCLUDE
}

"""
Reason a prediction service was skipped for a field (i.e. produced no candidates because
a precondition was not met, rather than because the model returned nothing).
"""
enum JiraFieldPredictionSkipReason {
  """
  Service does not support this field's type — e.g. URS is only valid for user fields
  (assignee), or SIMILAR_ISSUES / KNN_SIMILAR_ISSUES have no multi-value extractor
  registered for the field type.
  """
  FIELD_TYPE_UNSUPPORTED
  """
  Service requires additional request context before it can run. Applies to
  SIMILAR_ISSUES / KNN_SIMILAR_ISSUES when no summary text is supplied. Existing
  issueId is still used as objectId for analytics, but is not enough context for
  these services because they do not hydrate issue content from objectId.
  """
  INSUFFICIENT_CONTEXT
  """
  Service requires non-blank semantic context (typically the work-item summary) but
  none was supplied. Applies to SEMANTIC.
  """
  MISSING_SEMANTIC_CONTEXT
  """
  Service requires an authenticated user but the caller is anonymous. Applies to
  URS, SIMILAR_ISSUES, and KNN_SIMILAR_ISSUES.
  """
  UNAUTHENTICATED
}

enum JiraFieldPredictionSource {
  "Agent / conversational AI prediction source."
  AGENT
  "Global issue create (GIC) prediction source."
  GIC
}

"""
Available prediction service types a client can explicitly request.
Mirrors the server-side `FieldPredictionProvider.Service` enum, excluding `NOOP`
(which is an internal analytics baseline, not user-requestable).
"""
enum JiraFieldPredictionType {
  "Collaboration Graph behavioural predictions."
  BEHAVIOURAL
  "KNN similar-issues-based predictions."
  KNN_SIMILAR_ISSUES
  "Semantic (context-aware) predictions using Collaboration Graph + embedding similarity."
  SEMANTIC
  "Similar-issues-based predictions."
  SIMILAR_ISSUES
  "URS (User Recommendation Service) backed predictions."
  URS
}

enum JiraFieldScopeType {
  " Represents all field scopes"
  ALL
  " Represents global scoped fields"
  GLOBAL
  " Represents project scoped fields"
  PROJECT
}

enum JiraFieldStatusType {
  " Represents the field that is active or unassociated"
  ACTIVE
  " Represents the field that is deleted"
  TRASHED
}

"The action to apply to one or more AI field update suggestions."
enum JiraFieldSuggestionAction {
  "Accept the AI-suggested value — the field will be updated with the suggested value."
  ACCEPT
  "Decline the AI-suggested value — the suggestion will be marked as rejected."
  DECLINE
}

enum JiraFieldSuggestionLifecycleStatus {
  ACCEPTED
  AUTO_ACCEPTED
  PENDING
}

"Per-field outcome status within a JiraFieldActionFieldResult."
enum JiraFieldSuggestionStatus {
  ERROR
  FIELD_VALIDATION_ERROR
  PERMISSION_DENIED
  STALE_SUGGESTION
  SUCCESS
}

"The options for filter search mode for user preference in List Filter switcher tab."
enum JiraFilterSearchMode {
