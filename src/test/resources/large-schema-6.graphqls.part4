  Scope ARI for the team. Accepts a userbase ARI (e.g. `ari:cloud:identity::userbase/{userbaseId}`)
  or a site ARI (e.g. `ari:cloud:platform::site/{siteId}`), which is mapped to its userbase.
  """
  scopeId: ID!
  "ID of the team to remove members from."
  teamId: ID! @ARI(interpreted : false, owner : "identity", type : "team", usesActivationId : false)
}

