  owner: String!
  type: String
}

"The HTML to author an artifact document from, and how it should be presented."
input ArtifactAuthorContentInput {
  "The unit, or the Jira or Confluence site or workspace, to author in, as an ARI."
  contextId: ID!
  """
  The HTML to author, as the content of the document's `body`. A whole
  document is not expected: the surrounding shell, the design tokens and the
  base styles are supplied for you.
  """
  html: String!
  """
  Browser libraries to make available to the content, each inlined into the
  document before it. Not supported yet: asking for one is rejected, and the
  field is here so that callers can be written against it.
  """
  libraries: [ArtifactBrowserLibraryInput!]
  """
  Name of the artifact this content is for, which is also the authored
  document's title.
  """
  name: String!
  "Design token values to override, for this document only."
  tokenOverrides: [ArtifactTokenOverrideInput!]
}

"Where to read the authoring catalog."
input ArtifactAuthoringCatalogInput {
  "The unit, or the Jira or Confluence site or workspace, to read the catalog in, as an ARI."
  contextId: ID!
}

"Which authoring guidance to read."
input ArtifactAuthoringGuidanceInput {
  """
  Which category to read, or `all` for the whole guide at once. The catalog
  names the categories.
  """
  category: String!
  "The unit, or the Jira or Confluence site or workspace, to read the guidance in, as an ARI."
  contextId: ID!
}

"One browser library, at one version, to inline into the authored document."
input ArtifactBrowserLibraryInput {
  "Id of the library in the authoring catalog, such as `chart.js`."
  id: String!
  "Exact version of the library to inline, such as `4.4.7`."
  version: String!
}

"Describes the content an upload target is being created for."
input ArtifactCreateContentInput {
  "Checksum of the content, so that the upload can be verified."
  checksum: String!
  "The algorithm `checksum` was computed with."
  checksumType: ArtifactChecksumType!
  "The unit, or the Jira or Confluence site or workspace, to create the content in, as an ARI."
  contextId: ID!
  "Size of the content in bytes."
  length: Int!
}

input ArtifactCreateInput {
  "Who can see the artifact once it exists. Defaults to `OPEN` when absent."
  access: ArtifactAccess
  """
  The uploaded content this artifact refers to, as returned by
  `artifact_createContent`.
  """
  contentId: ID!
  "The unit, or the Jira or Confluence site or workspace, to create the artifact in, as an ARI."
  contextId: ID!
  """
  Free text describing the content of the artifact. It is indexed to improve
  how well the artifact is found in search. Up to 1000 characters.
  """
  description: String
  name: String!
  type: String!
}

"Describes the thumbnail image being uploaded, and the artifact it depicts."
input ArtifactCreateThumbnailInput {
  "Checksum of the image, so that the upload can be verified."
  checksum: String!
  "The algorithm `checksum` was computed with."
  checksumType: ArtifactChecksumType!
  "The unit, or the Jira or Confluence site or workspace, the artifact belongs to, as an ARI."
  contextId: ID!
  "The artifact to create the thumbnail for."
  id: ID!
  "Size of the image in bytes."
  length: Int!
  "Replace an existing thumbnail. Defaults to false."
  overwrite: Boolean
}

input ArtifactDeleteInput {
  "The unit, or the Jira or Confluence site or workspace, the artifact belongs to, as an ARI."
  contextId: ID!
  "The artifact to delete."
  id: ID!
}

"Which family of design tokens to read."
input ArtifactDesignTokensInput {
  "The unit, or the Jira or Confluence site or workspace, to read the tokens in, as an ARI."
  contextId: ID!
  "Which family to read. The catalog names the families."
  family: String!
}

input ArtifactGetInput {
  "The unit, or the Jira or Confluence site or workspace, the artifact belongs to, as an ARI."
  contextId: ID!
  id: ID!
}

"Who to grant share permissions on an artifact to."
input ArtifactShareInput {
  """
  The users, groups, and teams to share the artifact with, as ARIs.
  
  Teams are named by their identity ARI, `ari:cloud:identity::team/`, not by
  `ari:cloud:teams::team/`: both name the same team, and accepting either
  would let one team hold two shares that grant and revoke independently.
  
  Sharing with everyone who has the link, or with the whole organisation, is
  not done here. Those are the artifact's access level, set through
  `artifact_updateArtifact`, so any other ARI is rejected.
  
  At least one is required, and the whole call is refused if any one of them is
  not an audience, so a partial share is never reported as a success.
  """
  audienceAris: [String!]! @ARI(interpreted : false, owner : "identity", type : "", usesActivationId : false)
  "The unit, or the Jira or Confluence site or workspace, the artifact belongs to, as an ARI."
  contextId: ID! @ARI(interpreted : false, owner : "", type : "", usesActivationId : false)
  "The existing artifact to share."
  id: ID!
}

"Who to take share permissions off an artifact."
input ArtifactShareRevokeInput {
  """
  The users, groups and teams to revoke, as ARIs.
  
  Must name at least one; an empty list is refused, not read as everybody.
  Omit only when setting `revokeAll`. Teams may be named by team ARI, as
  when granting.
  """
  audienceAris: [String!] @ARI(interpreted : false, owner : "identity", type : "", usesActivationId : false)
  "The unit, or the Jira or Confluence site or workspace, the artifact belongs to, as an ARI."
  contextId: ID! @ARI(interpreted : false, owner : "", type : "", usesActivationId : false)
  "The artifact to take the audience off."
  id: ID!
  """
  Revoke every individual share instead of named audiences.
  
  Cannot be combined with `audienceAris`. Does not make the artifact
  private: use `artifact_updateArtifact` for that.
  """
  revokeAll: Boolean
}

"A single design token given a different value for this document."
input ArtifactTokenOverrideInput {
  "Which colour mode the override applies in. Defaults to both."
  colorMode: ArtifactColorMode
  "The token's CSS custom property name, such as `--ds-background-accent-blue-subtle`."
  name: String!
  "The CSS value to use. A single value: declarations and blocks are rejected."
  value: String!
}

input ArtifactUpdateInput {
  access: ArtifactAccess
  "The uploaded content returned by artifact_createContent. Supplying it publishes a new version."
  contentId: ID
  "The unit, or the Jira or Confluence site or workspace, the artifact belongs to, as an ARI."
  contextId: ID!
  "Free text describing the artifact. Send an empty string to clear it. Up to 1000 characters."
  description: String
  "The existing artifact to publish a new version of."
  id: ID!
  name: String!
  "Required alongside contentId when publishing a new version."
  type: String
}

