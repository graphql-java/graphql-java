"Input for a single sensor event ingest. All correlation ids pass through from the provider's sensor event envelope."
input PsmIngestSensorEventInput {
  "Deprecated and ignored: the server sources the acting employee from the authenticated context. Kept optional for backwards compatibility until callers stop sending it."
  accountId: ID
  "Whether the event was produced by the employee or the system."
  actor: PsmEventActor!
  "1-based index of this attempt; set on EXECUTION_ATTEMPT_COMPLETED events."
  attemptNumber: Int
  "Total attempts consumed by the run; set on EXECUTION_COMPLETED events."
  attemptsUsed: Int
  "The employee's approval decision; set only on CONSENT_RESPONDED events, null otherwise."
  consentResponse: PsmConsentResponse
  "PSM device id the fault is on."
  deviceId: ID!
  "The lifecycle event being ingested."
  event: PsmSensorEventType!
  "Occurrence id — one of batch_id or consent_id."
  eventId: ID!
  "Machine-readable failure reason (e.g. \"runner_timeout\"); set only when outcome is FAILED."
  failureReason: String
  "Transport-level idempotency/dedupe key from the endpoint envelope."
  notificationId: ID!
  "When the event occurred on the endpoint (UTC)."
  occurredAt: DateTime!
  "The run/attempt outcome; set on EXECUTION_ATTEMPT_COMPLETED and EXECUTION_COMPLETED events, null otherwise."
  outcome: PsmExecutionOutcome
  "The automation associated with the sensor. Sent only on arrival events (CONSENT_REQUESTED / EXECUTED); resolved from the conversation on follow-ups."
  remediationId: ID
  "Which sensor definition fired. Sent only on arrival events (CONSENT_REQUESTED / EXECUTED); resolved from the conversation on follow-ups."
  sensorId: ID
  "Per-notification sequence; dedupe key = notificationId + sequence."
  sequence: Int!
  "Per-conversation monotonic version for transition ordering; absent on arrival events."
  version: Int
  "Whether the provider will retry after this attempt; set on EXECUTION_ATTEMPT_COMPLETED events."
  willRetry: Boolean
}

