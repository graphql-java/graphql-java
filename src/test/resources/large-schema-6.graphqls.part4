input TrelloEnableBoardPowerUpInput {
  "The board on which the Power-Up will be enabled"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "The application ARI of the Power-Up to enable"
  powerUpId: ID! @ARI(interpreted : false, owner : "trello", type : "application", usesActivationId : false)
}

"Arguments passed into the enable board self join mutation"
input TrelloEnableBoardSelfJoinInput {
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into the enable card front complete toggle mutation"
input TrelloEnableCardFrontCompleteToggleInput {
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into the endVoiceCaptureSession mutation."
input TrelloEndVoiceCaptureSessionInput {
  "The ARI of the voice capture session to end."
  sessionId: ID!
}

"Input for the enqueueGenerateBoardBackgroundJob mutation"
input TrelloEnqueueGenerateBoardBackgroundJobInput {
  "The board to generate a background for"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "The theme to use for the board background"
  theme: String
  "The user input to AI to help create a personalized board background"
  userInput: String!
}

"""
Input for the enqueueProposePlannerEventsJob mutation. Mirrors
TrelloProposePlannerEventsInput so existing callers can migrate without
changing the request shape.
"""
input TrelloEnqueueProposePlannerEventsJobInput {
  """
  The IDs of the cards to schedule. If not provided, we will select the
  cards to schedule from the user's inbox.
  """
  cardIds: [ID!] @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
  "The timezone offset in hours from UTC."
  timezoneOffsetHours: Float!
}

"Synthetic state and questions to evaluate with Jev. Do not include Hello or customer data."
input TrelloEvaluateWithJevInput {
  "A JSON object containing Jev question definitions."
  questions: JSON! @suppressValidationRule(rules : ["JSON"])
  "A JSON object containing the synthetic state to evaluate."
  state: JSON! @suppressValidationRule(rules : ["JSON"])
}

"""
Arguments for generating and caching an AI summary of an uploaded PDF
attachment.
"""
input TrelloGenerateAttachmentSummaryInput {
  "The uploaded PDF attachment to summarize."
  attachmentId: ID! @ARI(interpreted : false, owner : "trello", type : "attachment", usesActivationId : false)
  "The card containing the attachment."
  cardId: ID! @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
}

"Input for the generateAttachmentSummaryWithAi mutation"
input TrelloGenerateAttachmentSummaryWithAiInput {
  "Also append the summary to the card description"
  addToDescription: Boolean
  "The uploaded PDF, DOC, DOCX, XLSX, image or text attachment to summarize"
  attachmentId: ID! @ARI(interpreted : false, owner : "trello", type : "attachment", usesActivationId : false)
  "The card containing the attachment"
  cardId: ID! @ARI(interpreted : false, owner : "trello", type : "card", usesActivationId : false)
}

"Arguments passed into generateBoardBackgroundWithAi mutation"
input TrelloGenerateBoardBackgroundWithAiInput {
  "The board to generate a background for"
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
  "The theme to use for the board background"
  theme: String
  "The user input to AI to help create a personalized board"
  userInput: String!
}

"Arguments for generateBoardEmailAddress."
input TrelloGenerateBoardEmailAddressInput {
  "Board whose viewer email settings will change."
  boardId: ID! @ARI(interpreted : false, owner : "trello", type : "board", usesActivationId : false)
}

"Arguments passed into generateCardCoverWithAi mutation"
input TrelloGenerateCardCoverWithAiInput {
  "The card to generate a cover for"
