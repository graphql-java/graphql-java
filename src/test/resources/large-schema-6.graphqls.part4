"Input to update an end-user agent configuration."
input JiraUpdateEndUserAgentConfigurationInput {
  """
  The conditions under which the agent executes, as the project and status combinations it runs in.
  Replaces the configuration's current coverage rather than adding to it.
  """
  appliesTo: [JiraEndUserAgentProjectStatusInput!]!
  "Version of the configuration the caller read. If omitted or null, uses the current server version for compatibility."
  expectedVersion: Long
  "ARI of the configuration to update."
  id: ID! @ARI(interpreted : false, owner : "jira", type : "end-user-agent-configuration", usesActivationId : false)
  """
  Name of the configuration. Must not be blank, and at most 255 characters counted in UTF-16 code units
  (JavaScript `String.length`), so an emoji counts as two. Fails with errorType NAME_REQUIRED or NAME_TOO_LONG.
  """
  name: String!
  """
  Prompt given to the agent. Null clears it.
  When changed, at most 10,000 characters, counted like the name. Fails with errorType PROMPT_TOO_LONG.
  """
  prompt: String
}

