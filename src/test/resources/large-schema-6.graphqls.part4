"""
Input for gravity_updateGlobalViewAttributes. Every attribute is optional: one omitted or given as
null keeps its current value.
"""
input JpdUpdateGlobalViewAttributesInput {
  """
  Whether containers created from now on get the global view automatically. Containers that
  already exist are not associated or unassociated by changing it.
  """
  associateWithNewContainers: Boolean
  id: ID! @ARI(interpreted : false, owner : "jira-product-discovery", type : "global-view", usesActivationId : false)
}

"""
Every field below other than id follows JSON Merge Patch semantics: omitting a field preserves its
existing persisted value, an explicit null clears/resets it, and a supplied value replaces it. name
is the one exception: it may be omitted (preserves the existing name) or supplied (replaces it), but
not set to an explicit null, since a global view cannot be nameless.
"""
input JpdUpdateGlobalViewInput {
  description: JSON @suppressValidationRule(rules : ["JSON"])
  emoji: String
  id: ID! @ARI(interpreted : false, owner : "jira-product-discovery", type : "global-view", usesActivationId : false)
  name: String
  viewTypeConfig: JpdViewTypeConfigInput
}

"""
Every field below other than id follows JSON Merge Patch semantics: omitting a field preserves
its existing persisted value, an explicit null clears/resets it, and a supplied value replaces
it. name is the one exception: it may be omitted (preserves the existing name) or supplied
(replaces it), but not set to an explicit null, since a view cannot be nameless.
"""
input JpdUpdateViewInput {
  description: JSON @suppressValidationRule(rules : ["JSON"])
  emoji: String
  id: ID! @ARI(interpreted : false, owner : "jira/jira-product-discovery", type : "view", usesActivationId : false)
  name: String
  viewTypeConfig: JpdViewTypeConfigInput
}

