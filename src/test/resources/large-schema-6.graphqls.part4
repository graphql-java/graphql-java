  colorBy: ID
  " field to color by"
  colorStyle: PolarisColorStyle
  columnSize: PolarisColumnSize
  " groups filter configuration"
  connectionsFilter: [PolarisViewFilterInput!]
  connectionsLayoutType: PolarisConnectionsLayout
  " view emoji"
  description: JSON @suppressValidationRule(rules : ["JSON"])
  " the name of the view"
