"""
Authorization model used to establish the connection.

DELEGATED uses the OAuth2 authorization-code flow: the connection acts on behalf of the
authorizing user (delegated permissions), and third-party audit logs attribute actions to that user.

APPLICATION uses the OAuth2 client-credentials flow: the connection acts as the application
itself (application permissions / app roles), and third-party audit logs attribute actions to the
application's service principal rather than a user. Currently supported for ENTRA connections.
"""
enum JsmChannelsAuthMode {
  APPLICATION
  DELEGATED
}

