"Input for updating an allowance pool allocation."
input UtsAllowancePoolAllocationUpdateInput {
  "The unique identifier of the allocation to update."
  allocationId: ID!
  """
  Deprecated and ignored. The billing entity is resolved from allocationId before authorization and update.
  
  
  This field is **deprecated** and will be removed in the future
  """
  billingEntity: String
  "The enforcement mode that controls how usage is constrained against the allowance."
  enforcementMode: UtsLatestAllowanceEnforcementModeType
  "Maximum overage allowed. Required only if enforcementMode is LIMITED_OVERAGE."
  overageCap: Float
  "Percentage of the pool allowance for this allocation. Not needed for the default allocation."
  poolShare: Float
}

