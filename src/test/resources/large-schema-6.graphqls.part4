"Auth config inputs for an MCP server that authenticates with an API token"
input GraphIntegrationMcpAdminManagementApiTokenAuthConfigInput @renamed(from : "McpAdminManagementApiTokenAuthConfigInput") {
  "A single plain API token, injected using the customAuthConfig's authHeaderName/authHeaderPrefix (`Authorization: Bearer <token>` unless overridden). Provide exactly one of apiToken or credentials."
  apiToken: String
  """
  The request header the token is sent in, for a server with no gallery template. Rejected for a
  gallery/templated server, which uses its declared header name instead. Omit to default to 'Authorization'.
  """
  authHeaderName: String
  """
  Text prepended to the token in the header value, for a server with no gallery template. Rejected for
  a gallery/templated server, which uses its declared prefix instead. Omit to default to 'Bearer'.
  """
  authHeaderPrefix: String
  "The auth type used to authenticate the MCP server. Must be set to API_TOKEN."
  authType: GraphIntegrationMcpAdminManagementMcpServerAuthType!
  """
  Named secret values for providers whose customAuthConfig declares an authHeaderStructure (e.g. Splunk's apiKey).
  Stored encoded and rebuilt into headers at execution time. Provide exactly one of apiToken or credentials.
  """
  credentials: [GraphIntegrationMcpAdminManagementExtraInputEntry!]
}

"Auth config inputs for an MCP server that uses a custom 2LO or 3LO configuration"
input GraphIntegrationMcpAdminManagementCustomOauthConfigInput @renamed(from : "McpAdminManagementCustomOauthConfigInput") {
  "The auth type used to authenticate the MCP server. Must be set to CUSTOM_OAUTH_AUTHORIZATION_CODE or CUSTOM_OAUTH_CLIENT_CREDENTIALS."
  authType: GraphIntegrationMcpAdminManagementMcpServerAuthType!
  "The OAuth client ID for the customer-owned app."
  clientId: String
  "The OAuth client secret for the customer-owned app."
  clientSecret: String
  """
  Whether the customer-owned app uses PKCE instead of a client secret. Only accepted when the
  template declares PKCE settable; supplying it otherwise is rejected. Omit to keep the template's
  own flow types. When false, a client secret is required.
  """
  pkceEnabled: Boolean
  """
  The scopes the connection requests. Only accepted when the template declares scopes settable;
  supplying them otherwise is rejected. Omit to keep the template's own scopes.
  """
  scopes: [String!]
  "Provider-specific template values used to complete the custom auth configuration."
  values: [GraphIntegrationMcpAdminManagementExtraInputEntry!]
}

