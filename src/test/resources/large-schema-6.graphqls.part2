  sessionId: String
  "The time when the agent session started."
  startTime: DateTime
  "The current state of the agent session."
  state: JiraAgentSessionState
  "The coarser-grained state category of the agent session."
  stateCategory: JiraAgentSessionStateCategory
  "The display title of the session."
