}

"The representation of a Jira field within the context of the Jira Query Language with minimal metadata and its aliases that can be used in JQL query."
type JiraJqlFieldWithAliases {
  "The aliases that can be used in a JQL query to refer to the Jira JQL field. The aliases are case-insensitive. These can include the field name, jqlTerm, untranslated name."
  aliases: [String!]
