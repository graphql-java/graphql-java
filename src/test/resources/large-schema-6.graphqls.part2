type JiraReleaseHistoryConnection {
  edges: [JiraReleaseHistoryEdge!]!
  pageInfo: PageInfo!
}

type JiraReleaseHistoryEdge {
  """
  Relay edge cursor. ERS is a key-based paginator with a single page-level cursor, so every edge in a
  page carries the same value (the page's next cursor); it is null on the last page. Pagination is driven
  by pageInfo, but Relay requires each edge to expose a cursor.
  """
  cursor: String
  node: JiraReleaseHistoryItem!
}

"A change-history field value for plain text and date fields."
type JiraReleaseHistoryGenericFieldValue {
