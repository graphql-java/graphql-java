" eslint-disable-next-line @graphql-eslint/strict-id-in-types -- id is not required"
type MarketplaceStoreDeveloperSpace {
  name: String!
  status: MarketplaceStoreDeveloperSpaceStatus!
}

" eslint-disable-next-line @graphql-eslint/strict-id-in-types -- value carrier, no id"
type MarketplaceStoreDynamicProductRecommendations {
  "Recommended apps for this product, best first."
  apps: [MarketplaceStoreSearchHitObject!]!
  """
  Whether these apps were ranked for the current user. False when they are the top search
  results returned as-is — the user has no access to this product, or ranking produced nothing
  usable.
  """
  isPersonalized: Boolean!
  "The parent product these apps were searched and ranked for."
  parentApplicationKey: String
  """
  Identifier of the ranking that produced this product's apps, for tagging analytics events so
  they can be tied back to it. Each product is ranked in its own call, so each carries its own.
  """
  sessionId: String
}

" eslint-disable-next-line @graphql-eslint/strict-id-in-types -- response wrapper, no id"
type MarketplaceStoreDynamicRecommendationsResponse {
  """
  One entry per parent product searched, in the order the products were supplied. Empty when
  the site has no product the recommendations cover.
  """
  productRecommendations: [MarketplaceStoreDynamicProductRecommendations!]!
  "Total number of recommended apps across every product."
  resultsCount: Int!
}

