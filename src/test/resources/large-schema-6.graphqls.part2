  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "JiraPrAndDeploymentLinkedToIssue")' query directive to the 'prAndDeploymentLinkedToIssue' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  prAndDeploymentLinkedToIssue(after: String, first: Int, issueId: ID! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)): GraphStoreCypherQueryV2Connection @cypherQueryV2(query : "MATCH (issue:JiraWorkItem {ari: $issueId})\nMATCH (issue)-[:jira_work_item_links_external_pull_request]->(pr:ExternalPullRequest)\nMATCH (pr)-[:external_pull_request_has_external_commit]->(commit:ExternalCommit)\nOPTIONAL MATCH (deployment:GraphDeployment)-[:external_deployment_has_external_commit]->(commit)\nWITH deployment, pr\nORDER BY deployment.createdAt DESC\nWITH pr, collect(DISTINCT deployment) as deployments\nORDER BY pr.status ASC, pr.lastUpdated\nRETURN pr, deployments") @lifecycle(allowThirdParties : false, name : "JiraPrAndDeploymentLinkedToIssue", stage : EXPERIMENTAL) @scopes(product : JIRA, required : [READ_JIRA_WORK])
