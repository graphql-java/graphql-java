  "Raw value (the user's account id)."
  value: String
}

"""
The release notes configuration for a version describing how to display properties,
types and keys for an issue

This configuration is typically saved whenever a new release note is generated on a
per version basis.
"""
type JiraReleaseNotesConfiguration {
  """
  The ARIs of issue fields(issue-field-meta ARI) to include when generating release notes
  
  This field intentionally returns an array instead of a connection as it is not meant to be paginated
  An upper limit of 500 items can be returned from this array
  
  Note: An empty array indicates no issue properties should be included in the release notes generation. Summary is not a part of this as it is included in Release note by default.
  """
  issueFieldIds: [ID] @ARI(interpreted : false, owner : "jira", type : "issue-field-meta", usesActivationId : false)
  "The issue key config to include when generating release notes"
  issueKeyConfig: JiraReleaseNotesIssueKeyConfig
  """
  The ARIs of issue types(issue-type ARI) to include when generating release notes
  
  This field intentionally returns an array instead of a connection as it is not meant to be paginated
  An upper limit of 200 items can be returned from this array
  
  Note: An empty array indicates all the issue types should be included in the release notes generation
  """
  issueTypeIds: [ID] @ARI(interpreted : false, owner : "jira", type : "issue-type", usesActivationId : false)
}

