"Aggregate counts of projects and schemes relative to an entity per project limit"
type JiraProjectLimitsReport {
  """
  ISO-8601 timestamp of the most recent recommendation data used in this report
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  lastUpdated: DateTime
  """
  Count of projects having entities more than specified limit
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  projectsOverLimit: Long
  """
  Count of projects having entities reaching specified limit (>= 0.75 * specified limit)
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  projectsReachingLimit: Long
  """
  Count of projects having entities below the reaching limit threshold
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  projectsWithinLimit: Long
  """
  Recommended maximum number of entities per project, which is the limit itself
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  recommendedEntitiesPerProject: Long
  """
  Count of schemes having entities more than specified limit
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  schemesOverLimit: Long
  """
  Count of schemes having entities reaching specified limit (>= 0.75 * specified limit)
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  schemesReachingLimit: Long
  """
  Count of all projects covered by this report
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  totalProjects: Long
  """
  Count of all schemes covered by this report
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  totalSchemes: Long
}

