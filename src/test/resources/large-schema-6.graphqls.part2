  """
  A few example prompts or starter questions showing how to invoke the agent,
  Sourced from ASVL `agentCapabilities.examplePrompts`.
  """
  examplePrompts: [String!]
  """
  List of skills declared for the agent.
  Partner-provided. Sourced from ASVL `agentCapabilities.skills`.
  """
  skills: [MarketplaceAgentSkill!]
  "Tools the agent can invoke."
  tools: [MarketplaceAgentTool!]
}

"A skill an AI agent declares"
type MarketplaceAgentSkill {
  "Description of what the skill does"
  description: String!
  "Name of the skill used by the agent as declared by the partner"
  name: String!
}

"A tool an AI agent can invoke"
type MarketplaceAgentTool {
  accessType: MarketplaceAgentToolAccessType!
  description: String!
  name: String!
}

"A piece of code that modifies the functionality or look and feel of Atlassian products"
type MarketplaceApp {
  "A numeric identifier for an app in marketplace."
  appId: ID!
  "A human-readable identifier for an app in marketplace."
  appKey: String!
  "List of categories associated with an app."
  categories: [MarketplaceAppCategory!]!
  "Timestamp when the app was created, in ISO time format `yyyy-MM-dd'T'HH:mm:ss.SSS'Z'` e.g, 2013-10-02T22:05:56.767Z"
  createdAt: DateTime!
  """
  Long form description of the listing. Sourced from product listing `description`.
  Used for AGENT and MCP listings, which do not show `summary`.
  """
  description: String
  "Distribution information about the app, optionally filtered by hosting type"
  distribution(hosting: AppDistributionHosting): MarketplaceAppDistribution @hydrated(arguments : [{name : "appKey", value : "$source.appKey"}, {name : "hosting", value : "$argument.hosting"}], batchSize : 200, field : "marketplaceAppDistribution", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "marketplace_app_catalog", timeout : -1)
  "Status of the app entity in Marketplace."
  entityStatus: MarketplaceEntityStatus!
  "A URL where users can find Community Support resources for the app"
  forumsUrl: URL
  "Google analytics Ga4 id used for tracking visitors to the app."
  googleAnalytics4Id: String
  "Google analytics id used for tracking visitors to the app."
  googleAnalyticsId: String
  "When enabled providing customers with a place to ask questions or browse answers about the app."
  isAtlassianCommunityEnabled: Boolean!
  "Link to the issue tracker for the app"
  issueTrackerUrl: URL
  "JSD widget key"
  jsdWidgetKey: String
  "Status of app’s listing in Marketplace."
  listingStatus: MarketplaceListingStatus!
  "App's logo"
  logo: MarketplaceListingImage
  "Marketing Labels for the app"
  marketingLabels: [String!]!
  "App's name in Marketplace."
  name: String!
  "Kind of object this listing represents."
  objectType: MarketplaceObjectType
  "Marketplace Partner that provided this app in Marketplace."
  partner: MarketplacePartner @hydrated(arguments : [{name : "id", value : "$source.partnerId"}], batchSize : 200, field : "marketplacePartner", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "marketplace_app_catalog", timeout : -1)
  "Unique id of the Marketplace Partner that provided this app in Marketplace."
  partnerId: ID!
  "Link to a statement explaining how the app uses and secures user data."
  privacyPolicyUrl: URL
  "Options of Atlassian product instance hosting types for which app versions are available."
  productHostingOptions(excludeHiddenIn: MarketplaceLocation): [AtlassianProductHostingType!]!
  "A human-readable identifier for the backing product in marketplace."
  productId: ID
  "Marketplace App Programs that this App has enrolled in."
  programs: MarketplaceAppPrograms
  "Summary of the reviews for an app"
  reviewSummary: MarketplaceAppReviewSummary
  "Segment write key for capturing user journey funnel for the app."
  segmentWriteKey: String
  "An SEO-friendly URL pathname for the app"
  slug: String!
  "Link to the status page for the app"
  statusPageUrl: URL
  "A summary describing the app functionality."
  summary: String
  "Link to the support ticket system for the app"
  supportTicketSystemUrl: URL
  "A short phrase that summarizes what the app does."
  tagline: String
  "Tags associated with an app"
  tags: MarketplaceAppTags
  "App's versions in Marketplace system (paginated). Max page size is 20. Default pagination is 15."
  versions(after: String, filter: MarketplaceAppVersionFilter, first: Int = 15): MarketplaceAppVersionConnection!
  "Information of watchers of a Marketplace app"
  watchersInfo: MarketplaceAppWatchersInfo @hydrated(arguments : [{name : "appKey", value : "$source.appKey"}], batchSize : 200, field : "marketplaceAppWatchersInfo", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "marketplace_app_catalog", timeout : -1)
  "A URL where users can find documentation platform hosted by the partner"
  wikiUrl: URL
}

"Category associated with an app"
type MarketplaceAppCategory {
  "Name of the category"
  name: String!
}

"A connection providing cursor-based pagination for a list of apps."
type MarketplaceAppConnection {
  "A list of edges in the current page, each containing an app and its cursor."
  edges: [MarketplaceAppConnectionEdge]
  "Information about the current page in the list, to enable pagination."
  pageInfo: PageInfo!
  "The total number of apps in the list."
  totalCount: Int!
}

"An entry in a paginated list of apps."
type MarketplaceAppConnectionEdge {
  "An opaque string to be used in cursor-based pagination."
  cursor: String!
  "The app from the list."
  node: MarketplaceApp
}

"Step for installing the instructional app"
type MarketplaceAppDeploymentStep {
  """
  Text/html to explain the step
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  instruction: String!
  """
  Screenshot of the step
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
