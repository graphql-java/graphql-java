  "The value of inwards direction. For example: blocks"
  inwards: String
  "Represents the IssueLinkType id to which this type belongs to."
  linkTypeId: ID
  "Display name of IssueLinkType to which this relation belongs to. For example: Blocks, Duplicate, Cloners"
  linkTypeName: String
  "The value of outwards direction. For example: is blocked by"
  outwards: String
}

