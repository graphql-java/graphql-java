"A unique combination of hostName and contextARI for an installation."
type HostNameEntry {
  """
  The context ARI associated with this installation (e.g. ari:cloud:jira::site/abc-123).
  For searchHostNamesV2 SITE/WORKSPACE nested matches, this is secondaryContextHosts.context.
  """
  contextARI: String!
  """
  Context ARIs associated with this result. searchHostNames populates the primary,
  active secondary, and optionally retained secondary contexts. searchHostNamesV2
  returns an empty list until it supports this enrichment.
  """
  contextAris: [String!]!
  """
  The hostname of the installation (e.g. acme.atlassian.net).
  For searchHostNamesV2 with target ORGANISATION, this is the orgId.
  For searchHostNamesV2 with target UNIT, this is the unitId.
  For searchHostNamesV2 with target INSTALLATION_ID, this is the installationId.
  """
  hostName: String!
}

"""
Paginated response for the searchHostNames query.
Returns a deduplicated, lexicographically-ordered list of unique (hostName, contextARI) pairs
for the given appId, optionally filtered by a prefix on the name argument.
"""
type HostNameSearchResponse {
  "Deduplicated, lexicographically-sorted list of unique (hostName, contextARI) pairs on this page (max 20)."
  entries: [HostNameEntry!]!
  "Whether there are more pages of results after this one."
  hasNextPage: Boolean!
  """
  Opaque cursor to pass as 'cursor' in the next searchHostNames call to retrieve the next page.
  Null when there is no next page.
  """
  nextCursor: String
}

