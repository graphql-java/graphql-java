type JiraDateTimeFieldPayload implements JiraSupportsUpdatedDependentFields & Payload {
  errors: [MutationError!]
  field: JiraDateTimePickerField
  success: Boolean!
  """
  Connection of issue fields that were updated as a result of the mutation.
  Since this is a mutation payload, only the `first` pagination argument is supported to limit results - if `pageInfo.hasNext`
  is true in the response payload, it is recommended to refetch all fields on the updated issue to ensure stale issue field values
  are not being used.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "JiraUpdatedDependentFields")' query directive to the 'updatedDependentFields' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  updatedDependentFields(first: Int): JiraIssueFieldConnection @lifecycle(allowThirdParties : false, name : "JiraUpdatedDependentFields", stage : EXPERIMENTAL)
}

