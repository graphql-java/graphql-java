  type: String!
}

"Field definition describing what kind of field a template requires."
type GravityFieldDefinition {
  """
  Optional configuration.
  Used by some field types (e.g. 'jira.polaris:formula')
  """
  configuration: JSON @suppressValidationRule(rules : ["JSON"])
  "Description of the field."
  description: String
  "True if this field is global (shared across projects)."
  global: Boolean
  "Human-readable name of the field."
  name: String!
  "Indicates if the field cannot be replaced by user"
  nonReplaceable: Boolean
  """
  Optional list of options.
  Used by some field types (e.g. 'com.atlassian.jira.plugin.system.customfieldtypes:select')
  """
  options: [JSON!] @suppressValidationRule(rules : ["JSON"])
  """
  Template field reference.
  Example: 'vtri:field:ref:polaris-rating-effort'
  """
  ref: ID!
  "Field type (e.g. 'jira.polaris:rating')."
  type: String!
}

"Candidate mappings for a field definition used in a template."
