"The result of analysing what remediating a single policy-violating entity would impact."
type JiraPolicyRemediationImpactAnalysis {
  "The ARI of the field configuration or status that was analysed."
  entityAri: ID!
  """
  The impacted entities, grouped by the type of entity impacted.
  
  One group is returned per entity type the policies domain analysed for this remediation.
  `entityTypes` narrows the response to a subset of those groups; it cannot widen the analysis.
  Types that were not analysed are simply absent — passing them yields no group rather than an
  empty one. Omitting `entityTypes` returns every analysed group.
  """
  impactedEntityGroups(entityTypes: [JiraPolicyRemediationImpactedEntityType!]): [JiraPolicyRemediationImpactedEntityGroup!]
  """
  Work-item impact details for this remediation, or null when work-item impact
  is unavailable or not supported.
  """
  workItemImpact: JiraPolicyRemediationWorkItemImpact
}

