type MercuryUpdatedField {
  "The field that was changed"
  field: String
  "The type of the field that was changed"
  fieldType: String
  "Extensible metadata for this field change (e.g. searchKey for custom fields)"
  metadata: [MercuryActivityHistoryMetadata!]
  "Optional union field that contains data hydrated through AGG from other services"
  newData: MercuryActivityHistoryData @hydrated(arguments : [{name : "accountIds", value : "$source.newValue"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1, when : {result : {sourceField : "field", predicate : {equals : OWNER}}}) @hydrated(arguments : [{name : "goalIds", value : "$source.newValue"}], batchSize : 90, field : "goals_byIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "townsquare", timeout : -1, when : {result : {sourceField : "field", predicate : {equals : LINKED_GOAL}}}) @hydrated(arguments : [{name : "ids", value : "$source.newValue"}], batchSize : 90, field : "home_tagsByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "townsquare", timeout : -1, when : {result : {sourceField : "field", predicate : {equals : LINKED_TAG}}}) @hydrated(arguments : [{name : "projectIds", value : "$source.newValue"}], batchSize : 90, field : "projects_byIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "townsquare", timeout : -1, when : {result : {sourceField : "newValue", predicate : {matches : "ari:cloud:townsquare:[^:]+:project/.+"}}}) @hydrated(arguments : [{name : "ids", value : "$source.newValue"}], batchSize : 90, field : "jira_issuesByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "gira", timeout : -1, when : {result : {sourceField : "newValue", predicate : {matches : "ari:cloud:jira:[^:]+:issue/.+"}}}) @hydrated(arguments : [{name : "ids", value : "$source.newValue"}], batchSize : 90, field : "jiraAlignAgg_projectsByAris", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "jira_align_twg_pipeline", timeout : -1, when : {result : {sourceField : "newValue", predicate : {matches : "ari:cloud:jira-align:[^:]+:project/.+"}}}) @hydrated(arguments : [{name : "ids", value : "$source.newValue"}], batchSize : 50, field : "mercury_organizations.organizations", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "mercury", timeout : -1, when : {result : {sourceField : "field", predicate : {equals : SPONSOR_ORGANIZATION}}}) @hydrated(arguments : [{name : "ids", value : "$source.newValue"}], batchSize : 50, field : "mercury_asksByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "mercury", timeout : -1, when : {result : {sourceField : "field", predicate : {equals : PROMOTED_FROM_ASK}}})
  "A user-facing representation of the new value"
  newString: String
  "The system identifier for the new value"
  newValue: String
  "Optional union field that contains data hydrated through AGG from other services"
  oldData: MercuryActivityHistoryData @hydrated(arguments : [{name : "accountIds", value : "$source.oldValue"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1, when : {result : {sourceField : "field", predicate : {equals : OWNER}}}) @hydrated(arguments : [{name : "goalIds", value : "$source.oldValue"}], batchSize : 90, field : "goals_byIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "townsquare", timeout : -1, when : {result : {sourceField : "field", predicate : {equals : LINKED_GOAL}}}) @hydrated(arguments : [{name : "ids", value : "$source.oldValue"}], batchSize : 90, field : "home_tagsByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "townsquare", timeout : -1, when : {result : {sourceField : "field", predicate : {equals : LINKED_TAG}}}) @hydrated(arguments : [{name : "projectIds", value : "$source.oldValue"}], batchSize : 90, field : "projects_byIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "townsquare", timeout : -1, when : {result : {sourceField : "oldValue", predicate : {matches : "ari:cloud:townsquare:[^:]+:project/.+"}}}) @hydrated(arguments : [{name : "ids", value : "$source.oldValue"}], batchSize : 90, field : "jira_issuesByIds", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "gira", timeout : -1, when : {result : {sourceField : "oldValue", predicate : {matches : "ari:cloud:jira:[^:]+:issue/.+"}}}) @hydrated(arguments : [{name : "ids", value : "$source.oldValue"}], batchSize : 90, field : "jiraAlignAgg_projectsByAris", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "jira_align_twg_pipeline", timeout : -1, when : {result : {sourceField : "oldValue", predicate : {matches : "ari:cloud:jira-align:[^:]+:project/.+"}}}) @hydrated(arguments : [{name : "ids", value : "$source.oldValue"}], batchSize : 50, field : "mercury_organizations