"""
A persisted saved filter (filters, columns, grouping, etc.) over a particular Focus
entity type. Reusable across the product as the unit of "saved list / board
configuration".

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:mercury:twg-cli__
"""
type MercurySavedFilter implements Node @defaultHydration(batchSize : 50, field : "mercury_savedFiltersByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_MERCURY_TWG_CLI]) {
  """
  Always null. Saved filters are no longer scoped to a container.
  
  
  This field is **deprecated** and will be removed in the future
  """
  containerId: ID @ARI(interpreted : false, owner : "mercury", type : "any", usesActivationId : false)
  "The user who created the saved filter."
  createdBy: User @idHydrated(idField : "createdBy", identifiedBy : null)
  createdDate: DateTime
  "The entity type this saved filter applies to."
  entityType: String!
  id: ID! @ARI(interpreted : false, owner : "mercury", type : "saved-filter", usesActivationId : false)
  "Whether the calling user has starred this saved filter."
  isStarred: Boolean!
  "Human readable name of the saved filter."
  name: String!
  "The owner of the saved filter."
  owner: User @idHydrated(idField : "owner", identifiedBy : null)
  "Filter / column / sort / grouping configuration for the saved filter."
  settings: MercurySavedFilterSettings
  "The user who last updated the saved filter."
  updatedBy: User @idHydrated(idField : "updatedBy", identifiedBy : null)
  updatedDate: DateTime
}

type MercurySavedFilterConnection {
  edges: [MercurySavedFilterEdge!]
  pageInfo: PageInfo!
  totalCount: Int
}

type MercurySavedFilterEdge {
  cursor: String!
  node: MercurySavedFilter
}

type MercurySavedFilterSettingEntry {
  key: String!
  value: String!
}

type MercurySavedFilterSettings {
  values: [MercurySavedFilterSettingEntry!]
}

