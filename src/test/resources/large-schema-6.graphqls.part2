"Represents a Statuspage page linked to an Issue in a JSM project."
type JiraServiceManagementStatusPage {
  """
  The Statuspage subdomain the page is served on - the label only, for example acme for the page at
  acme.statuspage.io. Neither a hostname nor a URL. Null when no subdomain is configured upstream; an
  unresolvable page is dropped from the connection, as with name.
  
  A vanity domain is not represented here - upstream exposes that separately as customDomain, which this read
  path does not surface - so a link built from this value alone points at the statuspage.io address.
  """
  domain: String
  "The ID of the Statuspage page"
  id: ID!
  """
  The name of the Statuspage page. Null when the page has no name set upstream.
  
  A page that cannot be resolved - deleted from Statuspage, or an id that never named a page on this tenant -
  is dropped from the connection rather than returned with a null name. An issue whose pages have all been
  deleted therefore reads as totalCount 0, indistinguishable from one that never had a page linked. hasValue
  stays true while the ids are still stored.
  """
  name: String
}

"The connection type for JiraServiceManagementStatusPage."
type JiraServiceManagementStatusPageConnection {
  """
  A list of edges in the current page.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  edges: [JiraServiceManagementStatusPageEdge]
  """
  Information about the current page. Used to aid in pagination.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  pageInfo: PageInfo!
  """
  The total count of items in the connection.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  totalCount: Int
}

"An edge in a JiraServiceManagementStatusPageConnection."
type JiraServiceManagementStatusPageEdge {
  "The cursor to this edge."
  cursor: String!
  "The node at the edge."
  node: JiraServiceManagementStatusPage
}

