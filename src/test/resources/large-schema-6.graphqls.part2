"""
Represents a mitigation execution for a given scope (e.g. an ICC incident).
Contains overall progress, indicators extracted, and plans generated.
"""
type Mitigation implements Node @defaultHydration(batchSize : 90, field : "playbook_mitigations", idArgument : "ids", identifiedBy : "id", timeout : -1) {
  "Timestamp when this mitigation was created."
  createdAt: DateTime
  "Globally-unique Relay Node id (ARI) for this mitigation."
  id: ID! @ARI(interpreted : false, owner : "jira", type : "playbook-mitigation", usesActivationId : false)
  "The id of the latest mitigation request. Internal pointer used to resolve state and the triggering user; hidden from the public schema."
  latestRequestId: String @hidden
  "The identifier of the scope (e.g. incident key or project id)."
  scopeId: String
  "The scope type this mitigation is associated with."
  scopeType: MitigationScopeType
  "The current lifecycle state of the mitigation's latest generation run (in-progress, completed, or failed)."
  state: MitigationGenerationState
  "The user who triggered the latest mitigation run."
  triggeredBy: User @hydrated(arguments : [{name : "accountIds", value : "$source.triggeredByUserId"}], batchSize : 50, field : "users", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "Timestamp when this mitigation was last updated."
  updatedAt: DateTime
  "The version of this mitigation."
  version: Int
}

"""
The mitigation pipeline finished successfully (latest request is DONE). Carries the indicators
extracted (with their generated plans).
"""
type MitigationGenerationCompleted {
  """
  Indicators extracted for this mitigation.
  By default, rejected indicators are excluded. Pass includeRejected: true to include them.
  """
  indicators(includeRejected: Boolean = false): [MitigationIndicator!]
  """
    Aggregated and deduplicated list of the underlying knowledge sources that contributed to this
    mitigation. Sources are collected from indicator provenance and plan-source references across
    every (non-rejected) indicator and plan in this mitigation.
  
  This list is not persisted: it is derived on read from the existing PlanSource and
    IndicatorProvenance entries. Deduplication is by ARI when present; entries without a resolvable
    MitigationSourceType or with neither a link nor an ARI are omitted.
  """
  sources: [MitigationSource!]
}

"""
The mitigation pipeline failed (latest request is ERRORED). Distinguished from
MitigationGenerationProgress by __typename. The reason for failure is carried by the ERRORED entry in
progressSteps (its stepStatus is ERRORED and its failureReason describes the cause).
"""
type MitigationGenerationFailed {
  "Progress of the mitigation pipeline steps reached before the failure. The failed step carries stepStatus ERRORED and its failureReason."
  progressSteps: [MitigationProgressStep!]
}

"""
The mitigation pipeline is still running (latest request is not yet DONE or ERRORED). Carries the
live pipeline progress.
"""
type MitigationGenerationProgress {
  "Progress of the mitigation pipeline steps."
  progressSteps: [MitigationProgressStep!]
}

"Represents a single indicator (signal, symptom, or hypothesis) within a mitigation."
type MitigationIndicator implements Node @defaultHydration(batchSize : 90, field : "playbook_mitigationIndicators", idArgument : "ids", identifiedBy : "id", timeout : -1) {
  "Timestamp when this indicator was created."
  createdAt: DateTime
  """
  Type-specific details for this indicator. Resolves to exactly one of
  AdvisorySignalIndicator, SymptomIndicator, or HypothesisIndicator based on indicatorType.
  """
  details: MitigationIndicatorDetails
  "Globally-unique Relay Node id (ARI) for this indicator."
  id: ID! @ARI(interpreted : false, owner : "jira", type : "playbook-mitigation-indicator", usesActivationId : false)
  "The type of this indicator."
  indicatorType: MitigationIndicatorType
  "The mitigation this indicator belongs to."
  mitigationId: ID @ARI(interpreted : false, owner : "jira", type : "playbook-mitigation", usesActivationId : false)
  """
  Mitigation plans generated for this indicator.
  By default, rejected plans are excluded. Pass includeRejected: true to include them.
  """
  plans(includeRejected: Boolean = false): [MitigationPlan!]
  "Whether this indicator has been rejected."
  rejected: Boolean
  "Timestamp when this indicator was rejected."
  rejectedAt: DateTime
  "The user who rejected this indicator, if rejected by a human."
  rejectedBy: User @hydrated(arguments : [{name : "accountIds", value : "$source.rejectedByUserId"}], batchSize : 50, field : "users", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "The reason given for rejection."
  rejectionReason: IndicatorRejectionReason
  "Who or what performed the rejection."
  rejectionSource: MitigationRejectionSource
  "A short human-readable title summarising what this indicator is about."
  title: String
  "Timestamp when this indicator was last updated."
  updatedAt: DateTime
}

"A mitigation plan generated for a specific indicator."
type MitigationPlan implements Node @defaultHydration(batchSize : 90, field : "playbook_mitigationPlans", idArgument : "ids", identifiedBy : "id", timeout : -1) {
  "Confidence bucket for this plan."
  confidence: MitigationConfidence
  "Timestamp when this plan was created."
  createdAt: DateTime
  "Globally-unique Relay Node id (ARI) for this plan."
  id: ID! @ARI(interpreted : false, owner : "jira", type : "playbook-mitigation-plan", usesActivationId : false)
  "The indicator this plan was generated for."
  indicatorId: ID @ARI(interpreted : false, owner : "jira", type : "playbook-mitigation-indicator", usesActivationId : false)
  "The mitigation this plan belongs to."
  mitigationId: ID @ARI(interpreted : false, owner : "jira", type : "playbook-mitigation", usesActivationId : false)
  "The source documents that informed this plan."
  planSources: [PlanSource!]
  """
  The virtual Jira playbook instance associated with this plan, if any.
  Instances have no persisted row of their own; the resolver synthesises an
  instance ARI from the plan's playbook id + the parent mitigation's scope
  (incident Jira issue id, keyed under the standard `issue` context) and
  hydrates via the Node interface. This means these instances are also
  reachable via `playbook_jiraPlaybookInstancesForIssue` on the incident issue.
  """
  playbook: JiraPlaybookInstance
  "Whether this plan has been rejected."
  rejected: Boolean
  "Timestamp when this plan was rejected."
  rejectedAt: DateTime
  "The user who rejected this plan, if rejected by a human."
  rejectedBy: User @hydrated(arguments : [{name : "accountIds", value : "$source.rejectedByUserId"}], batchSize : 50, field : "users", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "The reason given for rejection."
  rejectionReason: PlanRejectionReason
  "Who or what performed the rejection."
  rejectionSource: MitigationRejectionSource
  "A short summary of the plan."
  summary: String
  "The title of the plan."
  title: String
  "Timestamp when this plan was last updated."
  updatedAt: DateTime
}

"Represents the status of a single pipeline step within a mitigation execution."
type MitigationProgressStep {
  "Timestamp when this step completed."
  completedAt: DateTime
  "Reason for failure if the step errored."
  failureReason: String
  "Timestamp when this step started."
  startedAt: DateTime
  "The pipeline step."
  step: MitigationPipelineStep
  "The current status of this step."
  stepStatus: MitigationStepStatus
}

"""
A single knowledge source that contributed to a mitigation, aggregated from indicator provenance
and plan-source references. Exposes only the fields needed by the FE to render a source link.
"""
type MitigationSource {
  "The source ARI, when the underlying id is ARI-shaped (starts with 'ari:')."
  ari: String
  "Direct link to the source, when one is available."
  link: String
  "The product-line classification of the source. Null when the underlying source type cannot be mapped to a known MitigationSourceType (see enum doc)."
  type: MitigationSourceType
}

"Details of the underlying alert (linked or related) that produced a symptom indicator."
type MitigationSymptomAlert {
  "The user the alert is assigned to, if any."
  assignee: User @hydrated(arguments : [{name : "accountIds", value : "$source.assigneeUserId"}], batchSize : 50, field : "users", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "The creation timestamp of the alert."
  createdDate: DateTime
  "A deep link to the alert's detail view."
  link: String
  "The priority of the alert."
  priority: MitigationSymptomAlertPriority
  "The current status of the alert."
  status: MitigationSymptomAlertStatus
  "The short, human-readable identifier of the alert (e.g. 172876)."
  tinyId: String
}

