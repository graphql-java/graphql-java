"A pipeline row returned by the list, the detail query, and a successful create or transition."
type IrisPipeline {
  """
  States the client may offer from the current state.
  ENABLED can move to DISABLED or DELETED.
  DISABLED can move to ENABLED or DELETED.
  DRAFT can move to ENABLED or DELETED.
  DELETED cannot be restored.
  Offering a state does not guarantee the transition will succeed.
  """
  allowedTransitions: [IrisPipelineState]
  connector: IrisPipelineConnector
  displayName: String
  id: ID
  lastImport: IrisPipelineLastImport
  "Feasibility is still open."
