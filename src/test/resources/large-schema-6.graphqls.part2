"The count of a group's work items in one status category."
type JiraGroupedStatusCategoryCount {
  """
  How many group members are in that category.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
