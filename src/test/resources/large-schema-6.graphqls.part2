"""
A conversation with the virtual agent

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:jsm:twg-cli__
"""
type JsmChannelsOrchestratorConversation implements Node @defaultHydration(batchSize : 100, field : "jsmChannels_conversationsByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI]) {
  "How a conversation was actioned"
  action: JsmChannelsOrchestratorConversationActionType
  "Conversation channel"
  channel: JsmChannelsOrchestratorConversationChannel
  "The CSAT score, if any, provided by the user at the end of a conversation"
  csat: Int
  "The first message content of the conversation"
  firstMessageContent: String
  "The unique identifier (ID) of a conversation, will be an ARI"
  id: ID! @ARI(interpreted : false, owner : "jsm-channel-orchestrator", type : "conversation", usesActivationId : false)
  "The unique identifier (ID) of an intent projection, will be an ARI"
  intentProjectionId: ID @ARI(interpreted : false, owner : "virtual-agent", type : "intent-projection", usesActivationId : false)
  "Deep link to the external source of this conversation, if applicable"
  linkToSource: String
  "When the conversation started"
  startedAt: DateTime
  "The state of a conversation"
  state: JsmChannelsOrchestratorConversationState
}

type JsmChannelsOrchestratorConversationEdge {
  cursor: String!
  node: JsmChannelsOrchestratorConversation
}

type JsmChannelsOrchestratorConversationsConnection {
  edges: [JsmChannelsOrchestratorConversationEdge!]
  nodes: [JsmChannelsOrchestratorConversation]
  pageInfo: PageInfo!
}

"""
We are using a map entry to reduce the duplicate nodes in response, to reduce payload size
Using nodes in adjacency list would lead to multiple duplications
"""
type JsmChannelsPlanNodeMapEntry {
  node: JsmChannelsPlanNode!
  nodeId: ID!
}

