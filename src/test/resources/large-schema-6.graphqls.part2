type GravityViewFeedbackSettings {
  "Form IDs stored in this view's general feedback settings, including IDs of unavailable forms. Use generalFeedbackForms for form data returned by the Feedback App."
  generalFeedbackFormIds: [ID] @semanticNonNull(levels : [0, 1])
  "Render-ready active forms returned by the Feedback App for the stored general feedback form IDs. Unavailable forms are returned as nulls."
  generalFeedbackForms: [KitsuneFormSubmissionView] @hydrated(arguments : [{name : "ids", value : "$source.generalFeedbackFormIds"}], batchSize : 50, field : "kitsune_formSubmissionViews", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "kitsune", timeout : -1)
  "Form IDs stored in this view's idea feedback settings, including IDs of unavailable forms. Use ideaFeedbackForms for form data returned by the Feedback App."
  ideaFeedbackFormIds: [ID] @semanticNonNull(levels : [0, 1])
  "Render-ready active forms returned by the Feedback App for the stored idea feedback form IDs. Unavailable forms are returned as nulls."
  ideaFeedbackForms: [KitsuneFormSubmissionView] @hydrated(arguments : [{name : "ids", value : "$source.ideaFeedbackFormIds"}], batchSize : 50, field : "kitsune_formSubmissionViews", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "kitsune", timeout : -1)
  "Whether eligible users can submit this view's forms on behalf of a customer or organization. Defaults to false."
  proxyFeedbackEnabled: Boolean!
}

"Single filter definition inside a view configuration."
type GravityViewFilter {
  """
  VTRI identifier of the field this filter applies to.
  Optional for some filter kinds (e.g. text search across all fields).
  """
  field: ID
  "The kind of filter logic to apply."
  kind: GravityViewFilterKind!
  "List of filter values with optional operators."
  values: [GravityViewFilterValue!]!
}

"A single filter value with optional operator and type-specific data."
type GravityViewFilterValue {
  "Special enum type for matching board columns or view groups."
  enumValue: GravityViewFilterEnumType
  "Numeric value for numeric comparisons."
  numericValue: Float
  "Operator for numeric/interval comparisons (GT, LT, EQ, etc.)."
  operator: GravityViewFilterOperator
  "String value for text/identity filters."
  stringValue: String
}

"One entry in a grouping axis's ordered value list."
type GravityViewGroupValue {
  "VTRI identifier of the field option."
  id: ID!
  "Display label for the option."
  label: String
  "Ordering weight; lower values appear first."
  weight: Int
}

"""
One axis of a matrix view.

Note: axis options are currently dropped downstream by Views Service, which sends them under a
key the Polaris templating endpoint does not read. The field and reversed flag are applied.
"""
type GravityViewMatrixAxis {
  "Which axis this configures. Z is the bubble-size dimension."
  dimension: GravityViewMatrixAxisDimension!
  "VTRI identifier of the field mapped to this axis."
  field: ID!
  "Ordered VTRI option identifiers to show on this axis."
  fieldOptions: [ID!]
  "Whether the axis is displayed in reverse order."
  reversed: Boolean
}

"Matrix view configuration."
type GravityViewMatrixConfig {
  "The axis definitions."
  axes: [GravityViewMatrixAxis!]
}

"Single sort definition inside a view configuration."
type GravityViewSort {
  "VTRI identifier of the field to sort by."
  field: ID!
  "Sort direction (ASC or DESC)."
  order: GravitySortOrder!
}

"Per-field column width configuration for table views."
type GravityViewTableColumnSize {
  "VTRI identifier of the field whose column width is configured."
  field: ID!
  "Column width in pixels."
  size: Int!
}

"Template describing a pre-configured view that can be instantiated."
type GravityViewTemplate {
  "High-level category used to group templates in the library UI."
  category: GravityViewTemplateCategory
  "Color scheme to be applied to the template image when listed in the UI."
  colorScheme: GravityViewTemplateColorScheme
  "Definitions of references (e.g fields) used by the template."
  definitions: GravityViewTemplateDefinitions
  "Unique identifier of the template (e.g. 'product-roadmap-template')."
  id: ID!
  "Long ADF description of the template."
  longDescription: JSON @suppressValidationRule(rules : ["JSON"])
  "Human-readable name of the template (e.g. 'Product Roadmap Template')."
  name: String!
  """
  URN of the template schema this template conforms to
  (e.g. 'urn:atlassian:jpd:view-template:v1.0.0'). Nullable for
  templates that predate schema stamping.
  """
  schema: String
  "Larger screenshot showcasing the resulting view."
  screenshot: GravityViewTemplateImage
  "Short ADF description of the template."
  shortDescription: JSON @suppressValidationRule(rules : ["JSON"])
  "Thumbnail image for listing templates."
  thumbnail: GravityViewTemplateImage
  "Definition of the view that will be created from this template."
  view: GravityView!
}

"Definitions of references for entities required by the template (e.g. fields)."
type GravityViewTemplateDefinitions {
  """
  Field definitions used by this template.
  These describe what kind of fields the template needs.
  """
  fields: [GravityFieldDefinition!]!
}

"Common structure for images (thumbnails, screenshots, etc.)."
type GravityViewTemplateImage {
  "Human-readable alt text for the image (for accessibility)."
  alt: String
  "URL to the primary (light theme) image."
  src: String!
  "URL to the dark-theme variant of the image, if available."
  srcDark: String
}

type GravityViewTemplateMappingProposalsSuccess {
  """
  Names of template fields that cannot be auto-created because a field with the same
  name already exists in the project with a different type.
  """
  conflictingFieldNames: [String!]!
  proposals: GravityRefMappingProposals!
}

type GravityViewTemplatesSuccess {
  templates: [GravityViewTemplate!]!
}

"Timeline view configuration."
type GravityViewTimelineConfig {
  "VTRI identifier of the field used as each bar's end date."
  dueDateField: ID
  "ISO-8601 timestamp of the rightmost visible date."
  endTimestamp: String
  "Granularity of the time axis."
  mode: GravityViewTimelineMode
  "VTRI identifier of the field used as each bar's start date."
  startDateField: ID
  "ISO-8601 timestamp of the leftmost visible date."
  startTimestamp: String
  "VTRI identifier of the field shown as the bar label."
  summaryCardField: ID
  "Whether to render a \"today\" line."
  todayMarker: GravityViewTodayMarker
}

"A labelled vertical marker on a timeline."
type GravityViewTimelineMarker {
  "Marker colour."
  color: String
  "ISO-8601 date the marker sits on."
  date: String!
  "Text shown against the marker."
  label: String
}

"Tree view configuration."
type GravityViewTreeConfig {
  "Whether an idea may appear under more than one parent."
  allowMultipleParents: Boolean
  "VTRI identifiers of the fields shown on nodes by default."
  defaultFields: [ID!]
  "Ordered hierarchy levels, outermost first."
  hierarchy: [GravityViewTreeHierarchyItem!]
  "Whether the hierarchy is derived automatically or set by hand."
  mode: GravityViewTreeMode
  "Direction the tree grows from its root."
  treeDirection: GravityViewTreeDirection
}

"One entry within a tree hierarchy level. Exactly one property is set."
type GravityViewTreeHierarchyEntry {
  "VTRI identifier of the field, for a field-derived level."
  fieldKey: ID
  "Concrete issue id. Not portable across projects."
  issueId: ID
  "Name of the issue type, for an issue-type-derived level."
  issueTypeName: String
}

"One level of a tree view's hierarchy."
type GravityViewTreeHierarchyItem {
  "VTRI identifiers of the fields shown on nodes at this level."
  fields: [ID!]
  "Filters scoped to this level."
  filter: [GravityViewFilter!]
  "The entries making up this level."
  items: [GravityViewTreeHierarchyEntry!]
  "How this level is derived."
  type: GravityViewTreeHierarchyType
}

type GravityViewUpdatedEvent {
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  updatedAt: String!
  """
  Account id of the user who made this edit. Null when the write had no user context.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  updatedByUserId: String
  """
  Null only on the subscribe-time Query ack; GQLS discards that payload. Delivery always
  carries the full view after enrichment.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  view: JpdView
}

