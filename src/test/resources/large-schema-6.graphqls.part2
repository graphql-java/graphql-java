  """
  The type of the allowed egress for the given addresses.
  
  Can be one of:
  * NAVIGATION
  * IMAGES
  * MEDIA
  * SCRIPTS
  * STYLES
  * FETCH_BACKEND_SIDE
  * FETCH_CLIENT_SIDE
  * FONTS
  * FRAMES
  
  More types may be added in the future.
  """
  type: String
}

