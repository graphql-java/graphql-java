  "Specifies the errors that occurred during the update operation."
  errors: [MutationError!]
  "The updated Single Group Picker field."
  field: JiraSingleGroupPickerField
  "Indicates whether the update operation was successful or not."
  success: Boolean!
}

"""
Represents a plain text field on a Jira Issue. E.g. summary, epic name, custom text field.
The type name is historical; use isMultiline to determine whether clients should render a single-line or multiline editor.
Multiline long text fields can contain up to 30,000 characters.
"""
type JiraSingleLineTextField implements JiraIssueField & JiraIssueFieldConfiguration & JiraListRowField & JiraTextLikeField & JiraUserIssueFieldConfiguration & Node {
  "The field ID alias (if applicable)."
  aliasFieldId: ID
  "Description for the field (if present)."
  description: String
  "Attributes of an issue field's configuration info."
  fieldConfig: JiraFieldConfig
  "The identifier of the field. E.g. summary, customfield_10001, etc."
  fieldId: String!
  "available field operations for the issue field"
  fieldOperations: JiraFieldOperation
  "Whether or not the field has a value."
  hasValue: Boolean
  "Unique identifier for the field."
  id: ID!
  "Whether or not the field is editable in the issue transition screen."
  isEditableInIssueTransition: Boolean
  "Whether or not the field is editable in the issue view."
  isEditableInIssueView: Boolean
  """
  Whether this plain text field should be rendered with a multiline editor.
  This preserves the existing JiraSingleLineTextField shape for text-like fields while
  allowing clients to distinguish long text fields without relying on the schema type name.
  """
  isMultiline: Boolean
  "Backlink to the parent issue, to aid in simple fragment design"
  issue: JiraIssue
  """
  ARI for this field in Global Issue Create / issue create context (issue-field-create-context-option resource).
  Populated only when the field is loaded under jiraIssueCreateFields (or equivalent) with a resolved project and issue type.
  """
  issueFieldCreateContextOptionAri: ID
  "Translated name for the field (if applicable)."
  name: String!
  "The text selected on the Issue or default text configured for the field."
  text: String
  "Field type key."
  type: String!
  "Configuration changes which a user can apply to a field. E.g. pin or hide the field."
  userFieldConfig: JiraUserFieldConfig
}

type JiraSingleLineTextFieldPayload implements JiraSupportsUpdatedDependentFields & Payload {
  errors: [MutationError!]
  field: JiraSingleLineTextField
  "Fields that were changed on save because they contained sensitive data, or empty if none were."
  redactedContent(first: Int): JiraRedactedContentConnection
  success: Boolean!
  """
  Connection of issue fields that were updated as a result of the mutation.
  Since this is a mutation payload, only the `first` pagination argument is supported to limit results - if `pageInfo.hasNext`
  is true in the response payload, it is recommended to refetch all fields on the updated issue to ensure stale issue field values
  are not being used.
  
  ### Field lifecycle
  
