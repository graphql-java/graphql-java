"""
# Object types

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:form:feedback__
"""
type KitsuneForm implements Node @defaultHydration(batchSize : 50, field : "kitsune_forms", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : FEEDBACK, required : [READ_FEEDBACK_FORM]) {
  createdAt: DateTime!
  createdBy: KitsuneUser
  description: String
  "Ordered by `order` ascending. Includes FIXED_VALUE fields (admin/edit view)."
  fields: [KitsuneFormField!]!
  id: ID! @ARI(interpreted : false, owner : "feedback", type : "form", usesActivationId : false)
  spaceAri: ID! @ARI(interpreted : false, owner : "feedback", type : "space", usesActivationId : false)
  state: KitsuneFormState!
  title: String!
  updatedAt: DateTime!
}

type KitsuneFormConnection implements KitsuneConnection {
  edges: [KitsuneFormEdge!]!
  pageInfo: PageInfo!
}

type KitsuneFormEdge implements KitsuneEdge {
  cursor: String!
  node: KitsuneForm
}

type KitsuneFormField {
  "Per-form help text."
  description: String
  "Nullable because KitsuneField is itself a routed (scoped) Node."
  field: KitsuneField
  fieldMode: KitsuneFormFieldMode!
  """
  Non-null only when `fieldMode` is FIXED_VALUE. For SELECT and MULTISELECT this is a JSON array
  of option ids, e.g. '["id1","id2"]'.
  """
  fixedValue: String
  """
  A `form-field` ARI. Carries no `@ARI` directive because this type is only ever
  reached nested under `KitsuneForm.fields` and is not an independently routable
  Node; AGG requires ARI-directive ids to implement `Node`.
  """
  id: ID!
  "Display order within the form (lower = earlier)."
  order: Int!
  required: Boolean!
}

