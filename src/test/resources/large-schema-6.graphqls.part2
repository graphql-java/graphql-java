type JiraForYouAgentReadinessProfile {
  """
  Version of the criteria computation semantics, incremented whenever an
  existing criterion's definition changes.
  """
  definitionVersion: Int
  """
  Candidate items with no description at all.
  These will also be counted in JiraForYouReadinessAtBar.planningNeededCount.
  Null (not zero) if this count could not be computed.
  """
  emptyDescriptionCount: Int
  """
  Whether a supported third-party coding agent (e.g. Cursor, GitHub Copilot,
  OpenAI Codex, Claude) is connected for this user/site.
  """
  has3PCodingAgent: Boolean
  "Whether this user has the Jira Coding Agent (Rovo Dev) enabled on this site."
  hasJiraCodingAgent: Boolean
  """
  Candidate work items in all remaining project types. Count-only.
  Null (not zero) if this count could not be computed.
  """
  otherCandidateCount: Int
  """
  The readiness split for the sampled software candidates, evaluated server-side against the
  work items themselves at each candidate description bar.
  """
  readinessByBar: [JiraForYouReadinessAtBar!]
  """
  Number of software candidates actually hydrated and evaluated to produce readinessByBar
  (capped server-side).
  """
  sampledSoftwareCandidateCount: Int
  """
  Candidate work items in Jira Service Management (service_desk) projects. Count-only.
  Null (not zero) if this count could not be computed.
  """
  serviceDeskCandidateCount: Int
  """
  Candidate work items in software projects. Zero is valid and expected.
  This is the only bucket evaluated for coding-agent readiness (see readinessByBar).
  """
  softwareCandidateCount: Int
  """
  Candidate work items in Jira Work Management (business) projects. Count-only.
  Null (not zero) if this count could not be computed, so failures are distinguishable
  from a genuine zero and can be excluded from aggregation.
  """
  workManagementCandidateCount: Int
}

type JiraForYouReadinessAtBar {
  "Items meeting the word bar, not blocked, and actionable by agents according to the version definition."
  codingReadyCount: Int
  """
  Sampled candidate items that are not coding-ready at this bar and need planning.
  Should always equal sampledSoftwareCandidateCount - codingReadyCount.
  """
  planningNeededCount: Int
  """
  Minimum word count a work item description must meet to be coding-ready at
  this evaluation. Emitted for 10, 40 and 80.
  """
  wordBar: Int
}

type JiraForgeAppEgressDeclaration {
  "The list of addresses this egress declaration allows."
  addresses: [String!]
  """
  The category of the egress.
  
