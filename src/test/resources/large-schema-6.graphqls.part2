"""
An onboarding canvas, including its saved state.

Saved state can be large, so it is only returned when a single canvas is fetched by id. Use
MercuryOnboardingCanvasSummary when listing.
"""
type MercuryOnboardingCanvas {
  "The kind of entity this canvas produces."
  canvasType: MercuryOnboardingCanvasType
  "The user who created the canvas."
  createdBy: User @idHydrated(idField : "createdBy", identifiedBy : null)
  "The time the canvas was created, in ISO-8601 format."
  createdDate: String!
