"""
Threaded / nested comments (distinct from legacy entity `MercuryComment` on `MercuryQueryApi`).

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:mercury:twg-cli__
"""
type MercuryThreadedComment implements LoopComment & Node @defaultHydration(batchSize : 50, field : "mercury_comments.commentsByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_MERCURY_TWG_CLI]) {
  commentText: String!
  commentType: MercuryCommentType
  containerId: ID
  createdAt: DateTime
  "The user who created the comment."
  createdBy: User @idHydrated(idField : "createdBy", identifiedBy : null)
  "Alias for createdAt."
  creationDate: DateTime
  "Alias for createdBy."
  creator: User @idHydrated(idField : "creator", identifiedBy : null)
  "Alias for updatedAt."
  editDate: DateTime
  id: ID! @ARI(interpreted : false, owner : "mercury", type : "comment", usesActivationId : false)
  "The parent comment if this is a reply."
  parentComment: MercuryThreadedComment
  parentId: ID!
  "Replies to this comment."
  replies(after: String, first: Int, sort: String): MercuryThreadedCommentConnection
  updatedAt: DateTime
}

type MercuryThreadedCommentConnection implements LoopCommentConnection {
  edges: [MercuryThreadedCommentEdge!]
  pageInfo: PageInfo!
  totalCount: Int
}

type MercuryThreadedCommentEdge implements LoopCommentEdge {
  cursor: String!
  node: MercuryThreadedComment
}

