"""
A site-level view definition. Associated containers render an instance of this definition, which
inherits all configuration from it.
"""
type JpdGlobalView {
  "Whether this global view is automatically associated with newly created containers."
  associateWithNewContainers: Boolean @semanticNonNull(levels : [0])
  """
  Number of containers this global view is associated with. Resolved on every path that returns
  a global view.
  """
  associatedContainersCount: Int @semanticNonNull(levels : [0])
  createdAt: String
  description: JSON @suppressValidationRule(rules : ["JSON"])
  emoji: String
  """
  Whether this global view has an unpublished draft. A global view has at most one draft at a
  time.
  """
  hasDraft: Boolean @semanticNonNull(levels : [0])
  """
  A global-view ARI. Deliberately not annotated with @ARI: AGG requires any type carrying that
  directive on its id field to implement Node, and global views have no Node/hydration story yet
  (see the open questions on the PR). JpdView.id is plain for the same reason. The directive is
  still applied to every global view *argument* and *input* field.
  """
  id: ID!
  name: String @semanticNonNull(levels : [0])
  ownerAaid: String
  "Position in the site-wide global view order. Lower sorts first."
  rank: Int @semanticNonNull(levels : [0])
  updatedAt: String
  viewType: JpdViewType @semanticNonNull(levels : [0])
  """
  The configuration instances inherit wholesale, overriding only their own table column widths.
  While a global view has an unpublished draft, this is the draft configuration rather than the
  published one, so an editor reads back what it last saved.
  """
  viewTypeConfig: JpdViewTypeConfig
}

"""
Outcome of an association change. Containers are processed independently, so success may be
partial: inspect each entry in results.
"""
type JpdGlobalViewAssociationResult {
  """
  Per-container outcome, one entry per container ARI supplied in the input.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ❌ No |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  results: [JpdGlobalViewContainerResult] @semanticNonNull(levels : [0, 1])
}

type JpdGlobalViewConnection implements HasPageInfo & HasTotal {
  "Total number of global views associated with at least one container, across all pages."
  associatedCount: Int
  edges: [JpdGlobalViewEdge]
  pageInfo: PageInfo!
  totalCount: Int
  "Total number of global views with an unpublished draft, across all pages."
  withDraftCount: Int
  """
  Total number of global views without an unpublished draft, across all pages. Informational
  only: there is deliberately no matching JpdGlobalViewSearchType value, because the underlying
  service supports filtering by HAVING_DRAFT but not by its negation.
  """
  withoutDraftCount: Int
}

type JpdGlobalViewContainerResult {
  containerId: ID @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false) @semanticNonNull(levels : [0])
  "Human-readable reason this container failed. Null when success is true."
  message: String
  success: Boolean @semanticNonNull(levels : [0])
}

"""
The containers a global view is associated with.
Currently only project containers can be associated with global views.

Deliberately not paginated: the number of containers a single global view may be associated with is
hard-capped by the gravity_limits projectsPerGlobalView limit, so this list is small and bounded by construction.
"""
type JpdGlobalViewContainers {
  projectIds: [ID!]! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  "The associated project containers, hydrated."
  projects: [JiraProject] @idHydrated(idField : "projectIds", identifiedBy : null)
  totalCount: Int @semanticNonNull(levels : [0])
}

