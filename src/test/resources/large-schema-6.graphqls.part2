type JiraAdminAgentRequestConfigPayload implements Payload {
  """
  The configuration as stored, so a client need not refetch.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  configuration: JiraAdminAgentRequestConfiguration
  """
  Error cases
      - Caller lacks the global ADMINISTER permission
          - errors.#.extensions.statusCode: 403
          - errors.#.extensions.errorType: FORBIDDEN
          - errors.#.message: ADMIN_AGENT_REQUEST_CONFIG_FORBIDDEN
      - requestsEnabled is true with no destination
          - errors.#.extensions.statusCode: 400
          - errors.#.extensions.errorType: BAD_REQUEST
          - errors.#.message: ADMIN_AGENT_REQUEST_CONFIG_INCOMPLETE
      - A supplied project does not resolve, is archived, or is not eligible
          - errors.#.extensions.statusCode: 404
          - errors.#.extensions.errorType: NOT_FOUND
          - errors.#.message: ADMIN_AGENT_REQUEST_PROJECT_NOT_FOUND
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  errors: [MutationError!]
  """
  
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  success: Boolean!
}

"""
The site's configuration, and how to interpret it.

The two fields are deliberately NOT mutually exclusive. `availableProjects` and the saved selection
both live on the configuration, and a client needs them in precisely the states an absent
configuration would withhold them: on a first-run site it has nothing to offer as choices, and for
an invalid destination it cannot show what was saved. See the LDR "make configuration always
present" (JIAA-501).
"""
type JiraAdminAgentRequestConfigStatus {
  """
  Whether the reader holds the global ADMINISTER permission, and so may write this configuration.
  
  Reading requires no permission — a champion needs to know whether they can raise a request at
  all — so a client needs this separately to decide whether to offer a save action. The server
  enforces the permission on write regardless; this only drives what the client renders.
  """
  canAdminister: Boolean
  """
  The site's configuration. Present even when incomplete — read `unavailableReason` to know how
  to interpret it.
  
  - `unavailableReason` null: complete and usable, `destination` non-null.
  - `NOT_CONFIGURED`: `requestsEnabled` false, `enabledProjects` / `enabledProjectIds` empty,
    `destination` null, `availableProjects` populated — so a client can offer the choices needed
    to fill it in.
  - `DESTINATION_INVALID`: saved `enabledProjects` / `enabledProjectIds` and
    `destination.workType` populated, `destination.project` null.
  - `REQUEST_WORKTYPE_INVALID`: saved `enabledProjects` / `enabledProjectIds` and
    `destination.project` populated, `destination.workType` null.
  - `FEATURE_NOT_ENABLED`: null. There is nothing to configure.
  """
  configuration: JiraAdminAgentRequestConfiguration
  """
  How to interpret `configuration`. Null when the configuration is complete and usable.
  
  An annotation on the configuration rather than a replacement for it: except for
  `FEATURE_NOT_ENABLED`, `configuration` stays populated so a client can render the available
  choices and the saved values.
  """
  unavailableReason: JiraAdminAgentRequestConfigUnavailableReason
}

"Site-wide configuration for the Admin Agent champion request flow."
type JiraAdminAgentRequestConfiguration {
  """
  The projects that may be added to `enabledProjects`.
  
  Eligibility is decided here, on the server: company-managed projects only for beta (JIAA-345).
  Clients must not filter for eligibility themselves — over a paginated connection that produces
  short and empty pages, and it would put an authorisation decision on the client.
  
  Modelled on `JiraFieldScheme.availableProjects`.
  """
  availableProjects(after: String, first: Int, input: JiraAdminAgentProjectSearchInput): JiraProjectConnection
  "Where request work items are created — one project and one work type, site-wide."
  destination: JiraAdminAgentRequestDestination
  """
  Every enabled project id, unpaginated.
  
  The write takes the complete allowlist (`JiraSetAdminAgentRequestConfigInput.enabledProjectIds`),
  so a client editing the selection has to send all of it. Deriving that set from `enabledProjects`
  means paginating to the end first, and a client that does not silently drops the projects it
  never fetched. This field is the set the write round-trips; `enabledProjects` is for display.
  
  Null when `enabledProjectsScope` is `ALL` — nothing to enumerate, same convention as the write.
  
  Returned as project ARIs (e.g. `ari:cloud:jira:<cloudId>:project/<id>`).
  """
  enabledProjectIds: [ID!] @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  """
  The projects whose members may raise champion requests.
  
  An authorisation input, not a display filter: a project absent from this list cannot open the
  agent as a champion at all. Paginated because a site may enable many, and because callers other
  than the administration modal read it to decide whether to offer champion entry points.
  
  Modelled on `JiraFieldScheme.associatedProjects`.
  
  
  This field is **deprecated** and will be removed in the future
  """
  enabledProjects(after: String, first: Int, input: JiraAdminAgentProjectSearchInput): JiraProjectConnection
  "Whether the enabled set is every eligible project or a specific curated list."
  enabledProjectsScope: JiraAdminAgentEnabledProjectsScope!
  """
  Whether this site currently offers the champion request flow to its users.
  
  An administrator-operated product control, deliberately NOT the
  `jira-admin-agent-m2-champion-flow` rollout gate, which is an engineering switch we operate.
  When this is false the M1 admin experience is unaffected; only the M2 champion flow is withheld
  from every user on the site.
  """
  requestsEnabled: Boolean
}

"The single destination every champion request work item is created in, site-wide."
type JiraAdminAgentRequestDestination {
  "The project request work items are created in."
  project: JiraProject
  """
  The work type applied to every request work item.
  
  "Work type" is Jira's current product term for what the platform still calls an issue type,
  which is why this returns a `JiraIssueType`.
  """
  workType: JiraIssueType
}

