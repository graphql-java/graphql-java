Subscriptions in jiraProductDiscovery namespace.
It is extended by other subscriptions files.
"""
type JpdSubscriptions {
  """
  Project subscription for Insight events
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ✅ Yes |
