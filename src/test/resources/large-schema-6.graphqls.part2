"""
Sort key for a particular issue, term, and view. Can be used by the client to locally sort issues according to the
view's configuration.
"""
type JiraViewSortKey {
  """
  An opaque key which can be used by the client to lexicographically sort issues locally without relying on
  relative positioning. The key always represents ascending order, the client can reverse this based on
  `JiraViewSortDirection` provided by the view's configuration, if appropriate. The client should make no attempt to
  interpret the contents. A null key represents a missing value and is placed according to `JiraViewSortNulls`.
  """
  key: String
  "The opaque ID of the sort term this key corresponds to."
  termId: String
}

