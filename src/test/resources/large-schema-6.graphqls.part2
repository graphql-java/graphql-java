"""
Form feedback the viewer submitted, as captured at submission (not its current data).
Not a Node: only reachable through `kitsune_myFeedback`.
"""
type KitsuneMyFeedback {
  "The respondent's answers in form order, excluding fixed-value fields."
  answers: [KitsuneMyFeedbackAnswer!]!
  "When the form was submitted."
  createdAt: DateTime!
  "Account ID the feedback is about: the viewer, unless submitted on someone's behalf."
  createdOnBehalfOf: ID!
  formAnswerId: ID!
  "Form ARI. The form may since have been deleted."
  formId: ID!
  "Form title at submission."
  formTitle: String!
  "Feedback ARI."
  id: ID!
  "Jira issue IDs of ideas this feedback is linked to."
  linkedIdeas: [ID!]!
  sourceType: KitsuneFeedbackType!
  "Jira issue IDs of ideas the viewer voted for with this feedback."
  votedIdeas: [ID!]!
}

"""
A form field answer as captured at submission, with the field's name, type and option
labels at that time. Read `content` for the Content answer, else the field matching `valueType`.
"""
type KitsuneMyFeedbackAnswer {
  "Value of BOOLEAN answers."
  boolean: Boolean
  "Value of the Content answer."
  content: KitsuneADF
  "Field ARI."
  fieldId: ID!
  "CONTENT for the system Content field, CUSTOM otherwise."
  fieldType: KitsuneFieldType!
  name: String!
  "Value of NUMBER answers."
  number: Float
  "Chosen options of SELECT and MULTISELECT answers. Empty for other types."
  options: [KitsuneMyFeedbackAnswerOption!]!
  "Value of TEXT, EMAIL, URL, DATE and PHONE answers, or of answers that don't decode."
  text: String
  "Null for system fields, such as Content."
  valueType: KitsuneFieldValueType
}

"An option chosen in a form answer, with its label at submission."
type KitsuneMyFeedbackAnswerOption {
  id: ID!
  "Label at submission; null if it wasn't stored."
  name: String
}

type KitsuneMyFeedbackConnection implements KitsuneConnection {
  edges: [KitsuneMyFeedbackEdge!]!
  pageInfo: PageInfo!
}

type KitsuneMyFeedbackEdge implements KitsuneEdge {
  cursor: String!
  node: KitsuneMyFeedback
}

type KitsuneNumberValue {
  _id: ID!
  value: Float!
}

