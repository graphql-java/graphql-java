"""
 ------------------------------------------------------
 Expenditure Types
 ------------------------------------------------------

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:mercury:twg-cli__
* __read:funds:focus__
"""
type MercuryExpenditureType implements Node @defaultHydration(batchSize : 50, field : "mercury_funds.expenditureTypesByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_MERCURY_TWG_CLI]) @scopes(product : NO_GRANT_CHECKS, required : [READ_FUNDS_FOCUS]) {
  displayName: String!
  id: ID! @ARI(interpreted : false, owner : "mercury", type : "expenditure-type", usesActivationId : false)
  key: String!
  order: Int!
}

type MercuryExtendOrganizationMembershipsToFiscalYearPayload implements Payload {
  errors: [MutationError!]
  "The number of memberships extended into the target fiscal year."
  extendedMembershipCount: Int
  "The IDs of memberships that received an availability range in the target fiscal year."
  extendedOrganizationMembershipIds: [ID!] @ARI(interpreted : false, owner : "mercury", type : "organization-membership", usesActivationId : false)
  "The number of eligible memberships already represented in the target fiscal year."
  skippedMembershipCount: Int
  success: Boolean!
}

type MercuryExternalOwner implements MercuryExternalUser {
  email: String
  name: String
}

"""
###################################################################################################################
 COMPONENTS - FIELD CONFIGURATION - TYPES
###################################################################################################################
"""
type MercuryFieldCapability {
  "Whether the field can be hidden"
  canHide: Boolean
  "Whether the field can be set/unset as required"
  canMarkAsRequired: Boolean
  "Whether the name of the field can be re-labeled"
  canRelabel: Boolean
  "Whether the field should be available in Global create form"
  canShowOnGlobalCreate: Boolean
}

"The settings applied to a field"
type MercuryFieldConfigurationSettings {
  "The type-specific label for this field."
  label: String
  "Whether the field is required for this type."
  required: Boolean
  "Whether the field should be shown in global create form when creating this type."
  showOnGlobalCreate: Boolean
  "The visibility for this field on the type."
  visible: Boolean
}

"A paginated list of field definitions."
type MercuryFieldDefinitionConnection {
  edges: [MercuryFieldDefinitionEdge!]
  pageInfo: PageInfo!
  totalCount: Int
}

"A single field definition in a paginated result."
type MercuryFieldDefinitionEdge {
  cursor: String!
  node: MercuryFieldDefinition
}

"""
Represents a specific dataset, version, or 'scenario' of financial values.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:mercury:twg-cli__
