"""
A private offer created by a partner for a specific customer. Mirrors the
app-catalog `PrivateOfferResponseDto`. All monetary values are expressed in
minor currency units (cents).
"""
type MarketplaceConsolePrivateOffer {
  acceptedAt: String
  actorAccountId: String!
  assignedDeveloperUserId: String
  billingCycle: String!
  commerceCorrelationId: String
  createdAt: String!
  currency: String!
  customerOrgId: ID!
  developerId: ID!
  discountType: MarketplaceConsolePrivateOfferDiscountType!
  discountValue: Int
  edition: String!
  expiryDate: String
  hostingType: String!
  latest: Int!
  legalTermsArtifact: String
  listPriceCents: Int
  """
  The numeric marketplace App ID for the offer's product. Resolved on demand
  from `productId` via the product listing product-metadata API. Null when the
  metadata lookup fails or the product has no marketplace app.
  """
  marketplaceAppId: ID
  """
  The marketplace App Key for the offer's product. Resolved on demand from
  `productId` via the product listing product-metadata API. Null when the
  metadata lookup fails or the product has no marketplace app.
  """
  marketplaceAppKey: String
  offerId: ID!
  productId: ID!
  quantity: Int
  requestId: ID
  siteId: ID
  status: MarketplaceConsolePrivateOfferStatus!
  termMonths: Int
  updatedAt: String!
  version: Int!
  viewedAt: String
  viewedByAccountId: String
  withdrawReason: String
}

"""
The compact result returned by private offer write mutations (create, update,
share, withdraw). Mirrors the app-catalog write response DTOs, which return only
the offer identity, resulting status/version and a relevant timestamp rather than
the full offer representation. `createdAt` is populated on create; `updatedAt` on
update/share/withdraw; `withdrawReason` only on withdraw.
"""
type MarketplaceConsolePrivateOfferMutationResult {
  createdAt: String
  offerId: ID!
  status: MarketplaceConsolePrivateOfferStatus!
  updatedAt: String
  version: Int!
  withdrawReason: String
}

