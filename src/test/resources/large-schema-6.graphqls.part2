"The destination and audit details for a promoted Ask."
type MercuryAskPromotedItem {
  "The Focus Area or Jira work item this Ask was promoted to."
  entity: MercuryAskPromotedEntity @idHydrated(idField : "id", identifiedBy : null)
  "The ARI of the Focus Area or Jira work item this Ask was promoted to. Mixed ARI types, so no @ARI."
  id: ID
  "The Atlassian user who promoted the Ask."
  promotedBy: User @idHydrated(idField : "promotedById", identifiedBy : null)
  "The ID of the Atlassian user who promoted the Ask."
