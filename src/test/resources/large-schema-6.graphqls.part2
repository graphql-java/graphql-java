"""


### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:jsm:twg-cli__
"""
type HelpCenterPage implements Node @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI]) {
  "Timestamp of page creation"
  createdAt: String
  "Description of the helpcenter page."
  description: HelpCenterPageDescription
  "ARI of the Help center, this page belong to"
  helpCenterAri: ID!
  id: ID! @ARI(interpreted : false, owner : "help", type : "page", usesActivationId : false)
  """
  Whether this page has a live counterpart (i.e. has ever been published).
  
  Defaults to true. When false, the page exists only as a draft.
  """
  isPublished: Boolean
  "Name of the helpcenter page."
  name: HelpCenterPageName
  "Layout associated with the Help center page"
  pageLayout: HelpCenterPageLayout
  "Help Center Page Type"
  pageType: HelpCenterPageType
  """
  Ordered chain of entities containing this page, OUTERMOST FIRST - index 0 is the
  outermost container, and the last element is this page's direct parent. The
  invisible ROOT folder is never included, and this page itself is never included.
  
  Today this is always either empty or exactly one folder, because non-root folders
  contain pages only. It is modelled as a list so that introducing nested folders
  later needs no schema change.
  
  Empty (`[]`) means the page definitively has no parent - a custom page at the root
  of the site tree, CUSTOM_HOME, a portal page, or a topic. `null` means the chain
  could not be resolved (transient failure); it never means "no parents". Clients
  should render both the same way.
  """
  parents: [HelpCenterPageParentReference!]
  "Rovo configuration for the Help Center page"
  rovoConfig: HelpCenterPageRovoConfig
  "Timestamp of latest update"
  updatedAt: String
}

