"Remote MCP (Model Context Protocol) server deployment properties"
type MarketplaceRemoteMcpDeployment implements MarketplaceAppDeployment {
  """
  All Atlassian Products this app version is compatible with.
  Always empty for MCP servers: they declare no Atlassian product compatibilities.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  compatibleProducts: [CompatibleAtlassianProduct!]!
  """
  Unique identifier of the remote MCP server backing this app version.
  Equals the Integrations Service `templateId`.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  mcpId: ID!
  """
  Error message when the MCP server details fail to fetch.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  serverFetchError: String
  """
  Every authentication mechanism the server supports
  Never empty; defaults to ["OAUTH"].
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  supportedAuthTypes: [String!]!
  """
  Tools this server exposes.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ❌ No |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ✅ Yes |
  """
  tools: [MarketplaceMcpTool!]!
}

