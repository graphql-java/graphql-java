  """
  Return all the PR with their builds linked to Issue using Cypher Query
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jira-work__
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "JiraPrAndBuildLinkedToIssue")' query directive to the 'prAndBuildLinkedToIssue' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  prAndBuildLinkedToIssue(after: String, first: Int, issueId: ID! @ARI(interpreted : false, owner : "jira", type : "issue", usesActivationId : false)): GraphStoreCypherQueryV2Connection @cypherQueryV2(query : "MATCH (issue:JiraWorkItem {ari: $issueId})-[:jira_work_item_links_external_pull_request]->(pr:ExternalPullRequest)\nOPTIONAL MATCH (issue)-[:jira_work_item_links_external_build]->(build:ExternalBuild)\nwhere pr.headCommitHash=build.commitHash\nWITH pr, build\nORDER BY build.lastUpdated DESC\nWITH pr, collect(build) AS builds\nORDER BY pr.status ASC, pr.lastUpdated\nreturn pr,builds") @lifecycle(allowThirdParties : false, name : "JiraPrAndBuildLinkedToIssue", stage : EXPERIMENTAL) @scopes(product : JIRA, required : [READ_JIRA_WORK])
  """
