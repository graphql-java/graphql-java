  success: Boolean!
}

"""
Per-action result for a single JiraRemediationActionInput within a batch.

Correlate a result to its input by its sourceEntityId, which the mutation guarantees
is unique per request (a source entity may be remediated at most once per request, so
duplicate sourceEntityIds are rejected as invalid input). On success, status is set
and errorType/message are null; on a per-action failure, errorType/message are set and
status is null.
"""
type JiraRemediationActionResult {
  "Error type if the action failed or was rejected; null on success."
  errorType: JiraRemediationErrorType
  "Error message when errorType is set; null on success."
  message: String
  "The kind of remediation that was requested; echoed from the input for reference."
  remediationType: JiraRemediationType!
  "The rule the action targeted; echoed from the input for reference."
  ruleId: ID!
  "ARI of the source entity the action targeted; the correlation key, unique per request."
  sourceEntityId: ID!
  "Progress status if the action was accepted; null on failure."
  status: JiraRemediationProgressStatus
}

"Progress snapshot for a policy violation remediation."
type JiraRemediationProgress {
  "Current lifecycle status of the remediation."
  status: JiraRemediationProgressStatus!
}

