}

" Main activity feed item type for history"
type JiraHistoryActivityFeedItem {
  actor: User @hydrated(arguments : [{name : "accountIds", value : "$source.actor.accountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  fieldDisplayName: String
  fieldId: String
  fieldSchema: JiraHistoryFieldSchema
  fieldType: String
  from: JiraHistoryValue
  i18nDescription: String
  id: ID!
  isDueToRedaction: Boolean
  isDueToRedactionRestore: Boolean
  timestamp: Long
  to: JiraHistoryValue
}

"""
The agent session an activity relates to. Identifiers are best-effort: a session
backed by a local agent has no server-side agent account, and the ConvoAI-sourced
identifiers are only populated once the session has been reconciled. When
agentAccountId is null the hydrated agent is null too, so fall back to displayValue.

startTime is when the session was linked to this work item, which for a session spanning
several work items is later than the session's own start. It is present on both events, so
a duration can be derived on COMPLETED by subtracting it from occurredAt.
"""
type JiraHistoryAgentSession {
  agent: User @hydrated(arguments : [{name : "accountIds", value : "$source.agentAccountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  agentAccountId: String
  agentAri: String
  convoAiAgentId: String
  invocationType: String
  jcaSessionAri: String
  sessionId: String
  startTime: Long
}

"""
What happened to an agent session. Unlike the other members of JiraHistoryValue this
describes an event rather than a field transition, so the matching `from` is always null.
"""
type JiraHistoryAgentSessionFieldValue {
  author: User @hydrated(arguments : [{name : "accountIds", value : "$source.authorAccountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  authorAccountId: String
  displayValue: String
  eventType: JiraHistoryAgentSessionEventType
  formattedValue: String
  occurredAt: Long
  previousState: String
  session: JiraHistoryAgentSession
  value: String
}

type JiraHistoryAssigneeFieldValue {
  avatarUrl: String
  displayValue: String
  formattedValue: String
  user: User @hydrated(arguments : [{name : "accountIds", value : "$source.value"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  value: String
}

"""
History GraphQL Schema for AGG
Defines cursor-based pagination types for issue history
"""
type JiraHistoryAttachmentFieldValue {
  fileName: String
  id: ID
  mediaApiFileId: String
}

"""
A consolidated history row in the activity timeline, built from a run of changes sharing one actor
within a fixed one-minute window; a standalone change is a single-member group. Agent attribution is
carried per change on each section's JiraHistoryItem, not on the group. This is one member of the
JiraActivityTimelineItem union.
"""
type JiraHistoryChangeGroup {
  actor: User @hydrated(arguments : [{name : "accountIds", value : "$source.actor.accountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  id: ID!
  kind: JiraHistoryGroupKind
  sections: [JiraHistoryChangeGroupSection!]!
  timestamp: Long
}

"""
A labelled subset of a history group's changes. The label is used for sub-sectioning (e.g. link
relationship); it is null for the default Fields section. Each change is a JiraHistoryItem wrapper
so every change carries its own sibling agentAttribution, exactly like the flat all-activity feed.
"""
type JiraHistoryChangeGroupSection {
  changes: [JiraHistoryItem!]!
  label: String
}

" Field schema type"
type JiraHistoryFieldSchema {
  customFieldType: String
  itemType: String
  type: String
}

type JiraHistoryGenericFieldValue {
  attachment: JiraHistoryAttachmentFieldValue
  category: String
  displayValue: String
  formattedValue: String
  url: String
  users: [User]
  value: String
}

" History item wrapper for union compatibility"
type JiraHistoryItem {
