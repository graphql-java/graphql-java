type JiraFieldPredictionCandidate {
  "Identifier for the candidate option (matches the id supplied in the input)."
  id: String
  "Whether this candidate scored above the prediction confidence threshold."
  isAboveThreshold: Boolean
  "Display value of the candidate option (matches the value supplied in the input)."
  value: String
}

"Prediction results for a single field."
type JiraFieldPredictionFieldResult {
  """
  Error message when `success = false` (e.g. unsupported field, no candidates
  could be resolved). Null on success.
  """
  errorMessage: String
  "Field ID this result corresponds to."
  fieldId: String!
  """
  Prediction outcomes — one per prediction service that ran for this field.
  Empty when no service produced a result.
  """
  predictions: [JiraFieldPredictionOutcome!]!
  "Whether prediction succeeded for this field."
  success: Boolean!
}

"""
The result from a single prediction service for a single field.

A live outcome carries ranked `candidates` and a null `skippedReason`. A skipped outcome
carries an empty `candidates` list and a non-null `skippedReason` — the entry is still
emitted so callers can distinguish "service ran and returned nothing" from "service was
never invoked because a precondition (auth, semantic context, field-type support) was
not met". UI / AI callers can use the skip reason to decide whether to retry with more
context (e.g. once the user types a summary) or to suppress the affordance entirely.
"""
type JiraFieldPredictionOutcome {
  """
  Scored / ranked candidates in descending confidence order. Empty when `skippedReason`
  is non-null.
  """
  candidates: [JiraFieldPredictionRankedCandidate!]!
  "Prediction service type that produced this result."
  predictionType: JiraFieldPredictionType!
  "Reason the service was skipped, or null when the service ran successfully."
  skippedReason: JiraFieldPredictionSkipReason
}

"A single scored / ranked prediction candidate."
type JiraFieldPredictionRankedCandidate {
  "Candidate identifier (matches the id supplied in input, or resolved server-side)."
  id: String!
  """
  Whether this candidate is recommended — i.e. it scored above the prediction
  confidence threshold and should be surfaced to the user.
  """
  recommended: Boolean!
  "ML confidence score (0.0–1.0). Null if the underlying service does not emit scores."
  score: Float
  "Display value of the candidate."
  value: String
}

type JiraFieldPredictionResult {
  """
  Count of candidates that scored above the prediction confidence threshold.
  Null when no synchronous prediction was executed.
  """
  candidatesAboveThreshold: Int
  """
  Re-ranked candidates from the synchronous baseline prediction, in descending confidence order.
  Null when no synchronous prediction was executed (e.g. field type not yet supported, or feature not enabled).
  """
  predictions: [JiraFieldPredictionCandidate]
  "Whether the fetcher completed without a server error (validation errors are reported separately)."
  success: Boolean
}

"Top-level result of a `fieldPredictions` call."
type JiraFieldPredictionsResult {
  "Prediction results, one entry per requested field, in input order."
  fieldResults: [JiraFieldPredictionFieldResult!]!
  """
  Whether the call completed without a server error. Per-field errors are surfaced
  on the individual `fieldResults` entries.
  """
  success: Boolean!
}

"""
Represents Field Scheme information
which is used to display the schemes in centralised fields administration UIs

