"""
Represents a project field on a Jira Issue.
Both the system & custom project field can be represented by this type.
"""
type JiraProjectField implements JiraIssueField & JiraIssueFieldConfiguration & JiraListRowField & JiraUserIssueFieldConfiguration & Node {
