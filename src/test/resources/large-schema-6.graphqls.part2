}

"DRAFT / FOR REVIEW. Expandable detail content for a JsmChannelsProgressLogEntry. All fields nullable."
type JsmChannelsProgressLogDetail {
  "Unredacted raw detail (e.g. raw tool output). Pending the redaction pipeline — treat as sensitive."
  rawText: String
  "Free-form rationale — decision reasoning, approval reason, handoff reason, etc."
  reason: String
  "Safe, human-readable explanation, e.g. 'Insufficient permissions to reset the user's Figma password.'"
  text: String
}

"DRAFT / FOR REVIEW. A single log entry — one execution attempt's outcome for a step. Deliberately lean: no stepId/stepTitle here, since the enclosing JsmChannelsProgressLogStepGroup already carries that context. Plan-level events (RUN_COMPLETED, APPROVAL_*, no stepId) don't have a home in this schema yet — still under design discussion. Generic names, additive-only, may end up shared with the chain-of-thought reasoning feature. Nullability follows JsmChannelsReasoningEvent: discriminators (id/type/status/occurredAt) non-null, payload (summary/detail) nullable."
type JsmChannelsProgressLogEntry {
  "Tier 2 — shown on second expand, nested under this entry's summary."
  detail: JsmChannelsProgressLogDetail
  "Unique id for this entry. Must always be assigned by the producer — required for live-update upserting."
  id: ID!
  "When this entry occurred."
  occurredAt: DateTime!
  "Status for this entry."
  status: JsmChannelsProgressLogStatus!
  "Tier 1 — shown on first expand."
  summary: JsmChannelsProgressLogSummary
  "Discriminator for what kind of entry this is."
  type: JsmChannelsProgressLogEntryType!
}

"DRAFT / FOR REVIEW. One step's complete progress log history — the Progress Log UI's Level-1 row. stepId is null only for INPUT_RECEIVED, a plan-level event with no step of its own — it gets a singleton group. Every other plan-level event type (RUN_COMPLETED, APPROVAL_*) is intentionally excluded from progressLogs for now — still under design discussion on where they belong."
type JsmChannelsProgressLogStepGroup {
  "Every entry for this step, oldest first."
  entries: [JsmChannelsProgressLogEntry!]!
  "Stable grouping key — the plan-authored step id. Null only for INPUT_RECEIVED."
  stepId: ID
  "Level-1 label — the step title. Null for INPUT_RECEIVED."
  stepTitle: String
}

"DRAFT / FOR REVIEW. Always-visible summary content for a JsmChannelsProgressLogEntry. All fields nullable."
type JsmChannelsProgressLogSummary {
  "Closed category/bucket for this row, when applicable (e.g. a failure category)."
  category: String
  "The rendered one-liner, e.g. 'Could not reset password'."
  text: String
}

"A single chain-of-thought reasoning event pushed by convo-ai in real-time."
type JsmChannelsReasoningEvent {
  "SourceCitation: short excerpt from the source (may be null if UGC redacted)"
  excerpt: String
  "Forward-compatibility escape hatch — any fields not yet modelled above"
  extras: JSON @suppressValidationRule(rules : ["JSON"])
  "FailureAttribution: optional human-readable failure message"
  message: String
  "SourceCitation: product derived from the source URL (confluence or jira); null when unrecognized"
  productType: String
  "ConfidenceSignal: human-readable rationale for the score"
  rationale: String
  "FailureAttribution: structured reason code for the failure"
  reason: String
  "FailureAttribution: whether the failure is recoverable by retry"
  recoverable: Boolean
  "SourceCitation: relevance score 0.0–1.0 indicating match quality"
  relevanceScore: Float
  "ConfidenceSignal: confidence score 0.0–1.0 at the end of this stage"
  score: Float
  "SourceCitation: category of the retrieved source"
  sourceType: String
  "Stage that emitted this event — triaging | analysing | planning | executing"
  stage: String!
  "Correlation ID — all events sharing a stepId belong to the same reasoning step"
  stepId: String!
  "ThinkingStep: user-facing summary of what the agent is doing at this stage"
  summary: String
  "ConfidenceSignal: bucketed tier — LOW | MEDIUM | HIGH"
  tier: String
  "Epoch millis when the event was emitted by convo-ai"
  timestampMs: Float
  "SourceCitation: title of the retrieved document or issue"
  title: String
  "Discriminator — thinking_step | source_citation | confidence_signal | failure_attribution"
  type: String!
  "SourceCitation: URL to the source"
  url: String
}

