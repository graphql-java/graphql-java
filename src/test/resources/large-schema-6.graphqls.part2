"""
GTM Graph account. Sourced from the Sales Data Platform.
id is the Account ARI: ari:cloud:gtm::account/workspace/{workspaceId}/{sdpUuid}.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:csm:twg-cli__
"""
type GtmAccount implements Node @defaultHydration(batchSize : 200, field : "gtm_accountsById", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_CSM_TWG_CLI]) {
  accountDomain: String
  """
  
  
  
  This field is **deprecated** and will be removed in the future
  """
  accountId: String
  accountName: String
  accountOwnerId: String
  accountSegment: String
  accountSfdcId: String
  """
  
  
  
  This field is **deprecated** and will be removed in the future
  """
  accountTeam: [GtmAccountTeamMember!]
  accountType: String
  annualContractValue: Float
  country: String
  createdAt: String
  customerSince: String
  enterpriseAccountStatus: String
  id: ID! @ARI(interpreted : false, owner : "gtm", type : "account", usesActivationId : false)
  naicsIndustry: String
  nbpPotential: Float
  region: String
  salesTerritory: String
  sfdcAccountOwnerName: String
  updatedAt: String
}

"""
A contact on a GTM Graph account. Sourced from the Sales Data Platform.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:csm:twg-cli__
"""
type GtmAccountContact @scopes(product : NO_GRANT_CHECKS, required : [READ_CSM_TWG_CLI]) {
  customerDomain: String
  email: String
  name: String
  phone: String
  role: String
  sfdcAccountId: String
  sfdcContactId: String
  title: String
}

