"""
Connection-style response for consolidated resources.

Implements Relay-compatible pagination pattern.
Use edges for resource data and pageInfo for pagination state.
"""
type JiraConsolidatedResourceConnection {
  """
  List of resource edges.
  
  Each edge contains:
  - node: The actual resource data
  - cursor: Opaque cursor for pagination
  """
  edges: [JiraConsolidatedResourcesEdge!]!
  """
  Pagination metadata.
  
  Use pageInfo.hasNextPage to determine if more data available.
  Use pageInfo.endCursor as 'after' parameter for next query.
  """
  pageInfo: PageInfo!
}

type JiraConsolidatedResourcesEdge {
  """
  Opaque cursor for this resource.
  
  Pass to next query's 'after' parameter to continue pagination.
  Do not parse or modify this value.
  """
  cursor: String!
  """
  The resource data.
  
  Content depends on hydration level:
  - hydrate: true  -> Full resource details
  - hydrate: false -> Metadata only
  """
  node: JiraConsolidatedResource!
}

