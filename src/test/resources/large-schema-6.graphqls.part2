"""
Error extension carrying presentation detail for an error the owning service enriched. In addition
to the generic status code and error type, it provides subtext and calls-to-action (such as a
learn-more link) so a client can render the full message instead of the bare error string.

Clients should select this extension on `__typename` rather than on `errorType`: the status code and
error type are those of the underlying failure (commonly a 400 validation error), so they do not
distinguish an enriched error from a plain one. Entity-limit breaches are the first use of this
extension, but it is not limited to them.
"""
type JiraDetailedMutationErrorExtension implements MutationErrorExtension {
  """
  Calls-to-action for the error, such as a learn-more link.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  actions: [JiraErrorAction!]
  """
  Subtext expanding on the error, for example the limit that was reached and how to proceed.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  additionalDetails: String
  """
  Application specific error type.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  errorType: String
  """
  A numerical code (such as a HTTP status code) representing the error category.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  statusCode: Int
}

