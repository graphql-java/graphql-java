  installations: [Installation!]!
  """
  Opaque cursor pointing to the last document on this page.
  Pass as the cursor argument on the next request to retrieve the next page
  using sort-key pagination (search_after), which supports more than 10,000 results.
  Null when there is no next page.
  """
