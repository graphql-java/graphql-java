"""
Company record for the account profile.

The same firmographic fields as GrowthUnifiedProfileCompanyRecord plus
accountSegment and domainType, which are exposed only on accountProfile and
deliberately absent from the companyProfile query. GraphQL has no field inheritance
between object types, so the shared fields are restated here; on the TypeScript side
the relationship is real (graphqlAccountCompanyRecordSchema extends
graphqlCompanyRecordSchema), so the two cannot drift silently.

Not every field is backed by stored company data. domain and domainType are derived
from the caller's user context, so this record is returned for any resolvable
customer domain — including one we hold no firmographics for, where every other
field is null. Check companyId to tell the two apart: it is present only when a
company record actually exists. This is why companyId is nullable here while the
equivalent field on GrowthUnifiedProfileCompanyRecord is not.
"""
type GrowthUnifiedProfileAccountCompanyRecord {
  "Sales account segment the company falls into"
  accountSegment: String
  "Address"
  address: String
  "Address city"
  addressCity: String
  "Address country"
  addressCountry: String
  "Address state"
  addressState: String
  "Annual revenue"
  annualRevenue: Float
  "Business name"
  businessName: String
  "Company enterprise sized flag"
  companyEnterpriseSized: Boolean
  """
  Company ID. Null when we hold no company record for the caller's domain — use
  this to distinguish an unenriched domain from an enriched one.
  """
  companyId: String
  "Company size"
  companySize: String
  "Company type"
  companyType: String
  "Country code"
  countryCode: String
  "Created date"
  createdDate: String
  "Customer account IDs"
  customerAccountId: [String]
  "Company description"
  description: String
  "Developers count"
  developersCount: Int
  "Company domain, from the caller's user context. Always present."
  domain: String!
  """
  Whether the caller's email domain is a business or a personal one (gmail.com,
  outlook.com, ...). Derived from the caller's auth context rather than stored on
  the company record, and always present. The same classification as
  unifiedProfile.userProfile.domainType.
  """
  domainType: GrowthUnifiedProfileDomainType!
  "Employees range"
  employeesRange: String
  "Enrichment source"
  enrichmentSource: String
  "Enterprise account status"
  enterpriseAccountStatus: String
  "Estimated annual revenue"
  estimatedAnnualRevenue: String
  "Industry"
  industry: String
  "Industry group"
  industryGroup: String
  "IT agents count"
  itAgentsCount: Int
  "Knowledge workers count"
  knowledgeWorkersCount: Int
  "Market cap"
  marketCap: String
  "NAICS code"
  naicsCode: String
  "Number of employees"
  numberOfEmployees: Int
  "Phone number"
  phone: String
  "Postal code"
  postalCode: String
  "Record number"
  recordNumber: Int
  "Record status"
  recordStatus: String
  "Refresh date"
  refreshDate: String
  "Region"
  region: String
  "Revenue currency"
  revenueCurrency: String
  "Sector"
  sector: String
  "Sector raw"
  sectorRaw: String
  "SIC code"
  sicCode: String
  "Source sequence ISO"
  sourceSequenceIso: String
  "Stock ticker"
  stockTicker: String
  "Sub industry"
  subIndustry: String
  "Technologies used"
  techsUsed: [String]
  "Company website"
  website: String
}

"Account profile result"
type GrowthUnifiedProfileAccountProfileResult {
  """
  Per-product usage aggregate metrics for the company the account belongs to,
  derived from the same customer domain as companyProfile. Null under the same
  conditions, and additionally when the company has no usage snapshot yet.
  """
  companyProductUsage: GrowthUnifiedProfileCompanyProductUsageRecord
  """
  Company the account belongs to, derived from the customer domain on the caller's
  user context. Personal email domains are served here too — read domainType to
  tell them apart rather than assuming every record describes a business.
  Present whenever a customer domain resolves, even if we hold no company data for
  it: domain and domainType come from the user context, so a domain with no
  firmographics returns those two with every other field null. Null only for
  callers with no customer domain at all (anonymous or staff).
  """
  companyProfile: GrowthUnifiedProfileAccountCompanyRecord
  "\"paid feature usage/ PFU data for the account"
  paidFeatureUsage(
    "Filter for paid feature usage/ PFU data"
    filter: GrowthUnifiedProfilePFUFilter!
  ): [GrowthUnifiedProfilePFUResult!]!
  "Nbp Product recommendation"
  recommendations: GrowthUnifiedProfileUserRecommendations
  "Properties of the user"
  userProfile: GrowthUnifiedProfileAccountUserProfile
}

"User profile for account profile"
type GrowthUnifiedProfileAccountUserProfile {
  "IANA time zone identifier Eg. \"America/New_York\" "
  inferredTimezone: String
}

