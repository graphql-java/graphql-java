"""
Configuration defining how issues/ideas are presented in the view.
Contains all display, grouping, filtering, and sorting settings.
"""
type GravityViewConfig {
  "Use bold/saturated colors for better visibility."
  boldColors: Boolean
  "Field to color ideas/issues by (VTRI identifier)."
  colorBy: ID
  "How to apply the color (BACKGROUND or HIGHLIGHT)."
  colorStyle: GravityViewColorStyle
  "Column size configuration for table views."
  columnSize: GravityViewColumnSize
  "Filters applied within the connections panel."
  connectionsFilter: [GravityViewFilter!]
  "Layout of connected issues shown on cards."
  connectionsLayoutType: GravityViewConnectionsLayoutType
  "Rollup aggregations displayed per field in the view footer."
  fieldRollups: [GravityFieldRollup!]
  """
  List of field VTRI identifiers to include in the view (i.e. visible columns in table).
  VTRI format: 'vtri:<resource>:<kind>:<value>'.
  For fields:
  - 'vtri:field:ref:<ref>' is a template-scoped identifier a template defines to uniquely
  reference a field in the template definition. It is not an existing field.
  It must be resolved to a concrete field when instantiating the view.
  - 'vtri:field:id:<id>' refers to an existing concrete field in the DB (e.g. 'vtri:field:id:customfield_10055').
  """
  fields: [ID!]!
  "Main filters applied to the entire view."
  filter: [GravityViewFilter!]
  """
  Grouping dimension on the horizontal axis.
  VTRI identifier of the field to group by.
  """
  groupBy: ID
  "Ordered values for the horizontal grouping."
  groupValues: [GravityViewGroupValue!]
  "Filters that apply only to group-level issues when view is grouped by connection field."
  groupsFilter: [GravityViewFilter!]
  "Field VTRI identifiers explicitly hidden in the view."
  hidden: [ID!]
  "Hide empty columns in board view."
  hideEmptyColumns: Boolean
  "Hide/collapse empty groups when view is grouped."
  hideEmptyGroups: Boolean
  "JQL applied to the view."
  jql: String
  "View layout type. Determines how much information is shown per item."
  layoutType: GravityViewLayoutType
  "Axis configuration for matrix views."
  matrixConfig: GravityViewMatrixConfig
  "Whether the leading row-number column is shown. Table views only."
  numberColumnDisplay: GravityViewNumberColumnDisplay
  "Show card cover images on board views."
  showCardCovers: Boolean
  "Show only connections matching the current column."
  showConnectionsMatchingColumn: Boolean
  "Show only connections matching the current group."
  showConnectionsMatchingGroup: Boolean
  "Sort criteria applied to items in the view."
  sort: [GravityViewSort!]
  "View sort mode - determines whether to use field-based sorting or rank-based sorting."
  sortMode: GravityViewSortMode
  "Per-field column width overrides for table views."
  tableColumnSizes: [GravityViewTableColumnSize!]
  "Date fields and visible window for timeline views."
  timelineConfig: GravityViewTimelineConfig
  "Labelled vertical markers on the timeline."
  timelineMarkers: [GravityViewTimelineMarker!]
  "Hierarchy configuration for tree views."
  treeConfig: GravityViewTreeConfig
  """
  Grouping dimension on the vertical axis.
  VTRI identifier of the field to vertically group by.
  """
  verticalGroupBy: ID
  "Ordered values for the vertical grouping."
  verticalGroupValues: [GravityViewGroupValue!]
  "Filters that apply only to board view columns (vertical groups)."
  verticalGroupsFilter: [GravityViewFilter!]
}

