"""
One field that was silently changed on save because it contained sensitive data.

Jira removes sensitive data from content as it is saved, where the organisation's policy
requires it. The write still succeeds, so the user is told afterwards what was changed —
otherwise their text would appear to have altered itself.

Shared by every mutation payload that can carry redactions, so the shape stays identical
wherever a user meets it.
"""
type JiraRedactedContent {
  """
  What kind of content was redacted, as a stable identifier.
  
  Currently one of SUMMARY, DESCRIPTION, ENVIRONMENT, COMMENT, WORKLOG_COMMENT or
  CUSTOM_FIELD. This list will grow as Jira redacts more surfaces, so clients must
  tolerate values they do not recognise and fall back to generic wording.
  
  A string rather than an enum for that reason: a new enum value is a breaking change
  for clients that switch exhaustively over it.
  
  Not display text. The server does not reliably know the reader's language on a save
  path, so clients map this to their own localised strings.
  """
  contentKind: String
  """
  How many separate pieces of sensitive data were removed from that field.
  
  At least one whenever this resolves: a redaction is only ever reported because
  something was removed. Nullable so that a failure resolving this single field
  cannot null the whole redaction, not because the count is ever legitimately
  absent.
  """
  redactionCount: Int
}

"The fields a single save had sensitive data removed from."
type JiraRedactedContentConnection {
  "The redacted fields."
  edges: [JiraRedactedContentEdge]
  "Information about the current page. Used to aid in pagination."
  pageInfo: PageInfo!
  "The total count of fields that were redacted."
  totalCount: Int
}

"A single redacted field within a connection."
type JiraRedactedContentEdge {
  "The cursor of this edge, for pagination."
  cursor: String!
  "The redacted field."
  node: JiraRedactedContent
}

"Represents a redaction in Jira"
type JiraRedaction {
  "Time when the redaction was created"
  created: DateTime
  "External Redaction ID of the redacted entity."
  externalRedactionId: String
  "Redacted field name"
  fieldName: String
  "Identifier for the redaction."
  id: ID!
  "Reason for redaction"
  reason: String
  "User who redacted the field"
  redactedBy: User @hydrated(arguments : [{name : "accountIds", value : "$source.redactedBy.accountId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  "Time when the redaction was last updated"
  updated: DateTime
}

"A connection type for JiraRedaction"
type JiraRedactionConnection {
  "The list of edges in the connection"
  edges: [JiraRedactionEdge]
  "Information to aid in pagination"
  pageInfo: PageInfo!
  "Total count of redactions"
  totalCount: Long
}

"An edge in a JiraRedaction connection"
type JiraRedactionEdge {
  "The cursor to this edge"
  cursor: String
  "The node at the edge"
  node: JiraRedaction
}

