"""
Represents the data required to render a Jira board view.

### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __jira:atlassian-external__
* __read:jira-work__
* __read:jira-platform:twg-cli__
"""
type JiraBoardView implements JiraView & Node @defaultHydration(batchSize : 200, field : "jira_viewsByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : JIRA, required : [JIRA_ATLASSIAN_EXTERNAL]) @scopes(product : JIRA, required : [READ_JIRA_WORK]) @scopes(product : NO_GRANT_CHECKS, required : [READ_JIRA_PLATFORM_TWG_CLI]) {
  """
  The number of currently auto-managed active sprints that have a complete-sprint error.
  Returns null when no active sprints can be found.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  autoCompleteSprintErrorCount: Int
  """
  A connection of all available fields to group issues on the board view by.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  availableGroupByOptions(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int,
    """
    Filter returned options by their display name. The text is split on whitespace into terms, and an option is
    returned only when its name contains every term, ignoring case and term order.
    """
    searchText: String,
    "Input for settings applied to the board view."
    settings: JiraBoardViewSettings
  ): JiraViewGroupByConfigConnection
  """
  Transitions available for the current user to perform on a particular issue on this board, based on its current state.
  
  
  This field is **deprecated** and will be removed in the future
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  availableTransitionsForIssue(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int,
    """
    ARI of the issue to return available transitions for. It is treated as the drag anchor issue, i.e. the issue
    being dragged.
    """
    issueId: ID!
  ): JiraTransitionConnection
  """
  Transitions available for the current user to perform on all of the given issues on this board (the
  intersection of each issue's available transitions). The returned transitions are common to every selected
  issue and can be applied as a single shared transition. This connection is empty when the issue selection spans more than one workflow.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  availableTransitionsForIssues(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int,
    """
    ARIs of the issues to return the common available transitions for. Order is significant: the first ARI is the
    drag anchor issue, i.e. the issue being dragged. The order of the remaining ARIs is not significant, and
    duplicate ARIs are ignored.
    """
    issueIds: [ID!]!
  ): JiraTransitionConnection
  """
  A connection of statuses mapped to the special Backlog column, which determines which statuses appear in the Backlog
  view rather than on the board for Software CMP Kanban. Returns null when no Backlog column applies to this board view.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  backlogStatuses(
    """
    The index based cursor to specify the beginning of the items.
    If not specified it's assumed as the cursor for the item before the beginning.
    """
    after: String,
    """
    The number of items after the cursor to be returned in a forward page.
    If not specified, it is up to the server to determine a page size.
    """
    first: Int
  ): JiraBoardViewStatusConnection
  """
  JQL matching the view's base scope: the issues it shows before any filter the view applies on top of it. Settings
  defining the scope still apply. Same as `viewJql` for views which do not apply filters on top of their scope.
  Null when the view cannot describe its scope as JQL, or when its scope resolves to no issues at all.
  
  Callers combining this with their own conditions must parenthesize both sides: the generated JQL can rely on JQL
  operator precedence (`AND` binding tighter than `OR`), so naive concatenation can change its meaning.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ✅ Yes |
  """
  baseJql: String
  """
  The rapid view associated with the board view, if applicable.
  
  |Authentication Category    |Callable      |
