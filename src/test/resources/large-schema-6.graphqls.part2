}

type MercuryAskEdge {
  cursor: String!
  node: MercuryAskResult
}

"""
The admin-configured settings that apply to every ask of a given ask type.

A setting that has never been configured is null, in which case the client should
fall back to the product default for that setting.
"""
type MercuryAskGlobalConfiguration implements MercuryConfiguration {
  "How asks of this type can be promoted to other entities."
  askPromotionSettings: MercuryAskPromotionSettings
  "Whether work can be connected to asks of this type."
  connectedWorkEnabled: Boolean
  "Whether asks of this type must follow the Atlassian workflow."
  enforceAtlassianWorkflow: Boolean
  """
  The stable identifier for the configuration, which is the id of the ask type it configures.
  A configuration has no identity of its own, so it stays stable even before any setting is configured.
  """
  id: ID!
}

type MercuryAskIcon {
  url: String!
}

"""


### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __read:mercury:twg-cli__
"""
type MercuryAskLink implements Node @defaultHydration(batchSize : 50, field : "mercury_askLinksByIds", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : NO_GRANT_CHECKS, required : [READ_MERCURY_TWG_CLI]) {
  askId: ID! @ARI(interpreted : false, owner : "mercury", type : "ask", usesActivationId : false)
  attachedByUser: User @idHydrated(idField : "attachedByUserId", identifiedBy : null)
  attachedByUserId: ID @ARI(interpreted : false, owner : "identity", type : "user", usesActivationId : false)
  attachedDateTime: DateTime
  id: ID! @ARI(interpreted : false, owner : "mercury", type : "ask-link", usesActivationId : false)
  linkText: String
  url: URL!
}

