  cannibalisationRiskSegment: String
  "Estimated charge elements used for the collection price estimate"
  collectionChargeElementsEstimate: [GrowthUnifiedProfileCollectionSegmentChargeElementResult!]!
  "Collection offering for the segment"
  collectionOfferingId: String
  "Estimated price of the future collection for this entitlement, in the given billing cycle"
  collectionPriceEstimate: Float
  "The standalone apps the customer already holds that this collection would bundle together"
  existingStandaloneApps: [GrowthUnifiedProfileCollectionSegmentStandaloneAppResult!]!
  "Pricing movement bucket for this offer (e.g. price_reduction, more_than_20p_increase)"
  pricingSegment: String
  "Estimated total price the customer pays today across the existing standalone apps per the billing cycle"
  totalStandalonePriceEstimate: Float
}

