"The connection type for JiraBoard"
type JiraBoardConnection {
  "A list of edges in the current page"
  edges: [JiraBoardEdge]
  "Information about the current page. Used to aid in pagination"
  pageInfo: PageInfo!
  "The total count of items in the connection"
  totalCount: Int
}

"An edge in a JiraBoard connection"
type JiraBoardEdge {
  "The cursor to this edge"
  cursor: String!
  "The node at the edge"
  node: JiraBoard
}

