  "Total count of spaces associated with this global view."
  associatedSpacesCount: Int
  boldColors: Boolean
  colorBy: JpdViewsServiceField
  colorStyle: JpdViewsServiceColorStyle
  columnSize: JpdViewsServiceColumnSize!
  connectionsFilter: [JpdViewsServiceFilter!]!
  connectionsLayoutType: JpdViewsServiceConnectionsLayout!
  createdAt: String!
  description: JSON @suppressValidationRule(rules : ["JSON"])
  emoji: String
  fieldRollups: [JpdViewsServiceFieldRollup!]!
  fields: [JpdViewsServiceField!]!
  filter: [JpdViewsServiceFilter!]!
  groupBy: JpdViewsServiceField
  groupOrder: JpdViewsServiceViewOrderType
  groupValues: [JpdViewsServiceNestedId!]!
  groupsFilter: [JpdViewsServiceFilter!]!
  hasDraft: Boolean
  hidden: [JpdViewsServiceField!]!
  hideEmptyColumns: Boolean!
  hideEmptyGroups: Boolean
  """
  Global View ARI, for example:
  `ari:cloud:cebeacbd-f85e-483c-96ac-fd432a12ad1c:global-view/activation/{activationId}/2346a038-3c8c-498b-a79b-e7847859868d`
  """
  id: ID! @ARI(interpreted : false, owner : "jira-product-discovery", type : "global-view", usesActivationId : false)
  jql: String
  layoutType: JpdViewsServiceViewLayoutType
  matrixConfig: JpdViewsServiceMatrixConfig
  " interface properties"
  name: String!
  "Indicates how the numbered list column is displayed in list view."
  numberColumnDisplay: String
  rank: Int
  showCardCovers: Boolean
  showConnectionsMatchingColumn: Boolean!
  showConnectionsMatchingGroup: Boolean!
  sort: [JpdViewsServiceSort!]!
  sortMode: JpdViewsServiceSortMode!
  tableColumnSizes: [JpdViewsServiceTableColumnSize]
  timelineConfig: JpdViewsServiceTimelineConfig2
  treeConfig: JpdViewsServiceTreeConfig
  updatedAt: String!
  "The UUID of the view. Same value as viewId."
  uuid: String!
  verticalGroupBy: JpdViewsServiceField
  verticalGroupOrder: JpdViewsServiceViewOrderType
  verticalGroupValues: [JpdViewsServiceNestedId!]!
  verticalGroupsFilter: [JpdViewsServiceFilter!]!
  "The ID of the view without the ARI prefix, for example `2346a038-3c8c-498b-a79b-e7847859868d`"
  viewId: String!
  visualizationType: JpdViewsServiceVisualizationType!
}

type JpdViewsServiceGlobalViewConnection2 {
  "The total count of global views that are associated with at least one space, across all pages."
  associatedGlobalViewsCount: Int
  edges: [JpdViewsServiceGlobalViewEdge2!]
  "The total count of global views that have a draft, across all pages."
  globalViewsWithDraftCount: Int
  "The total count of global views that do not have a draft, across all pages."
  globalViewsWithoutDraftCount: Int
  pageInfo: PageInfo!
}

type JpdViewsServiceGlobalViewEdge2 {
  cursor: String
  node: JpdViewsServiceGlobalView2
}

"Holds a limit value and its corresponding usage for a specific limit type."
type JpdViewsServiceGlobalViewLimitEntry {
  "The maximum allowed value for this limit type."
  limit: Int
  "The current count across the whole tenant (only populated for site-wide limits)."
  siteUsage: Int
  "The current count for the queried view (only populated when a viewId is provided)."
  viewUsage: Int
}

"Response type for fetching global view limits."
type JpdViewsServiceGlobalViewLimitsResponse {
  "Limit information for the maximum number of fields allowed per global view."
  fieldsPerGlobalView: JpdViewsServiceGlobalViewLimitEntry
  "Limit information for the maximum number of global views allowed per site."
  globalViewsPerSite: JpdViewsServiceGlobalViewLimitEntry
  "Limit information for the maximum number of spaces allowed per global view."
  spacesPerGlobalView: JpdViewsServiceGlobalViewLimitEntry
}

"Response type for fetching spaces associated with a global view."
type JpdViewsServiceGlobalViewProjectsResponse {
  "List of space ARIs (project ARIs) associated with the global view."
