type JiraForgeGroupField implements JiraIssueField & JiraIssueFieldConfiguration & JiraListRowField & JiraSelectedGroupField & JiraUserIssueFieldConfiguration & Node {
  "The field ID alias (if applicable)."
  aliasFieldId: ID
