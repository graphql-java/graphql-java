type InfluentsNotificationQuery {
  "API for fetching unique actors who have triggered notifications for this user."
  availableActors(collabContextRoutingAri: String, filter: InfluentsNotificationActorFilter, first: Int = 25, routingWorkspaceId: String): [InfluentsNotificationActor!]!
  """
  API for fetching a user's notifications.
  Notification feed returns a list of notifications where each notification represents the head notification for a group.
  i.e. If more than one notification belongs to a group, this API returns the latest notification from the group.
  If the flat option is enabled, no grouping is applied to the list of notifications, and thus each notification only contains one head item.
  It is recommended to use flat: false and fetch group contents on user interaction, rather than using the flat feed.
  """
  notificationFeed(after: String, collabContextRoutingAri: String, filter: InfluentsNotificationFilter, first: Int = 25, flat: Boolean, routingWorkspaceId: String): InfluentsNotificationFeedConnection!
  "API for fetching all notifications belonging to a specific group."
  notificationGroup(after: String, collabContextRoutingAri: String, filter: InfluentsNotificationFilter, first: Int = 25, groupId: String!, routingWorkspaceId: String): InfluentsNotificationGroupConnection!
  "API for fetching a user's unseen notification count."
  unseenNotificationCount(collabContextRoutingAri: String, product: String, routingWorkspaceId: String, workspaceId: String): Int!
}

