  This field is **deprecated** and will be removed in the future
  """
  fields: [String!]!
  jqlBuilder(cloudId: ID! @CloudID(owner : "jira")): JiraJqlBuilder
  """
  The persisted filter fields as a connection with Relay-compatible IDs.
  Returns the same data as the myFilterFieldsWithIds query, enabling automatic cache updates.
  May differ from input if some fields were invalid and dropped.
  
  
  This field is **deprecated** and will be removed in the future
  """
  myFilterFieldsWithIds: JiraMyFilterFieldConnectionResult!
  "Denotes whether the mutation was successful."
  success: Boolean!
}

