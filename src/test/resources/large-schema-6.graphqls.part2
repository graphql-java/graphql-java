type HelpObjectStoreQueryApi {
  """
  To fetch the Articles in bulk
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  articles(ids: [ID!]! @ARI(interpreted : false, owner : "help", type : "article", usesActivationId : false)): [HelpObjectStoreArticleResult] @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
  """
  To fetch the channels in bulk
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  channels(ids: [ID!]! @ARI(interpreted : false, owner : "help", type : "channel", usesActivationId : false)): [HelpObjectStoreChannelResult] @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
  """
  Unified endpoint for all JSM help objects.
  
  Aggregates request types, KB articles, and external resources from multiple parents.
  Merges, sorts, and paginates results based on sortConfig.
  
  For MANUAL sort mode: Uses manualSortOrder to determine item positions.
  Items in manualSortOrder use their configured order. Items not in manualSortOrder appear at the end
  
  For PARENT sort mode: Groups results by parent, then by entity type within parent.
  For SUB_ENTITY_TYPE sort mode: Groups results by entity type globally across all parents.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  helpObjects(filters: HelpObjectStoreFilters, input: HelpObjectStoreProductEntityInput!, sortConfig: HelpObjectStoreSortConfig): HelpObjectStoreProductEntityResult @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
  """
  Fetches kb categories with their projects mapped to a help center.
  Can filter by helpCenterAri (in input), projectId (from filters.filters), or both.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  kbCategories(filters: HelpObjectStoreFilters, input: HelpObjectStoreProductEntityInput!): HelpObjectStoreKbCategoriesResult @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
  """
  Fetches portal groups with their request forms mapped to a help center.
  Can filter by helpCenterAri (in input), projectId (from filters.filters), or both.
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  portalGroups(filters: HelpObjectStoreFilters, input: HelpObjectStoreProductEntityInput!): HelpObjectStorePortalGroupsResult @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
  """
  To fetch the Portals in bulk
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  portals(ids: [ID!]! @ARI(interpreted : false, owner : "help", type : "portal", usesActivationId : false)): [HelpObjectStorePortalResult] @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
  """
  To fetch the Request Forms in bulk
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  requestForms(ids: [ID!]! @ARI(interpreted : false, owner : "help", type : "request-form", usesActivationId : false)): [HelpObjectStoreRequestFormResult] @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
  """
  
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  searchHelpObjects(searchInput: HelpObjectStoreSearchInput!): [HelpObjectStoreHelpCenterSearchResult] @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
  """
  Suggested request types for a help center, backed by Jira REST
  
  ### OAuth Scopes
  
  One of the following scopes will need to be present on OAuth requests to get data from this field
  
  * __read:jsm:twg-cli__
  """
  suggestedRequestTypes(helpCenterAri: ID! @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)): HelpObjectStoreSuggestedRequestTypesResult @scopes(product : NO_GRANT_CHECKS, required : [READ_JSM_TWG_CLI])
}

