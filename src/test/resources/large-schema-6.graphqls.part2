}

"""
SLA metrics configuration for a Jira Service Management project, mirroring the data served by the internal
`GET /rest/servicedesk/1/servicedesk/agent/{projectKey}/sla/metrics` endpoint.
"""
type JiraServiceManagementProjectSlaMetricsConfiguration {
  "Calendars that goals in this project may reference."
  calendarRefs: [JiraServiceManagementProjectSlaCalendarReference!]!
  """
  Whether the site's plan entitles it to show SLAs on the customer portal. Unlike the other
  capabilities on this type this is a site entitlement rather than a user permission, so it is
  the same for every user of the project.
  """
  canConfigurePortalVisibility: Boolean!
  "Whether the logged-in user can create new SLA metrics for the project."
  canCreateMetrics: Boolean!
  "Whether the logged-in user can manage the SLA custom fields."
  canManageFields: Boolean!
  "Help URL for authoring the JQL used by SLA conditions and goals."
  jqlHelpUrl: String!
  "Number of SLA time metrics configured for the project."
  metricCount: Int!
  "The SLA time metrics configured for the project, in their configured order."
  timeMetrics: [JiraServiceManagementProjectSlaTimeMetric!]!
}

