type JiraPolicyRemediationWorkItemImpact {
  """
  Tenant-wide number of work items impacted by this remediation, including
  work items the requesting user may not have permission to view.
  
  Zero means analysis succeeded and found no matching work items. Null means
  the count could not be calculated.
  """
  impactedCount: Int
  """
  JQL identifying the impacted work items.
  
  The impact count is tenant-wide, but running this JQL applies the
