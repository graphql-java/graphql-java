"""
###################################################################################################################
 WORK NORMALIZATION SCHEMA
###################################################################################################################
"""
type MercuryWorkNormalizationQueryApi {
  """
  Get a list of the work linked directly to the given Focus Areas (excluding descendants)
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "Mercury")' query directive to the 'linkedWorkByFocusAreas' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  linkedWorkByFocusAreas(
    "Next"
    after: String,
    "Object representing all the available filters"
    filter: MercuryNormalizedWorkSearchFiltersInput,
    "The number of records to return in a page"
    first: Int,
    "The Focus Areas to get linked work from"
    focusAreaIds: [ID]! @ARI(interpreted : false, owner : "mercury", type : "focus-area", usesActivationId : false),
    "An array that stores the column to sort by, in priority order."
    sort: [MercuryNormalizedWorkSortInput],
    "Text to filter work names and keys by"
    textQuery: String
  ): MercuryNormalizedWorkConnection @lifecycle(allowThirdParties : true, name : "Mercury", stage : EXPERIMENTAL)
  """
  Get normalized work attributed to Organizations and linked to the requested Focus Areas
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "Mercury")' query directive to the 'linkedWorkByOrganizationAndFocusAreas' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  linkedWorkByOrganizationAndFocusAreas(
    "Next"
    after: String,
    "Filters including the Organizations that accepted the work"
    filter: MercuryOrganizationLinkedWorkSearchFiltersInput!,
    "The number of records to return in a page"
    first: Int,
    "The Focus Areas to get linked work from"
    focusAreaIds: [ID]! @ARI(interpreted : false, owner : "mercury", type : "focus-area", usesActivationId : false),
    "An array that stores the column to sort by, in priority order."
    sort: [MercuryNormalizedWorkSortInput],
    "Text to filter work names and keys by"
    textQuery: String
  ): MercuryNormalizedWorkConnection @lifecycle(allowThirdParties : true, name : "Mercury", stage : EXPERIMENTAL)
}

