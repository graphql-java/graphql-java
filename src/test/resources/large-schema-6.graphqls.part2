"""
Details required to render the initial screen of the new Bulk Move experience.

The selected issues are grouped by their source project, each carrying a per-type
breakdown of how many selected issues belong to each issue type. The candidate
destination projects are exposed once, at this level, because destination
eligibility is a per-user, per-target-project check (the caller must be able to
create issues in the target) and is independent of any individual source project.
"""
type JiraBulkMoveDetails {
  """
  Candidate destination projects the caller may move the selected issues into
  (projects in this instance where the caller can create issues). This candidate
  set is instance-wide and independent of any individual source project; deeper
  per-issue-type and per-target validation happens on later wizard screens.
  """
  destinationProjects(
    """
    Opaque cursor marking where the page begins, taken from a previous response.
    If not specified the page starts at the beginning.
    """
    after: String,
    "Not supported. Backward pagination is unavailable on this field; use first and after."
    before: String,
    """
    The number of items after the cursor to be returned.
    Defaults to 50 and is capped at 100.
    """
    first: Int,
    "Not supported. Backward pagination is unavailable on this field; use first and after."
    last: Int,
    "Specifies inputs for searching destination projects (e.g. typeahead by text)."
    search: JiraBulkMoveDestinationProjectSearch
  ): JiraProjectConnection
  """
  The distinct source projects the selected issues belong to, each with its own
  issue-type breakdown.
  """
  sourceProjects: [JiraBulkMoveSourceProject!]!
  """
  Status-mapping details for a set of bulk move destinations. For each destination
  (target project + work type), returns all statuses of the destination workflow as
  candidate mapping destinations, and the current statuses of the selected issues
  split into those that need mapping (not in the destination workflow) and those that
  are already valid. Mirrors legacy bulk move status mapping.
  """
  statusMappings(
    "The destinations, each with the selected issues that will be moved into it."
    moveTargets: [JiraBulkMoveStatusMappingTargetInput!]!
  ): [JiraBulkMoveStatusMapping!]
}

"A current status of the selected issues that does not exist in the destination workflow."
type JiraBulkMoveInvalidSourceStatus {
  "ARIs of the selected issues moving into the destination that are currently in this status."
  affectedIssueIds: [ID!]!
  "The current status."
  status: JiraStatus!
  """
  Suggested destination status: a status with the same name, otherwise the first status of
  the same status category, otherwise the destination workflow's initial status.
  """
  suggestedTargetStatus: JiraStatus
}

"The number of selected issues of a given issue type within a source project."
type JiraBulkMoveIssueTypeCount {
  """
  The number of selected issues of this issue type within the source project.
  Always equal to the size of {@code selectedIssueIds}.
  """
  count: Int!
  "The issue type of the counted issues."
  issueType: JiraIssueType
  """
  The ARIs of the selected issues of this issue type within the source project.
  These are the same issue identifiers the caller passes back to the submit
  mutation, so the client can partition its selection by source work type
  without an extra request. The count above always matches the size of this list.
  """
