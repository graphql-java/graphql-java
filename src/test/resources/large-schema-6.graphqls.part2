  degradedMode: JsmChannelsDegradedMode!
  """
  showcase loading state on panel
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  isLoading: Boolean!
  """
  Message to be shown in resolution panel
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  message: String
  """
  Plan would contain the runbooks that are most relevant and used for steps generation
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  plan: JsmChannelsServiceAgentResolutionPlan
  """
  Step-grouped progress log history for this conversation's current plan. Not paginated and not incremental — the complete current array is pushed whenever any entry changes, so this single field serves both the initial (re)load and every live update. Each group is step-complete: every entry for a step is always present together.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  progressLogs: [JsmChannelsProgressLogStepGroup!]
  """
  Latest chain-of-thought reasoning event for real-time UI updates
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  reasoningEvent: JsmChannelsReasoningEvent
  """
  Full chain-of-thought reasoning history (oldest-first) to hydrate the panel on load; live updates still arrive via the reasoningEvent field.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ❌ No |
  | UNAUTHENTICATED | ❌ No |
  """
  reasoningEvents: [JsmChannelsReasoningEvent!]
}

