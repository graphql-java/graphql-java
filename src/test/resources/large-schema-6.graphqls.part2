  "Shared identifier linking entries that came from the same user action, or null for ungrouped entries."
  eventId: String
  "Stable id of the field that changed (e.g. \"status\")."
  fieldId: String
  "The previous value of the field, or null if there was none."
  from: JiraReleaseHistoryValue
  "Localised display name of the field that changed."
  i18nFieldName: String
  id: ID!
  "When the change happened, as UTC unix epoch milliseconds."
  timestamp: Long
  "The new value of the field, or null if the field was cleared."
  to: JiraReleaseHistoryValue
}

"A change-history field value for the release status."
type JiraReleaseHistoryStatusFieldValue {
