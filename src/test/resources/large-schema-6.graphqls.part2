type InfluentsNotificationMutation {
  """
  API for archiving all of a users notifications.
  
  
  This field is **deprecated** and will be removed in the future
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  archiveAllNotifications(
    "The notificationId of the notification to archive and all older ones before the specified notification (INCLUSIVE)."
    beforeInclusive: String,
    """
    Archive all notifications older than this timestamp in ISO-8601 format (INCLUSIVE).
    Format: date-time
    """
    beforeInclusiveTimestamp: String,
    category: InfluentsNotificationCategory,
    "Which product the notifications should be from. If omitted, the results are from any product."
    product: String,
    "Notifications will only be archived from the workspace with the specified workspace id."
    workspaceId: String
  ): String
  """
  API for archiving the notifications specified by ids.
  Archived notifications will be excluded from future queries.
  
  
  This field is **deprecated** and will be removed in the future
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  archiveNotifications(
    "Required to support collaboration contexts. You must provide the id of the site/workspace the user is currently viewing."
    collabContextRoutingAri: String,
    """
    The list of notifications specified by ids.
    Min items: 1
    Max items: 100
    Unique items: true
    """
    ids: [String!]!,
    routingWorkspaceId: String
  ): String
  """
  API for archiving the notifications specified by group id.
  Archives at most 100 matching notifications per call, leaving any remaining members unchanged.
  Unknown and already archived groups succeed without changes.
  
  
  This field is **deprecated** and will be removed in the future
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  archiveNotificationsByGroupId(
    """
    The notificationId of the notification to archive and all older ones (INCLUSIVE).
    The timestamp encoded in the ID remains the cutoff on repeated calls.
    """
    beforeInclusive: String,
    category: InfluentsNotificationCategory,
    "Required to support collaboration contexts. You must provide the id of the site/workspace the user is currently viewing."
    collabContextRoutingAri: String,
    "groupId for archiving grouped notifications."
    groupId: String!
  ): String
  """
  API for clearing unseen notification count for a user.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  clearUnseenCount(
    "Required to support collaboration contexts. You must provide the id of the site/workspace the user is currently viewing."
    collabContextRoutingAri: String,
    "Only clear the unseen count for this product. If omitted, clears the count across all products."
    product: String,
    routingWorkspaceId: String,
    "Only clear the unseen count for this workspace. If omitted, clears the count across all workspaces."
    workspaceId: String
  ): String
  """
  API for marking notifications matching provided filters as read.
  
  This endpoint allows clients to implement 'markAllAsRead' functionality.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  markNotificationsAsRead(
    "Mark only notifications as old or older than this notificationId."
    beforeInclusive: String,
    """
    Mark only notifications as old or older than beforeInclusiveTimestamp.
    Format: ISO-8601 date-time (e.g., "2026-01-01T10:30:00Z").
    """
    beforeInclusiveTimestamp: String,
    category: InfluentsNotificationCategory,
    "Required to support collaboration contexts. You must provide the id of the site/workspace the user is currently viewing."
    collabContextRoutingAri: String,
    "Filter to exclude notifications from specific actors. If provided, notifications from these actors will not be marked."
    excludeActor: [String!],
    "Filter to include notifications from specific actors. If provided, only notifications from these actors will be marked."
    includeActor: [String!],
    "Filter notifications to mark by product. If omitted, the marked notifications can be from any product."
    product: String,
    routingWorkspaceId: String,
    "Filter notifications to mark by workspaceId. If omitted, the marked notifications can be from any workspace."
    workspaceId: String
  ): String
  """
  API for marking a group of notifications as read.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  markNotificationsByGroupIdAsRead(
    "Mark only notifications as old or older than this notificationId."
    beforeInclusive: String,
    category: InfluentsNotificationCategory,
    "Required to support collaboration contexts. You must provide the id of the site/workspace the user is currently viewing."
    collabContextRoutingAri: String,
    "Mark all notifications in this group as read."
    groupId: String!,
    routingWorkspaceId: String
  ): String
  """
  Mark all notifications in this group as unread.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  markNotificationsByGroupIdAsUnread(
    "Mark only notifications as old or older than this notificationId."
    beforeInclusive: String,
    category: InfluentsNotificationCategory,
    "Required to support collaboration contexts. You must provide the id of the site/workspace the user is currently viewing."
    collabContextRoutingAri: String,
    "Mark all notifications in this group as unread."
    groupId: String!,
    routingWorkspaceId: String
  ): String
  """
  API for marking a list of notifications, specified by their IDs, as read.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  markNotificationsByIdsAsRead(
    "Required to support collaboration contexts. You must provide the id of the site/workspace the user is currently viewing."
    collabContextRoutingAri: String,
    """
    List of notificationIds
    Min items: 1
    Max items: 100
    Unique items: true
    """
    ids: [String!]!,
    routingWorkspaceId: String
  ): String
  """
  API for marking a list of notifications, specified by their IDs, as unread.
  
  |Authentication Category    |Callable      |
  |:--------------------------|:-------------|
  | SESSION | ✅ Yes |
  | API_TOKEN | ✅ Yes |
  | CONTAINER_TOKEN | ❌ No |
  | FIRST_PARTY_OAUTH | ✅ Yes |
  | THIRD_PARTY_OAUTH | ✅ Yes |
  | UNAUTHENTICATED | ❌ No |
  """
  markNotificationsByIdsAsUnread(
    "Required to support collaboration contexts. You must provide the id of the site/workspace the user is currently viewing."
    collabContextRoutingAri: String,
    """
    List of notificationIds
    Min items: 1
    Max items: 100
    Unique items: true
    """
    ids: [String!]!,
    routingWorkspaceId: String
  ): String
}

