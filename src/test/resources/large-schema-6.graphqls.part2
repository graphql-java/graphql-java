"Represents an installation of a Forge app from the installations-v1 OpenSearch index."
type Installation {
  "Whether analytics is enabled for this installation."
  analyticsEnabled: Boolean
  "The Forge app identifier."
  appId: String
  "List of Atlassian products the app is associated with."
  atlassianApp: [String!]
  "The cloud ID extracted from the context ARI."
  cloudId: String
  "Compute version of the app."
  computeVersion: String
  """
  ARI of the site/context where the app is installed
  (e.g. ari:cloud:jira::site/<uuid>).
  """
  contextARI: String
  "Whether custom metrics are enabled."
  customMetricsEnabled: Boolean
  "Product edition."
  edition: String
  "The deployment environment (e.g. production, staging, development)."
  environment: String
  "The environment identifier for this installation."
  environmentId: String
  "The site hostname."
  hostName: String
  "The unique installation identifier. Populated from the OpenSearch _id field."
  installationId: String!
  "Timestamp when the app was installed (RFC-3339)."
  installedOn: String
  "License type."
  license: String
  "Whether logs are enabled."
  logsEnabled: Boolean
  "Organization identifier associated with this installation."
  orgId: String
  "Region of the remote installation, when the app is installed remotely."
  remoteInstallationRegion: String
  """
  Hostnames associated with additional contexts for cross-context (XCA) installs.
  Each entry has the context ARI, product, and hostname.
  """
  secondaryContextHosts: [SecondaryContextHostName!]
  "Additional context ARIs for cross-context (XCA) installs."
  secondaryContexts: [String!]
  "Installation status."
  status: String
  "Timestamp when the installation was suspended."
  suspendedAt: String
  "Reason the installation is suspended, when present."
  suspensionType: String
  "Unit identifier associated with this installation."
  unitId: String
  "App version."
  version: String
}

type InstallationContext {
  "Environment Id of the app"
  environmentId: ID!
  "Indicates whether the installation context has log access"
  hasLogAccess: Boolean!
  "Installation context as an ARI"
  installationContext: ID!
  "The tenant context for the cloud id. Only populated if context id is a valid cloud context. The batch size can only be a maximum can 20. Do not change it to any higher."
  tenantContext: TenantContext @hydrated(arguments : [{name : "cloudIds", value : "$source.cloudId"}], batchSize : 20, field : "tenantContexts", identifiedBy : "cloudId", indexed : false, inputIdentifiedBy : [], service : "tcs", timeout : -1)
}

type InstallationContextWithInstallationIdResponse {
  "Environment type for this context-installation pair"
  envType: AppEnvironmentType!
  "Installation context as an ARI"
  installationContext: ID!
  "Installation ID that granted access to this context"
  installationId: ID!
}

type InstallationContextWithLogAccess {
  "Installation context as an ARI"
  installationContext: ID!
  "The tenant context for the cloud id. Only populated if context id is a valid cloud context. The batch size can only be a maximum can 20. Do not change it to any higher."
  tenantContext: TenantContext @hydrated(arguments : [{name : "cloudIds", value : "$source.cloudId"}], batchSize : 20, field : "tenantContexts", identifiedBy : "cloudId", indexed : false, inputIdentifiedBy : [], service : "tcs", timeout : -1)
  "The tenant context for cloud or activation id."
  tenantContexts: DevConsoleTenantContext @hydrated(arguments : [{name : "ids", value : "$source.cloudId"}], batchSize : 200, field : "ecosystem.devConsole.tenantContexts", identifiedBy : "cloudIdOrActivationId", indexed : false, inputIdentifiedBy : [], service : "dev_console_legacy_graphql", timeout : -1)
}

