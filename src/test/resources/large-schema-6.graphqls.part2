"""
A single site the calling user has access to, enriched with org / admin
context. Field-by-field source mapping:

  cloudId      -> Identity resourcesByPrincipalPermissions: parsed from
                  `resourceId` ARI                                   (always present)
  displayName  -> TCS sidecar `getTenantDetails(cloudId).cloudName`  (null on TCS error; `hasErrors` then true)
  url          -> TCS sidecar `getTenantDetails(cloudId).cloudUrl`   (null on TCS error; `hasErrors` then true)
  avatarUrl    -> NULL in M1 — sourced from `siteSettings['avatar']` which is
                  served by TCS settings_service (not currently allowlisted
                  in our sandbox) or enterprise-gatekeeper (no id-gatekeeper
                  allowlist either). Tracked as a post-M1 follow-up.
  products     -> Identity resourcesByPrincipalPermissions, grouped by cloudId,
                  mapped through `productEnumMap.ts`                 (non-canonical products dropped silently)
  orgId        -> TCS sidecar `getOrgId(cloudId)`                    (null on TCS error; `hasErrors` then true)
  orgName      -> NULL in M1 — deferred to M2.
  unitId       -> TCS sidecar `getUserbaseAri(cloudId)`              (always populated; null if TCS lookup failed)
  unitName     -> NULL in M1 — deferred to M2.
  isAdmin      -> Identity `bulk/permitted` (permissionId="manage")
                  bucketed by userbase, with mandatory `id-sharding-key`
                  (null when the call fails so consumers can degrade)
"""
type MarketplaceStoreUserSite {
  """
  Avatar URL. NULL in M1 — see source-mapping comment on the parent type.
  Reserved as nullable so the frontend can render a default placeholder
  without a schema change once we wire the avatar source.
  """
  avatarUrl: String
  "Site UUID. Stable identifier, also used as the pagination cursor."
  cloudId: String!
  """
  Site display name (TCS `cloudName`). NULL if the per-site TCS lookup
  failed; in that case `hasErrors` is also true and the UI should render a
  placeholder rather than the raw cloudId.
  """
  displayName: String
  """
  Whether the calling user is a site administrator on this site (per the
  `manage` permission, checked via `bulk/permitted`). NULL when the per-bucket
  permissions call failed; in that case
  `MarketplaceStoreUserSitesResult.hasErrors` is also true. The frontend
  should treat NULL as "unknown" and fall back to a permission re-check on
  the user's first administrative action.
  """
  isAdmin: Boolean
  """
  Organization ID the site belongs to. NULL only when the TCS sidecar lookup
  for this specific site failed; in that case the site is still returned and
  `MarketplaceStoreUserSitesResult.hasErrors` is set to true.
  """
  orgId: String
  """
  Organization display name. Always null in M1; reserved for M2 (no
  non-AppSwitcher source currently allowlisted for us).
  """
  orgName: String
  """
  Products the user can access on this site (intersected with
  `input.productFilter` when in EMCEE mode). Sorted ascending by
  `productType` so consumers can render a stable, deterministic order.
  """
  products: [MarketplaceStoreSiteProductEntry!]!
  """
  Userbase / unit UUID. Always populated when the TCS lookup succeeds;
  null only when the per-site TCS call failed (in which case `hasErrors` is
  also true).
  """
  unitId: String
  "Unit display name. Always null in M1; reserved for M2."
  unitName: String
  """
  Canonical site URL (e.g. `https://acme.atlassian.net`). Sourced from TCS
  `cloudUrl`. NULL if the per-site TCS lookup failed (same semantics as
  `displayName`).
  """
  url: String
}

"""
Cursor pagination metadata for `marketplaceStore.userSites`.

Distinct from the older `MarketplaceStorePageInfo` (defined in
`AppInstallationsByApp.graphqls`) which only carries `hasNextPage` +
`endCursor`. The user-sites variant additionally surfaces `totalSites` so
the frontend can render "showing X of Y sites" copy.
"""
type MarketplaceStoreUserSitesPageInfo {
  """
  Pass back as `input.cursor` to fetch the next page. Equals the `cloudId` of
  the last site in this page; null when `hasNextPage` is false.
  """
  endCursor: String
  "True when more pages exist after this one."
  hasNextPage: Boolean!
  """
  Total number of sites the user has access to (post-dedup + post-filter,
  pre-pagination).
  """
  totalSites: Int!
}

"""
Top-level response for `marketplaceStore.userSites`.

`hasErrors` is true when ANY per-site enrichment call (TCS `getTenantDetails`,
TCS `getOrgId`, TCS `getUserbaseAri`, or Identity `bulk/permitted`) failed
for one or more sites on this page. Failed-enrichment sites are still
returned with the affected fields set to null (or the documented fallback,
e.g. `displayName = cloudId`). The frontend should surface a soft indicator
(e.g. inline retry) rather than blanking the page.
"""
type MarketplaceStoreUserSitesResult {
  "Echoes the resolver mode (STORE or EMCEE) for client diagnostics."
  context: MarketplaceStoreUserSitesContext!
  "True when at least one per-site enrichment call failed on this page."
  hasErrors: Boolean!
  pageInfo: MarketplaceStoreUserSitesPageInfo!
  sites: [MarketplaceStoreUserSite!]!
}

