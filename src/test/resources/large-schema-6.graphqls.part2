  ari: ID!
  containerAri: ID!
  reactions: [KitsuneReactionSummary!]!
}

"One entry in the upstream object-ARI-to-reactions map."
type KitsuneObjectReactions {
  ari: ID!
  reactions: [KitsuneReactionSummary!]!
}

