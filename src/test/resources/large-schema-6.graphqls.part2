  edges: [HelpCenterTopicItemEdge]
  nodes: [HelpCenterTopicItem]
  pageInfo: PageInfo!
  totalCount: Int
}

type HelpCenterTopicItemEdge {
  cursor: String!
  node: HelpCenterTopicItem
}

"A translatable block: an extension type plus the set of fields within it that may be translated."
type HelpCenterTranslatableBlock {
  "Typed block identifier."
  blockType: HelpCenterTranslatableBlockType!
  "Raw ADF match key, e.g. `com.atlassian.confluence.spotlight`."
  extensionType: String!
  "The translatable fields for this block."
  fields: [HelpCenterTranslatableField!]!
}

"One translatable field of a block. Path is relative to the block's parameters."
type HelpCenterTranslatableField {
  "ARRAY_ITEM only: the parameters key holding the array (e.g. `cards`); null for SCALAR."
  arrayKey: String
  "ARRAY_ITEM only: the id property on each array element (e.g. `cardId`); null for SCALAR."
  idField: String
  "Whether this is a single value or a value inside a repeated array element."
  kind: HelpCenterTranslatableFieldKind!
  "Template path relative to the block, e.g. `content.text.title` or `cards[].title`."
  path: String!
}

type HelpCenterTranslation {
  "Locale key of the Translation"
  locale: String!
  "Locale display Name of the Translation"
  localeDisplayName: String!
  "Value of the Translation"
  value: String!
}

