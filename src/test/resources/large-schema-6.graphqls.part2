"""
Per-issue decision describing which AI Context Panel should be rendered now.
The contract is intentionally minimal: `defaultPanel + fallbackPanel + initialState`.
The client may use `fallbackPanel` only when the `defaultPanel` content flow reports
its content is unavailable. Plan lifecycle, data sources, actions, and citations are
owned by the downstream content services (JSM-CO, Firebolt) and are not exposed here.
"""
type JiraAiContextPanelDecision {
  "The panel the client should render first. Decided by the backend."
  defaultPanel: JiraAiContextPanel
  """
  Backend-provided fallback panel. Used only when the `defaultPanel` content flow
  reports its content is unavailable.
  """
  fallbackPanel: JiraAiContextPanel
  "Initial UI display state for the panel container."
  initialState: JiraAiContextPanelInitial
}

