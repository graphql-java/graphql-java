  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  archiveApp(archiveAppRequest: MarketplaceConsoleArchiveAppRequest!): MarketplaceConsoleProductLifecycleJobResponse @lifecycle(allowThirdParties : false, name : "MarketplaceConsoleArchiveApp", stage : EXPERIMENTAL) @rateLimited(disabled : true, rate : 10, usePerIpPolicy : false, usePerUserPolicy : true)
