"""


### OAuth Scopes

One of the following scopes will need to be present on OAuth requests to get data from this field

* __confluence:atlassian-external__
* __read:loom:twg-cli__
* __read:comment:loom__
* __read:loom__
"""
type LoomComment implements Node @defaultHydration(batchSize : 100, field : "loom_comments", idArgument : "ids", identifiedBy : "id", timeout : -1) @scopes(product : CONFLUENCE, required : [CONFLUENCE_ATLASSIAN_EXTERNAL]) @scopes(product : NO_GRANT_CHECKS, required : [READ_LOOM_TWG_CLI]) @scopes(product : LOOM, required : [READ_LOOM_COMMENT]) @scopes(product : LOOM, required : [LOOM_READ]) {
  content: String
  createdAt: String
  editedAt: String
  id: ID! @ARI(interpreted : false, owner : "loom", type : "comment", usesActivationId : false)
  replies: [LoomCommentReply!]
  timestamp: Int
  url: String
  user: User @hydrated(arguments : [{name : "accountIds", value : "$source.userId"}], batchSize : 90, field : "users", identifiedBy : "accountId", indexed : false, inputIdentifiedBy : [], service : "identity", timeout : -1)
  userId: ID
  video: LoomVideo @hydrated(arguments : [{name : "ids", value : "$source.videoId"}], batchSize : 100, field : "loom_videos", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "loom", timeout : -1)
  videoId: ID!
}

type LoomCommentConnection {
  edges: [LoomCommentEdge]
  pageInfo: LoomPageInfo
}

type LoomCommentEdge {
  cursor: String
  node: LoomComment
}

"""
 Embedded (non-entity) type: replies are returned inline within the parent
 LoomComment's loom_comments response, not fetched via a separate by-ID field,
 so this type is not a hydratable @defaultHydration entity (there is no
 loom_comment_replies backing field). Because it does not implement Node, its
 ID fields cannot carry the @ARI directive (AGG standard: @ARI requires Node);
 the id/parentCommentId are still ARI-formatted string values at runtime.
"""
type LoomCommentReply {
  content: String
  createdAt: String
  editedAt: String
  id: ID!
  parentCommentId: ID
  timestamp: Int
  url: String
  userId: ID
  videoId: ID!
}

