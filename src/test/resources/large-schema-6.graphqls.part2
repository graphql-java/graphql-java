"""
Consolidated migration details for a help center, reached via the `HelpCenter.migration` field.
`HelpCenter.migration` is null when migration was never initiated (the card shows "Live").
`preMigrationSummary` is resolved independently, so a client that selects only `state` /
`migratedHubAri` does not trigger the (expensive) content-count aggregation.
"""
type HelpCenterMigrationInfo {
  "ARI of the newly migrated Help Hub, used for the \"Review migration\" link. Null until a migrated hub exists."
  migratedHubAri: String
  "Pre-migration content counts for the \"Review your selection\" screen. Resolved only when selected; null when unavailable."
  preMigrationSummary: HelpCenterMigrationPreMigrationSummary
  "Current per-help-center migration lifecycle state. Cheap to resolve."
  state: HelpCenterMigrationState!
}

"""
A snapshot of a help center's content before migration, used to populate the
"Review your selection" screen. Counts are point-in-time estimates.
"""
type HelpCenterMigrationPreMigrationSummary {
  "Number of Forge/Connect apps present on the help center and its portals."
  appsCount: Int
  "Number of custom pages configured on this help center."
  customPagesCount: Int
  "Estimated migration duration in seconds."
  estimatedDurationSeconds: Int
  "Number of knowledge base articles associated with this help center."
  knowledgeArticlesCount: Int
  "Timestamp (ISO-8601) of the most recent update to the help center."
  lastUpdatedAt: String
  "Number of Confluence/knowledge spaces linked to this help center."
  linkedSpacesCount: Int
  "Display name of the help center."
  name: String
}

type HelpCenterMoveSiteTreeNodePayload implements Payload {
  "The 1-2 folders whose contents changed (source and destination, deduped). May include ROOT."
