"The top level wrapper for JSMSolutionComposerPlanQueryApi."
type JsmSolutionComposerPlanQueryApi {
  """
  Fetches the Solution Composer context available for a given project. projectAri represents the ARI of the Jira project.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "SolutionComposer")' query directive to the 'jsmSolutionComposerPlanContext' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  jsmSolutionComposerPlanContext(projectAri: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)): JsmSolutionComposerPlanContextResult @lifecycle(allowThirdParties : false, name : "SolutionComposer", stage : EXPERIMENTAL)
  """
  Fetches the solution composer plan status for a given project. projectAri represents the ARI of the Jira project.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "SolutionComposer")' query directive to the 'jsmSolutionComposerPlanStatus' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  jsmSolutionComposerPlanStatus(projectAri: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)): JsmSolutionComposerPlanStatusResult @lifecycle(allowThirdParties : false, name : "SolutionComposer", stage : EXPERIMENTAL)
}

"SolutionComposerPlanStatus metadata for extend with additional information"
type JsmSolutionComposerPlanStatusMetadata {
  "Optional ARI of Hub created as part of Solution Composer."
  hubAri: ID @ARI(interpreted : false, owner : "help", type : "help-center", usesActivationId : false)
}

"SolutionComposerPlanStatus for a project"
type JsmSolutionComposerPlanStatusResponse {
  automationOverview: JsmSolutionComposerAutomationOverview
  followupTasks: [JsmSolutionComposerFollowupTask]
  formsOverview: JsmSolutionComposerFormsOverview
  id: ID!
  metadata: JsmSolutionComposerPlanStatusMetadata
  projectAri: ID! @ARI(interpreted : false, owner : "jira", type : "project", usesActivationId : false)
  """
  The lightweight Rovo agent reference for this project's portal widget.
  A null result indicates no available agent; QueryError indicates a failed lookup.
  
  ### Field lifecycle
  
  This field is in the 'EXPERIMENTAL' lifecycle stage
  
  To query this field a client will need to add the '@optIn(to: "AgentStudio")' query directive to the 'rovoAgentsOverview' field, or to any of its parents.
  
  The field is extremely unstable. It can go through changes at any moment, and its execution can be slow and/or unreliable. Clients should use it with care and at their own risk!
  """
  rovoAgentsOverview(cloudId: String! @CloudID(owner : "agent")): AgentStudioWidgetReferenceByContainerAriResult @hydrated(arguments : [{name : "cloudId", value : "$argument.cloudId"}, {name : "containerAri", value : "$source.projectAri"}], batchSize : 200, field : "agentStudio_widgetReferenceByContainerAri", identifiedBy : "id", indexed : false, inputIdentifiedBy : [], service : "agent", timeout : -1) @lifecycle(allowThirdParties : false, name : "AgentStudio", stage : EXPERIMENTAL)
  status: JsmSolutionComposerPlanStatusType!
  steps: [JsmSolutionComposerStepStatus]
}

