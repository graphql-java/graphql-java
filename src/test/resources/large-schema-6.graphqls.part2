  category: JsmAnalyticsInsightCategory!
  description: String!
  displayOrder: Int
  insights: [JsmAnalyticsInsight!]!
  title: String!
}

"""
All configurable insight types for the acting (cloudId, accountId, projectId) scope.
One entry per supported `InsightType`, even when the type has no subjects for the
project, so the UI can render a stable section list.
"""
type JsmAnalyticsInsightSettings @renamed(from : "InsightSettings") {
  insightTypes: [JsmAnalyticsInsightTypeSettings!]!
}

"""
Response envelope for the `insightSettings` query. Implements the shared `Payload`
interface (`success` + `errors`) from `agg-shared-types.graphqlst` so clients can
handle errors generically, extended with a typed `data` payload.
"""
type JsmAnalyticsInsightSettingsResponse implements Payload @renamed(from : "InsightSettingsResponse") {
  data: JsmAnalyticsInsightSettings
  errors: [MutationError!]
  success: Boolean!
}

type JsmAnalyticsInsightStep @renamed(from : "InsightStep") {
  category: JsmAnalyticsInsightStepCategory!
  summary: String!
  title: String!
}

"""
`subjectMeta` is insight-type-specific parameters that do NOT participate in subject
identity. `null` for `SLA` subjects today; populated for `JQL` subjects (e.g. the
upcoming ticket-inflow insight) with `{"jql": "...", "name": "..."}` or similar.
"""
type JsmAnalyticsInsightSubjectSetting @renamed(from : "InsightSubjectSetting") {
  configId: ID!
  enabled: Boolean!
  subjectId: String!
  subjectMeta: JSON @suppressValidationRule(rules : ["JSON"])
  subjectName: String
  subjectType: JsmAnalyticsInsightSubjectType!
}

type JsmAnalyticsInsightSummary @renamed(from : "InsightSummary") {
  total: Int!
}

"""
`enabled` is the aggregate master-toggle state the UI binds to the type-level switch:
`true` iff AT LEAST one subject is enabled (`subjects.any { it.enabled }`). An all-off
type reports `false` so the UI can collapse the section and the master toggle lets the
user enable/disable every subject at once via `updateInsightConfig` BROAD mode.
Empty `subjects` reports `false` (nothing to enable).
"""
type JsmAnalyticsInsightTypeSettings @renamed(from : "InsightTypeSettings") {
  enabled: Boolean!
  insightType: JsmAnalyticsInsightType!
  subjects: [JsmAnalyticsInsightSubjectSetting!]!
}

type JsmAnalyticsInsightsQueryResponse @renamed(from : "InsightsQueryResponse") {
  generatedAt: DateTime!
  insights: [JsmAnalyticsInsight!]!
  pageInfo: PageInfo!
  sections: [JsmAnalyticsInsightSection!]!
  summary: JsmAnalyticsInsightSummary!
  timeRange: JsmAnalyticsTimeRange!
}

